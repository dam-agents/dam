#!/usr/bin/env bash
#MISE description="On an overlay root a sandbox's or an Environment's cluster keeps the kubelet's root and the runner's node directories on the home disk, and nowhere else, an Environment's kubelet keeps its images, and its huge pages stay on"
#MISE sources=["helm/values*.yaml", ".mise/lib/cluster.sh", ".mise/lib/root.sh", ".mise/tasks/check/cluster-sandbox-dirs"]
#MISE outputs=[]
#MISE cache.enabled=true
# The VM runner pod runs in a user namespace, and runc cannot idmap a volume
# whose source is on an overlay: in an agent sandbox, whose machine root is
# one, the pod never started after a restart until someone moved the kubelet's
# root and bind-mounted the node directories by hand (#6017). The helpers in
# .mise/lib/cluster.sh do it now; this runs them against a stubbed root, mount
# and filesystem, so no cluster, root or overlay is needed.
set -euo pipefail

unset IS_SANDBOX DAM_INSTALL CLUSTER_ENVIRONMENT E2E_LANE E2E_ENVIRONMENT CLUSTER_ANNOUNCED usage_environment usage_name
# shellcheck disable=SC1091
CLUSTER_RESOLVE_ONLY=1 . "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"
cd "$MISE_CONFIG_ROOT"
fail=0
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT

same() { # <what> <want> <got>
  [ "$2" = "$3" ] || { echo "FAIL: $1: got '$3', want '$2'" >&2; fail=1; }
}
sorted() { sort | paste -sd' ' -; }

# --- which node directories an install hands its runners -------------------
same "the dev install" "/var/lib/platform-vm-images /var/lib/platform-vm-runner-releases" \
  "$(node_dir_roots helm/values.yaml helm/values-local.yaml -- | sorted)"
same "the e2e lane's own cache root replaces the dev one" "/var/lib/platform-vm-runner-releases /var/lib/vm-images" \
  "$(node_dir_roots helm/values.yaml helm/values-local.yaml helm/values-e2e.yaml -- \
    --set=domain=localhost --set=virtualization.imageCache.hostPath=/var/lib/vm-images --set=virtualization.runner.machineCPUs=4 | sorted)"
same "a --set-string and a legacy path" "/srv/old /srv/releases" \
  "$(node_dir_roots helm/values.yaml -- --set-string=virtualization.runner.releaseHostPath=/srv/releases \
    --set=virtualization.imageCache.legacyPath=/srv/old | sorted)"

# --- the stubs: which paths are on an overlay, what is mounted, what root ran
OVERLAY=""
on_overlay() { case " $OVERLAY " in *" $1 "*) return 0 ;; *) return 1 ;; esac; }
MOUNTED=""
node_sh() {
  case "$1" in
    mount) echo "$*" >> "$work/root.log" ;;
    mountpoint) case " $MOUNTED " in *" $3 "*) return 0 ;; *) return 1 ;; esac ;;
    *) "$@" ;;
  esac
}
NODE_HOME_SHARE="$work/home"
NODE_KUBELET_DROPIN="$work/config.yaml.d/60-kubelet-root.yaml"

# --- the kubelet's root ----------------------------------------------------
dropin() { [ -e "$NODE_KUBELET_DROPIN" ] && echo present || echo absent; }
rc=0; node_kubelet_root_needed || rc=$?
same "no overlay: nothing to move" "1 absent" "$rc $(dropin)"
OVERLAY="/var/lib/kubelet"
rc=0; node_kubelet_root_needed || rc=$?
same "an overlay root: the kubelet's root must move" 0 "$rc"
same "asking writes nothing, so a stop that fails after it leaves no drop-in" absent "$(dropin)"
rc=0; node_kubelet_root_needed || rc=$?
same "a failed stop is tried again on the next install" 0 "$rc"
node_kubelet_root_write
grep -qF "  - \"root-dir=$NODE_HOME_SHARE/kubelet\"" "$NODE_KUBELET_DROPIN" ||
  { echo "FAIL: the drop-in does not move the kubelet's root to $NODE_HOME_SHARE/kubelet" >&2; fail=1; }
grep -q '^kubelet-arg+:' "$NODE_KUBELET_DROPIN" ||
  { echo "FAIL: the drop-in replaces kubelet-arg instead of appending to it" >&2; fail=1; }
rc=0; node_kubelet_root_needed || rc=$?
same "a drop-in already there: nothing to restart for" 1 "$rc"
# k3s merges config.yaml.d in name order, and a plain `kubelet-arg:` replaces
# every append before it.
[[ "$(basename "$NODE_KUBELET_DROPIN")" > 50-container-log-rotation.yaml ]] ||
  { echo "FAIL: $(basename "$NODE_KUBELET_DROPIN") sorts before 50-container-log-rotation.yaml, whose kubelet-arg would drop it" >&2; fail=1; }
rm -f "$NODE_KUBELET_DROPIN"
OVERLAY="/var/lib/kubelet $NODE_HOME_SHARE"
rc=0; node_kubelet_root_needed 2>/dev/null || rc=$?
same "the home on an overlay too: nothing to move" "1 absent" "$rc $(dropin)"

# --- an Environment's k3s keeps its images (#6128, #6272) -----------------
NODE_IMAGE_GC_DROPIN="$work/config.yaml.d/60-image-gc-off.yaml"
rc=0; node_image_gc_off || rc=$?
same "a first write changes the drop-in" 0 "$rc"
same "image collection never starts, and only memory evicts, at any disk use" \
  "image-gc-high-threshold=100 image-gc-low-threshold=99 eviction-hard=memory.available<100Mi" \
  "$(yq -r '."kubelet-arg+" | join(" ")' "$NODE_IMAGE_GC_DROPIN")"
# The guard's grant reads as used disk: a disk threshold here would delete
# the install's images and evict pods.
yq -r '."kubelet-arg+"[]' "$NODE_IMAGE_GC_DROPIN" | grep -qE '(nodefs|imagefs)\.' &&
  { echo "FAIL: the drop-in gives the kubelet a disk eviction threshold" >&2; fail=1; }
rc=0; node_image_gc_off || rc=$?
same "an unchanged drop-in: nothing to restart for" 1 "$rc"
[[ "$(basename "$NODE_IMAGE_GC_DROPIN")" > 50-container-log-rotation.yaml ]] ||
  { echo "FAIL: $(basename "$NODE_IMAGE_GC_DROPIN") sorts before 50-container-log-rotation.yaml, whose kubelet-arg would drop it" >&2; fail=1; }

# --- the node directories --------------------------------------------------
: > "$work/root.log"
OVERLAY="" node_host_dirs "$work/var/vm-images"
same "no overlay: nothing mounted" "|" "$(cat "$work/root.log")|${NODE_MOUNTED[*]}"
: > "$work/root.log"
mkdir -p "$work/var/vm-images/default"
echo staged > "$work/var/vm-images/default/image"
OVERLAY="$work/var/vm-images $work/var/releases" MOUNTED="$work/var/releases"
node_host_dirs "$work/var/vm-images" "$work/var/releases" ""
same "an overlay directory is mounted from the home disk, an existing mount is left" \
  "mount --bind $NODE_HOME_SHARE/host-vm-images $work/var/vm-images|$work/var/vm-images" \
  "$(cat "$work/root.log")|${NODE_MOUNTED[*]}"
same "what the overlay directory held is kept behind the mount" staged \
  "$(cat "$NODE_HOME_SHARE/host-vm-images/default/image" 2>/dev/null)"

# --- the mounts come back at every boot (#6017) ----------------------------
NODE_HOST_DIRS_SERVICE="$work/init.d/platform-host-dirs"
mkdir -p "$work/init.d"
node_sh() {
  case "$1" in
    mount|rc-update) echo "$*" >> "$work/root.log" ;;
    mountpoint) case " $MOUNTED " in *" $3 "*) return 0 ;; *) return 1 ;; esac ;;
    test) [ "$2 $3" = "-x /sbin/openrc-run" ] && return 0; "$@" ;;
    *) "$@" ;;
  esac
}
: > "$work/root.log"
OVERLAY="$work/var/vm-images $work/var/releases" MOUNTED="$work/var/releases"
mkdir -p "$NODE_HOME_SHARE/host-releases"
node_host_dirs "$work/var/vm-images" "$work/var/releases"
node_host_dirs_at_boot
same "the boot service names the mount made now and one an earlier install made" \
  "2" "$(grep -c 'mount --bind' "$NODE_HOST_DIRS_SERVICE" 2>/dev/null)"
grep -qF "mount --bind '$NODE_HOME_SHARE/host-vm-images' '$work/var/vm-images'" "$NODE_HOST_DIRS_SERVICE" &&
  grep -qF "mount --bind '$NODE_HOME_SHARE/host-releases' '$work/var/releases'" "$NODE_HOST_DIRS_SERVICE" ||
  { echo "FAIL: the boot service does not bind-mount both node directories from the home disk" >&2; fail=1; }
# A path with a space is one operand in the service, not two (review of #6225).
NODE_HOST_MOUNTS=("$work/home/host one" "$work/var/vm images")
node_host_dirs_at_boot
sed -n '/^start() {$/,/^}$/p' "$NODE_HOST_DIRS_SERVICE" > "$work/start-space.sh"
: > "$work/root.log"
( mountpoint() { return 1; }
  mkdir() { :; }
  mount() { printf '%s|' "$@" >> "$work/root.log"; }
  . "$work/start-space.sh"; start )
same "a path with a space reaches mount as one argument" \
  "--bind|$work/home/host one|$work/var/vm images|" "$(cat "$work/root.log")"
NODE_HOST_MOUNTS=()
OVERLAY="$work/var/vm-images $work/var/releases" MOUNTED="$work/var/releases"
mkdir -p "$NODE_HOME_SHARE/host-releases"
node_host_dirs "$work/var/vm-images" "$work/var/releases"
node_host_dirs_at_boot
grep -q 'before k3s' "$NODE_HOST_DIRS_SERVICE" ||
  { echo "FAIL: the boot service does not start before k3s" >&2; fail=1; }
grep -qF "rc-update add $(basename "$NODE_HOST_DIRS_SERVICE") default" "$work/root.log" ||
  { echo "FAIL: the boot service is not added to the default runlevel" >&2; fail=1; }
sh -n "$NODE_HOST_DIRS_SERVICE" || { echo "FAIL: the boot service is not valid shell" >&2; fail=1; }
# The start() body, run as the boot would run it, mounts each directory once:
# a directory already mounted is left, so a restart of the service is a no-op.
sed -n '/^start() {$/,/^}$/p' "$NODE_HOST_DIRS_SERVICE" > "$work/start.sh"
: > "$work/root.log"
( mountpoint() { case " $MOUNTED " in *" $2 "*) return 0 ;; *) return 1 ;; esac; }
  mount() { echo "mount $*" >> "$work/root.log"; }
  . "$work/start.sh"; MOUNTED="$work/var/releases" start )
same "a boot mounts what is not mounted yet, and leaves what is" \
  "mount --bind $NODE_HOME_SHARE/host-vm-images $work/var/vm-images" "$(cat "$work/root.log")"
: > "$work/root.log"
OVERLAY="" MOUNTED=""
rm -rf "$NODE_HOME_SHARE/host-releases" "$NODE_HOME_SHARE/host-vm-images"
node_host_dirs "$work/var/vm-images" "$work/var/releases"
node_host_dirs_at_boot
[ ! -e "$NODE_HOST_DIRS_SERVICE" ] ||
  { echo "FAIL: a node whose directories need no mount keeps a boot service" >&2; fail=1; }
grep -qF "rc-update del $(basename "$NODE_HOST_DIRS_SERVICE") default" "$work/root.log" ||
  { echo "FAIL: a boot service no install needs is left in the default runlevel" >&2; fail=1; }

# --- an Environment's nested guests get huge pages, at every boot (#6199) --
NODE_THP_SERVICE="$work/init.d/platform-thp"
NODE_THP_ENABLED="$work/thp-enabled"
mkdir -p "$work/init.d"
echo 'always [madvise] never' > "$NODE_THP_ENABLED"
node_sh() {
  case "$1" in
    rc-update) echo "$*" >> "$work/root.log" ;;
    test) [ "$2 $3" = "-x /sbin/openrc-run" ] && return 0; "$@" ;;
    sh) [ "$4 $5" = "_ $NODE_THP_ENABLED" ] && echo "[always] madvise never" > "$5" ;;
    *) "$@" ;;
  esac
}
: > "$work/root.log"
rc=0; node_thp_always || rc=$?
same "huge pages turn on now" "0 [always] madvise never" "$rc $(cat "$NODE_THP_ENABLED")"
grep -q 'before k3s' "$NODE_THP_SERVICE" ||
  { echo "FAIL: the huge pages service does not start before k3s" >&2; fail=1; }
grep -qF "echo always > $NODE_THP_ENABLED" "$NODE_THP_SERVICE" ||
  { echo "FAIL: the huge pages service does not turn huge pages on" >&2; fail=1; }
sh -n "$NODE_THP_SERVICE" || { echo "FAIL: the huge pages service is not valid shell" >&2; fail=1; }
grep -qF "rc-update add $(basename "$NODE_THP_SERVICE") default" "$work/root.log" ||
  { echo "FAIL: the huge pages service is not added to the default runlevel" >&2; fail=1; }
echo 'always [madvise] never' > "$NODE_THP_ENABLED"
node_sh() {
  case "$1" in
    rc-update|sh) return 0 ;;
    test) [ "$2 $3" = "-x /sbin/openrc-run" ] && return 0; "$@" ;;
    *) "$@" ;;
  esac
}
rc=0; node_thp_always 2>/dev/null || rc=$?
same "a kernel that keeps madvise fails the install" 1 "$rc"

exit "$fail"
