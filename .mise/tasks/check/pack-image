#!/usr/bin/env bash
#MISE description="Assert image:pack's ownership and mode flags on a tiny image: --own, --own-dir and --mode"
#MISE sources=[".mise/tasks/image/pack", ".mise/tasks/image/name-layout", ".mise/tasks/check/pack-image"]
#MISE outputs=[]
#MISE cache.enabled=true
set -euo pipefail
pack="$(cd "$(dirname "$0")/../image" && pwd)/pack"
t="$(mktemp -d)"
trap 'rm -rf "$t"' EXIT
umask 002

# An empty base: one config, no layers.
mkdir -p "$t/base/blobs/sha256"
put() {
  local h; h="$(printf '%s' "$1" | sha256sum | cut -c1-64)"
  printf '%s' "$1" > "$t/base/blobs/sha256/$h"
  jq -cn --arg d "sha256:$h" --argjson s "${#1}" --arg m "$2" '{mediaType: $m, digest: $d, size: $s}'
}
config="$(put '{"architecture":"amd64","os":"linux","config":{},"rootfs":{"type":"layers","diff_ids":[]}}' application/vnd.oci.image.config.v1+json)"
manifest="$(put "$(jq -cn --argjson c "$config" '{schemaVersion: 2, mediaType: "application/vnd.oci.image.manifest.v1+json", config: $c, layers: []}')" application/vnd.oci.image.manifest.v1+json)"
jq -n --argjson m "$manifest" '{schemaVersion: 2, manifests: [$m]}' > "$t/base/index.json"
echo '{"imageLayoutVersion":"1.0.0"}' > "$t/base/oci-layout"

# A tree as a build user with umask 002 leaves it: group-writable throughout.
mkdir -p "$t/whiteouts/etc" "$t/root/app/dist" "$t/root/app/.hidden" "$t/root/home/agent/.config" "$t/root/etc/mise"
touch "$t/whiteouts/etc/.wh.motd" "$t/root/app/dist/server.js" "$t/root/home/agent/.config/x" "$t/root/etc/mise/config.toml" "$t/root/etc/hosts"
(cd "$t" && XDG_CACHE_HOME="$t/cache" "$pack" "$t/base" "$t/root" "$t/out" check:latest --layout --mode=go-w --root-layer="$t/whiteouts" \
  --own=65532:0=home/agent --own=65532:0=etc/mise --own=65532:0=absent --own-dir=65532:0=app >/dev/null)

m="$(jq -r '.manifests[0].digest | sub(":"; "/")' "$t/out/index.json")"
layer="$(jq -r '.layers[-1].digest | sub(":"; "/")' "$t/out/blobs/$m")"
bsdtar -tvf "$t/out/blobs/$layer" | awk '{sub(/\/$/, "", $9); print $9, $3 "/" $4, $1}' > "$t/entries"
fail=0
dups="$(awk '{print $1}' "$t/entries" | sort | uniq -d)"
[ -z "$dups" ] || { echo "FAIL: CRI-O refuses a layer that repeats a path: $dups" >&2; fail=1; }
want() {
  local got; got="$(awk -v p="$1" '$1 == p {$1 = ""; print substr($0, 2)}' "$t/entries")"
  [ "$got" = "$2" ] || { echo "FAIL: $1 is [$got], want [$2]" >&2; fail=1; }
}
want app "65532/0 drwxr-xr-x"
want app/dist "0/0 drwxr-xr-x"
want app/dist/server.js "0/0 -rw-r--r--"
want app/.hidden "0/0 drwxr-xr-x"
want home/agent "65532/0 drwxr-xr-x"
want home/agent/.config/x "65532/0 -rw-r--r--"
want etc/mise/config.toml "65532/0 -rw-r--r--"
want etc "0/0 drwxr-xr-x"
want etc/hosts "0/0 -rw-r--r--"
[ "$fail" = 0 ] && echo "pack-image check OK" || exit 1
