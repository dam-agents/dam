#!/usr/bin/env bash
#MISE description="A failed e2e provision writes its status, and the wait reports it"
# Both halves are a workflow's shell, which nothing else runs, so this runs the
# deployed scripts against a stubbed provision: one that fails, one that hangs,
# one that fails late, one that succeeds. No cluster, no Lima.
set -euo pipefail
step() { yq -r ".jobs.e2e.steps[] | select(.name == \"$1\") | .run" .github/workflows/e2e.yml; }
launch_raw="$(step 'Provision k3s in the background')"
wait_raw="$(step 'Wait for the background k3s provision')"
[ -n "$launch_raw" ] && [ -n "$wait_raw" ] ||
  { echo "e2e.yml no longer holds both the provision launch and its wait" >&2; exit 1; }
grep -q 'timeout 180' <<< "$wait_raw" ||
  { echo "the wait's budget no longer reads 'timeout 180'; teach this check the new one" >&2; exit 1; }

tmp="$(mktemp -d)"
cleanup() {
  while read -r pid; do kill "$pid" 2>/dev/null || true; done < <(cat "$tmp/stub.pids" 2>/dev/null)
  rm -rf "$tmp" || true
}
trap cleanup EXIT

# The provision the launch starts: an executable task under a stub repo root,
# exactly as the workflow calls it.
mkdir -p "$tmp/repo/.mise/tasks/cluster" "$tmp/repo/etc/lima"
: > "$tmp/repo/etc/lima/k3s-test.yaml"
stub() { printf '#!/usr/bin/env bash\n%s\n' "$1" > "$tmp/repo/.mise/tasks/cluster/provision-host"; chmod +x "$tmp/repo/.mise/tasks/cluster/provision-host"; }
# Two seconds instead of three minutes, no root, and a status, log and env of
# this scenario's own (RUNNER_TEMP is the scenario's directory) rather than
# the runner's temp directory and this checkout: a wrapper still alive
# from another scenario then writes into its own tree, never into this one.
scenario() {
  dir="$tmp/$1"
  mkdir -p "$dir"
  : > "$dir/env"
  launch="$(sed -e '/^sudo sysctl/d' <<< "$launch_raw")"
  wait="$(sed -e 's|timeout 180|timeout 2|' <<< "$wait_raw")"
  export GITHUB_ENV="$dir/env" RUNNER_TEMP="$dir"
}
provision() { ( cd "$tmp/repo" && bash -e -c "$launch" ); }
settle() { for _ in $(seq 100); do [ -s "$dir/k3s-provision.status" ] && return 0; sleep 0.1; done; return 1; }

# A failed provision: its own status reaches the file the wait reads, and the
# wait leaves the re-provisioning to the suite instead of failing the job.
stub 'echo "error: k3s install failed after 4 attempts" >&2; exit 3'
scenario failed
provision
settle || { echo "a provision that failed wrote no status file" >&2; exit 1; }
[ "$(cat "$dir/k3s-provision.status")" = 3 ] || { echo "the status file must carry the provision's exit code" >&2; exit 1; }
out="$(bash -e -c "$wait" 2>&1)" || { echo "a failed provision is not the wait's failure" >&2; exit 1; }
grep -q '::warning::.*exited 3' <<< "$out" ||
  { echo "the wait must warn which status it read" >&2; printf '%s\n' "$out" >&2; exit 1; }
[ ! -s "$GITHUB_ENV" ] ||
  { echo "a failed provision must leave E2E_HOST_PROVISIONED unset" >&2; exit 1; }

# A hung provision: no status file, so the wait is what fails, and the
# provision's own log is what says why. It exits only once the next scenario
# has started, so its status lands after that one's provision began.
stub 'echo $$ >> "'"$tmp"'/stub.pids"; echo "fetching the k3s release tarball"; until [ -e "'"$tmp"'/release" ]; do sleep 0.1; done'
scenario hung
provision
[ ! -s "$dir/k3s-provision.status" ] || { echo "a hung provision wrote a status file" >&2; exit 1; }
rc=0 out="$(bash -e -c "$wait" 2>&1)" || rc=$?
[ "$rc" != 0 ] || { echo "a provision that writes no status must fail the wait" >&2; exit 1; }
grep -qF 'fetching the k3s release tarball' <<< "$out" ||
  { echo "the wait must print the provision's log when it gives up" >&2; printf '%s\n' "$out" >&2; exit 1; }
grep -q '::error::' <<< "$out" ||
  { echo "the wait must fail with an annotation" >&2; exit 1; }

# A provision that fails late: the hung one above reports a 0 of its own a
# moment after this provision starts, and that stale 0 must not settle it.
stub 'sleep 2; exit 7'
scenario late
provision
: > "$tmp/release"
settle || { echo "a provision that failed late wrote no status file" >&2; exit 1; }
[ "$(cat "$dir/k3s-provision.status")" = 7 ] ||
  { echo "a failing provision took the status of a provision that outlived its own scenario" >&2; exit 1; }

# A provision that worked: the suite keeps the cluster this run made.
stub 'exit 0'
scenario ok
provision
settle || { echo "a provision that succeeded wrote no status file" >&2; exit 1; }
bash -e -c "$wait" > /dev/null || { echo "a successful provision must pass the wait" >&2; exit 1; }
grep -qx 'E2E_HOST_PROVISIONED=1' "$GITHUB_ENV" ||
  { echo "a successful provision must set E2E_HOST_PROVISIONED" >&2; exit 1; }
