#!/usr/bin/env bash
#MISE description="Copy the third-party images the chart pins onto the quay.io/dam-agents mirror; skips what is already there"
# Copy the third-party runtime images we serve from our own registry onto the
# mirror. Single source of truth for that set, shared by the CI job and anyone
# running it by hand.
#
# The mirror keeps the upstream tag verbatim and the destination repository is
# always the upstream repository's last path segment, so one upstream ref per
# line is the whole registration. Adding a mirrored image, or bumping one, is a
# one-line edit here plus the matching pin in helm/values.yaml or
# .mise/tasks/cluster/install.
#
# A tag already on the mirror is never overwritten — existence is the whole
# test, digests are deliberately not compared. Upstream rebuilds moving tags
# (`busybox:1.37.0` has already moved under us), and re-copying on every main
# push would swap a reviewed, pinned image for an unreviewed one without any
# commit saying so. A new upstream build gets a new tag, or a deliberate
# `crane copy` by hand.
#
# Usage: mise run image:mirror
# Env: IMAGE_PREFIX (default quay.io/dam-agents). Writing needs a registry
# login (`crane auth login quay.io -u … -p …`); reading the upstreams does not.
set -euo pipefail

IMAGE_PREFIX="${IMAGE_PREFIX:-quay.io/dam-agents}"

# Keep in step with helm/values.yaml (clickstack.collector.image, the clickstack
# subchart image pins) and .mise/tasks/cluster/install (the operator images).
MIRRORS="
otel/opentelemetry-collector-contrib:0.161.0
docker.hyperdx.io/hyperdx/hyperdx:2.35.0
clickhouse/clickhouse-server:25.7-alpine
clickhouse/clickhouse-keeper:25.7-alpine
busybox:1.38.0
ghcr.io/clickhouse/clickhouse-operator:v0.0.7
quay.io/mongodb/mongodb-kubernetes:1.7.0
"

copied=0
for src in $MIRRORS; do
  dst="$IMAGE_PREFIX/${src##*/}"
  if crane digest "$dst" >/dev/null 2>&1; then
    echo "present  $dst"
    continue
  fi
  echo "copying  $src -> $dst"
  crane copy "$src" "$dst"
  copied=$((copied + 1))
done
echo "mirror: $copied copied"
