#!/usr/bin/env -S usage bash
#MISE description="CI only: build several component images for one arch in one job"
#MISE hide=true
#USAGE flag "--serial" help="Build one at a time, for images too large to build side by side on one runner's disk; the builder is pruned between builds when less than CI_BUILD_MIN_FREE_GB (default 20) is free"
#USAGE flag "--base-image <ref>" help="BASE_IMAGE for the components built on a base (k-search)"
#USAGE arg "<arch>"
#USAGE arg "<component>..." var=#true help="<component>[:<output>]; output is digest (default: push by digest and write /tmp/digests/<component>/<hex>), cacheonly (build without exporting, to prove it builds), sha (push <component>:$GITHUB_SHA) or load (write the component's dist/oci tar, named platform-<component>:latest)"
# cd.yml builds all of one arch's images, agents or workloads in one job
# instead of one job per image. Each job costs a runner slot and a turn in the
# shared queue, which is what a run waited on, not the builds.
#
# Env: IMAGE_PREFIX, GITHUB_SHA; CACHE_TO=1 also writes each component's
# registry buildcache (main, tags, schedule); KEYCLOAK_THEME_BUILT=1 when the
# caller already built the theme JAR the keycloak image bakes in. Every build runs even after one
# fails; the exit status names the failures.
#
# By path, like image:resolve, with usage installed. image.toml agents build
# with //packages/agents:oci and need mise, node, pnpm and crane.
set -uo pipefail

serial="${usage_serial:-false}" base="${usage_base_image:-}" arch="$usage_arch"
eval "set -- $usage_component"
: "${IMAGE_PREFIX:?}" "${GITHUB_SHA:?}"

mkdir -p /tmp/ci-build/meta /tmp/ci-build/logs /tmp/digests
export AGENT_OCI_OUT=/tmp/ci-build/oci

# spec <component> -> "<dockerfile> <context> <takes-base> [<name>=<extra context>]"
spec() {
  if [ -f "packages/agents/$1/image.toml" ] || [ -f "packages/e2e/agents/$1/image.toml" ]; then echo mise; return; fi
  case "$1" in
    controller | ui) echo crane ;;
    # The runner image is built from its crate alone, platform-init included.
    vm-runner) echo "packages/vm-runner/Dockerfile packages/vm-runner no" ;;
    api-server) echo "packages/api-server/Dockerfile . no" ;;
    keycloak) echo "packages/keycloak-theme/Dockerfile . no" ;;
    *) [ -f "packages/agents/$1/Dockerfile" ] || { echo "ci-build: unknown component $1" >&2; return 1; }
       echo "packages/agents/$1/Dockerfile packages/agents/$1 yes" ;;
  esac
}

tar_of() { .mise/tasks/image/resolve tar-path "$1"; }

output_for() {
  case "$2" in
    digest) echo "type=image,name=$IMAGE_PREFIX/$1,push-by-digest=true,name-canonical=true,push=true,rewrite-timestamp=true" ;;
    cacheonly) echo "type=cacheonly" ;;
    sha) echo "type=image,name=$IMAGE_PREFIX/$1:$GITHUB_SHA,push=true" ;;
    load) echo "type=docker,name=platform-$1:latest,dest=$(tar_of "$1")" ;;
    *) echo "ci-build: unknown output $2" >&2; return 1 ;;
  esac
}

# The digest lands where buildx's metadata would.
build_mise() {
  local c=$1 kind=$2 layout="$AGENT_OCI_OUT/$1" ref
  packages/agents/.mise/tasks/oci --build $([ "$kind" = load ] || echo --no-tar) "$c" || return 1
  case "$kind" in
    cacheonly | load) ;;
    sha) crane push "$layout" "$IMAGE_PREFIX/$c:$GITHUB_SHA" || return 1 ;;
    # By digest: an untagged crane reference means :latest.
    digest)
      ref="$(jq -r '.manifests[0].digest' "$layout/index.json")" || return 1
      crane push "$layout" "$IMAGE_PREFIX/$c@$ref" || return 1
      jq -n --arg d "$ref" '{"containerimage.digest": $d}' > "/tmp/ci-build/meta/$c.json"
      ;;
    *) echo "ci-build: unknown output $kind" >&2; return 1 ;;
  esac
  rm -rf "$layout"
}

build_crane() {
  local c=$1 kind=$2 tar ref
  tar="$(tar_of "$c")"
  mise run "//packages/$c:oci" || return 1
  case "$kind" in
    cacheonly | load) ;;
    sha) crane push "$tar" "$IMAGE_PREFIX/$c:$GITHUB_SHA" || return 1 ;;
    digest)
      ref="$(crane digest --tarball "$tar")" || return 1
      crane push "$tar" "$IMAGE_PREFIX/$c@$ref" || return 1
      jq -n --arg d "$ref" '{"containerimage.digest": $d}' > "/tmp/ci-build/meta/$c.json"
      ;;
    *) echo "ci-build: unknown output $kind" >&2; return 1 ;;
  esac
}

build_one() {
  local c=$1 kind=$2 s file ctx takes extra out args=()
  s="$(spec "$c")" || return 1
  if [ "$s" = mise ]; then build_mise "$c" "$kind"; return; fi
  if [ "$s" = crane ]; then build_crane "$c" "$kind"; return; fi
  read -r file ctx takes extra <<< "$s"
  [ -z "$extra" ] || args+=(--build-context "$extra")
  out="$(output_for "$c" "$kind")" || return 1
  if [ "$takes" = yes ]; then
    [ -n "$base" ] || { echo "ci-build: $c needs --base-image" >&2; return 1; }
    args+=(--build-arg "BASE_IMAGE=$base")
  fi
  if [ "${CACHE_TO:-}" = 1 ]; then
    args+=(--cache-to "type=registry,ref=$IMAGE_PREFIX/$c:buildcache-$arch,mode=max,image-manifest=true")
  fi
  if [ "$c" = keycloak ] && [ -z "${KEYCLOAK_THEME_BUILT:-}" ]; then
    # The image bakes in the theme JAR.
    mise run //packages/keycloak-theme:build || return 1
  fi
  docker buildx build --platform "linux/$arch" -f "$file" \
    --cache-from "type=registry,ref=$IMAGE_PREFIX/$c:buildcache-$arch" \
    --output "$out" --metadata-file "/tmp/ci-build/meta/$c.json" "${args[@]}" "$ctx"
}

names=() kinds=()
for arg in "$@"; do
  names+=("${arg%%:*}")
  case "$arg" in *:*) kinds+=("${arg#*:}") ;; *) kinds+=(digest) ;; esac
done

failed=()
if [ "$serial" = true ]; then
  for i in "${!names[@]}"; do
    echo "::group::${names[$i]}"
    SECONDS=0
    build_one "${names[$i]}" "${kinds[$i]}" 2>&1 || failed+=("${names[$i]}")
    echo "${names[$i]}: ${SECONDS}s"
    echo "::endgroup::"
    free_gb=$(( $(df --output=avail -k / | tail -1) / 1048576 ))
    if [ "$free_gb" -lt "${CI_BUILD_MIN_FREE_GB:-20}" ]; then
      echo "${free_gb} GB free: pruning the builder"
      docker buildx prune --all --force >/dev/null 2>&1 || true
    fi
  done
else
  pids=()
  for i in "${!names[@]}"; do
    build_one "${names[$i]}" "${kinds[$i]}" > "/tmp/ci-build/logs/${names[$i]}.log" 2>&1 &
    pids+=($!)
  done
  for i in "${!pids[@]}"; do wait "${pids[$i]}" || failed+=("${names[$i]}"); done
  for n in "${names[@]}"; do
    echo "::group::$n"; cat "/tmp/ci-build/logs/$n.log"; echo "::endgroup::"
  done
fi

if [ "${#failed[@]}" -gt 0 ]; then echo "::error::failed to build: ${failed[*]}"; exit 1; fi

for i in "${!names[@]}"; do
  [ "${kinds[$i]}" = digest ] || continue
  d="$(jq -r '."containerimage.digest"' "/tmp/ci-build/meta/${names[$i]}.json")"
  case "$d" in sha256:*) ;; *) echo "::error::no digest for ${names[$i]}"; exit 1 ;; esac
  mkdir -p "/tmp/digests/${names[$i]}" && touch "/tmp/digests/${names[$i]}/${d#sha256:}"
done
