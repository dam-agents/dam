#!/usr/bin/env -S usage bash
#MISE description="CI only: build several component images for one arch in one job"
#MISE hide=true
#USAGE flag "--serial" help="Build one at a time, for images too large to build side by side on one runner's disk"
#USAGE arg "<arch>"
#USAGE arg "<component>..." var=#true help="<component>[:<output>]; output is digest (default: push by digest and write /tmp/digests/<component>/<hex>), cacheonly (build without pushing, to prove it builds), source (push <component>:<source sha>, the tag image:resolve reuses), mq (push <component>:mq-<content hash>, the cache tag only a merge group reuses) or load (keep the component's image where the e2e cluster imports it: an agent's OCI layout, every other component's dist/oci tar, named platform-<component>:latest)"
# build.yml builds all of one arch's images, agents or workloads in one job
# instead of one job per image. Each job costs a runner slot and a turn in the
# shared queue, which is what a run waited on, not the builds.
#
# Env: IMAGE_PREFIX. Every build runs even after one fails; the
# exit status names the failures.
#
# Two of these can run side by side on one runner, as e2e:ci-images runs one
# per image family, and they share /tmp/ci-build and /tmp/digests. Ceiling:
# the log dump at the end prints every log file in that directory, so each run
# also prints the other's; a state directory per run is the upgrade path.
# Only the agent family appends to the load list under /tmp/ci-build/oci.
#
# By path, like image:resolve, with usage and pigz installed. image.toml
# agents build with //packages/agents:oci and need mise, node, pnpm and crane;
# every other component with its package's :oci task, which writes its image
# tar. A pushed image's plain-tar layers are gzipped first; see
# image:gzip-layout.
set -uo pipefail

serial="${usage_serial:-false}" arch="$usage_arch"
eval "set -- $usage_component"
: "${IMAGE_PREFIX:?}"
# Every build is for the host's arch: CI runs each on a runner of that arch.
host_arch="$(uname -m | sed 's/aarch64/arm64/;s/x86_64/amd64/')"
[ "$arch" = "$host_arch" ] || { echo "ci-build: $arch images build on an $arch runner, not $host_arch" >&2; exit 2; }

mkdir -p /tmp/ci-build/meta /tmp/ci-build/logs /tmp/digests
export AGENT_OCI_OUT="$(.mise/tasks/image/resolve oci-out)"

# The package whose :oci task builds a component, or `mise` for an agent.
package_of() {
  if [ -f "packages/agents/$1/image.toml" ] || [ -f "packages/e2e/agents/$1/image.toml" ]; then echo mise; return; fi
  case "$1" in
    controller | ui | api-server | vm-runner) echo "$1" ;;
    keycloak) echo keycloak-theme ;;
    *) echo "ci-build: unknown component $1" >&2; return 1 ;;
  esac
}

tar_of() { .mise/tasks/image/resolve tar-path "$1"; }
source_ref() {
  local s; s="$(.mise/tasks/image/resolve source-sha "$1")"
  [ -n "$s" ] || { echo "ci-build: no source sha for $1" >&2; return 1; }
  echo "$IMAGE_PREFIX/$1:$s"
}

# Each pushed digest lands in /tmp/ci-build/meta, which the end of this
# script turns into /tmp/digests.
push_layout() {
  local c=$1 kind=$2 layout=$3 ref
  case "$kind" in cacheonly | load) return ;; esac
  .mise/tasks/image/gzip-layout "$layout" || return 1
  case "$kind" in
    source) crane push "$layout" "$(source_ref "$c")" || return 1 ;;
    # By digest: an untagged crane reference means :latest.
    digest)
      ref="$(jq -r '.manifests[0].digest' "$layout/index.json")" || return 1
      crane push "$layout" "$IMAGE_PREFIX/$c@$ref" || return 1
      jq -n --arg d "$ref" '{"containerimage.digest": $d}' > "/tmp/ci-build/meta/$c.json"
      ;;
    # Quay deletes the tag after two days, by its label: see image:resolve's mq_tag.
    mq)
      ref="$IMAGE_PREFIX/$c@$(jq -r '.manifests[0].digest' "$layout/index.json")" || return 1
      crane push "$layout" "$ref" || return 1
      crane mutate "$ref" --label quay.expires-after=2d -t "$IMAGE_PREFIX/$c:$(.mise/tasks/image/resolve mq-tag "$c")" || return 1
      ;;
    *) echo "ci-build: unknown output $kind" >&2; return 1 ;;
  esac
}

# One oci run for every agent named: each run builds the default image, which
# every other is packed onto, so one run per image built it again for each.
build_mise() {
  local kind=$1 c layout; shift
  # No tar: a push reads the layout, and the e2e lane imports the layout itself.
  packages/agents/.mise/tasks/oci --build --no-tar "$@" || return 1
  for c in "$@"; do
    layout="$AGENT_OCI_OUT/$c"
    # Each plain layer's digest, so two runs' logs show which layers a change
    # rewrote and which a rebuild kept.
    jq -r '.manifests[0].digest | sub(":"; "/")' "$layout/index.json" |
      xargs -I{} jq -r '.layers[] | "\(.digest) \(.size)"' "$layout/blobs/{}" | sed "s|^|$c layer: |"
    push_layout "$c" "$kind" "$layout" || return 1
    # A load keeps the layout for cluster:import to tar into the import, and names
    # it where image:resolve looks; another image's build leaves a base layout
    # there too, which no load names.
    if [ "$kind" = load ]; then echo "$c" >> "$AGENT_OCI_OUT/load"; else rm -rf "$layout"; fi
  done
}

# Every :oci tar holds an OCI layout, which is pushed as that layout: pushed
# as a tarball, crane rewrites its OCI manifest as a Docker one around the OCI
# config and layers, which quay.io refuses as invalid.
build_tar() {
  local c=$1 pkg=$2 kind=$3 layout="$AGENT_OCI_OUT/$1"
  mise run "//packages/$pkg:oci" || return 1
  case "$kind" in cacheonly | load) return ;; esac
  rm -rf "$layout" && mkdir -p "$layout" && tar -C "$layout" -xf "$(tar_of "$c")" || return 1
  push_layout "$c" "$kind" "$layout" || return 1
  rm -rf "$layout"
}

names=() kinds=()
for arg in "$@"; do
  names+=("${arg%%:*}")
  case "$arg" in *:*) kinds+=("${arg#*:}") ;; *) kinds+=(digest) ;; esac
done

# Each :oci task is a `mise run`, which first runs the root's pnpm install:
# once here, so builds side by side do not race it.
for n in "${names[@]}"; do
  [ "$(package_of "$n" 2>/dev/null)" = mise ] && continue
  mise deps install --only pnpm || exit 1
  break
done

# One build, of one component or of agents with one output, its wall time
# last in its output. Given CI_BUILD_READY_DIR, a file named after each
# component lands there once it is built: e2e:ci-images sets it, and
# cluster:install imports each image as it lands.
timed_build() {
  local kind=$1 start=$SECONDS code=0 pkg n; shift
  pkg="$(package_of "$1")" || return 1
  if [ "$pkg" = mise ]; then build_mise "$kind" "$@" || code=$?; else build_tar "$1" "$pkg" "$kind" || code=$?; fi
  echo "$*: $((SECONDS - start))s"
  [ "$code" -eq 0 ] || return "$code"
  [ -z "${CI_BUILD_READY_DIR:-}" ] || for n in "$@"; do touch "$CI_BUILD_READY_DIR/$n"; done
}

failed=()
if [ "$serial" = true ]; then
  for i in "${!names[@]}"; do
    echo "::group::${names[$i]}"
    timed_build "${kinds[$i]}" "${names[$i]}" 2>&1 || failed+=("${names[$i]}")
    echo "::endgroup::"
  done
else
  # The mise images share the oci task's stage and apt-base layout, one build
  # per host at a time, so they take one lane beside the rest: one build for
  # each output, one after another. A failure is named in a file, since the
  # lane is one process.
  pids=() lane=()
  : > /tmp/ci-build/mise-failed
  for i in "${!names[@]}"; do
    if [ "$(package_of "${names[$i]}" 2>/dev/null)" = mise ]; then
      lane+=("$i")
      continue
    fi
    timed_build "${kinds[$i]}" "${names[$i]}" > "/tmp/ci-build/logs/${names[$i]}.log" 2>&1 &
    pids+=("$!:${names[$i]}")
  done
  if [ ${#lane[@]} -gt 0 ]; then
    (for kind in $(for i in "${lane[@]}"; do echo "${kinds[$i]}"; done | sort -u); do
      group=()
      for i in "${lane[@]}"; do [ "${kinds[$i]}" != "$kind" ] || group+=("${names[$i]}"); done
      timed_build "$kind" "${group[@]}" > "/tmp/ci-build/logs/$(IFS=-; echo "${group[*]}").log" 2>&1 ||
        printf '%s\n' "${group[@]}" >> /tmp/ci-build/mise-failed
    done) &
    pids+=("$!:")
  fi
  for p in ${pids[@]+"${pids[@]}"}; do wait "${p%%:*}" || { [ -z "${p#*:}" ] || failed+=("${p#*:}"); }; done
  while read -r n; do failed+=("$n"); done < /tmp/ci-build/mise-failed
  for f in /tmp/ci-build/logs/*.log; do
    n="${f##*/}"; echo "::group::${n%.log}"; cat "$f"; echo "::endgroup::"
  done
fi

if [ "${#failed[@]}" -gt 0 ]; then echo "::error::failed to build: ${failed[*]}"; exit 1; fi

for i in "${!names[@]}"; do
  [ "${kinds[$i]}" = digest ] || continue
  d="$(jq -r '."containerimage.digest"' "/tmp/ci-build/meta/${names[$i]}.json")"
  case "$d" in sha256:*) ;; *) echo "::error::no digest for ${names[$i]}"; exit 1 ;; esac
  mkdir -p "/tmp/digests/${names[$i]}" && touch "/tmp/digests/${names[$i]}/${d#sha256:}"
done
