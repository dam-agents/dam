#!/usr/bin/env -S usage bash
#MISE description="Write an image tar for the host's arch: a directory's tree as one layer on a base image"
#MISE hide=true
#MISE dir="{{cwd}}"
#USAGE arg "<base>" help="Base image reference, pinned by digest, or a local OCI layout directory"
#USAGE arg "<root>" help="Directory whose tree becomes the layer, at / or --at"
#USAGE arg "<tar>" help="Image tar to write, or with --layout the OCI layout directory"
#USAGE arg "<tag>" help="Tag the tar carries"
#USAGE flag "--entrypoint <entrypoint>" help="The image's ENTRYPOINT, its words separated by commas; it clears the base's CMD"
#USAGE flag "--cmd <cmd>" help="The image's CMD, its words separated by commas"
#USAGE flag "--workdir <workdir>"
#USAGE flag "--user <user>"
#USAGE flag "--env <env>" var=#true help="KEY=VALUE in the image's env, replacing the base's KEY; a later one replaces an earlier"
#USAGE flag "--owner <uid:gid>" default="0:0" help="Owner of every entry in the layer"
#USAGE flag "--own <spec>" var=#true help="<uid:gid>=<path>: the owner of <root>'s <path> and everything under it, in place of --owner; a <path> <root> lacks is skipped"
#USAGE flag "--own-dir <spec>" var=#true help="<uid:gid>=<path>: the owner of <root>'s directory <path> itself, its entries keeping --owner"
#USAGE flag "--mode <mode>" help="A chmod mode every entry of every layer this adds gets, e.g. go-w so the build host's umask never makes a root path writable to group 0"
#USAGE flag "--layout" help="Write the image as an OCI layout directory at <tar>, not a tar of one"
#USAGE flag "--at <dir>" help="The image directory <root>'s tree lands in. The layer has no entries for it or its parents, so the base's keep their owner and mode"
#USAGE flag "--root-layer <dir>" var=#true help="A directory whose tree becomes a root-owned layer under <root>'s, e.g. whiteouts of the base's files"
#USAGE flag "--layer <spec>" var=#true help="A further layer over <root>'s, as <uid:gid>=<image dir>=<dir>: <dir>'s tree at <image dir>, every entry owned by <uid:gid>, with no entries for <image dir> or its parents"
# The tar holds an OCI layout, like every other image tar: the base's layers as
# the registry serves them, then the new layers as plain tars, which a local
# cluster imports as they are and image:ci-build gzips as it publishes them. The base is kept as a layout per reference and arch,
# so a rebuild downloads nothing; the reference carries its digest, so an entry
# never goes stale.
set -euo pipefail
arch="$(uname -m | sed 's/aarch64/arm64/;s/x86_64/amd64/')"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/platform-image-pack"
mkdir -p "$cache"
base="$cache/$(printf '%s %s' "$usage_base" "$arch" | sha256sum | cut -c1-32)"
if [ -f "$usage_base/index.json" ]; then
  base="$usage_base"
elif [ ! -f "$base/index.json" ]; then
  rm -rf "$base.$$"
  crane pull --format=oci --platform "linux/$arch" "$usage_base" "$base.$$"
  mv -T "$base.$$" "$base" 2>/dev/null || rm -rf "$base.$$"
fi
# In the cache, so the base's blobs are hard links rather than copies.
work="$(mktemp -d "$cache/work.XXXXXX")"
trap 'rm -rf "$work"' EXIT
out="$work/oci"
mkdir -p "$out/blobs/sha256"
cp -l "$base"/blobs/sha256/* "$out/blobs/sha256/" 2>/dev/null || cp "$base"/blobs/sha256/* "$out/blobs/sha256/"

blob() { echo "$out/blobs/${1/://}"; }
# One owner, mtime 0, sorted: the layer's digest follows its content alone.
# Its top-level entries, not ".", so the layer never resets / itself. A path
# <root> gives another owner (--own, --own-dir) is appended after the rest
# under that owner; a directory alone is appended again, which a later entry's
# metadata wins.
layers='[]'
eval "owns=(${usage_own:-})" "own_dirs=(${usage_own_dir:-})"
mode=(${usage_mode:+--mode="$usage_mode"})
layer() {
  local t="$work/layer.tar" h spec excl=()
  [ "${4:-}" != own ] || for spec in ${owns[@]+"${owns[@]}"}; do excl+=("--exclude=${spec#*=}"); done
  tar --sort=name --owner="${2%:*}" --group="${2#*:}" --numeric-owner --mtime=@0 --format=gnu ${mode[@]+"${mode[@]}"} \
    --anchored ${excl[@]+"${excl[@]}"} ${3:+--transform "s|^|$3/|S"} -C "$1" -cf "$t" $(ls -A "$1")
  if [ "${4:-}" = own ]; then
    for spec in ${owns[@]+"${owns[@]}"} ${own_dirs[@]+"${own_dirs[@]}"}; do
      [ -e "$1/${spec#*=}" ] || continue
      local recurse=(); case " ${own_dirs[*]:-} " in *" $spec "*) recurse=(--no-recursion) ;; esac
      tar --sort=name --owner="${spec%%:*}" --group="$(spec="${spec#*:}"; echo "${spec%%=*}")" --numeric-owner \
        --mtime=@0 --format=gnu ${mode[@]+"${mode[@]}"} ${recurse[@]+"${recurse[@]}"} ${3:+--transform "s|^|$3/|S"} -C "$1" -rf "$t" "${spec#*=}"
    done
  fi
  h="$(sha256sum "$t" | cut -c1-64)"
  mv "$t" "$out/blobs/sha256/$h"
  layers="$(jq -c --arg d "sha256:$h" --argjson s "$(wc -c < "$out/blobs/sha256/$h")" \
    '. + [{mediaType: "application/vnd.oci.image.layer.v1.tar", digest: $d, size: $s}]' <<< "$layers")"
}
eval "root_layers=(${usage_root_layer:-})"
for d in ${root_layers[@]+"${root_layers[@]}"}; do layer "$d" 0:0; done
at="${usage_at:-}"; at="${at#/}"; at="${at%/}"
layer "$usage_root" "$usage_owner" "$at" own
eval "extra_layers=(${usage_layer:-})"
for spec in ${extra_layers[@]+"${extra_layers[@]}"}; do
  owner="${spec%%=*}" rest="${spec#*=}"
  dir="${rest#*=}" at="${rest%%=*}"; at="${at#/}"; at="${at%/}"
  layer "$dir" "$owner" "$at"
done

put() {
  local h
  h="$(printf '%s' "$1" | sha256sum | cut -c1-64)"
  printf '%s' "$1" > "$out/blobs/sha256/$h"
  jq -cn --arg d "sha256:$h" --argjson s "${#1}" '{digest: $d, size: $s}'
}
manifest="$(cat "$(blob "$(jq -r '.manifests[0].digest' "$base/index.json")")")"
# OCI layers under a Docker manifest are what quay refuses.
[ "$(jq -r .mediaType <<< "$manifest")" = application/vnd.oci.image.manifest.v1+json ] ||
  { echo "image:pack: $usage_base is not an OCI image manifest" >&2; exit 1; }
eval "envs=(${usage_env:-})"
env_json="$(printf '%s\n' ${envs[@]+"${envs[@]}"} | jq -R 'select(. != "")' | jq -cs .)"
config="$(jq -c --argjson l "$layers" --arg ep "${usage_entrypoint:-}" --arg cmd "${usage_cmd:-}" \
  --arg wd "${usage_workdir:-}" --arg user "${usage_user:-}" --argjson env "$env_json" '
  .rootfs.diff_ids += [$l[].digest]
  | .history = (.history // []) + [$l[] | {created_by: "image:pack"}]
  | if $ep != "" then .config.Entrypoint = ($ep | split(",")) | del(.config.Cmd) else . end
  | if $cmd != "" then .config.Cmd = ($cmd | split(",")) else . end
  | if $wd != "" then .config.WorkingDir = $wd else . end
  | if $user != "" then .config.User = $user else . end
  | reduce $env[] as $e (.; ($e | split("=")[0]) as $k
      | .config.Env = ((.config.Env // []) | map(select(split("=")[0] != $k))) + [$e])' \
  "$(blob "$(jq -r .config.digest <<< "$manifest")")")"
manifest="$(jq -c --argjson c "$(put "$config")" --argjson l "$layers" \
  '.config += $c | .layers += $l | del(.annotations)' <<< "$manifest")"
jq -n --argjson m "$(put "$manifest")" --arg a "$arch" \
  '{schemaVersion: 2, mediaType: "application/vnd.oci.image.index.v1+json",
    manifests: [$m + {mediaType: "application/vnd.oci.image.manifest.v1+json", platform: {architecture: $a, os: "linux"}}]}' \
  > "$out/index.json"
echo '{"imageLayoutVersion":"1.0.0"}' > "$out/oci-layout"
# Only the blobs the image names: a base layout may hold more.
jq -r '.config.digest, .layers[].digest' <<< "$manifest" | sed 's/^sha256://' | sort > "$work/keep"
jq -r '.manifests[0].digest' "$out/index.json" | sed 's/^sha256://' >> "$work/keep"
(cd "$out/blobs/sha256" && ls | sort | comm -23 - <(sort "$work/keep") | xargs -r rm -f)
"$(dirname "$0")/name-layout" "$out" "$usage_tag"
mkdir -p "$(dirname "$usage_tar")"
if [ "${usage_layout:-}" = true ]; then
  rm -rf "$usage_tar" && mv "$out" "$usage_tar"
else
  tar --sort=name --mtime=@0 -C "$out" -cf "$usage_tar" $(ls -A "$out")
fi
