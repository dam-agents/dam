#!/usr/bin/env bash
#MISE description="Write an image tar for the host's arch: a directory's tree as one layer on a base image"
#MISE hide=true
#MISE dir="{{cwd}}"
#USAGE arg "<base>" help="Base image reference"
#USAGE arg "<root>" help="Directory whose tree becomes the layer, at /"
#USAGE arg "<tar>" help="Image tar to write"
#USAGE arg "<tag>" help="Tag the tar carries"
#USAGE flag "--entrypoint <entrypoint>"
#USAGE flag "--workdir <workdir>"
#USAGE flag "--user <user>"
set -euo pipefail
layer="$(mktemp)"
trap 'rm -f "$layer"' EXIT
# Root-owned, mtime 0, sorted: the layer's digest follows its content alone,
# whichever tar the host has.
python3 - "$layer" "$usage_root" <<'EOF'
import os, sys, tarfile
def norm(t):
    t.uid = t.gid = t.mtime = 0
    t.uname = t.gname = "root"
    return t
with tarfile.open(sys.argv[1], "w") as tar:
    for d in sorted(os.listdir(sys.argv[2])):
        tar.add(os.path.join(sys.argv[2], d), d, filter=norm)
EOF
mkdir -p "$(dirname "$usage_tar")"
crane mutate "$usage_base" --append "$layer" -t "$usage_tag" -o "$usage_tar" \
  --platform "linux/$(uname -m | sed 's/aarch64/arm64/;s/x86_64/amd64/')" \
  ${usage_entrypoint:+--entrypoint "$usage_entrypoint"} ${usage_workdir:+--workdir "$usage_workdir"} ${usage_user:+--user "$usage_user"}
