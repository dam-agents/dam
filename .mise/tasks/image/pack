#!/usr/bin/env -S usage bash
#MISE description="Write an image tar for the host's arch: a directory's tree as one layer on a base image"
#MISE hide=true
#MISE dir="{{cwd}}"
#USAGE arg "<base>" help="Base image reference, pinned by digest, or a local OCI layout directory"
#USAGE arg "<root>" help="Directory whose tree becomes the layer, at / or --at"
#USAGE arg "<tar>" help="Image tar to write, or with --layout the OCI layout directory"
#USAGE arg "<tag>" help="Tag the tar carries"
#USAGE flag "--entrypoint <entrypoint>" help="The image's ENTRYPOINT, its words separated by commas; it clears the base's CMD"
#USAGE flag "--cmd <cmd>" help="The image's CMD, its words separated by commas"
#USAGE flag "--workdir <workdir>"
#USAGE flag "--user <user>"
#USAGE flag "--env <env>" var=#true help="KEY=VALUE in the image's env, replacing the base's KEY; a later one replaces an earlier"
#USAGE flag "--owner <uid:gid>" default="0:0" help="Owner of every entry in the layer"
#USAGE flag "--own <spec>" var=#true help="<uid:gid>=<path>: the owner of <root>'s <path> and everything under it, in place of --owner; a <path> <root> lacks is skipped"
#USAGE flag "--own-dir <spec>" var=#true help="<uid:gid>=<path>: the owner of <root>'s directory <path> itself, its entries keeping --owner"
#USAGE flag "--mode <mode>" help="A chmod mode every entry of every layer this adds gets, e.g. go-w so the build host's umask never makes a root path writable to group 0. It is applied to the trees themselves"
#USAGE flag "--layout" help="Write the image as an OCI layout directory at <tar>, not a tar of one"
#USAGE flag "--at <dir>" help="The image directory <root>'s tree lands in. The layer has no entries for it or its parents, so the base's keep their owner and mode"
#USAGE flag "--root-layer <dir>" var=#true help="A directory whose tree becomes a root-owned layer under <root>'s, e.g. whiteouts of the base's files"
#USAGE flag "--layer <spec>" var=#true help="A further layer over <root>'s, as <uid:gid>=<image dir>=<dir>: <dir>'s tree at <image dir>, every entry owned by <uid:gid>, with no entries for <image dir> or its parents"
# The tar holds an OCI layout, like every other image tar: the base's layers as
# the registry serves them, then the new layers as plain tars, which a local
# cluster imports as they are and image:ci-build gzips as it publishes them.
# The base is kept as a layout per reference and arch, so a rebuild downloads
# nothing; the reference carries its digest, so an entry never goes stale.
set -euo pipefail
arch="$(uname -m | sed 's/aarch64/arm64/;s/x86_64/amd64/')"
cache="${XDG_CACHE_HOME:-$HOME/.cache}/platform-image-pack"
mkdir -p "$cache"
base="$cache/$(printf '%s %s' "$usage_base" "$arch" | sha256sum | cut -c1-32)"
if [ -f "$usage_base/index.json" ]; then
  base="$usage_base"
elif [ ! -f "$base/index.json" ]; then
  rm -rf "$base.$$"
  regctl image copy --platform "linux/$arch" "$usage_base" "ocidir://$base.$$:base" >/dev/null
  mv -T "$base.$$" "$base" 2>/dev/null || rm -rf "$base.$$"
fi
# In the cache, so the base's blobs are hard links rather than copies.
work="$(mktemp -d "$cache/work.XXXXXX")"
trap 'rm -rf "$work"' EXIT
out="$work/oci"
mkdir -p "$out/blobs/sha256"
cp -l "$base"/blobs/sha256/* "$out/blobs/sha256/" 2>/dev/null || cp "$base"/blobs/sha256/* "$out/blobs/sha256/"
cp "$base/oci-layout" "$out/"
jq '{schemaVersion: 2, manifests: [.manifests[0]]}' "$base/index.json" > "$out/index.json"
from="$(jq -r '.manifests[0].digest' "$out/index.json")"

eval "owns=(${usage_own:-})" "own_dirs=(${usage_own_dir:-})"
# tree_tar <dir> <tar> <uid:gid> [<at>] [own]: <dir>'s tree, not <dir> itself,
# so a layer never resets / or <at>'s parents. Every path is owned by <uid:gid>
# or, with [own], by the --own or --own-dir path it is or is under, and goes in
# once, which CRI-O needs. bsdtar sets one owner a run, so each owner's paths
# are a run of their own, sorted, with mtime 0: the tar follows the tree's
# content alone. Read from disk, where bsdtar keeps hard links as links.
tree_tar() {
  local o
  (cd "$1" && find . -mindepth 1) | LC_ALL=C sort |
    awk -v owner="$3" -v owns="${5:+${owns[*]:-}}" -v dirs="${5:+${own_dirs[*]:-}}" '
      BEGIN { n = split(owns, o, " "); m = split(dirs, d, " ") }
      {
        p = substr($0, 3); own = owner
        for (i = 1; i <= n; i++) { q = substr(o[i], index(o[i], "=") + 1); if (p == q || index(p, q "/") == 1) own = substr(o[i], 1, index(o[i], "=") - 1) }
        for (i = 1; i <= m; i++) { q = substr(d[i], index(d[i], "=") + 1); if (p == q) own = substr(d[i], 1, index(d[i], "=") - 1) }
        print own "\t" $0
      }' > "$work/paths"
  rm -f "$2"
  for o in $(cut -f1 "$work/paths" | sort -u); do
    awk -F'\t' -v o="$o" '$1 == o { print $2 }' "$work/paths" |
      bsdtar "$([ -f "$2" ] && echo -r || echo -c)" -f "$2" -n -T - --format=gnutar --numeric-owner \
        --uid "${o%:*}" --gid "${o#*:}" --mtime @0 -s "|^\./|${4:+$4/}|S" -C "$1"
  done
  [ -f "$2" ] || bsdtar -cf "$2" --format=gnutar -T /dev/null
}

adds=() n=0
add_layer() {
  n=$((n + 1))
  [ -z "${usage_mode:-}" ] || chmod -R "$usage_mode" "$1"
  tree_tar "$1" "$work/layer$n.tar" "$2" "${@:3}"
  adds+=(--layer-add "tar=$work/layer$n.tar,mediaType=application/vnd.oci.image.layer.v1.tar")
}
eval "root_layers=(${usage_root_layer:-})"
for d in ${root_layers[@]+"${root_layers[@]}"}; do add_layer "$d" 0:0; done
at="${usage_at:-}"; at="${at#/}"; at="${at%/}"
add_layer "$usage_root" "$usage_owner" "$at" own
eval "extra_layers=(${usage_layer:-})"
for spec in ${extra_layers[@]+"${extra_layers[@]}"}; do
  owner="${spec%%=*}" rest="${spec#*=}"
  dir="${rest#*=}" at="${rest%%=*}"; at="${at#/}"; at="${at%/}"
  add_layer "$dir" "$owner" "$at"
done

words() { jq -cn --arg s "$1" '$s | split(",")'; }
mods=(--to-oci)
# The base's annotations (its revision, its created) describe the base.
for k in $(jq -r '.annotations // {} | keys[]' "$out/blobs/${from/://}"); do mods+=(--annotation "$k="); done
[ -z "${usage_entrypoint:-}" ] || mods+=(--config-entrypoint "$(words "$usage_entrypoint")" --config-cmd "")
[ -z "${usage_cmd:-}" ] || mods+=(--config-cmd "$(words "$usage_cmd")")
[ -z "${usage_workdir:-}" ] || mods+=(--workdir "$usage_workdir")
[ -z "${usage_user:-}" ] || mods+=(--user "$usage_user")
eval "envs=(${usage_env:-})"
for e in ${envs[@]+"${envs[@]}"}; do mods+=(--env "$e"); done
regctl image mod "ocidir://$out@$from" --create "ocidir://$out:latest" "${adds[@]}" "${mods[@]}" >/dev/null
# regctl stamps the history entries it adds with the time it ran; they take
# the base's own, so the image's digest follows its content alone. A second
# pass, as the first stamps them after applying its time options.
config="$(jq -r '.config.digest | sub(":"; "/")' "$out/blobs/${from/://}")"
created="$(jq -r '.created // "1970-01-01T00:00:00Z"' "$out/blobs/$config")"
regctl image mod "ocidir://$out:latest" --replace --config-time "set=$created,after=$created" >/dev/null
jq '.manifests |= map(select(.annotations["org.opencontainers.image.ref.name"] == "latest") | del(.annotations))' \
  "$out/index.json" > "$out/index.json.new"
mv "$out/index.json.new" "$out/index.json"
# Only the blobs the image names: a base layout may hold more.
manifest="$(cat "$out/blobs/$(jq -r '.manifests[0].digest | sub(":"; "/")' "$out/index.json")")"
{ jq -r '.config.digest, .layers[].digest' <<< "$manifest"; jq -r '.manifests[0].digest' "$out/index.json"; } |
  sed 's/^sha256://' | sort > "$work/keep"
(cd "$out/blobs/sha256" && ls | sort | comm -23 - "$work/keep" | xargs -r rm -f)
"$(dirname "$0")/name-layout" "$out" "$usage_tag"
mkdir -p "$(dirname "$usage_tar")"
if [ "${usage_layout:-}" = true ]; then
  rm -rf "$usage_tar" && mv "$out" "$usage_tar"
else
  tree_tar "$out" "$usage_tar" 0:0
fi
