#!/usr/bin/env -S usage bash
#MISE description="CI only: tag each component's per-arch digests as one multi-arch image"
#MISE hide=true
#USAGE arg "<digests-dir>" help="Holds <component>/ with one empty file per arch, named by the digest's hex, as image:ci-build writes them; a component without one is reused and only tagged"
#USAGE arg "<component>..." var=#true
# cd.yml merges every image of one kind in one job instead of one job per
# image; see image:ci-build.
#
# Env: IMAGE_PREFIX, GITHUB_SHA, GITHUB_REF, GITHUB_REF_NAME,
#   COMPOSITE (the app version), SOURCE_SHAS (image:resolve's JSON map) and
#   SOURCE_SHA_TAGGED (the components that also get their source-sha tag),
#   CONTENT_REUSED (the components a rebuild of unchanged content does not
#   replace).
#   CI_MERGE_DEBUG names components whose merge logs every registry request,
#   timestamped.
#
# A component this run did not build, because image:resolve found its source
# published, has no digests: its source-sha image gets this run's tags. That is
# one manifest write per tag, where a merge copies inside the registry.
#
# A CONTENT_REUSED component the chart pins by digest, so a new digest rolls
# its pods. A rebuild whose every arch's config equals that of the image it
# would replace, but for what it says about the build — the creation date
# each build takes from its own commit, the version of mise that built it — is
# that image: it gets this run's tags and keeps its digest. The image it would
# replace is this commit's own, on a rerun or a release, else the last one main
# published, which such a component is also tagged `main` for.
#
# The tags are what docker/metadata-action gave each image: the commit sha,
# the composite version, and on a v* tag its semver version, major.minor
# (not for a prerelease) and latest.
set -uo pipefail

dir="$usage_digests_dir"
eval "set -- $usage_component"
: "${IMAGE_PREFIX:?}" "${GITHUB_SHA:?}" "${GITHUB_REF:?}" "${COMPOSITE:?}"

release=()
case "$GITHUB_REF" in
  refs/tags/v*)
    v="${GITHUB_REF_NAME#v}"
    if [[ "$v" =~ ^([0-9]+)\.([0-9]+)\.[0-9]+(-[0-9A-Za-z.-]+)?$ ]]; then
      release+=("$v")
      [ -n "${BASH_REMATCH[3]}" ] || release+=("${BASH_REMATCH[1]}.${BASH_REMATCH[2]}")
    fi
    release+=(latest)
    ;;
esac

# <ref> <component> <per-arch digest>...: whether those builds are ref's.
same_content() {
  local ref=$1 c=$2 d cfg
  shift 2
  [ "$(crane manifest "$ref" | jq '.manifests | length')" = $# ] || return 1
  for d; do
    cfg="$(crane config "$IMAGE_PREFIX/$c@sha256:$d")" || return 1
    [ "$(undated <<< "$cfg")" = "$(crane config --platform "linux/$(jq -r .architecture <<< "$cfg")" "$ref" | undated)" ] || return 1
  done
}
undated() { jq -cS 'walk(if type == "object" then del(.created) else . end) | del(.config.Labels["org.opencontainers.image.created", "dev.mise.version"])'; }

# The images merge side by side, so the job takes as long as its slowest
# image (keycloak's copy inside the registry takes minutes) rather than the
# sum of them all.
merge_one() {
  local c=$1 s t r from="" seen=" " uniq=() args=() digests=() tags=("$GITHUB_SHA" "$COMPOSITE" "${release[@]}") reused=false
  [[ " ${CONTENT_REUSED:-} " == *" $c "* ]] && reused=true
  [ "$reused" = true ] && [ "$GITHUB_REF" = refs/heads/main ] && tags+=(main)
  if [[ " ${SOURCE_SHA_TAGGED:-} " == *" $c "* ]]; then
    s="$(jq -r --arg c "$c" '.[$c] // empty' <<< "${SOURCE_SHAS:?}")"
    [ -n "$s" ] && tags+=("$s")
  fi
  for t in "${tags[@]}"; do
    [[ "$seen" == *" $t "* ]] && continue
    seen+="$t " uniq+=("$t")
  done
  for d in "$dir/$c"/*; do [ -e "$d" ] && digests+=("$(basename "$d")"); done
  if [ "${#digests[@]}" -eq 0 ]; then
    s="$(jq -r --arg c "$c" '.[$c] // empty' <<< "${SOURCE_SHAS:?}")"
    if [ -z "$s" ] || ! crane digest "$IMAGE_PREFIX/$c:$s" >/dev/null 2>&1; then
      echo "::error::no digests for $c, and no image at its source sha"; return 1
    fi
    from="$IMAGE_PREFIX/$c:$s"
  elif [ "$reused" = true ]; then
    for t in "$GITHUB_SHA" main; do
      r="$(crane digest "$IMAGE_PREFIX/$c:$t" 2>/dev/null)" || continue
      same_content "$IMAGE_PREFIX/$c@$r" "$c" "${digests[@]}" && { from="$IMAGE_PREFIX/$c@$r"; break; }
    done
  fi
  if [ -n "$from" ]; then
    echo "$c: reused $from <-$seen"
    for t in "${uniq[@]}"; do
      [ "$from" = "$IMAGE_PREFIX/$c:$t" ] || crane tag "$from" "$t" || return 1
    done
    return 0
  fi
  for d in "${digests[@]}"; do args+=(-m "$IMAGE_PREFIX/$c@sha256:$d"); done
  echo "$c:$seen<- ${args[*]}"
  if [[ " ${CI_MERGE_DEBUG:-} " == *" $c "* ]]; then
    crane -v index append "${args[@]}" -t "$IMAGE_PREFIX/$c:${uniq[0]}" 2>&1 |
      while IFS= read -r line; do printf '%s %s\n' "$(date -u +%T.%3N)" "$line"; done
    [ "${PIPESTATUS[0]}" = 0 ] || return 1
  else
    crane index append "${args[@]}" -t "$IMAGE_PREFIX/$c:${uniq[0]}" || return 1
  fi
  for t in "${uniq[@]:1}"; do crane tag "$IMAGE_PREFIX/$c:${uniq[0]}" "$t" || return 1; done
}

mkdir -p /tmp/ci-merge
pids=() failed=()
for c in "$@"; do
  merge_one "$c" > "/tmp/ci-merge/$c.log" 2>&1 &
  pids+=($!)
done
names=("$@")
for i in "${!pids[@]}"; do wait "${pids[$i]}" || failed+=("${names[$i]}"); done
for c in "$@"; do
  echo "::group::$c"; cat "/tmp/ci-merge/$c.log"; echo "::endgroup::"
done

if [ "${#failed[@]}" -gt 0 ]; then echo "::error::failed to merge: ${failed[*]}"; exit 1; fi
