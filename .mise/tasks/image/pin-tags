#!/usr/bin/env bash
#MISE description="Rewrite the chart's @ci-pin markers to content tags and digests before packaging (CI publish jobs)"
# Rewrite the chart's `@ci-pin` markers to content tags and digests before
# packaging.
#
# A marker line looks like:
#   tag: "" # @ci-pin keycloak-image-tag
# and becomes:
#   tag: "<source sha of the component>"
#
# A digest marker, `digest: "" # @ci-pin <component>-image-digest`, becomes the
# digest the image at that source sha has. The vm-runner is pinned this way:
# its source sha also moves on commits that leave its content as it was, and
# image:ci-merge keeps the digest of a rebuild that changed nothing.
#
# Content tags pin an image to the commit that last touched its inputs, so
# upgrading to a chart that didn't change the image doesn't roll the pod (or
# rebuild the agent) — and a harness template's image ref, its version
# identity for upgrade offers, moves only when the image really did. The repo
# default stays `""` — charts rendered straight from git keep the appVersion
# fallback.
#
# Both publish jobs call this, so the marker set and the component list can't
# drift apart between the dev and release paths.
#
# Usage: mise run image:pin-tags -- <source-shas-json> [values-file]
# Written for bash 3.2 (macOS) and portable sed — no GNU-only \s or `sed -i`.
set -euo pipefail

SOURCE_SHAS="${1:?source-shas JSON required}"
VALUES="${2:-helm/values.yaml}"
here="$(cd "$(dirname "$0")" && pwd)"

[ -f "$VALUES" ] || { echo "no such values file: $VALUES" >&2; exit 1; }
KIT_FILES="$(find "$(dirname "$VALUES")/starter-kits" -name kit.yaml 2>/dev/null || true)"

for comp in $("$here/resolve" list-pinned-tags); do
  tag="$(jq -re --arg c "$comp" '.[$c]' <<< "$SOURCE_SHAS")"
  [ -n "$tag" ] || { echo "empty source sha for $comp" >&2; exit 1; }
  tmp="$(mktemp)"
  sed "s|^\([[:space:]]*\)tag: \"\" # @ci-pin ${comp}-image-tag\$|\1tag: \"$tag\"|" \
    "$VALUES" > "$tmp"
  mv "$tmp" "$VALUES"
  if grep -q "# @ci-pin ${comp}-image-digest\$" "$VALUES"; then
    digest="$(crane digest "${IMAGE_PREFIX:-quay.io/dam-agents}/$comp:$tag")"
    tmp="$(mktemp)"
    sed "s|^\([[:space:]]*\)digest: \"\" # @ci-pin ${comp}-image-digest\$|\1digest: \"$digest\"|" \
      "$VALUES" > "$tmp"
    mv "$tmp" "$VALUES"
  fi
  # Built-in starter kits pin their image the same way: a tagless ref with the
  # marker becomes `<ref>:<source sha>`.
  for kit in $KIT_FILES; do
    ktmp="$(mktemp)"
    sed "s|^\([[:space:]]*\)ref: \([^ ]*\) # @ci-pin ${comp}-image-tag\$|\1ref: \2:$tag|" \
      "$kit" > "$ktmp"
    mv "$ktmp" "$kit"
  done
done

# Every marker must have been consumed — a leftover means the component list
# and the values.yaml markers drifted apart.
! grep -nE '@ci-pin .*-image-(tag|digest)' "$VALUES" $KIT_FILES
