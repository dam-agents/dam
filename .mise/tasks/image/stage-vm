#!/usr/bin/env bash
#MISE description="Stage an image tar or OCI layout on the node for the VM runners, as a flattened tree plus its launch record"
#USAGE arg "<image>" help="An image tar, as the :oci tasks write, or the OCI layout a layout-only build leaves"
# It lands under the read-only image directory the runners mount, by the name
# the image carries.
# The runner boots a staged tree as a shared read-only lower layer, so a
# machine starts in seconds. The runner refuses a `docker save` archive
# staged instead: no guest flattens one since platform-init became its init.
set -euo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"
# The directory the runners mount, out of the controller's own environment. The
# install hands it in (VM_IMAGE_DIR), since its render is the only one that
# knows its overlay and --set; on its own, the chart's local values are all
# there is. Either way a staged tree lands where that install's runners look.
IMAGE_DIR="${VM_IMAGE_DIR:-$(helm template platform "$MISE_CONFIG_ROOT/helm" \
  -f "$MISE_CONFIG_ROOT/helm/values-local.yaml" \
  --show-only templates/controller/deployment.yaml \
  | yq -r 'select(.kind == "Deployment") | .spec.template.spec.containers[].env[]
      | select(.name == "AGENT_VM") | .value | fromjson | .runner.imageCacheHostPath')}"
# The trees land under this directory as root; an empty one would put them in
# the node's own root, where the next prune or eviction of the cache would take
# them for its own.
[ -n "$IMAGE_DIR" ] || {
  echo "image:stage-vm: helm/values-local.yaml names no node image cache directory, and no VM_IMAGE_DIR was given — set virtualization.imageCache.hostPath in that file, or hand in the directory the install's runners mount as VM_IMAGE_DIR" >&2
  exit 1
}
# Under the runner's temp directory in CI: the hard links below need the work
# directory on the filesystem the lane's layout is on, and on the ubuntu-26.04
# runner image /tmp is a small filesystem of its own.
work="$(TMPDIR="${RUNNER_TEMP:-${TMPDIR:-/tmp}}" mktemp -d)"
trap 'rm -rf "$work"' EXIT

# A layout is linked in, not unpacked: the e2e lane leaves a built agent image as
# its layout, and its blobs are the image's. The link needs both on one
# filesystem, the temp directory the lane and this work directory share.
# gzip-layout and name-layout replace the files they rewrite, which leaves the
# layout they read alone.
layout="$work/layout"
mkdir -p "$layout"
if [ -d "$usage_image" ]; then cp -al "$usage_image/." "$layout"; else tar -xf "$usage_image" -C "$layout"; fi
IMAGE="$(jq -r '.[0].RepoTags[0]' "$layout/manifest.json")"
name="$(printf '%s' "$IMAGE" | tr '/:@' '___')"

# The record the runner reads beside the tree: what the image says to run.
config="$(jq -r '.[0].Config' "$layout/manifest.json")"
jq \
  '.config | {"entrypoint": (.Entrypoint // []), "cmd": (.Cmd // []), "env": (.Env // []), "workingDir": (.WorkingDir // "")}' \
  "$layout/$config" > "$work/launch.json"

# Runs as root on the node: fills a tree beside the live entry, moves the old
# entry aside and the new one in, so a runner looking the entry up finds a
# whole tree at every moment — never a half-written one, and never none. A
# machine already booted from the old tree keeps its mounted files until it
# restarts. The archive an earlier stage left under the same name goes last:
# the runner boots the tree, and the archive only costs disk. The tree keeps
# the modes and owners the image gave it — the runner reads it with
# DAC_OVERRIDE, and a file the image keeps from others, such as /etc/shadow,
# must stay that way in the guest.
# The source is either a flattened rootfs tar or, when the node's containerd
# already holds the image, its ref: cluster:install imports every agent image
# before staging it, and the snapshot that import unpacked is mounted and
# copied, which skips re-reading, re-compressing and flattening the layers.
# xattrs are left out, as tar leaves them out of the tar path's tree.
place='set -e
dest="$1"; src="$2"; launch="$3"; unpacked_as="${4:-}"
rm -rf "$dest.new" "$dest.old"
mkdir -p "$dest.new/rootfs"
case "$src" in
  *.tar) tar -xf "$src" -C "$dest.new/rootfs" ;;
  *)
    mnt="$(mktemp -d)"
    k3s ctr images mount "$src" "$mnt" >/dev/null
    rc=0; cp -a --no-preserve=xattr "$mnt/." "$dest.new/rootfs/" || rc=$?
    k3s ctr images unmount --rm "$mnt" >/dev/null; rmdir "$mnt"
    [ "$rc" = 0 ] ;;
esac
[ -z "$unpacked_as" ] || printf "%s\n" "$unpacked_as" > "$dest.new/unpacked-as"
install -m 644 "$launch" "$dest.new/launch.json"
chmod a+rx "$dest.new"
[ ! -e "$dest" ] || mv "$dest" "$dest.old"
mv "$dest.new" "$dest"
rm -rf "$dest.old" "$dest.tar"'

# containerd's name for the image: a bare name or one without a registry
# host is normalized onto docker.io, as `ctr images import` stores it. The
# node's image is used only when its ID is the tar's config digest: a tag
# the node holds from an earlier build would give a tree that disagrees
# with the launch record read from this tar.
case "$IMAGE" in
  *.*/* | *:*/* | localhost/*) ref="$IMAGE" ;;
  */*) ref="docker.io/$IMAGE" ;;
  *) ref="docker.io/library/$IMAGE" ;;
esac
if [ -n "${IS_SANDBOX:-}" ]; then
  on_node() { as_root "$@"; }
else
  on_node() { limactl shell "$LIMA_INSTANCE" sudo "$@"; }
fi
digest="${config##*/}"; digest="sha256:${digest%.json}"
if [ -z "${VM_HOST_RUNNER:-}" ] \
  && [ "$(on_node k3s crictl inspecti -o go-template --template '{{.status.id}}' "$ref" 2>/dev/null)" = "$digest" ]; then
  if [ -n "${IS_SANDBOX:-}" ]; then
    as_root sh -c "$place" _ "$IMAGE_DIR/$name" "$ref" "$work/launch.json"
  else
    limactl copy "$work/launch.json" "$LIMA_INSTANCE:/tmp/$name.launch.json"
    limactl shell "$LIMA_INSTANCE" sudo sh -c "$place" _ "$IMAGE_DIR/$name" "$ref" "/tmp/$name.launch.json"
    limactl shell "$LIMA_INSTANCE" rm -f "/tmp/$name.launch.json"
  fi
  echo "staged $IMAGE at $IMAGE_DIR/$name, from the node's containerd"
  exit 0
fi

# crane reads a docker-save tarball's layers as all gzip or all plain, judged
# by the first layer alone, and a built image mixes the two: the layers its
# build writes are plain tars, the ones it takes from its base stay gzip. Read
# as plain, a gzip layer is a truncated tar ("reading tar: unexpected EOF"),
# so every plain layer is gzipped and the docker-save manifest written again
# before crane flattens it. An image pulled from a registry is gzip throughout
# and passes through unchanged.
"$MISE_CONFIG_ROOT/.mise/tasks/image/gzip-layout" "$layout"
"$MISE_CONFIG_ROOT/.mise/tasks/image/name-layout" "$layout" "$IMAGE"
entries=()
while IFS= read -r e; do entries+=("$e"); done < <(ls -A "$layout")
tar -C "$layout" -cf - "${entries[@]}" | crane export - "$work/rootfs.tar"
rm -rf "$layout"

if [ -n "${VM_HOST_RUNNER:-}" ]; then
  # The runner on this Mac reads its own image volume, as the user it runs
  # as, so the tree is placed there unprivileged. tar cannot restore the
  # image's owners without root, so every file is the runner's, and the guest
  # must read them all as root's: the record written beside the tree names the
  # one owner the unpack gave them, and platform-init maps it. A tree staged
  # with privilege carries no record and keeps the image's own owners.
  . "$MISE_CONFIG_ROOT/.mise/lib/host-runner.sh"
  IMAGE_DIR="$(host_runner_images)"
  sh -c "$place" _ "$IMAGE_DIR/$name" "$work/rootfs.tar" "$work/launch.json" "$(id -u) $(id -g)"
elif [ -n "${IS_SANDBOX:-}" ]; then
  as_root sh -c "$place" _ "$IMAGE_DIR/$name" "$work/rootfs.tar" "$work/launch.json"
else
  limactl copy "$work/rootfs.tar" "$LIMA_INSTANCE:/tmp/$name.rootfs.tar"
  limactl copy "$work/launch.json" "$LIMA_INSTANCE:/tmp/$name.launch.json"
  limactl shell "$LIMA_INSTANCE" sudo sh -c "$place" _ "$IMAGE_DIR/$name" "/tmp/$name.rootfs.tar" "/tmp/$name.launch.json"
  limactl shell "$LIMA_INSTANCE" rm -f "/tmp/$name.rootfs.tar" "/tmp/$name.launch.json"
fi
echo "staged $IMAGE at $IMAGE_DIR/$name"
