#!/usr/bin/env bash
#MISE description="Decide whether a component image must be built or can be reused from the registry; see the usage block below"
# Decide whether a container image must be built or can be reused from the
# registry. Single source of truth shared by `//packages/agents:oci` and
# CI (the `changes` job) so the dependency graph and skip logic never drift.
#
# An image is REUSABLE when its effective source (its own paths PLUS its base's,
# transitively) has no uncommitted changes AND the registry already has it at the
# commit that last touched that source. The transitive path union is what makes a
# base change propagate to its children automatically (a stale base ⇒ the child's
# last-touching commit moves ⇒ its reuse tag moves too), and the registry check is
# self-correcting: a missing image (never built, build failed, off-main branch)
# just falls back to BUILD.
#
# Usage:
#   mise run image:resolve -- resolve <component>        -> "BUILD" | "REUSE <full-ref>"
#   mise run image:resolve -- gha-outputs                -> key=value lines for $GITHUB_OUTPUT (all components)
#   mise run image:resolve -- list-agents                -> the harness agent components (chart-pinned by source sha)
#   mise run image:resolve -- list-workloads             -> the claude-code-derived workload components
#   mise run image:resolve -- list-pinned-tags           -> every component whose chart/kit tag pin-tags rewrites
#   mise run image:resolve -- list-components            -> every published image (cd.yml scans them all)
#   mise run image:resolve -- paths <component>          -> effective source paths (debug)
#   mise run image:resolve -- --self-check               -> run assertions (no docker/network; git optional)
# (the leading `--` keeps mise from parsing the subcommand's own `--`)
#
# Env: IMAGE_PREFIX (default quay.io/dam-agents), GITHUB_SHA, EVENT (gha-outputs
# archs + workload skip: pull_request never builds workloads),
# RESOLVE_NO_REUSE=1 forces BUILD everywhere (CI tag/schedule: publish all),
# RESOLVE_REUSE_AGENTS=1 exempts agents and workloads from
# RESOLVE_NO_REUSE (CI main: they rebuild only when their effective source moved
# — the published chart pins their source-sha tags, so an unchanged one keeps
# last deploy's tag).
# Written for bash 3.2 (macOS) — no associative arrays.
set -euo pipefail

IMAGE_PREFIX="${IMAGE_PREFIX:-quay.io/dam-agents}"

# Test-only files and the agents' READMEs never ship (final images copy dist/ +
# node_modules, an agent's rootfs), so they don't move the last-touching commit.
# Ceiling: a reused image may differ in builder-stage test sources; runtime
# content is identical.
UNSHIPPED=':(exclude)*__tests__* :(exclude)*.test.ts :(exclude)*vitest.config.ts :(exclude)packages/agents/*/README.md'

# Source of the images `mise oci` builds (//packages/agents:oci), besides
# their own directory.
MISE_IMAGE_PATHS="packages/agents/.mise/tasks/oci packages/agents/base packages/agent-runtime packages/agent-runtime-api packages/api-server-api packages/driver-sdk packages/experiment-sdk packages/dev-config package.json pnpm-workspace.yaml pnpm-lock.yaml"

# harness agents; CI's `agents` build/merge matrix
AGENTS="claude-code codex pi-agent bob"
# claude-code-derived workloads; single registration point, also emitted as
# CI's `workloads` build/merge matrix
WORKLOADS="nous openevolve shinkaevolve gepa skydiscover k-search"
# Components whose chart or kit tag is rewritten from a source sha by pin-tags:
# the harnesses, keycloak, the vm-runner and every workload, since a starter kit
# names its image directly and its tag has to be pinned the same way a
# Template's is.
PINNED_TAGS="keycloak vm-runner $AGENTS $WORKLOADS"

is_workload() { case " $WORKLOADS " in *" $1 "*) ;; *) return 1 ;; esac; }

# Where a component's :oci task writes its image tar.
tar_path() {
  local d=packages/keycloak-theme
  [ "$1" = keycloak ] || for d in "packages/$1" "packages/agents/$1" "packages/e2e/agents/$1"; do [ -d "$d" ] && break; done
  echo "$d/dist/oci/$1.tar"
}

own_paths() {
  if is_workload "$1"; then echo "packages/agents/$1"; return; fi
  case "$1" in
    # The mock's harness bundles the mock control API client.
    mock) echo "$MISE_IMAGE_PATHS packages/e2e/agents/mock packages/e2e/agents/mock-api" ;;
    # The runner is the Rust workspace, whole: the runner and platform-init,
    # their lockfile, the pin naming the smolvm tree they build against, the
    # script that fetches it, image.toml and the task that builds the image
    # from it all. Beside it, only the task that names the image.
    vm-runner) echo "packages/vm-runner .mise/tasks/image/name-layout" ;;
    # keycloak = upstream Keycloak + the Keycloakify theme, packed onto it by
    # image:pack. The theme build also depends on dev-config and (any)
    # lockfile change — lockfile bumps re-tag it even when unrelated, which
    # errs toward rebuilds. Its source-sha tag is what the published chart
    # pins as the image tag, so a release that doesn't touch these paths
    # doesn't roll the Keycloak pod.
    keycloak) echo "packages/keycloak-theme packages/dev-config pnpm-lock.yaml .mise/tasks/image/pack" ;;
    claude-code|codex|pi-agent|bob) echo "$MISE_IMAGE_PATHS packages/agents/$1" ;;
    *) echo "unknown component: $1" >&2; return 1 ;;
  esac
}

base_of() {
  if is_workload "$1"; then echo "claude-code"; return; fi
  case "$1" in
    keycloak|vm-runner|claude-code|codex|pi-agent|bob|mock) echo "" ;;
    *) echo "unknown component: $1" >&2; return 1 ;;
  esac
}

effective_paths() {
  local base; base="$(base_of "$1")"
  if [ -n "$base" ]; then echo "$(own_paths "$1") $(effective_paths "$base")"; else own_paths "$1"; fi
}

registry_has() { crane digest "$1" >/dev/null 2>&1; }

# Last commit touching the component's effective source (tests excluded).
# Empty when git/history is unavailable — callers pick their own fallback.
source_sha() { git log -1 --format=%H -- $(effective_paths "$1") $UNSHIPPED 2>/dev/null || true; }

resolve() {
  local comp="$1" paths sha ref
  [ -n "${RESOLVE_NO_REUSE:-}" ] && { echo BUILD; return; }
  paths="$(effective_paths "$comp")"
  # Uncommitted change (or untracked file) in the effective source ⇒ must build.
  [ -n "$(git status --porcelain -- $paths $UNSHIPPED 2>/dev/null)" ] && { echo BUILD; return; }
  sha="$(source_sha "$comp")"
  [ -z "$sha" ] && { echo BUILD; return; }
  ref="${IMAGE_PREFIX}/${comp}:${sha}"
  if registry_has "$ref"; then echo "REUSE $ref"; else echo BUILD; fi
}

# Agents and workloads honour RESOLVE_REUSE_AGENTS despite
# RESOLVE_NO_REUSE (see header); keycloak keeps the caller's mode.
resolve_derived() {
  ( [ -z "${RESOLVE_REUSE_AGENTS:-}" ] || unset RESOLVE_NO_REUSE; resolve "$1" )
}

gha_outputs() {
  local archs built a agents_json wl_built w workloads_json s src
  archs='["amd64","arm64"]'; [ "${EVENT:-}" = pull_request ] && archs='["amd64"]'
  # source_shas: per-component last-touching-source sha — non-PR runs tag their
  # images with it so PR reuse hits even when that commit was never a green
  # push tip. Falls back to GITHUB_SHA (a duplicate of the sha tag, harmless).
  src="$(for a in keycloak vm-runner $AGENTS $WORKLOADS; do
    s="$(source_sha "$a")"; printf '%s=%s\n' "$a" "${s:-${GITHUB_SHA:-}}"
  done | jq -cRn '[inputs | split("=") | {(.[0]): .[1]}] | add')"
  built=()
  for a in $AGENTS; do
    [ "$(resolve_derived "$a" | cut -d' ' -f1)" = BUILD ] && built+=("$a")
  done
  agents_json="$(printf '%s\n' "${built[@]:-}" | jq -R . | jq -cs 'map(select(length>0))')"
  # Workloads are slow, rarely-changing builds on the claude-code base: PRs
  # never build them.
  wl_built=()
  if [ "${EVENT:-}" != pull_request ]; then
    for w in $WORKLOADS; do
      [ "$(resolve_derived "$w" | cut -d' ' -f1)" = BUILD ] && wl_built+=("$w")
    done
  fi
  workloads_json="$(printf '%s\n' "${wl_built[@]:-}" | jq -R . | jq -cs 'map(select(length>0))')"
  printf 'agents=%s\narchs=%s\nworkloads=%s\nsource_shas=%s\n' \
    "$agents_json" "$archs" "$workloads_json" "$src"
}

self_check() {
  local f=0
  chk() { if [ "$1" != "$2" ]; then echo "FAIL: expected [$2] got [$1]" >&2; f=1; fi; }
  has() { case "$1" in *"$2"*) ;; *) echo "FAIL: [$1] missing [$2]" >&2; f=1 ;; esac; }
  chk "$(base_of nous)" claude-code
  chk "$(base_of shinkaevolve)" claude-code
  chk "$(base_of gepa)" claude-code
  chk "$(base_of skydiscover)" claude-code
  chk "$(base_of claude-code)" ""
  chk "$(base_of k-search)" claude-code
  chk "$(base_of mock)" ""
  has "$(effective_paths claude-code)" packages/agents/claude-code
  has "$(effective_paths claude-code)" packages/agents/base
  has "$(effective_paths claude-code)" packages/agent-runtime
  has "$(effective_paths bob)" packages/agents/bob
  chk "$(base_of keycloak)" ""
  chk "$(base_of vm-runner)" ""
  has "$(effective_paths keycloak)" packages/keycloak-theme
  has "$(effective_paths vm-runner)" packages/vm-runner
  has "$PINNED_TAGS" vm-runner
  has "$(effective_paths nous)" packages/agents/base
  has "$(effective_paths mock)" packages/e2e/agents/mock-api
  has "$(effective_paths k-search)" packages/agents/claude-code
  has "$(effective_paths nous)" packages/agents/claude-code
  has "$(effective_paths nous)" packages/agents/nous
  has "$(effective_paths shinkaevolve)" packages/agents/shinkaevolve
  has "$(effective_paths shinkaevolve)" packages/agents/claude-code
  has "$(effective_paths gepa)" packages/agents/gepa
  has "$(effective_paths gepa)" packages/agents/claude-code
  has "$(effective_paths skydiscover)" packages/agents/skydiscover
  has "$(effective_paths skydiscover)" packages/agents/claude-code
  # NO_REUSE reproduces the full-build (tag/schedule/dispatch) output without
  # git/docker.
  local out; out="$(EVENT=push GITHUB_SHA=deadbeef RESOLVE_NO_REUSE=1; export EVENT GITHUB_SHA RESOLVE_NO_REUSE; gha_outputs)"
  has "$out" 'agents=["claude-code","codex","pi-agent","bob"]'
  has "$out" 'workloads=["nous","openevolve","shinkaevolve","gepa","skydiscover","k-search"]'
  has "$out" 'archs=["amd64","arm64"]'
  has "$out" 'source_shas={"keycloak":"'
  has "$out" '"vm-runner":"'
  # PRs never build workloads — the EVENT gate short-circuits before any
  # resolve; NO_REUSE keeps the other components' resolves hermetic.
  out="$(EVENT=pull_request GITHUB_SHA=deadbeef RESOLVE_NO_REUSE=1; export EVENT GITHUB_SHA RESOLVE_NO_REUSE; gha_outputs)"
  has "$out" 'workloads=[]'
  has "$out" 'archs=["amd64"]'
  [ "$f" = 0 ] && echo "self-check OK" || exit 1
}

case "${1:-}" in
  resolve)        resolve "$2" ;;
  gha-outputs)    gha_outputs ;;
  list-agents)    echo $AGENTS ;;
  list-workloads) echo $WORKLOADS ;;
  list-pinned-tags) echo $PINNED_TAGS ;;
  list-components) echo api-server ui controller vm-runner keycloak $AGENTS $WORKLOADS ;;
  paths)          effective_paths "$2" ;;
  tar-path)       tar_path "$2" ;;
  --self-check)   self_check ;;
  *) echo "usage: resolve-image.sh {resolve|gha-outputs|list-agents|list-workloads|list-pinned-tags|list-components|paths|tar-path|--self-check}" >&2; exit 2 ;;
esac
