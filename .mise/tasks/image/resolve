#!/usr/bin/env bash
#MISE description="Decide whether a component image is built or reused from the registry"
# Decide whether a container image must be built or can be reused from the
# registry. Single source of truth shared by `//packages/agents:oci` and
# CI (the `changes` job) so the dependency graph and skip logic never drift.
#
# An image is REUSABLE when its effective source (its own paths PLUS its base's,
# transitively) has no uncommitted changes AND the registry already has it at the
# commit that last touched that source. The transitive path union is what makes a
# base change propagate to its children automatically (a stale base ⇒ the child's
# last-touching commit moves ⇒ its reuse tag moves too), and the registry check is
# self-correcting: a missing image (never built, build failed, off-main branch)
# just falls back to BUILD. A merge group (EVENT=merge_group) also reuses an
# earlier group's build, from its cache tag (mq_tag); nothing else reads it.
#
# Usage:
#   mise run image:resolve -- resolve <component>        -> "BUILD" | "REUSE <full-ref>"
#   mise run image:resolve -- source-sha <component>     -> the commit that last touched its effective source
#   mise run image:resolve -- mq-tag <component>         -> the merge-queue cache tag of its effective source's content
#   mise run image:resolve -- gha-outputs                -> key=value lines for $GITHUB_OUTPUT (all components)
#   mise run image:resolve -- list-workloads            -> the workload components, each packed onto the default image
#   mise run image:resolve -- list-harnesses            -> the harness directories the default image carries, no image of their own
#   mise run image:resolve -- list-pinned-tags           -> every component whose chart/kit tag pin-tags rewrites
#   mise run image:resolve -- list-components            -> every published image (security.yml scans them all)
#   mise run image:resolve -- list-third-party           -> every third-party image ref the chart runs (security.yml scans them too)
#   mise run image:resolve -- paths <component>          -> effective source paths (debug)
#   mise run image:resolve -- tar-path <component>       -> where its :oci task writes its image tar
#   mise run image:resolve -- import-path <component>    -> what the e2e cluster imports for it: its layout, or its tar
#   mise run image:resolve -- oci-out                    -> where a build leaves an image's OCI layout
#   mise run image:resolve -- --self-check               -> run assertions (no registry/network; git optional)
# (the leading `--` keeps mise from parsing the subcommand's own `--`)
#
# Env: IMAGE_PREFIX (default quay.io/dam-agents), GITHUB_SHA, EVENT (gha-outputs
# archs + workload skip: pull_request never builds workloads; merge_group
# builds both archs like main, without workloads or the mock), GITHUB_REF
# (gha-outputs image_archs: only a v* tag builds the IMAGES for arm64),
# RESOLVE_NO_REUSE=1 forces BUILD everywhere (CI tag/schedule/dispatch: publish
# all, which also picks up newer Debian packages and uncached tool trees). A
# main push reuses every image whose effective source did not move.
# Written for bash 3.2 (macOS) — no associative arrays.
set -euo pipefail

IMAGE_PREFIX="${IMAGE_PREFIX:-quay.io/dam-agents}"
# Where image:ci-build leaves an image's OCI layout: it names this for the oci
# task, and import_path finds an image's layout by it.
OCI_OUT="${AGENT_OCI_OUT:-/tmp/ci-build/oci}"

# Test-only files and the agents' READMEs never ship (final images copy dist/ +
# node_modules, an agent's rootfs), so they don't move the last-touching commit.
# Ceiling: a reused image may differ in builder-stage test sources; runtime
# content is identical.
UNSHIPPED=':(exclude)*__tests__* :(exclude)*.test.ts :(exclude)*_test.go :(exclude)*vitest.config.ts :(exclude)packages/agents/*/README.md'

# Source of the agent images (//packages/agents:oci), besides their own
# directory: the task, image:pack and image:name-layout that put them
# together, and the base. The root config names their Debian base; a bump of
# another tool there re-tags them too, which errs toward rebuilds.
MISE_IMAGE_PATHS="packages/agents/.mise/tasks/oci .mise/tasks/image/pack .mise/tasks/image/name-layout packages/agents/base .mise/config.toml packages/agent-runtime packages/agent-runtime-api packages/api-server-api packages/driver-sdk packages/driver-sdk-py packages/dev-config package.json pnpm-workspace.yaml pnpm-lock.yaml"

# agent images; CI's `agents` build/merge matrix. The default image carries
# every harness, whose directories are its sources and no image of their own.
AGENTS="default"
HARNESSES="claude-code codex pi-agent bob copilot"
# workloads, each packed onto the default image; single registration point,
# also emitted as CI's `workloads` build/merge matrix
WORKLOADS="nous openevolve shinkaevolve gepa skydiscover k-search"
# Components image:pack builds on the host, plus the task that packs them, the
# base and toolchain pins in the root config and the tools' exact versions in
# mise.lock. A lockfile bump for another tool re-tags them too, which errs
# toward rebuilds.
PACK_TOOLING=".mise/tasks/image/pack .mise/config.toml mise.lock"
# The pnpm workspace: its root manifests and lockfile.
PNPM_ROOT="package.json pnpm-workspace.yaml pnpm-lock.yaml packages/dev-config"
# The images build.yml's build-images job builds, one job per arch of
# image_archs. A Mac's cluster:install builds these five itself and never
# pulls them, so only a v* tag, for release consumers, builds them for arm64.
IMAGES="controller ui api-server keycloak vm-runner"

# Components whose chart or kit tag is rewritten from a source sha by pin-tags:
# the default image, keycloak, the vm-runner and every workload, since a starter kit
# names its image directly and its tag has to be pinned the same way a
# Template's is.
PINNED_TAGS="keycloak vm-runner $AGENTS $WORKLOADS"

# Every non-empty `image`/`*Image` string and repository+tag/digest pair in the
# chart values, plus the mirror's copies. Our own images have no tag there.
# Ceiling: images only cluster:install deploys (the dev cluster's add-ons) are
# not listed.
third_party() {
  {
    yq -N -r '.. | select(tag == "!!map") | (
      (to_entries[] | select((.key | test("(^i|I)mage$")) and (.value | tag) == "!!str" and .value != "") | .value),
      (select((.repository // "") != "" and (.tag // "") != "") | .repository + ":" + .tag),
      (select((.repository // "") != "" and (.digest // "") != "") | .repository + "@" + .digest))' helm/values.yaml helm/extra/kvm-device-plugin.yaml
    sed -n '/^MIRRORS="/,/^"$/{/:/s|.*/|'"$IMAGE_PREFIX"'/|p;}' .mise/tasks/image/mirror
  } | sort -u
}

is_workload() { case " $WORKLOADS " in *" $1 "*) ;; *) return 1 ;; esac; }

# Where a component's :oci task writes its image tar.
tar_path() {
  local d=packages/keycloak-theme
  [ "$1" = keycloak ] || for d in "packages/$1" "packages/agents/$1" "packages/e2e/agents/$1"; do [ -d "$d" ] && break; done
  echo "$d/dist/oci/$1.tar"
}

# What the e2e lane gives cluster:import for a component: an agent image this
# run's :load output built is its OCI layout, which cluster:import tars into the
# import as it reads it, so a multi-gigabyte image is never stored as a tar and
# read back. Every other component, and an agent image pulled from the registry,
# is the tar its :oci task or image:pull wrote. The oci task also leaves a
# layout it built only as another image's base; image:ci-build names the ones a
# load made, one per line, so neither kind is confused for the other.
import_path() { if grep -qx "$1" "$OCI_OUT/load" 2>/dev/null; then echo "$OCI_OUT/$1"; else tar_path "$1"; fi; }

own_paths() {
  if is_workload "$1"; then echo "$MISE_IMAGE_PATHS packages/agents/$1"; return; fi
  case "$1" in
    # The mock's harness bundles the mock control API client.
    mock) echo "packages/e2e/agents/mock packages/e2e/agents/mock-api" ;;
    # The runner is the Rust workspace, whole: the runner and platform-init,
    # their lockfile, the pin naming the smolvm tree they build against, the
    # script that fetches it, image.toml and the task that builds the image
    # from it all. Beside it, the task that names the image, its base and the
    # Rust toolchain that compiles it: their pins in the root config, the
    # toolchain's exact version in mise.lock. A lockfile bump for another tool re-tags it too,
    # which errs toward rebuilds.
    vm-runner) echo "packages/vm-runner .mise/tasks/image/name-layout .mise/config.toml mise.lock" ;;
    # Each TS image's own package and its workspace dependencies, transitively.
    controller) echo "packages/controller $PACK_TOOLING" ;;
    ui) echo "packages/ui packages/agent-runtime-api packages/api-server-api $PNPM_ROOT $PACK_TOOLING" ;;
    api-server) echo "packages/api-server packages/agent-runtime-api packages/api-server-api packages/db packages/e2e/agents/mock-api $PNPM_ROOT $PACK_TOOLING" ;;
    # keycloak = upstream Keycloak, pinned in the root config, + the
    # Keycloakify theme, packed onto it by image:pack. The theme build also
    # depends on dev-config and (any) lockfile change — lockfile and root
    # config bumps re-tag it even when unrelated, which errs toward rebuilds. Its source-sha tag is what the published chart
    # pins as the image tag, so a release that doesn't touch these paths
    # doesn't roll the Keycloak pod.
    keycloak) echo "packages/keycloak-theme packages/dev-config pnpm-lock.yaml .mise/tasks/image/pack .mise/config.toml" ;;
    default) echo "$MISE_IMAGE_PATHS packages/agents/default $(for h in $HARNESSES; do printf ' packages/agents/%s' "$h"; done)" ;;
    *) echo "unknown component: $1" >&2; return 1 ;;
  esac
}

base_of() {
  if is_workload "$1"; then echo "default"; return; fi
  case "$1" in
    mock) echo "default" ;;
    controller|ui|api-server|keycloak|vm-runner|default) echo "" ;;
    *) echo "unknown component: $1" >&2; return 1 ;;
  esac
}

effective_paths() {
  local base; base="$(base_of "$1")"
  if [ -n "$base" ]; then echo "$(own_paths "$1") $(effective_paths "$base")"; else own_paths "$1"; fi
}

registry_has() { crane digest "$1" >/dev/null 2>&1; }

# Last commit touching the component's effective source (tests excluded).
# Empty when git/history is unavailable — callers pick their own fallback.
source_sha() { git log -1 --format=%H -- $(effective_paths "$1") $UNSHIPPED 2>/dev/null || true; }
# A merge group's cache tag: build-images pushes it there, and only a merge
# group reuses it. It names the effective source's content, not a commit: a
# queue rebuilt after an ejection gets new commits, the same content.
mq_tag() { echo "mq-$(git ls-files -s -- $(effective_paths "$1") $UNSHIPPED | git hash-object --stdin)"; }

resolve() {
  local comp="$1" paths sha ref
  [ -n "${RESOLVE_NO_REUSE:-}" ] && { echo BUILD; return; }
  paths="$(effective_paths "$comp")"
  # Uncommitted change (or untracked file) in the effective source ⇒ must build.
  [ -n "$(git status --porcelain -- $paths $UNSHIPPED 2>/dev/null)" ] && { echo BUILD; return; }
  sha="$(source_sha "$comp")"
  [ -z "$sha" ] && { echo BUILD; return; }
  ref="${IMAGE_PREFIX}/${comp}:${sha}"
  registry_has "$ref" && { echo "REUSE $ref"; return; }
  if [ "${EVENT:-}" = merge_group ]; then
    ref="${IMAGE_PREFIX}/${comp}:$(mq_tag "$comp")"
    registry_has "$ref" && { echo "REUSE $ref"; return; }
  fi
  echo BUILD
}

# The components of a list that resolve to BUILD, as a JSON array. An `if`,
# not `&&`: a reused last component would end the loop, and with it this
# pipeline, with status 1.
stale_json() {
  local c
  for c in "$@"; do
    if [ "$(resolve "$c" | cut -d' ' -f1)" = BUILD ]; then echo "$c"; fi
  done | jq -R . | jq -cs 'map(select(length>0))'
}

gha_outputs() {
  local archs image_archs='["amd64"]' a s src agents_json workloads_json='[]' images_json='[]' mock=false
  archs='["amd64","arm64"]'; [ "${EVENT:-}" = pull_request ] && archs='["amd64"]'
  case "${GITHUB_REF:-}" in refs/tags/v*) image_archs="$archs" ;; esac
  # source_shas: per-component last-touching-source sha — non-PR runs tag their
  # images with it so PR reuse hits even when that commit was never a green
  # push tip. Falls back to GITHUB_SHA (a duplicate of the sha tag, harmless).
  src="$(for a in $IMAGES mock $AGENTS $WORKLOADS; do
    s="$(source_sha "$a")"; printf '%s=%s\n' "$a" "${s:-${GITHUB_SHA:-}}"
  done | jq -cRn '[inputs | split("=") | {(.[0]): .[1]}] | add')"
  agents_json="$(stale_json $AGENTS)"
  # A PR builds its images and the mock in e2e, which resolves them itself,
  # and never builds workloads: slow, rarely-changing builds on the default
  # image. A merge group also builds its images in build-images, on amd64.
  [ "${EVENT:-}" = pull_request ] || images_json="$(stale_json $IMAGES)"
  if [ "${EVENT:-}" != pull_request ] && [ "${EVENT:-}" != merge_group ]; then
    workloads_json="$(stale_json $WORKLOADS)"
    [ "$(resolve mock | cut -d' ' -f1)" = BUILD ] && mock=true
  fi
  printf 'agents=%s\narchs=%s\nimage_archs=%s\nworkloads=%s\nimages=%s\nmock=%s\nsource_shas=%s\n' \
    "$agents_json" "$archs" "$image_archs" "$workloads_json" "$images_json" "$mock" "$src"
}

self_check() {
  local f=0
  chk() { if [ "$1" != "$2" ]; then echo "FAIL: expected [$2] got [$1]" >&2; f=1; fi; }
  has() { case "$1" in *"$2"*) ;; *) echo "FAIL: [$1] missing [$2]" >&2; f=1 ;; esac; }
  # An image built here imports as its layout, a pulled one as its tar, and a
  # layout no load named is ignored.
  chk "$(OCI_OUT=/nonexistent import_path mock)" "packages/e2e/agents/mock/dist/oci/mock.tar"
  local d; d="$(mktemp -d)"
  mkdir "$d/default" "$d/nous"
  printf 'default\n' > "$d/load"
  chk "$(OCI_OUT="$d" import_path default)" "$d/default"
  chk "$(OCI_OUT="$d" import_path nous)" "packages/agents/nous/dist/oci/nous.tar"
  chk "$(OCI_OUT="$d" import_path mock)" "packages/e2e/agents/mock/dist/oci/mock.tar"
  rm -rf "$d"
  chk "$(base_of nous)" default
  chk "$(base_of shinkaevolve)" default
  chk "$(base_of gepa)" default
  chk "$(base_of skydiscover)" default
  chk "$(base_of k-search)" default
  chk "$(base_of mock)" default
  base_of claude-code >/dev/null 2>&1 && { echo "FAIL: a harness resolves as an image" >&2; f=1; }
  chk "$(base_of default)" ""
  has "$(effective_paths default)" packages/agents/default
  has "$(effective_paths default)" packages/agents/pi-agent
  has "$(effective_paths default)" packages/agents/bob
  has "$(effective_paths default)" packages/agents/base
  has "$(effective_paths default)" packages/agent-runtime
  has "$(effective_paths default)" .mise/config.toml
  chk "$(base_of keycloak)" ""
  chk "$(base_of controller)" ""
  chk "$(base_of ui)" ""
  chk "$(base_of api-server)" ""
  has "$(effective_paths controller)" packages/controller
  has "$(effective_paths ui)" packages/api-server-api
  has "$(effective_paths ui)" pnpm-lock.yaml
  has "$(effective_paths api-server)" packages/db
  has "$(effective_paths api-server)" .mise/tasks/image/pack
  chk "$(base_of vm-runner)" ""
  has "$(effective_paths keycloak)" packages/keycloak-theme
  has "$(effective_paths keycloak)" .mise/config.toml
  has "$(effective_paths vm-runner)" packages/vm-runner
  has "$(effective_paths vm-runner)" mise.lock
  has "$PINNED_TAGS" vm-runner
  has "$(third_party)" mirror.gcr.io/envoyproxy/envoy:
  has "$(third_party)" ghcr.io/squat/generic-device-plugin@sha256:
  has "$(third_party)" "$IMAGE_PREFIX/clickhouse-operator:"
  case "$(third_party)" in *"$IMAGE_PREFIX/controller"*) echo "FAIL: own image in third_party" >&2; f=1 ;; esac
  case "$(third_party | grep -vE '^[^[:space:]]+[:@][^[:space:]]+$' || true)" in ?*) echo "FAIL: third_party lists a line that is no image ref" >&2; f=1 ;; esac
  has "$(effective_paths nous)" packages/agents/base
  has "$(effective_paths mock)" packages/e2e/agents/mock-api
  has "$(effective_paths k-search)" packages/agents/claude-code
  has "$(effective_paths nous)" packages/agents/claude-code
  has "$(effective_paths nous)" packages/agents/nous
  has "$(effective_paths shinkaevolve)" packages/agents/shinkaevolve
  has "$(effective_paths shinkaevolve)" packages/agents/claude-code
  has "$(effective_paths gepa)" packages/agents/gepa
  has "$(effective_paths gepa)" packages/agents/claude-code
  has "$(effective_paths skydiscover)" packages/agents/skydiscover
  has "$(effective_paths skydiscover)" packages/agents/claude-code
  # NO_REUSE reproduces the full-build (tag/schedule/dispatch) output without
  # git or a registry.
  local out; out="$(EVENT=push GITHUB_REF=refs/heads/main GITHUB_SHA=deadbeef RESOLVE_NO_REUSE=1; export EVENT GITHUB_REF GITHUB_SHA RESOLVE_NO_REUSE; gha_outputs)"
  has "$out" 'agents=["default"]'
  has "$out" 'workloads=["nous","openevolve","shinkaevolve","gepa","skydiscover","k-search"]'
  has "$out" '
archs=["amd64","arm64"]'
  has "$out" 'image_archs=["amd64"]'
  has "$out" 'source_shas={"controller":"'
  has "$out" '"keycloak":"'
  has "$out" '"vm-runner":"'
  has "$out" '"mock":"'
  has "$out" 'images=["controller","ui","api-server","keycloak","vm-runner"]'
  has "$out" 'mock=true'
  # PRs never build workloads — the EVENT gate short-circuits before any
  # resolve; NO_REUSE keeps the other components' resolves hermetic.
  out="$(EVENT=pull_request GITHUB_SHA=deadbeef RESOLVE_NO_REUSE=1; export EVENT GITHUB_SHA RESOLVE_NO_REUSE; gha_outputs)"
  has "$out" 'workloads=[]'
  has "$out" 'images=[]'
  has "$out" 'mock=false'
  has "$out" '
archs=["amd64"]'
  out="$(EVENT=merge_group GITHUB_REF=refs/heads/gh-readonly-queue/main/pr-1-deadbeef GITHUB_SHA=deadbeef RESOLVE_NO_REUSE=1; export EVENT GITHUB_REF GITHUB_SHA RESOLVE_NO_REUSE; gha_outputs)"
  has "$out" 'workloads=[]'
  has "$out" 'images=["controller","ui","api-server","keycloak","vm-runner"]'
  has "$out" 'mock=false'
  has "$out" '
archs=["amd64","arm64"]'
  has "$out" 'image_archs=["amd64"]'
  # A release builds every image for both archs.
  out="$(EVENT=push GITHUB_REF=refs/tags/v1.2.3 GITHUB_SHA=deadbeef RESOLVE_NO_REUSE=1; export EVENT GITHUB_REF GITHUB_SHA RESOLVE_NO_REUSE; gha_outputs)"
  has "$out" 'image_archs=["amd64","arm64"]'
  # A reused component, last in its list, leaves it out and fails nothing.
  out="$(resolve() { case "$1" in b) echo "REUSE x" ;; *) echo BUILD ;; esac; }; stale_json a b)" || { echo "FAIL: stale_json failed on a reused last component" >&2; f=1; }
  chk "$out" '["a"]'
  # Only a merge group reuses a cache tag, which follows content alone. The
  # git and registry stand-ins keep it hermetic.
  local tag1 tag2
  tag1="$(git() { case "$1" in ls-files) echo "100644 aa 0 packages/vm-runner/x" ;; *) command git "$@" ;; esac; }; mq_tag vm-runner)"
  tag2="$(git() { case "$1" in ls-files) echo "100644 bb 0 packages/vm-runner/x" ;; *) command git "$@" ;; esac; }; mq_tag vm-runner)"
  case "$tag1" in mq-????????????????????????????????????????) ;; *) echo "FAIL: mq tag [$tag1]" >&2; f=1 ;; esac
  [ "$tag1" != "$tag2" ] || { echo "FAIL: mq tag ignores content" >&2; f=1; }
  mq_resolve() (
    git() { case "$1" in status) ;; ls-files) echo "100644 aa 0 packages/vm-runner/x" ;; *) command git "$@" ;; esac; }
    source_sha() { echo cafe; }
    registry_has() { case "$1" in *:mq-*) ;; *) return 1 ;; esac; }
    EVENT="$1" resolve vm-runner
  )
  chk "$(mq_resolve merge_group)" "REUSE $IMAGE_PREFIX/vm-runner:$tag1"
  chk "$(mq_resolve pull_request)" BUILD
  chk "$(mq_resolve push)" BUILD
  chk "$(mq_resolve '')" BUILD
  [ "$f" = 0 ] && echo "self-check OK" || exit 1
}

case "${1:-}" in
  resolve)        resolve "$2" ;;
  source-sha)     source_sha "$2" ;;
  mq-tag)         mq_tag "$2" ;;
  gha-outputs)    gha_outputs ;;
  list-workloads) echo $WORKLOADS ;;
  list-harnesses) echo $HARNESSES ;;
  list-pinned-tags) echo $PINNED_TAGS ;;
  list-components) echo $IMAGES $AGENTS $WORKLOADS ;;
  list-third-party) third_party ;;
  paths)          effective_paths "$2" ;;
  tar-path)       tar_path "$2" ;;
  import-path)    import_path "$2" ;;
  oci-out)        echo "$OCI_OUT" ;;
  --self-check)   self_check ;;
  *) echo "usage: image:resolve {resolve|source-sha|mq-tag|gha-outputs|list-workloads|list-harnesses|list-pinned-tags|list-components|list-third-party|paths|tar-path|import-path|oci-out|--self-check}" >&2; exit 2 ;;
esac
