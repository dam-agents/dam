#!/usr/bin/env bash
#MISE description="Retire the Agent and UserBudget CRDs cluster-wide, once every install on the cluster is past contract"
#MISE raw=true
#USAGE flag "--dry-run" help="Report what it would back up and delete, and touch nothing"
#USAGE flag "--backup <path>" default="crds-retired.yaml" help="File the final YAML backup of every custom resource goes to"
#USAGE flag "--rehearsal" help="Accept a rehearsal's contract clock; never on a real cluster"
# The one cluster-wide, irreversible step of the Agents-in-Postgres move. It
# runs once, after every install on the cluster has passed its contract gate:
# the install writes contract-at into its store marker only when the rollback
# window has closed and its archive is attested, so a marker without it is an
# install still on the custom resources or still inside its window.
# No install's chart, hook or component ever deletes a shared CRD.
#
# It fails closed on every read and refuses while any custom resource is left:
# a CRD deletion cascades, and a resource deleted that way loses the children
# its Agent owned instead of orphaning them the way `delete-crs` does.
#
# This file is mirrored, verbatim, into dam-ops (`retire-crds.sh`) and needs
# nothing but kubectl and jq: set KUBECTL to point it at another cluster.
set -euo pipefail
umask 077

KUBECTL="${KUBECTL:-kubectl}"
DRY_RUN=0
REHEARSAL=0
BACKUP="crds-retired.yaml"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --backup) BACKUP="$2"; shift 2 ;;
    --rehearsal) REHEARSAL=1; shift ;;
    -h|--help) sed -n '2,18p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

fail() {
  echo "retire-crds refuses: $*" >&2
  exit 1
}

# Both GNU date and the BSD date macOS ships read an RFC 3339 UTC instant once
# its fractional seconds are gone; the markers carry one form and the other.
epoch_of() {
  local stamp
  stamp=$(printf '%s' "$1" | sed 's/\.[0-9]*Z$/Z/')
  if date -j -f "%Y-%m-%dT%H:%M:%SZ" "$stamp" +%s 2>/dev/null; then
    return 0
  fi
  date -u -d "$stamp" +%s 2>/dev/null
}

deployments=$("$KUBECTL" get deployments -A -l app.kubernetes.io/component=apiserver -o json) ||
  fail "cannot list the api-server Deployments; nothing was read, so nothing may be deleted"
installs=$(jq '.items | length' <<<"$deployments") ||
  fail "cannot read the Deployment list; nothing may be deleted"
[ "$installs" -gt 0 ] ||
  fail "no api-server Deployment found: this is not the cluster an operator retires, or it has no install on the custom resources to check"

problems=()
while IFS=$'\x1f' read -r release namespace markerNamespace markerName; do
  [ -n "${release:-}" ] || continue
  if [ "$markerName" = "" ]; then
    problems+=("$release (namespace $namespace): an api-server runs with no Agent store marker, so this install never switched")
    continue
  fi
  if ! marker=$("$KUBECTL" get configmap -n "$markerNamespace" "$markerName" -o json 2>&1); then
    case "$marker" in
      *"not found"*|*NotFound*)
        problems+=("$release (namespace $markerNamespace): an api-server runs with no Agent store marker, so this install never switched")
        continue ;;
      *)
        fail "cannot read $release's Agent store marker $markerNamespace/$markerName ($marker); nothing was read, so nothing may be deleted" ;;
    esac
  fi
  store=$(jq -r '.data.store // ""' <<<"$marker")
  contracted=$(jq -r '.data["contract-at"] // ""' <<<"$marker")
  clock=$(jq -r '.data["contract-clock"] // ""' <<<"$marker")
  if [ "$contracted" = "" ]; then
    problems+=("$release ($markerNamespace/$markerName): store ${store:-unset} with no contract-at, so this install is still on the custom resources or still inside its rollback window")
    continue
  fi
  if [ "$REHEARSAL" != 1 ]; then
    if [ "$clock" = rehearsal ]; then
      problems+=("$release ($markerNamespace/$markerName): its contract gate ran on a rehearsal clock, which no real cluster's retirement may trust")
      continue
    fi
    if ! contracted_at=$(epoch_of "$contracted"); then
      problems+=("$release ($markerNamespace/$markerName): its contract-at is not an RFC 3339 instant, so the window it records cannot be checked")
      continue
    fi
    if [ "$contracted_at" -gt "$(date -u +%s)" ]; then
      problems+=("$release ($markerNamespace/$markerName): its contract-at is in the future, so the window it records never closed on the real clock")
      continue
    fi
  fi
done < <(jq -r '
  .items[] | . as $d
  | ($d.metadata.namespace) as $ns
  | ([.spec.template.spec.containers[].env[]? | {key: .name, value: .value}] | from_entries) as $env
  | ($env.PLATFORM_AGENT_NAMESPACE // $env.NAMESPACE // $ns) as $markerNs
  | ($env.PLATFORM_AGENT_STORE_MARKER // (($d.metadata.name | sub("-apiserver$"; "")) + "-agent-store")) as $markerName
  | [$d.metadata.labels["app.kubernetes.io/instance"] // $d.metadata.name, $ns, $markerNs, $markerName]
  | join("\u001f")' <<<"$deployments")

if [ "${#problems[@]}" -gt 0 ]; then
  echo "retire-crds refuses: every install on the cluster must pass its contract gate on the real clock first." >&2
  printf '  %s\n' "${problems[@]}" >&2
  echo "  An install inside its rollback window keeps its custom resources; running its contract release is what closes that window." >&2
  exit 1
fi

present=()
for kind in "agents.agent-platform.ai" "userbudgets.agent-platform.ai"; do
  if "$KUBECTL" get crd "$kind" >/dev/null 2>&1; then present+=("$kind"); fi
done
if [ "${#present[@]}" -eq 0 ]; then
  echo "the Agent and UserBudget CRDs are already retired: nothing to back up and nothing to delete."
  exit 0
fi

resources=""
for kind in "${present[@]}"; do
  part=$("$KUBECTL" get "$kind" -A -o yaml) ||
    fail "cannot read every $kind in the cluster; nothing was backed up, so nothing may be deleted"
  resources+=$'\n'"$part"
done
count=$(grep -c '^  kind: \(Agent\|UserBudget\)$' <<<"$resources" || true)
if [ "$count" -gt 0 ]; then
  echo "retire-crds refuses: $count custom resource(s) still exist on the cluster." >&2
  awk '
    /^  kind: (Agent|UserBudget)$/ { kind = $2; name = "" }
    /^    name: / { name = $2 }
    /^    namespace: / {
      if (kind != "" && name != "") { print "  " kind, $2 "/" name; kind = "" }
    }
  ' <<<"$resources" | head -40 >&2
  echo "  Deleting the CRDs now would cascade them, and the children an Agent owned would go with it." >&2
  echo "  Run delete-crs in each install (it orphans the children through their anchors) until the kinds are empty, then run this again." >&2
  exit 1
fi

if [ "$DRY_RUN" = 1 ]; then
  echo "would back up the empty ${present[*]} set to $BACKUP and delete ${#present[@]} CRD(s); nothing was touched."
  exit 0
fi
{
  echo "# The Agent and UserBudget custom resources as they stood when the CRDs were retired."
  echo "# Written by retire-crds at $(date -u +%Y-%m-%dT%H:%M:%SZ); keep it with the installs' archives."
  printf '%s\n' "$resources"
} >"$BACKUP"
if command -v sha256sum >/dev/null 2>&1; then
  digest=$(sha256sum "$BACKUP" | cut -d' ' -f1)
else
  digest=$(shasum -a 256 "$BACKUP" | cut -d' ' -f1)
fi
echo "backed up 0 custom resource(s) to $BACKUP (sha256 $digest)"

for kind in "${present[@]}"; do
  "$KUBECTL" delete crd "$kind" --ignore-not-found
done
echo "the CRDs are retired. Every install reads Postgres; read the rows with \`agent-store-cli export-crds\`."
