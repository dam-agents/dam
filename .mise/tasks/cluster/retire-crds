#!/usr/bin/env bash
#MISE description="Retire the Agent and UserBudget CRDs cluster-wide, once every install on the cluster is past contract"
#MISE raw=true
#USAGE flag "--dry-run" help="Report what it would back up and delete, and touch nothing"
#USAGE flag "--backup <path>" default="crds-retired.yaml" help="File the final YAML backup of every custom resource goes to"
# The one cluster-wide, irreversible step of the Agents-in-Postgres move. It
# runs once, after every install on the cluster has passed its contract gate:
# the install writes contract-at into its store marker only when the rollback
# window has closed and its archive is attested, so a marker without it is an
# install still on the custom resources or still inside its window.
# No install's chart, hook or component ever deletes a shared CRD.
#
# This file is mirrored, verbatim, into dam-ops (`retire-crds.sh`) and needs
# nothing but kubectl and jq: set KUBECTL to point it at another cluster.
set -euo pipefail

KUBECTL="${KUBECTL:-kubectl}"
DRY_RUN=0
BACKUP="crds-retired.yaml"
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) DRY_RUN=1; shift ;;
    --backup) BACKUP="$2"; shift 2 ;;
    -h|--help) sed -n '2,20p' "$0"; exit 0 ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done

deployments=$("$KUBECTL" get deployments -A -l app.kubernetes.io/component=apiserver -o json)
markers=$("$KUBECTL" get configmaps -A -o json)

problems=()
while IFS=$'\x1f' read -r release name namespace store contracted; do
  [ -n "${release:-}" ] || continue
  if [ "$name" = "" ]; then
    problems+=("$release (namespace $namespace): an api-server runs with no Agent store marker, so this install never switched")
  elif [ "$contracted" = "" ]; then
    problems+=("$release ($namespace/$name): store ${store:-unset} with no contract-at, so this install is still on the custom resources or still inside its rollback window")
  fi
done < <(jq -r --argjson markers "$markers" '
  .items[] | . as $d
  | ($d.metadata.namespace) as $ns
  | ([.spec.template.spec.containers[].env[]? | {key: .name, value: .value}] | from_entries) as $env
  | ($env.PLATFORM_AGENT_NAMESPACE // $env.NAMESPACE // $ns) as $markerNs
  | ($env.PLATFORM_AGENT_STORE_MARKER // (($d.metadata.name | sub("-apiserver$"; "")) + "-agent-store")) as $markerName
  | (first($markers.items[] | select(.metadata.namespace == $markerNs and .metadata.name == $markerName)) // null) as $m
  | [$d.metadata.labels["app.kubernetes.io/instance"] // $d.metadata.name,
     (if $m == null then "" else $markerName end), $markerNs,
     ($m.data.store // ""), ($m.data["contract-at"] // "")] | join("\u001f")' <<<"$deployments")

if [ "${#problems[@]}" -gt 0 ]; then
  echo "retire-crds refuses: every install on the cluster must pass its contract gate first." >&2
  printf '  %s\n' "${problems[@]}" >&2
  echo "  An install inside its rollback window keeps its custom resources; running the contract release on it is what closes that window." >&2
  exit 1
fi

if ! "$KUBECTL" get crd agents.agent-platform.ai >/dev/null 2>&1; then
  echo "the Agent and UserBudget CRDs are already retired: nothing to back up and nothing to delete."
  exit 0
fi

resources=$("$KUBECTL" get agents.agent-platform.ai,userbudgets.agent-platform.ai -A -o yaml 2>/dev/null ||
  echo "apiVersion: v1
kind: List
items: []")
count=$(grep -c '^  kind: \(Agent\|UserBudget\)$' <<<"$resources" || true)
if [ "$DRY_RUN" = 1 ]; then
  echo "would back up $count custom resource(s) to $BACKUP and delete the two CRDs; nothing was touched."
  exit 0
fi
{
  echo "# The Agent and UserBudget custom resources as they stood when the CRDs were retired."
  echo "# Written by retire-crds at $(date -u +%Y-%m-%dT%H:%M:%SZ); keep it with the installs' archives."
  printf '%s\n' "$resources"
} >"$BACKUP"
chmod 600 "$BACKUP"
if command -v sha256sum >/dev/null 2>&1; then
  digest=$(sha256sum "$BACKUP" | cut -d' ' -f1)
else
  digest=$(shasum -a 256 "$BACKUP" | cut -d' ' -f1)
fi
echo "backed up $count custom resource(s) to $BACKUP (sha256 $digest)"

"$KUBECTL" delete crd agents.agent-platform.ai userbudgets.agent-platform.ai --ignore-not-found
echo "the CRDs are retired. Every install reads Postgres; read the rows with \`agent-store-cli export-crds\`."
