#!/usr/bin/env bash
#MISE description="Delete the k3s cluster and all its data"
#MISE raw=true
#USAGE flag "--force" help="Skip the confirmation prompt"
set -eo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

if [ "${usage_force:-}" != true ]; then
  if [ -n "${IS_SANDBOX:-}" ]; then
    echo "This will stop k3s and delete all cluster data."
  else
    echo "This will delete the k3s VM ($LIMA_INSTANCE) and all cluster data."
  fi
  read -p "Continue? [y/N] " -r
  if [[ ! $REPLY =~ ^[Yy]$ ]]; then
    echo "Cancelled."
    exit 0
  fi
fi

if [ -n "${IS_SANDBOX:-}" ]; then
  if [ -x /usr/local/bin/k3s-uninstall.sh ]; then
    /usr/local/bin/k3s-uninstall.sh
  else
    as_root pkill -f 'k3s server' || true
    as_root rm -rf /var/lib/rancher/k3s /etc/rancher/k3s
  fi
  echo "k3s stopped and its cluster data removed."
else
  limactl delete --force "$LIMA_INSTANCE" 2>/dev/null || true
  # The host runner's machines belonged to this cluster's agents. Its smolvm
  # release, disk templates and image volume are only caches, and stay.
  . "$MISE_CONFIG_ROOT/.mise/lib/host-runner.sh"
  if [ "$(cat "$HOST_RUNNER_DIR/instance" 2>/dev/null)" = "$LIMA_INSTANCE" ]; then
    host_runner_stop
    rm -rf "$HOST_RUNNER_DIR/machines" "$HOST_RUNNER_DIR/Library" "$HOST_RUNNER_DIR/instance"
  fi
  echo "k3s cluster ($LIMA_INSTANCE) deleted."
fi
