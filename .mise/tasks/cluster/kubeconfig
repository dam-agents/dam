#!/usr/bin/env bash
#MISE description="Print the KUBECONFIG path for the cluster. Usage: export KUBECONFIG=\"$(mise run cluster:kubeconfig)\""
#MISE quiet=true
if [ -n "${IS_SANDBOX:-}" ]; then
  echo "/etc/rancher/k3s/k3s.yaml"
else
  echo "${LIMA_HOME:-$HOME/.lima}/platform-k3s/copied-from-guest/kubeconfig.yaml"
fi
