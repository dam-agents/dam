#!/usr/bin/env bash
#MISE description="Create k3s cluster, build images, install cert-manager + Platform chart. With --set=virtualization.enabled=true the k3s VM gets nested virtualization (Apple silicon M3+) so the chart's VM runner pod can run vm-backend agents as microVMs. Honors LIMA_INSTANCE; SKIP_IMAGE_BUILD reuses the image tars already in dist/oci, SKIP_IMAGE_LOAD also skips importing them."
#MISE raw=true
#USAGE flag "--lima-template <path>" default="etc/lima/k3s.yaml"
#USAGE flag "--helm-values <path>"
#USAGE flag "--set <key=val>" var=#true
#USAGE flag "--no-restart"
#
# When IS_SANDBOX is set, it is assumed we are already _inside_ a VM.
#
# Both install and upgrade share the same flow:
#   ensure VM/k3s → cert-manager → build images → load into k3s → helm install/upgrade
#
# install: provisions VM/k3s if needed, uses helm install
# upgrade: assumes VM/k3s exists, uses helm upgrade
set -eo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

if [ -z "${SKIP_IMAGE_BUILD:-}" ]; then
  mise run //packages/controller:oci ::: //packages/api-server:oci ::: //packages/ui:oci ::: //packages/keycloak-theme:oci
fi

LIMA_TEMPLATE="$usage_lima_template"
HELM_VALUES="${usage_helm_values:-}"
eval "sets=(${usage_set:-})"
HELM_EXTRA_ARGS=()
for kv in ${sets[@]+"${sets[@]}"}; do HELM_EXTRA_ARGS+=("--set=$kv"); done
NO_RESTART="${usage_no_restart:-false}"
DEV_VALUES="helm/values-dev.yaml"

# Resolve the optional personal overlay (values-dev.yaml, gitignored) up front so
# the agent render in step 3 sees the same values the install uses. Committed dev
# defaults (terms.*, keycloak admin) live in values-local.yaml.
if [ -z "$HELM_VALUES" ] && [ -f "$DEV_VALUES" ]; then
  HELM_VALUES="$DEV_VALUES"
  echo "Using dev overrides: $DEV_VALUES"
fi
# Value flags that can flip an agentTemplate's `enabled`.
AGENT_VALUE_FLAGS=()
[ -n "$HELM_VALUES" ] && AGENT_VALUE_FLAGS+=(-f "$HELM_VALUES")
AGENT_VALUE_FLAGS+=("${HELM_EXTRA_ARGS[@]}")

# virtualization.enabled drives extra provisioning below (nested virt on the
# k3s VM, the vm image archive loaded onto the VM runner pod) — resolve it
# from the values file + --set flags (chart default is false) so one flag
# configures the whole stack.
VIRT_ENABLED=""
if [ -n "$HELM_VALUES" ] && [ "$(yq '.virtualization.enabled // false' "$HELM_VALUES")" = "true" ]; then
  VIRT_ENABLED=1
fi
for arg in "${HELM_EXTRA_ARGS[@]}"; do
  case "$arg" in
    --set=virtualization.enabled=true) VIRT_ENABLED=1 ;;
    --set=virtualization.enabled=false) VIRT_ENABLED="" ;;
  esac
done
# Probe by opening: the node can exist while the device cgroup still denies it.
if [ -n "$VIRT_ENABLED" ] && [ -n "${IS_SANDBOX:-}" ] && ! python3 -c 'import os; os.close(os.open("/dev/kvm", os.O_RDWR))' 2>/dev/null; then
  echo "FATAL: virtualization.enabled=true needs a usable /dev/kvm on this host (the VM runner pod runs microVMs on it)." >&2
  exit 1
fi

# 1. Provision cluster and set KUBECONFIG
if [ -n "${IS_SANDBOX:-}" ]; then
  # A running systemd, not an installed systemctl: containers often ship the
  # binary with something else as PID 1, and the k3s installer then fails
  # to enable a unit nothing will ever start.
  if [ -d /run/systemd/system ] || [ -x /sbin/openrc-run ]; then
    # Keyed on the kubeconfig, which k3s writes only once it is actually
    # serving — not on /var/lib/rancher/k3s, which the provision scripts create
    # early. An install interrupted mid-provision leaves that directory behind,
    # and skipping on it wedged every later run: no k3s, no service, and a
    # 120s wait ending in a misleading "stat k3s.yaml: no such file". The
    # provision scripts are idempotent, so re-running over a partial state heals
    # it.
    if [ ! -f "$KUBECONFIG" ]; then
      echo "Provisioning k3s on host (sandbox mode)..."
      "$MISE_CONFIG_ROOT/.mise/tasks/cluster/provision-host" "$LIMA_TEMPLATE"
    fi
  elif ! pgrep -x k3s-server >/dev/null; then
    # With no supervisor nothing restarts k3s, so a kubeconfig left by an
    # earlier run says nothing about whether it is serving: key on the process.
    echo "Starting k3s as a plain process (no supervisor to install it under)..."
    # Same pinned version as the provision script, so a plain process runs
    # the k3s the VM would; checksum-verified against the release's list.
    if ! command -v k3s >/dev/null 2>&1; then
      K3S_VERSION=$(yq '.provision[].script' "$LIMA_TEMPLATE" | sed -n 's/.*INSTALL_K3S_VERSION="\([^"]*\)".*/\1/p' | head -1)
      case "$(uname -m)" in
        x86_64) K3S_ASSET=k3s K3S_SUMS=sha256sum-amd64.txt ;;
        aarch64|arm64) K3S_ASSET=k3s-arm64 K3S_SUMS=sha256sum-arm64.txt ;;
        *) echo "FATAL: no k3s release asset for $(uname -m)" >&2; exit 1 ;;
      esac
      echo "Installing k3s $K3S_VERSION..."
      K3S_URL="https://github.com/k3s-io/k3s/releases/download/${K3S_VERSION/+/%2B}"
      K3S_TMP=$(mktemp -d)
      curl -fsSL --retry 3 --retry-all-errors -o "$K3S_TMP/$K3S_ASSET" "$K3S_URL/$K3S_ASSET"
      curl -fsSL --retry 3 --retry-all-errors -o "$K3S_TMP/sums" "$K3S_URL/$K3S_SUMS"
      (cd "$K3S_TMP" && grep " $K3S_ASSET\$" sums | sha256sum -c --quiet -)
      sudo install -m 0755 "$K3S_TMP/$K3S_ASSET" /usr/local/bin/k3s
      rm -rf "$K3S_TMP"
      for tool in kubectl crictl ctr; do
        command -v "$tool" >/dev/null 2>&1 || sudo ln -sf /usr/local/bin/k3s "/usr/local/bin/$tool"
      done
    fi
    # istio-cni mounts the netns directory with mount propagation, which a
    # private root refuses. systemd makes / shared at boot; with no systemd,
    # nothing has.
    case "$(findmnt -no PROPAGATION /)" in
      *shared*) ;;
      *) sudo mount --make-rshared / ;;
    esac
    # k3s exempts the pod and service ranges from the proxy, not the node's
    # own address; behind a proxy the API server's calls to the kubelet
    # (logs, exec, port-forward) would go out through it and fail.
    if [ -n "${HTTPS_PROXY:-${https_proxy:-}}" ]; then
      NODE_IPS=$(hostname -I 2>/dev/null | xargs | tr ' ' ',')
      export NO_PROXY="${NO_PROXY:+$NO_PROXY,}$NODE_IPS" no_proxy="${no_proxy:+$no_proxy,}$NODE_IPS"
    fi
    # K3S_LAUNCHER prefixes the command on hosts where k3s needs a wrapper to
    # run at all (see the ccweb skill). Unquoted on purpose: it may carry args.
    setsid ${K3S_LAUNCHER:-} k3s server --write-kubeconfig-mode 644 --https-listen-port 16443 \
      >>"${K3S_LOG:-$HOME/.k3s.log}" 2>&1 &
  fi
  echo "Waiting for k3s to be ready..."
  for _ in $(seq 1 60); do [ -f "$KUBECONFIG" ] && break; sleep 2; done
  for _ in $(seq 1 60); do kubectl --kubeconfig="$KUBECONFIG" get nodes -o name 2>/dev/null | grep -q . && break; sleep 2; done
else
  if ! limactl list -q 2>/dev/null | grep -qx "$LIMA_INSTANCE"; then
    echo "Creating k3s VM ($LIMA_INSTANCE)..."
    # Nested virtualization exposes /dev/kvm inside the VM, which the sandbox
    # node pod needs to run vm-backend agents as microVMs (macOS: vz on
    # M3+/macOS 15). Enabled automatically with virtualization.enabled=true;
    # PLATFORM_NESTED_VIRT=1 forces it for a plain install. Create-time only —
    # an existing VM needs cluster:delete + reinstall to gain it.
    if [ -n "${PLATFORM_NESTED_VIRT:-}" ] || [ -n "$VIRT_ENABLED" ]; then
      limactl create --name="$LIMA_INSTANCE" "$LIMA_TEMPLATE" --tty=false \
        --set '.vmType = "vz" | .nestedVirtualization = true'
    else
      limactl create --name="$LIMA_INSTANCE" "$LIMA_TEMPLATE" --tty=false
    fi
  fi
  STATUS=$(limactl list --json | python3 -c "import sys,json; [print(json.loads(l)['status']) for l in sys.stdin if json.loads(l)['name']=='$LIMA_INSTANCE']" 2>/dev/null || echo "Stopped")
  if [ "$STATUS" != "Running" ]; then
    echo "Starting k3s VM..."
    limactl start "$LIMA_INSTANCE"
  fi
  # Pre-existing VM without nested virt (create-time only): the VM runner
  # pod would have no /dev/kvm — stop early with the fix.
  if [ -n "$VIRT_ENABLED" ] && ! limactl shell "$LIMA_INSTANCE" test -e /dev/kvm; then
    echo "FATAL: VM '$LIMA_INSTANCE' has no /dev/kvm; the VM runner needs it." >&2
    echo "Recreate it: mise run cluster:delete, then rerun this install with virtualization.enabled=true" >&2
    echo "(nested virtualization needs Apple silicon M3+ on macOS 15+)." >&2
    exit 1
  fi
  echo "Waiting for k3s to be ready..."
  for _ in $(seq 1 60); do kubectl --kubeconfig="$KUBECONFIG" get nodes -o name 2>/dev/null | grep -q . && break; sleep 2; done
fi
# k3s writes kubeconfig before the node registers; the for-loop above
# ensures ≥1 node exists, otherwise `kubectl wait --all` would error
# immediately with "no matching resources found".
kubectl --kubeconfig="$KUBECONFIG" wait --for=condition=Ready node --all --timeout=120s

# 1b. Ensure k3s container-log rotation is configured (issue #244 upgrade
# path for VMs created before this flag was added). New VMs already have
# /etc/rancher/k3s/config.yaml from the lima provision script.
# A config.yaml.d drop-in, never config.yaml itself: k3s merges the
# directory natively, and overwriting the main file clobbers pre-existing
# config — inside a VM sandbox it carries the CIDR remap that keeps the
# inner cluster off the host cluster's ranges, and losing it crash-loops
# k3s ("cidr ... is out the range of cluster cidr").
K3S_LOGROT_DROPIN=/etc/rancher/k3s/config.yaml.d/50-container-log-rotation.yaml
K3S_CONFIG_YAML='kubelet-arg:
  - "container-log-max-size=10Mi"
  - "container-log-max-files=3"
'
if [ -n "${IS_SANDBOX:-}" ]; then
  if ! sudo grep -q container-log-max-size "$K3S_LOGROT_DROPIN" /etc/rancher/k3s/config.yaml 2>/dev/null; then
    echo "Configuring k3s container log rotation (issue #244)..."
    sudo mkdir -p "$(dirname "$K3S_LOGROT_DROPIN")"
    printf '%s' "$K3S_CONFIG_YAML" | sudo tee "$K3S_LOGROT_DROPIN" >/dev/null
    if [ -d /run/systemd/system ]; then
      sudo systemctl restart k3s
      kubectl --kubeconfig="$KUBECONFIG" wait --for=condition=Ready node --all --timeout=120s
    else
      echo "No service manager here — container log rotation applies the next time k3s starts."
    fi
  fi
else
  if ! limactl shell "$LIMA_INSTANCE" sudo grep -q container-log-max-size "$K3S_LOGROT_DROPIN" /etc/rancher/k3s/config.yaml 2>/dev/null; then
    echo "Configuring k3s container log rotation (issue #244)..."
    limactl shell "$LIMA_INSTANCE" sudo mkdir -p "$(dirname "$K3S_LOGROT_DROPIN")"
    printf '%s' "$K3S_CONFIG_YAML" | limactl shell "$LIMA_INSTANCE" sudo tee "$K3S_LOGROT_DROPIN" >/dev/null
    limactl shell "$LIMA_INSTANCE" sudo systemctl restart k3s
    kubectl --kubeconfig="$KUBECONFIG" wait --for=condition=Ready node --all --timeout=120s
  fi
fi

# 1c. Pull every third-party image the rest of the install runs, side by side,
# while the steps below wait on other things. Otherwise the kubelet pulls each
# only once its chart is applied: the Istio charts install one after another,
# each waiting for its pods, and Keycloak waits on Postgres. The chart's
# dependencies are resolved into charts/ (gitignored) here, first: rendering
# needs them even with clickstack.enabled=false, and the build refreshes both
# repositories. Best effort: the kubelet still pulls whatever this misses.
ISTIO_VERSION="1.31.0"
# Istio publishes its charts here from 1.31 on; the GCS bucket stops at 1.30
# and is being retired. --force-update repoints an `istio` repo a machine
# already has registered at the old URL.
helm repo add --force-update istio https://blob.istio.io/istio-release/charts >/dev/null 2>&1 || true
helm repo add clickstack https://clickhouse.github.io/ClickStack-helm-charts >/dev/null 2>&1 || true
helm dependency build helm
prepull_images() {
  local images
  images=$(
    {
      helm template istiod istio/istiod --version "$ISTIO_VERSION" --set profile=ambient
      helm template istio-cni istio/cni --version "$ISTIO_VERSION" --set profile=ambient
      helm template ztunnel istio/ztunnel --version "$ISTIO_VERSION"
      helm template platform helm -f helm/values-local.yaml "${AGENT_VALUE_FLAGS[@]}"
    } | yq -r '.. | select(tag == "!!map" and has("image")) | .image | select(tag == "!!str")' |
      grep -v '^---$' | grep -vE '(^|/)platform-' | sort -u
  ) || return 0
  # istiod injects the waypoint's proxy at run time, from beside its own image.
  images+=$'\n'$(printf '%s\n' "$images" | sed -n 's|/pilot:|/proxyv2:|p' | head -n1)
  printf '%s\n' "$images" | grep . | xargs -P 6 -I{} bash -c 'pull_one "$1"' _ {}
}
pull_one() {
  local start=$SECONDS cmd=(timeout 300 k3s crictl pull "$1")
  if [ -n "${IS_SANDBOX:-}" ]; then cmd=(sudo "${cmd[@]}"); else cmd=(limactl shell "$LIMA_INSTANCE" sudo "${cmd[@]}"); fi
  if "${cmd[@]}" >/dev/null 2>&1; then
    echo "pulled $1 in $((SECONDS - start))s"
  else
    echo "could not pull $1; the kubelet will"
  fi
}
export -f pull_one
prepull_images > >(sed -u 's/^/[prepull] /') 2>&1 &
PREPULL_PID=$!

# 1d. Load images into k3s (built at the top, or out-of-band in CI).
# SKIP_IMAGE_LOAD skips the containerd import — cluster:helm reuses the SHAs
# already loaded, so pods keep their pinned images. SKIP_IMAGE_BUILD alone (CI)
# does NOT skip the load: e2e:ci-images wrote the tars out-of-band, and they
# still have to be imported into k3s's containerd.
if [ -n "${SKIP_IMAGE_LOAD:-}" ]; then
  echo "Skipping image load (SKIP_IMAGE_LOAD set)"
  NO_RESTART=true
else
  # Build (and below, load) only the templates enabled in the effective rendered
  # values (--set/--helm-values honored). Capture first so a failed render aborts
  # rather than silently building none. Templates are one ConfigMap keyed by
  # "<name>.yaml"; emit "<name>.yaml\t<image>" per data entry. Enabled built-in
  # kits whose image is a local `platform-*` tag join the list as "kit:<id>"; a
  # kit on a published image is left for the node to pull.
  RENDERED=$(helm template platform helm \
      -f helm/values-local.yaml "${AGENT_VALUE_FLAGS[@]}")
  AGENTS_RENDERED=$(printf '%s\n' "$RENDERED" \
    | yq -r 'select(.kind == "ConfigMap") | select(.metadata.name | test("-harness-templates$"))
             | .data | to_entries | .[] | .key + "\t" + (.value | from_yaml | .image)')
  KITS_RENDERED=$(printf '%s\n' "$RENDERED" \
    | yq -r 'select(.kind == "ConfigMap") | select(.metadata.name | test("-starter-kits$"))
             | .data | to_entries | .[] | select(.key | test("__kit.yaml$")) | .value | from_yaml
             | select(.image != null) | select(.image.ref | test("^platform-")) | "kit:" + .id + "\t" + .image.ref')
  AGENT_TASKS=()
  VM_IMAGES=()
  SEEN_COMPONENTS=()
  while IFS=$'\t' read -r name image; do
    { [ -z "$name" ] || [ "$name" = "---" ]; } && continue
    name="${name%.yaml}" # data keys are "<name>.yaml" (single CM)
    # Templates can share one image (presets, e.g. adaevolve/evox over the
    # skydiscover image, or k-search-local over k-search), so resolve the
    # build component from the image repository basename
    # ("platform-<component>" locally), not the template key — and dedup so
    # a shared image builds and loads once.
    comp="${image##*/}"; comp="${comp%%:*}"; comp="${comp#platform-}"
    # The backend is chosen per agent at create, not declared by a template, so
    # any agent image may be asked to boot as a microVM — every one of them,
    # e2e fixtures included, is staged for the VM runners when the install
    # supports them, once per image.
    if [ -n "${VIRT_ENABLED:-}" ] && { [ -d "packages/agents/$comp" ] || [ -d "packages/e2e/agents/$comp" ]; }; then
      case " ${VM_IMAGES[*]:-} " in *" $image "*) ;; *) VM_IMAGES+=("$image") ;; esac
    fi
    case " ${SEEN_COMPONENTS[*]:-} " in *" $comp "*) continue ;; esac
    SEEN_COMPONENTS+=("$comp")
    if [ -d "packages/agents/$comp" ] || [ -d "packages/e2e/agents/$comp" ]; then
      AGENT_TASKS+=("$comp")
    else
      echo "WARN: no build task for '$name' ($image) — skipping" >&2
    fi
  done <<< "$AGENTS_RENDERED"$'\n'"$KITS_RENDERED"
  [ -z "${SKIP_IMAGE_BUILD:-}" ] && [ -n "${AGENT_TASKS[*]}" ] && mise run //packages/agents:oci -- "${AGENT_TASKS[@]}"
  # Like the agents', off Linux its build runs in the VM, so it waits for one.
  [ -z "${SKIP_IMAGE_BUILD:-}" ] && [ -n "$VIRT_ENABLED" ] && mise run //packages/vm-runner:oci

  COMPONENTS=(controller api-server ui keycloak)
  [ -n "$VIRT_ENABLED" ] && COMPONENTS+=(vm-runner)
  # CI brings the cluster up while this run's images are still building, and
  # e2e:ci-images pulls them in the background. Each batch it has finished is
  # imported while the rest are still on their way, so only the last to land
  # is imported after the wait.
  load_images() {
    local c remaining=("$@") left tars=()
    if [ -n "${CI_IMAGES_STATUS:-}" ]; then
      echo "Waiting for this run's images (e2e:ci-images): ${remaining[*]}"
      while [ ${#remaining[@]} -gt 0 ]; do
        left=() tars=()
        for c in "${remaining[@]}"; do
          if [ -e "$CI_IMAGES_STATUS.ready/$c" ]; then
            tars+=("$(.mise/tasks/image/resolve tar-path "$c")")
          else
            left+=("$c")
          fi
        done
        if [ ${#tars[@]} -gt 0 ]; then
          echo "Loading into k3s: ${tars[*]}"
          mise run cluster:import -- "${tars[@]}" || return 1
        fi
        tars=()
        remaining=(${left[@]+"${left[@]}"})
        if [ ${#remaining[@]} -gt 0 ] && [ -s "$CI_IMAGES_STATUS" ]; then
          [ "$(cat "$CI_IMAGES_STATUS")" = ok ] || { echo "FATAL: fetching this run's images failed; see the e2e job's image fetch log" >&2; return 1; }
          break
        fi
        [ ${#remaining[@]} -eq 0 ] || sleep 2
      done
    fi
    [ ${#remaining[@]} -gt 0 ] || return 0
    echo "Loading images into k3s: ${remaining[*]}"
    for c in "${remaining[@]}"; do tars+=("$(.mise/tasks/image/resolve tar-path "$c")"); done
    mise run cluster:import -- "${tars[@]}" || return 1
  }
  # Both loads run beside the mesh install below, which spends most of its time
  # waiting, and the chart install waits only for the platform images: no pod
  # the chart starts runs an agent image. The agent images load after the
  # platform images, not beside them: the mock's is the largest image the e2e
  # cluster loads, and its import took 32s alone but 71s beside the others,
  # then still ran into Keycloak's first boot and slowed that down.
  PLATFORM_IMAGES_LOADED=$(mktemp)
  {
    rc=0
    load_images "${COMPONENTS[@]}" || rc=$?
    echo "$rc" > "$PLATFORM_IMAGES_LOADED"
    exit "$rc"
  } > >(sed -u 's/^/[images] /') 2>&1 &
  IMAGE_LOAD_PID=$!
  if [ ${#AGENT_TASKS[@]} -gt 0 ]; then
    {
      until [ -s "$PLATFORM_IMAGES_LOADED" ]; do sleep 1; done
      load_images "${AGENT_TASKS[@]}"
    } > >(sed -u 's/^/[agent images] /') 2>&1 &
    AGENT_LOAD_PID=$!
  fi
fi

# 1e. Traefik app entrypoint — on lima this rides the provision script's
# k3s server manifest, but a pre-existing k3s (VM sandbox) never runs that,
# so the app port silently doesn't exist. HelmChartConfig via kubectl apply
# is idempotent and works on both. The port follows `--set=port=…` so the
# ingress listens where the chart's URLs point (dev defaults to 4444, the
# e2e install passes 5555); the last install wins.
APP_PORT=4444
if [ -n "$HELM_VALUES" ]; then
  APP_PORT="$(yq '.port // 4444' "$HELM_VALUES")"
fi
for arg in "${HELM_EXTRA_ARGS[@]}"; do
  case "$arg" in
    --set=port=*) APP_PORT="${arg#--set=port=}" ;;
  esac
done
kubectl --kubeconfig="$KUBECONFIG" apply -f - <<YAML
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: traefik
  namespace: kube-system
spec:
  valuesContent: |
    ports:
      platform:
        port: $APP_PORT
        expose:
          default: true
        exposedPort: $APP_PORT
        protocol: TCP
YAML

# 2. Install cert-manager, beside the Istio install below: neither needs the
# other, and each spends most of its time waiting for its pods. Its output is
# prefixed, and the Istio block ends by waiting for it.
CERT_MANAGER_VERSION="v1.21.2"

install_cert_manager() {
  if ! kubectl --kubeconfig="$KUBECONFIG" get ns cert-manager >/dev/null 2>&1; then
    echo "Installing cert-manager ($CERT_MANAGER_VERSION)..."
    # Retried: freshly-provisioned k3s can restart its apiserver right after
    # reporting Ready (seen as ECONNREFUSED mid-apply on CI runners).
    for attempt in 1 2 3 4 5; do
      kubectl --kubeconfig="$KUBECONFIG" apply -f https://github.com/cert-manager/cert-manager/releases/download/$CERT_MANAGER_VERSION/cert-manager.yaml && break
      [ "$attempt" = 5 ] && return 1
      echo "cert-manager apply failed (attempt $attempt); retrying in 10s..."
      sleep 10
    done
    echo "Waiting for cert-manager to be ready..."
    kubectl --kubeconfig="$KUBECONFIG" -n cert-manager wait --for=condition=Available deployment --all --timeout=120s
  else
    echo "cert-manager already installed"
  fi
}
install_cert_manager > >(sed -u 's/^/[cert-manager] /') 2>&1 &
CERT_MANAGER_PID=$!

# 2b. Install Istio ambient + Gateway-API CRDs (required).
# Pinned: Gateway API v1.2.0 stable channel (introduced Gateway/HTTPRoute v1
# and the gatewayClassName: istio-waypoint shape). Istio 1.29.x is the
# floor for ambient L7 with locked-down waypoint HCM; the Kubernetes 1.36
# that k3s runs needs Istio 1.30 or later.
GATEWAY_API_VERSION="v1.2.0"

if ! kubectl --kubeconfig="$KUBECONFIG" get crd gateways.gateway.networking.k8s.io >/dev/null 2>&1; then
  echo "Installing Gateway API CRDs ($GATEWAY_API_VERSION)..."
  kubectl --kubeconfig="$KUBECONFIG" apply -f "https://github.com/kubernetes-sigs/gateway-api/releases/download/$GATEWAY_API_VERSION/standard-install.yaml"
else
  echo "Gateway API CRDs already installed"
fi

# k3s bundles Traefik (chart v39+), whose `traefik-crd` chart also ships the
# Gateway API CRDs. We install those out-of-band above (for Istio) via plain
# `kubectl apply`, so they carry no Helm ownership metadata — and the
# `traefik-crd` Helm job then dies with "invalid ownership metadata" and
# Traefik never installs, leaving nothing on the ingress port. Stamp the
# ownership the `traefik-crd` release expects so it adopts them on its next
# reconcile. Idempotent, and covers both install orders (whichever of the k3s
# Traefik bootstrap vs. this CRD apply wins the race).
echo "Stamping Helm ownership on Gateway API CRDs (so k3s traefik-crd can adopt them)..."
# One call each for every CRD: kubectl still stamps the rest when one is
# missing.
GATEWAY_CRDS=()
for crd in gatewayclasses gateways grpcroutes httproutes referencegrants; do
  GATEWAY_CRDS+=("$crd.gateway.networking.k8s.io")
done
kubectl --kubeconfig="$KUBECONFIG" label crd "${GATEWAY_CRDS[@]}" \
  app.kubernetes.io/managed-by=Helm --overwrite >/dev/null 2>&1 || true
kubectl --kubeconfig="$KUBECONFIG" annotate crd "${GATEWAY_CRDS[@]}" \
  meta.helm.sh/release-name=traefik-crd meta.helm.sh/release-namespace=kube-system \
  --overwrite >/dev/null 2>&1 || true

echo "Ensuring Istio ambient mesh ($ISTIO_VERSION)..."
# Install-only path. Avoids helm upgrade conflicts with istiod, which
# patches `istiod-default-validator` ValidatingWebhookConfiguration's
# `failurePolicy` after start; a subsequent `helm upgrade istio-base`
# fails server-side apply because pilot-discovery owns that field.
# This task is the dev install loop, not the prod upgrade path; in-place
# Istio upgrades are an out-of-band operation when needed.
istio_install_if_missing() {
  local release="$1" chart="$2"
  shift 2
  if helm --kubeconfig="$KUBECONFIG" -n istio-system status "$release" >/dev/null 2>&1; then
    echo "  $release already installed, skipping"
    return 0
  fi
  helm --kubeconfig="$KUBECONFIG" install "$release" "$chart" \
    -n istio-system --version "$ISTIO_VERSION" --create-namespace --wait "$@"
}

istio_install_if_missing istio-base istio/base
# Pin workload SVID TTL to 30d (issue #283). The default 24h races
# against lima VM suspend/resume on a sleeping host laptop — when the
# rotation window slips past expiry, every mesh hop dies until ztunnel
# is bounced. Bumping the TTL well past a typical dev-cluster lifetime
# (and well under Istio's 90d MAX_WORKLOAD_CERT_TTL default) takes the
# rotation race off the critical path for normal dev work; the
# ztunnel-cert-watchdog CronJob below covers the residual.
#
# istiod, istio-cni and ztunnel install side by side once istio-base has
# created the namespace and CRDs. Each install's --wait is what took the time,
# and nothing in one chart needs another installed first: ztunnel's pods keep
# retrying istiod until it serves, and its wait covers that.
istio_install_if_missing istiod istio/istiod \
  --set profile=ambient \
  --set pilot.env.DEFAULT_WORKLOAD_CERT_TTL=720h > >(sed -u 's/^/[istiod] /') 2>&1 &
ISTIOD_PID=$!
# A node kernel without IPv6 (no /proc/net/if_inet6 — some container
# sandboxes) fails ztunnel's dual-stack bind with EAFNOSUPPORT, so it
# crash-loops; install the dataplane IPv4-only there. Probed on the node,
# never on a lima host (macOS has no /proc at all).
if [ -n "${IS_SANDBOX:-}" ]; then
  NODE_IPV6_PROBE=(test -e /proc/net/if_inet6)
else
  NODE_IPV6_PROBE=(limactl shell "$LIMA_INSTANCE" test -e /proc/net/if_inet6)
fi
ISTIO_CNI_IPV4_ONLY=()
ZTUNNEL_IPV4_ONLY=()
if ! "${NODE_IPV6_PROBE[@]}"; then
  echo "  node kernel has no IPv6 — installing the mesh dataplane IPv4-only"
  ISTIO_CNI_IPV4_ONLY=(--set ambient.ipv6=false)
  ZTUNNEL_IPV4_ONLY=(--set env.IPV6_ENABLED=false)
fi
# k3s places CNI dirs at non-upstream paths (/var/lib/rancher/k3s/...).
# Without these overrides istio-cni-node loops "no networks found in
# /host/etc/cni/net.d" and ambient redirection never engages.
istio_install_if_missing istio-cni istio/cni \
  --set profile=ambient \
  --set cni.cniBinDir=/var/lib/rancher/k3s/data/cni \
  --set cni.cniConfDir=/var/lib/rancher/k3s/agent/etc/cni/net.d \
  ${ISTIO_CNI_IPV4_ONLY[@]+"${ISTIO_CNI_IPV4_ONLY[@]}"} > >(sed -u 's/^/[istio-cni] /') 2>&1 &
ISTIO_CNI_PID=$!
# ztunnel proxies every mesh hop, including the experiment SDK's status polls
# from a driver to the api-server harness. Its chart default requests only
# 200m, so a bursting agent pod (a nous worker boots with a large upstream
# fetch and many concurrent dials) can outbid it on this single-node VM;
# starved, ztunnel terminates in-flight connections and the client sees a
# synthesized 503 with no retry anywhere in the path. Guarantee it a core.
istio_install_if_missing ztunnel istio/ztunnel \
  --set resources.requests.cpu=1 \
  --set resources.requests.memory=512Mi \
  ${ZTUNNEL_IPV4_ONLY[@]+"${ZTUNNEL_IPV4_ONLY[@]}"}
wait "$ISTIOD_PID" || { echo "FATAL: istiod install failed" >&2; exit 1; }
wait "$ISTIO_CNI_PID" || { echo "FATAL: istio-cni install failed" >&2; exit 1; }
kubectl --kubeconfig="$KUBECONFIG" -n istio-system rollout status ds/ztunnel --timeout=120s
kubectl --kubeconfig="$KUBECONFIG" -n istio-system rollout status ds/istio-cni-node --timeout=120s
wait "$CERT_MANAGER_PID" || { echo "FATAL: cert-manager install failed" >&2; exit 1; }

# Watchdog: every 10 min, scan ztunnel pod logs for the expired-SVID
# markers (issue #283) and, if any are present, roll ds/ztunnel plus all
# istiod-synthesised waypoint deployments — waypoints hold their own
# SVIDs, and ztunnel logs the failed HBONE dial when a waypoint's cert
# is the expired one (issue #705). Belt-and-suspenders against any
# rotation failure that slips past the 30d DEFAULT_WORKLOAD_CERT_TTL
# pinned on istiod above (e.g. a cluster left running past TTL, an
# upstream istio bug). Apply is idempotent on re-runs of cluster:install.
kubectl --kubeconfig="$KUBECONFIG" apply -f - <<'YAML'
apiVersion: v1
kind: ServiceAccount
metadata:
  name: ztunnel-cert-watchdog
  namespace: istio-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: Role
metadata:
  name: ztunnel-cert-watchdog
  namespace: istio-system
rules:
  - apiGroups: [""]
    resources: ["pods"]
    verbs: ["get", "list"]
  - apiGroups: [""]
    resources: ["pods/log"]
    verbs: ["get"]
  - apiGroups: ["apps"]
    resources: ["daemonsets"]
    # list+watch needed by `rollout status` (it watches the ds);
    # patch is what `rollout restart` does (pod-template annotation).
    verbs: ["get", "list", "watch", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: RoleBinding
metadata:
  name: ztunnel-cert-watchdog
  namespace: istio-system
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: Role
  name: ztunnel-cert-watchdog
subjects:
  - kind: ServiceAccount
    name: ztunnel-cert-watchdog
    namespace: istio-system
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: ztunnel-cert-watchdog-waypoints
rules:
  # Cluster-scoped: waypoint deployments are synthesised wherever an
  # istio-waypoint Gateway lives; discovery is label-based across namespaces.
  - apiGroups: ["apps"]
    resources: ["deployments"]
    verbs: ["get", "list", "watch", "patch"]
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: ztunnel-cert-watchdog-waypoints
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: ztunnel-cert-watchdog-waypoints
subjects:
  - kind: ServiceAccount
    name: ztunnel-cert-watchdog
    namespace: istio-system
---
apiVersion: batch/v1
kind: CronJob
metadata:
  name: ztunnel-cert-watchdog
  namespace: istio-system
spec:
  schedule: "*/10 * * * *"
  concurrencyPolicy: Forbid
  successfulJobsHistoryLimit: 1
  failedJobsHistoryLimit: 1
  jobTemplate:
    spec:
      backoffLimit: 0
      ttlSecondsAfterFinished: 600
      template:
        spec:
          serviceAccountName: ztunnel-cert-watchdog
          restartPolicy: Never
          containers:
            - name: watchdog
              image: mirror.gcr.io/alpine/k8s:1.30.4
              command:
                - sh
                - -c
                - |
                  set -eu
                  TRIGGERED=0
                  for pod in $(kubectl -n istio-system get pods -l app=ztunnel -o name); do
                    if kubectl -n istio-system logs --since=15m "$pod" 2>/dev/null \
                        | grep -qiE 'certificate expired|AlertReceived\(CertificateExpired\)'; then
                      echo "watchdog: $pod reported expired SVID — rolling ztunnel + waypoints"
                      TRIGGERED=1
                      break
                    fi
                  done
                  if [ "$TRIGGERED" = 1 ]; then
                    # The expired cert may be a waypoint's own SVID (ztunnel logs the
                    # failed HBONE dial); istiod labels the deployments it synthesises.
                    WAYPOINTS=$(kubectl get deploy -A -l gateway.istio.io/managed=istio.io-mesh-controller \
                      -o jsonpath='{range .items[*]}{.metadata.namespace}/{.metadata.name}{"\n"}{end}')
                    kubectl -n istio-system rollout restart ds/ztunnel
                    for wp in $WAYPOINTS; do
                      echo "watchdog: rolling waypoint deploy/${wp##*/} (ns ${wp%%/*})"
                      kubectl -n "${wp%%/*}" rollout restart "deploy/${wp##*/}"
                    done
                    kubectl -n istio-system rollout status ds/ztunnel --timeout=120s
                    for wp in $WAYPOINTS; do
                      kubectl -n "${wp%%/*}" rollout status "deploy/${wp##*/}" --timeout=120s
                    done
                  else
                    echo "watchdog: mesh SVIDs healthy"
                  fi
YAML

# Release namespace must be ambient so the api-server pod and the
# Istio-synthesised waypoint Pod participate in mesh mTLS. The helm
# install below targets the `default` namespace; label it now (the
# chart's validate-istio.yaml asserts this label is present).
kubectl --kubeconfig="$KUBECONFIG" label namespace default istio.io/dataplane-mode=ambient --overwrite

# 4. Helm install or upgrade.
if [ -n "${IMAGE_LOAD_PID:-}" ]; then
  wait "$IMAGE_LOAD_PID" || { echo "FATAL: loading the platform images failed" >&2; exit 1; }
fi
echo "Installing/upgrading Platform chart..."
# Helm never upgrades the chart's crds/ on an existing release — on
# this single-env local cluster the freeze has no value, so apply them directly.
# The explicit Established wait keeps the helm install below race-free even if
# the chart ever grows a CR instance (today it deliberately ships none).
kubectl --kubeconfig="$KUBECONFIG" apply --server-side --force-conflicts -f helm/crds/
kubectl --kubeconfig="$KUBECONFIG" wait --for=condition=Established --timeout=60s -f helm/crds/

# ClickStack operators + CRDs — installed out-of-band (Helm won't upgrade crds/), gated on
# CLICKSTACK=1; when set, also enable the clickstack workload below. Operator images from
# the quay.io/dam-agents mirror, registered in .mise/tasks/image/mirror (their db/agent
# images stay upstream). The MongoDB operator
# defaults to watching only its own namespace, so it must be pointed at the release ns
# (default) where the MongoDBCommunity CR lives, or HyperDX hangs waiting on mongodb.
if [ -n "${CLICKSTACK:-}" ]; then
  echo "Installing ClickStack operators (ClickHouse + MongoDB)..."
  helm --kubeconfig="$KUBECONFIG" upgrade --install clickstack-operators clickstack/clickstack-operators \
    --version 1.1.0 --namespace clickstack-operators --create-namespace --wait --timeout 5m \
    --set clickhouse-operator.manager.image.repository=quay.io/dam-agents/clickhouse-operator \
    --set clickhouse-operator.manager.image.tag=v0.0.7 \
    --set mongodb-operator.registry.operator=quay.io/dam-agents \
    --set mongodb-operator.operator.watchNamespace=default
  kubectl --kubeconfig="$KUBECONFIG" wait --for=condition=Established --timeout=120s \
    crd/clickhouseclusters.clickhouse.com \
    crd/keeperclusters.clickhouse.com \
    crd/mongodbcommunity.mongodbcommunity.mongodb.com
  HELM_EXTRA_ARGS+=(--set clickstack.enabled=true)
fi

# No --wait: the keycloak-provision post-install hook imports the platform realm
# after deployments come up. With --wait, helm would block on readiness
# before the hook runs.
# --force-conflicts: Helm v4 applies server-side; field drift on a chart-managed
# object (a stray kubectl patch/rollout, another controller) otherwise hard-fails
# the upgrade with an ownership conflict. The chart is the source of truth here.
helm --kubeconfig="$KUBECONFIG" upgrade --install platform helm -f helm/values-local.yaml --timeout 15m --force-conflicts ${HELM_VALUES:+-f "$HELM_VALUES"} "${HELM_EXTRA_ARGS[@]}"

if [ -n "${AGENT_LOAD_PID:-}" ]; then
  wait "$AGENT_LOAD_PID" || { echo "FATAL: loading the agent images failed" >&2; exit 1; }
fi

# 5. Restart pods to pick up new local images (dev only — :latest tags don't trigger rollout)
if [ "$NO_RESTART" = true ]; then
  echo "Skipping pod restart (--no-restart)"
else
  echo "Restarting pods..."
  kubectl --kubeconfig="$KUBECONFIG" rollout restart deployment platform-controller platform-apiserver platform-ui platform-keycloak
  # Runners are created per owner with a hashed name, so restart them by label.
  # The node image cache DaemonSet runs the same image. Both live in the agent
  # namespace, and either may not exist yet.
  if [ -n "$VIRT_ENABLED" ]; then
    for workload in deployment/vm-runner daemonset/vm-image-cache; do
      selector="app.kubernetes.io/component=${workload#*/}"
      if [ -n "$(kubectl --kubeconfig="$KUBECONFIG" -n platform-agents get "${workload%/*}" -l "$selector" -o name)" ]; then
        kubectl --kubeconfig="$KUBECONFIG" -n platform-agents rollout restart "${workload%/*}" -l "$selector"
      fi
    done
  fi
  # Agent pods are managed by the controller (StatefulSets in platform-agents) and
  # pin :latest too — delete them so they come back on the freshly loaded image.
  kubectl --kubeconfig="$KUBECONFIG" delete pods -n platform-agents --all --ignore-not-found
fi

# 6. Wait for all Platform deployments to become Available (replaces helm --wait,
# but happens AFTER post-install hooks have run, so no deadlock).
echo "Waiting for deployments to be ready..."
kubectl --kubeconfig="$KUBECONFIG" wait --for=condition=Available deployment --all --timeout=10m

# 6b. vm-backend images onto the node, where every VM runner mounts them read
# only: runners are per owner and created on demand, so there is no pod to copy
# into at install time, and no registry for them to pull from. Each image is a
# pre-flattened tree with its launch record, which a machine boots in seconds;
# see image:stage-vm for why not an archive.
for image in ${VM_IMAGES[@]+"${VM_IMAGES[@]}"}; do
  echo "Staging $image for the VM runners..."
  comp="${image##*/}"; comp="${comp%%:*}"
  mise run image:stage-vm -- "$(.mise/tasks/image/resolve tar-path "${comp#platform-}")"
done

# HyperDX's MongoDB driver can wedge if it starts before Mongo/ztunnel are ready (its
# long-lived monitor connection is closed, topology stuck Unknown, and it does not
# self-heal). Once the stack is up and Mongo is ready, a warm restart connects cleanly and
# stays healthy in-mesh — so restart it here. (Prod installs should likewise ensure HyperDX
# (re)starts after Mongo is ready.)
if [ -n "${CLICKSTACK:-}" ] && [ "$NO_RESTART" != true ]; then
  echo "Restarting HyperDX onto a ready MongoDB..."
  kubectl --kubeconfig="$KUBECONFIG" rollout status statefulset/platform-clickstack-mongodb --timeout=5m || true
  kubectl --kubeconfig="$KUBECONFIG" rollout restart deployment platform-clickstack-app
  kubectl --kubeconfig="$KUBECONFIG" rollout status deployment platform-clickstack-app --timeout=5m
fi

# 7. Prune dangling image layers (issue #244). After repeated reinstalls,
# old `:latest` SHAs lose their tag to the freshly imported one and become
# `<none>:<none>`. Drop only those — `crictl rmi --prune` would also wipe
# tagged-but-unpinned images like the agent ones we just loaded (no
# instance pods exist yet to pin them).
echo "Pruning dangling images..."
PRUNE_DANGLING='sudo k3s crictl images 2>/dev/null | sed -nE "s/^<none>[[:space:]]+<none>[[:space:]]+([^[:space:]]+).*/\\1/p" | xargs -r sudo k3s crictl rmi >/dev/null 2>&1 || true'
if [ -n "${IS_SANDBOX:-}" ]; then
  bash -c "$PRUNE_DANGLING"
else
  limactl shell "$LIMA_INSTANCE" bash -c "$PRUNE_DANGLING"
fi

wait "$PREPULL_PID" 2>/dev/null || true

echo ""
echo "=== Cluster ready ==="
echo "KUBECONFIG=$KUBECONFIG"
echo ""
kubectl --kubeconfig="$KUBECONFIG" get pods

# Where the install's wall clock went. `helm --wait` returns only once the
# slowest pod is Ready, so the one number it reports hides which service held
# it — and e2e:run dumps diagnostics on failure only, so on a green run the
# largest single block of the e2e job is unattributed. Measured on CI/CD run
# 35760500482: 105 s inside that wait, with platform-apiserver carrying
# RESTARTS 2, and no way to tell from the log whether the crash-loop or
# Keycloak's realm import was the long pole.
#
# Seconds from pod creation to Ready, slowest first, with restarts and what
# killed the previous container. A pod that crash-looped on the way up reads
# as a large number beside a non-zero restart count and a terminated reason —
# the signature of a startup-ordering race rather than a slow service. The
# apiserver/postgres race in e2e:install is exactly that shape.
#
# python3, not jq: this script already depends on python3 and the repo pins no
# jq. Never fails the install — instrumentation that can break a provision is
# worse than no instrumentation.
echo ""
echo "--- Readiness timeline (pod creation -> Ready) ---"
kubectl --kubeconfig="$KUBECONFIG" get pods -o json 2>/dev/null | python3 -c '
import json, sys
from datetime import datetime

def ts(v):
    return datetime.strptime(v, "%Y-%m-%dT%H:%M:%SZ")

rows = []
for pod in json.load(sys.stdin)["items"]:
    meta, status = pod["metadata"], pod.get("status", {})
    created = ts(meta["creationTimestamp"])
    ready = None
    for cond in status.get("conditions", []):
        if cond["type"] == "Ready" and cond["status"] == "True":
            ready = (ts(cond["lastTransitionTime"]) - created).total_seconds()
    states = status.get("containerStatuses", []) or []
    restarts = sum(c.get("restartCount", 0) for c in states)
    killed = []
    for c in states:
        term = c.get("lastState", {}).get("terminated")
        if term:
            killed.append("%s %s(%s)" % (c["name"], term.get("reason", "?"), term.get("exitCode", "?")))
    rows.append((ready if ready is not None else 1e9, meta["name"], ready, restarts, ", ".join(killed)))

for _, name, ready, restarts, killed in sorted(rows, reverse=True):
    print("  %-44s %9s  restarts=%d%s" % (
        name,
        ("%.0fs" % ready) if ready is not None else "NOT-READY",
        restarts,
        ("  last exit: " + killed) if killed else "",
    ))
' 2>/dev/null || echo "  (readiness timeline unavailable)"

# The pulls the kubelet still made itself, which the pre-pull in step 1c did
# not already finish. An image it found on the node logs nothing here.
echo ""
echo "--- Image pulls left to the kubelet ---"
kubectl --kubeconfig="$KUBECONFIG" get events -A --field-selector reason=Pulled \
    -o jsonpath='{range .items[*]}{.message}{"\n"}{end}' 2>/dev/null |
  sed -n 's/^Successfully pulled image "\([^"]*\)" in \([^ ]*\) .*/  \2  \1/p' || true
