#!/usr/bin/env bash
# The endpoints and credentials a node needs, read back from the cluster.
# `eval "$(mise run cluster:env)"` before installing a node.
#MISE raw=true
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
# In sandbox mode the cluster and the node are the same machine, so the
# kubeconfig is the local one and the endpoints are loopback.
if [ -n "${IS_SANDBOX:-}" ]; then
  export KUBECONFIG=/etc/rancher/k3s/k3s.yaml
  HOST="${DAM_CLUSTER_HOST:-127.0.0.1}"
  # No lima, no forwards: the NodePorts are where k3s binds them.
  DAM_CLUSTER_PORT_OFFSET=0
else
  export KUBECONFIG="${LIMA_HOME:-$HOME/.lima}/${DAM_CLUSTER_VM:-dam-cluster}/copied-from-guest/kubeconfig.yaml"
  # Node VMs are not on the cluster network; they reach it through the lima
  # host, which is the one address every guest can already resolve.
  HOST="${DAM_CLUSTER_HOST:-192.168.5.2}"
fi
NS="${DAM_NAMESPACE:-dam}"
# The host publishes the guest's fixed NodePorts shifted by this, so that a
# second cluster can run beside the first (see cluster:up).
OFF="${DAM_CLUSTER_PORT_OFFSET:-0}"
secret() { kubectl -n "$NS" get secret "$1" -o jsonpath="{.data.$2}" | base64 -d; }
cat <<VARS
export DAM_DATABASE_URL='postgres://platform_apiserver:$(secret dam-platform-postgres-secrets POSTGRES_APISERVER_PASSWORD)@${HOST}:$((30432 + OFF))/platform'
export DAM_REDIS_URL='redis://:$(secret dam-platform-redis-auth password 2>/dev/null || true)@${HOST}:$((30379 + OFF))'
export DAM_KEYCLOAK_URL='http://${HOST}:$((30081 + OFF))'
export DAM_KEYCLOAK_EXTERNAL_URL='http://localhost:$((30081 + OFF))'
export DAM_API_CLIENT_SECRET='$(secret dam-platform-keycloak-secrets PLATFORM_API_CLIENT_SECRET)'
export DAM_OBJECT_STORAGE_ENDPOINT='http://${HOST}:$((30333 + OFF))'
export DAM_OBJECT_STORAGE_ACCESS_KEY_ID='$(secret dam-platform-seaweedfs-secrets accessKeyId)'
export DAM_OBJECT_STORAGE_SECRET_ACCESS_KEY='$(secret dam-platform-seaweedfs-secrets secretAccessKey)'
VARS
