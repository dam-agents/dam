#!/usr/bin/env bash
#MISE description="Build and (re)start the VM runner on this Mac's own hypervisor"
# cluster:install runs vm agents on it here, instead of on a runner pod nested
# inside the k3s VM. It serves every owner from ~/.local/state/platform-vm-
# runner, listening on loopback, where the k3s VM's pods reach it.
# It holds one install's token and CA and listens on one fixed port, so it is
# one per Mac: the default install's.
set -euo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"
. "$MISE_CONFIG_ROOT/.mise/lib/host-runner.sh"
if [ -n "$CLUSTER_INSTALL" ]; then
  echo "FATAL: the host runner is one per Mac and belongs to the default install (it holds its token, CA and port)." >&2
  echo "Install '$CLUSTER_INSTALL' runs its agents on runner pods, which need /dev/kvm on the cluster's node." >&2
  exit 1
fi
R="$HOST_RUNNER_DIR"
pkg="$MISE_CONFIG_ROOT/packages/vm-runner"
mkdir -p "$R" "$HOST_RUNNER_VM_HOME"

mise run //packages/vm-runner:host
install -m 755 "$pkg/dist/host/vm-runner" "$R/vm-runner.new"

# The smolvm release the binary was built against, for what the VMM loads at
# run time: libkrun, the guest agent's root filesystem and the disk templates.
# The binary's loader path names this directory, so it must stay here, beside
# the runner (//packages/vm-runner:host builds it in).
tag="$(sed -n 's/^tag=//p' "$pkg/smolvm.pin")"
sha="$(sed -n 's/^sha256-darwin-arm64=//p' "$pkg/smolvm.pin")"
release="$R/smolvm-$tag"
if [ ! -x "$release/smolvm-bin" ]; then
  tarball="$R/smolvm-$tag.tar.gz"
  curl -fsSL -o "$tarball" "https://github.com/smol-machines/smolvm/releases/download/$tag/smolvm-${tag#v}-darwin-arm64.tar.gz"
  echo "$sha  $tarball" | shasum -a 256 -c --quiet -
  rm -rf "$release" "$release.new" && mkdir "$release.new"
  tar -xzf "$tarball" -C "$release.new" --strip-components=1
  rm "$tarball"
  mv "$release.new" "$release"
fi
# platform-init and platform-runc run inside the guest, so they are the static
# Linux binaries from the runner image, not anything built for this Mac, as is
# the btrfs disk template. The image is rebuilt when its sources changed, unless
# the caller just ran that build (SKIP_IMAGE_BUILD), so they match the runner
# built above.
# The guest kernel is the runner image's too: libkrunfw rebuilt with
# libkrunfw.patch, which adds btrfs and zram. The image build leaves that arm64
# kernel, wrapped for macOS, in the build VM's cache (see oci), which the
# task's skip cannot see: a recreated VM has none, and the caller's build was
# a skip. So when this Mac needs the kernel and the VM lacks it, the build is
# forced, whatever the caller did.
. "$MISE_CONFIG_ROOT/.mise/lib/lima-build.sh"
image="$pkg/dist/oci/vm-runner.tar"
fw_id="$(sed -n 's/^libkrunfw-commit=//p' "$pkg/smolvm.pin")-$(git -C "$pkg" hash-object libkrunfw.patch)"
fw_c=".cache/platform-vm-runner/libkrunfw-$fw_id-darwin.c"
vm_sh() { limactl shell --workdir / "$LIMA_BUILD_VM" sh -c "$@"; }
need_kernel=false
[ "$(cat "$release/lib/libkrunfw.id" 2>/dev/null)" = "$fw_id" ] || need_kernel=true
force=()
if $need_kernel && ! vm_sh 'test -f ~/"$1"' _ "$fw_c"; then force=(--force); fi
if [ ${#force[@]} -gt 0 ] || [ -z "${SKIP_IMAGE_BUILD:-}" ] || [ ! -f "$image" ]; then
  mise run ${force[@]+"${force[@]}"} //packages/vm-runner:oci
fi
for path in usr/local/libexec/vm-runner/platform-init usr/local/libexec/vm-runner/platform-runc opt/smolvm/storage-template.btrfs.zst; do
  bin="${path##*/}"
  for blob in $(tar -tf "$image" | grep '^blobs/sha256/.'); do
    tar -xOf "$image" "$blob" | gzip -cdf | tar -xOf - "$path" > "$R/$bin.new" 2>/dev/null || true
    [ ! -s "$R/$bin.new" ] || break
  done
  [ -s "$R/$bin.new" ] || { echo "FATAL: no $bin in $image" >&2; exit 1; }
  chmod 755 "$R/$bin.new"
done

# The guest kernel is compiled here in place of the release's libkrunfw.
if $need_kernel; then
  vm_sh 'cat ~/"$1"' _ "$fw_c" > "$R/kernel.c"
  cc -fPIC -DABI_VERSION=5 -shared -O2 -install_name libkrunfw.5.dylib -o "$R/libkrunfw.5.dylib" "$R/kernel.c" 2>/dev/null
  codesign -f -s - "$R/libkrunfw.5.dylib"
  mv "$R/libkrunfw.5.dylib" "$release/lib/libkrunfw.5.dylib"
  rm "$R/kernel.c"
  echo "$fw_id" > "$release/lib/libkrunfw.id"
fi

# The chart renders the runner's token and asks cert-manager for its serving
# certificate (virtualization.runner.hostAddress); the runner holds copies.
secret=platform-vm-runner-host
for _ in $(seq 1 60); do kubectl -n "$CLUSTER_AGENT_NAMESPACE" get secret "$secret-tls" >/dev/null 2>&1 && break; sleep 2; done
(
  umask 077
  kubectl -n "$CLUSTER_AGENT_NAMESPACE" get secret "$secret" -o jsonpath='{.data.token}' | base64 -d > "$R/token"
  kubectl -n "$CLUSTER_AGENT_NAMESPACE" get secret "$secret-tls" -o jsonpath='{.data.tls\.crt}' | base64 -d > "$R/tls.crt"
  kubectl -n "$CLUSTER_AGENT_NAMESPACE" get secret "$secret-tls" -o jsonpath='{.data.tls\.key}' | base64 -d > "$R/tls.key"
)
# The runner boots only the trees cluster:install stages onto this volume: it
# runs no node image cache service, so it fetches nothing from a registry.
images="$(host_runner_images)"

host_runner_stop
# Machines from before they moved out of HOST_RUNNER_DIR (see host-runner.sh)
# are carried over once, with their records, so no agent's home is lost.
if [ -d "$R/Library" ] && [ ! -e "$HOST_RUNNER_VM_HOME/Library" ]; then
  mv "$R/Library" "$HOST_RUNNER_VM_HOME/Library"
fi
mv "$R/vm-runner.new" "$R/vm-runner"
mv "$R/platform-init.new" "$R/platform-init"
mv "$R/platform-runc.new" "$R/platform-runc"
mv "$R/storage-template.btrfs.zst.new" "$release/storage-template.btrfs.zst"
# The guest's init, as in the runner image (see oci): platform-init, whose
# first stage executes the release's copy from the share.
install -m 755 "$R/platform-init" "$release/agent-rootfs/sbin/platform-init"
mem_mib="${PLATFORM_VM_RUNNER_MEMORY_MIB:-$(( $(sysctl -n hw.memsize) / 1048576 / 3 ))}"
(
  cd "$R"
  HOME="$HOST_RUNNER_VM_HOME" SMOLVM_VM_UID_DROP=off RUST_LOG=info nohup "$R/vm-runner" \
    --listen=127.0.0.1:4600 --publish-address=127.0.0.1 \
    --port-min="$HOST_RUNNER_PORT_MIN" --port-max="$HOST_RUNNER_PORT_MAX" \
    --token-file="$R/token" --tls-cert="$R/tls.crt" --tls-key="$R/tls.key" \
    --state-dir="$R/machines" --image-dir="$images" --image-budget-bytes=$((50 << 30)) \
    --memory-mib="$mem_mib" --reserve-mib=256 --boot-mib=2048 \
    --smolvm="$release/smolvm" --platform-init="$R/platform-init" --platform-runc="$R/platform-runc" \
    >> "$R/runner.log" 2>&1 &
  echo $! > "$R/runner.pid"
)
# One runner per Mac, serving the cluster that started it last: cluster:stop
# and cluster:delete of that cluster are the ones that stop it.
echo "$LIMA_INSTANCE" > "$R/instance"
for _ in $(seq 1 30); do
  curl -sfk -o /dev/null https://127.0.0.1:4600/healthz && { echo "host VM runner serving (log: $R/runner.log)"; exit 0; }
  sleep 1
done
echo "FATAL: the host VM runner did not come up; see $R/runner.log" >&2
tail -n 20 "$R/runner.log" >&2
exit 1
