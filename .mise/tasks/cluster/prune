#!/usr/bin/env bash
#MISE description="Reclaim disk in the k3s VM: dangling images and leftover import tars"
#MISE raw=true
set -eo pipefail

. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

if [ "$CLUSTER_TARGET" = lima ] && ! limactl list -q 2>/dev/null | grep -qx "$LIMA_INSTANCE"; then
  echo "k3s VM '$LIMA_INSTANCE' does not exist — nothing to prune."
  exit 0
fi

echo "== k3s VM =="
# cluster:import and image:stage-vm copy image tars into the guest's /tmp and
# remove them after, but a run interrupted in between leaves one behind. In
# the sandbox they import in place, from the repo.
[ "$CLUSTER_TARGET" != lima ] || limactl shell "$LIMA_INSTANCE" bash -c 'sudo rm -f /tmp/*.tar'
# The same prune the load tasks run.
prune_dangling_images
# k3s keeps its data in the home on an Environment, the one path on its disk.
case "$CLUSTER_TARGET" in
  environment) node_sh df -h /home/agent ;;
  host) df -h / ;;
  lima) limactl shell "$LIMA_INSTANCE" df -h / ;;
esac
