#!/usr/bin/env bash
#MISE description="Reclaim disk in the k3s VM: dangling images and leftover import tars"
#MISE raw=true
set -eo pipefail

. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

if [ -z "${IS_SANDBOX:-}" ] && ! limactl list -q 2>/dev/null | grep -qx "$LIMA_INSTANCE"; then
  echo "k3s VM '$LIMA_INSTANCE' does not exist — nothing to prune."
  exit 0
fi

echo "== k3s VM =="
# cluster:import and image:stage-vm copy image tars into the guest's /tmp and
# remove them after, but a run interrupted in between leaves one behind. In
# the sandbox they import in place, from the repo.
RM_TARS='sudo rm -f /tmp/*.tar'
# Same dangling-layer prune the load tasks run: old `:latest` SHAs that lost
# their tag to a freshly imported one. Not `crictl rmi --prune`, which would also
# wipe loaded-but-unpinned images when no instance pods are running. (issue #244)
PRUNE_DANGLING='sudo k3s crictl images 2>/dev/null | sed -nE "s/^<none>[[:space:]]+<none>[[:space:]]+([^[:space:]]+).*/\\1/p" | xargs -r sudo k3s crictl rmi >/dev/null 2>&1 || true'
if [ -n "${IS_SANDBOX:-}" ]; then
  bash -c "$PRUNE_DANGLING"
  df -h /
else
  limactl shell "$LIMA_INSTANCE" bash -c "$RM_TARS"
  limactl shell "$LIMA_INSTANCE" bash -c "$PRUNE_DANGLING"
  limactl shell "$LIMA_INSTANCE" df -h /
fi
