#!/usr/bin/env bash
#MISE description="Rebuild the deployed agents' images, load into k3s, restart agent pods"
set -eo pipefail

if [ -n "${IS_SANDBOX:-}" ]; then
  KUBECONFIG="/etc/rancher/k3s/k3s.yaml"
else
  LIMA_INSTANCE="${LIMA_INSTANCE:-platform-k3s}"
  KUBECONFIG="${LIMA_HOME:-$HOME/.lima}/$LIMA_INSTANCE/copied-from-guest/kubeconfig.yaml"
fi

# Rebuild only the agents the cluster has deployed — their entries in the
# harness-templates ConfigMap (one CM keyed by "<name>.yaml"), plus the
# built-in kits in the starter-kits ConfigMap whose image is a local
# `platform-*` tag. Capture first so a kubectl failure aborts rather than
# looking like "nothing deployed".
DEPLOYED_CMS=$(kubectl --kubeconfig="$KUBECONFIG" get configmap -A -o yaml)
DEPLOYED_AGENTS=$(printf '%s\n' "$DEPLOYED_CMS" \
  | yq -r '.items[] | select(.metadata.name | test("-harness-templates$"))
           | .data | to_entries | .[] | .key + "\t" + (.value | from_yaml | .image)')
DEPLOYED_KITS=$(printf '%s\n' "$DEPLOYED_CMS" \
  | yq -r '.items[] | select(.metadata.name | test("-starter-kits$"))
           | .data | to_entries | .[] | select(.key | test("__kit.yaml$")) | .value | from_yaml
           | select(.image != null) | select(.image.ref | test("^platform-")) | "kit:" + .id + "\t" + .image.ref')
AGENT_TASKS=()
SEEN_COMPONENTS=()
while IFS=$'\t' read -r name image; do
  [ -z "$name" ] && continue
  name="${name%.yaml}" # data keys are "<name>.yaml" (single CM)
  # Templates can share one image (presets, e.g. adaevolve/evox over the
  # skydiscover image, or k-search-local over k-search), so resolve the
  # build component from the image repository basename
  # ("platform-<component>" locally), not the template key — and dedup so
  # a shared image builds and loads once. Mirrors cluster:install.
  comp="${image##*/}"; comp="${comp%%:*}"; comp="${comp#platform-}"
  case " ${SEEN_COMPONENTS[*]:-} " in *" $comp "*) continue ;; esac
  SEEN_COMPONENTS+=("$comp")
  if [ -d "packages/agents/$comp" ] || [ -d "packages/e2e/agents/$comp" ]; then
    AGENT_TASKS+=("$comp")
  else
    echo "WARN: no build task for '$name' ($image) — skipping local build" >&2
  fi
done <<< "$DEPLOYED_AGENTS"$'\n'"$DEPLOYED_KITS"

if [ -z "${AGENT_TASKS[*]:-}" ]; then
  echo "No agent templates deployed — nothing to build."
  exit 0
fi
LIMA_INSTANCE="$LIMA_INSTANCE" mise run //packages/agents:oci -- "${AGENT_TASKS[@]}"

echo "Loading into k3s..."
agent_tar() { local d="packages/agents/$1"; [ -d "$d" ] || d="packages/e2e/agents/$1"; echo "$d/dist/oci/$1.tar"; }
tars=()
for c in "${AGENT_TASKS[@]}"; do tars+=("$(agent_tar "$c")"); done
LIMA_INSTANCE="$LIMA_INSTANCE" mise run cluster:import -- "${tars[@]}"

echo "Restarting agent pods..."
kubectl --kubeconfig="$KUBECONFIG" delete pods -n platform-agents --all 2>/dev/null || true

# Prune dangling layers: old `:latest` SHAs that just lost their tag to the
# freshly imported one. Skip `crictl rmi --prune` here — when no instance
# pods are running, our just-loaded agent images are unpinned and would
# get wiped. (issue #244)
PRUNE_DANGLING='sudo k3s crictl images 2>/dev/null | sed -nE "s/^<none>[[:space:]]+<none>[[:space:]]+([^[:space:]]+).*/\\1/p" | xargs -r sudo k3s crictl rmi >/dev/null 2>&1 || true'
if [ -n "${IS_SANDBOX:-}" ]; then
  bash -c "$PRUNE_DANGLING"
else
  limactl shell "$LIMA_INSTANCE" bash -c "$PRUNE_DANGLING"
fi

echo "Done. Agent pods will restart with new image."
