#!/usr/bin/env bash
#MISE description="Show cluster and pod status (--watch refreshes every 2s)"
#MISE raw=true
#USAGE flag "--environment <name>" help="Show this agent's Environment of that name instead of this host's cluster"
#USAGE flag "--name <name>" help="Show this install instead of this worktree's"
#USAGE flag "-w --watch" help="Refresh every 2s"
set -eo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

STATUS_CMD="
if [ \"$CLUSTER_TARGET\" = environment ]; then
  echo '=== Environment $CLUSTER_ENVIRONMENT: k3s service ==='
  env_k3s status || true
elif [ -n \"${IS_SANDBOX:-}\" ]; then
  echo '=== k3s service ==='
  if [ -x /etc/init.d/k3s ]; then as_root rc-service k3s status || true
  elif [ -d /run/systemd/system ]; then as_root systemctl is-active k3s || true
  else echo 'none — k3s runs as a plain process here'
  fi
else
  echo '=== Lima VM ==='
  limactl list
fi
echo ''
echo '=== Nodes ==='
kubectl get nodes 2>/dev/null || echo 'Cluster not reachable'
echo ''
echo \"=== Pods ($CLUSTER_NAMESPACE) ===\"
kubectl -n \"$CLUSTER_NAMESPACE\" get pods 2>/dev/null || true
echo ''
echo \"=== Pods ($CLUSTER_AGENT_NAMESPACE) ===\"
kubectl -n \"$CLUSTER_AGENT_NAMESPACE\" get pods 2>/dev/null || true
"

case "${1:-}" in
  --watch|-w)
    tput civis 2>/dev/null || true
    trap 'tput cnorm 2>/dev/null; exit' INT TERM
    while true; do
      tput home 2>/dev/null || true
      eval "$STATUS_CMD" | sed $'s/$/\033[K/'
      tput ed 2>/dev/null || true
      sleep 0.5
    done
    ;;
  *)
    eval "$STATUS_CMD"
    # One-shot only — log fetches and helm calls are too slow for the --watch loop.
    echo ''
    echo '=== Installs ==='
    "$MISE_CONFIG_ROOT/.mise/tasks/cluster/installs" --all || true
    echo ''
    echo '=== Mesh cert health (istio-system) ==='
    # A cluster:install --no-mesh cluster has no ztunnel to read, and an empty
    # log search would otherwise read as healthy.
    if kubectl -n kube-system get configmap platform-local-no-mesh >/dev/null 2>&1; then
      echo 'NO MESH (local-only, cluster:install --no-mesh): AuthorizationPolicies exist but nothing enforces them.'
    else
      CERT_HITS=$(kubectl -n istio-system logs \
          -l app=ztunnel --since=30m --tail=2000 --prefix 2>/dev/null \
        | grep -iE "$MESH_CERT_EXPIRED" | tail -5 || true)
      if [ -n "$CERT_HITS" ]; then
        echo 'WARNING: expired ambient-mesh certs detected (issue #283).'
        echo 'Known symptoms: UI login failure, keycloak "Connection reset" during install,'
        echo 'machines looping "[runtime] hello failed" (workspace seeding never starts).'
        echo 'Fix now: mise run cluster:fix-certs   (the watchdog auto-heals within ~10 min)'
        printf '%s\n' "$CERT_HITS"
      else
        echo 'ok — no expired-cert signature in recent ztunnel logs'
      fi
    fi
    echo ''
    echo '=== cert-manager webhook health ==='
    # The webhook's in-memory serving cert can expire while the VM sleeps,
    # failing chart installs at admission. Probe with a server dry-run — the
    # same call the platform chart's cert-manager objects go through.
    if ! kubectl -n cert-manager get deploy cert-manager-webhook >/dev/null 2>&1; then
      echo 'skipped — cert-manager not installed'
    else
      PROBE_ERR=$(printf 'apiVersion: cert-manager.io/v1\nkind: ClusterIssuer\nmetadata:\n  name: webhook-health-probe\nspec:\n  selfSigned: {}\n' \
        | kubectl apply --dry-run=server -f - 2>&1 >/dev/null || true)
      if [ -z "$PROBE_ERR" ]; then
        echo 'ok — webhook admission responding'
      elif printf '%s' "$PROBE_ERR" | grep -q 'certificate has expired'; then
        echo 'WARNING: cert-manager webhook serving cert has expired — helm installs will'
        echo 'fail at admission. Fix now: mise run cluster:fix-certs'
      else
        echo 'WARN: webhook probe failed for another reason:'
        printf '%s\n' "$PROBE_ERR" | head -3
      fi
    fi
    ;;
esac
