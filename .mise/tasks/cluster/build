#!/usr/bin/env bash
#MISE description="Rebuild images, load them into k3s and restart what runs them. Honors LIMA_INSTANCE and IS_SANDBOX."
#USAGE arg "<component>..." var=#true help="controller, api-server, ui, keycloak, or agents: every agent image the cluster has deployed"
set -eo pipefail
eval "components=($usage_component)"

. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

# The agents the cluster has deployed, from its ConfigMaps: their entries in
# the harness-templates ConfigMap (one CM keyed by "<name>.yaml"), plus the
# built-in kits in the starter-kits ConfigMap whose image is a local
# `platform-*` tag.
deployed_agents() {
  DEPLOYED_AGENTS=$(printf '%s\n' "$1" \
    | yq -r '.items[] | select(.metadata.name | test("-harness-templates$"))
             | .data | to_entries | .[] | .key + "\t" + (.value | from_yaml | .image)')
  DEPLOYED_KITS=$(printf '%s\n' "$1" \
    | yq -r '.items[] | select(.metadata.name | test("-starter-kits$"))
             | .data | to_entries | .[] | select(.key | test("__kit.yaml$")) | .value | from_yaml
             | select(.image != null) | select(.image.ref | test("^platform-")) | "kit:" + .id + "\t" + .image.ref')
  SEEN_COMPONENTS=()
  while IFS=$'\t' read -r name image; do
    [ -z "$name" ] && continue
    name="${name%.yaml}" # data keys are "<name>.yaml" (single CM)
    # Templates can share one image (presets, e.g. adaevolve/evox over the
    # skydiscover image, or k-search-local over k-search), so resolve the
    # build component from the image repository basename
    # ("platform-<component>" locally), not the template key — and dedup so
    # a shared image builds and loads once. Mirrors cluster:install.
    comp="${image##*/}"; comp="${comp%%:*}"; comp="${comp#platform-}"
    case " ${SEEN_COMPONENTS[*]:-} " in *" $comp "*) continue ;; esac
    SEEN_COMPONENTS+=("$comp")
    if [ -d "packages/agents/$comp" ] || [ -d "packages/e2e/agents/$comp" ]; then
      echo "$comp"
    else
      echo "WARN: no build task for '$name' ($image) — skipping local build" >&2
    fi
  done <<< "$DEPLOYED_AGENTS"$'\n'"$DEPLOYED_KITS"
}

for c in "${components[@]}"; do
  case "$c" in
    agents)
      # Captured first, so a kubectl failure aborts rather than looking like
      # "nothing deployed".
      cms="$(kubectl get configmap -A -o yaml)"
      agents=($(deployed_agents "$cms"))
      if [ ${#agents[@]} -eq 0 ]; then echo "No agent templates deployed — nothing to build."; continue; fi
      mise run //packages/agents:oci -- "${agents[@]}"
      tars=()
      for a in "${agents[@]}"; do tars+=("$(.mise/tasks/image/resolve tar-path "$a")"); done
      mise run cluster:import -- "${tars[@]}"
      kubectl delete pods -n platform-agents --all 2>/dev/null || true
      continue
      ;;
    controller) pkg=controller deploy=platform-controller timeout=60s ;;
    ui) pkg=ui deploy=platform-ui timeout=60s ;;
    # Readiness gates on the first Keycloak JWKS fetch (warm-up gives up at
    # ~240s), so a fresh pod whose mesh egress is still converging needs
    # headroom past that bound before it reports Ready.
    api-server) pkg=api-server deploy=platform-apiserver timeout=300s ;;
    keycloak) pkg=keycloak-theme deploy=platform-keycloak timeout=180s ;;
    *) echo "unknown component: $c" >&2; exit 2 ;;
  esac
  mise run "//packages/$pkg:oci"
  mise run cluster:import -- "$(.mise/tasks/image/resolve tar-path "$c")"
  kubectl rollout restart deployment "$deploy"
  kubectl rollout status deployment "$deploy" --timeout="$timeout"
done

prune_dangling_images

echo "Done."
