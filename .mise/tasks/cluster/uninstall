#!/usr/bin/env bash
#MISE description="Uninstall Platform chart and clean up all resources"
set -eo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

# Drain agent workloads BEFORE helm uninstall, so their PVCs and namespace
# go before the controller that owns them.
if kubectl get ns platform-agents >/dev/null 2>&1; then
  echo "Draining platform-agents before uninstall..."
  kubectl -n platform-agents delete sts --all --wait=true --timeout=60s 2>/dev/null || true
  kubectl -n platform-agents wait --for=delete pod --all --timeout=60s 2>/dev/null || true
  kubectl -n platform-agents delete pvc --all --wait=true --timeout=60s 2>/dev/null || true
  kubectl delete ns platform-agents --ignore-not-found --wait=true --timeout=60s 2>/dev/null || true
fi

helm uninstall platform || true

# Clean up StatefulSet-managed PVCs in the release namespace (postgres,
# redis). These aren't owned by the helm release, so helm
# leaves them behind. Delete them AFTER helm uninstall — pods are gone now,
# so pvc-protection finalizers clear immediately.
kubectl delete pvc --all --ignore-not-found 2>/dev/null || true

echo "Platform uninstalled and cleaned up. Use 'mise run cluster:delete' to remove the entire cluster."
