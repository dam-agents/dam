#!/usr/bin/env bash
#MISE description="Stop the k3s VM and the sandbox node VM if any (preserves data)"
set -eo pipefail
if [ -n "${IS_SANDBOX:-}" ]; then
  sudo systemctl stop k3s
else
  limactl stop platform-k3s
  limactl list -q 2>/dev/null | grep -qx platform-sandbox && limactl stop platform-sandbox
fi
