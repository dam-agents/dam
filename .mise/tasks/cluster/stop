#!/usr/bin/env bash
#MISE description="Stop the k3s VM (preserves data)"
set -eo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"
if [ "$CLUSTER_TARGET" = environment ]; then
  # Only k3s: the Environment itself sleeps on its own once nothing uses it.
  env_k3s stop
elif [ -n "${IS_SANDBOX:-}" ]; then
  if [ -d /run/systemd/system ] && [ ! -x /etc/init.d/k3s ]; then
    as_root systemctl stop k3s
  else
    # An OpenRC k3s service supervises the process and respawns it
    # (supervise-daemon, respawn_max=0), so it goes through rc-service: a bare
    # pkill is undone at once. Only a host with no service manager gets one.
    if ! k3s_has_service; then
      as_root pkill -x k3s-server || true
    else
      rc=0
      k3s_service stop || rc=$?
      # rc-service reports a service that was already stopped as an error too,
      # so only a process that outlived the stop is a failure.
      if [ "$rc" != 0 ] && pgrep -x k3s-server >/dev/null; then
        echo "FATAL: k3s did not stop (rc=$rc)." >&2
        exit 1
      fi
    fi
    for _ in $(seq 1 30); do pgrep -x k3s-server >/dev/null || break; sleep 1; done
    # What k3s-killall.sh does on a supervised host; a plain process leaves it
    # all behind. Pods outlive k3s in their shims, their mounts stay, and their
    # iptables rules live in the host netns — a stale hostport DNAT sends the
    # next start's ingress port to a pod IP that no longer exists.
    as_root pkill -9 -f '/var/lib/rancher/k3s/data/[^ ]*/containerd-shim' || true
    for _ in 1 2 3; do
      mount | awk '{print $3}' | grep -E '^/(run/k3s|var/lib/kubelet|var/lib/rancher/k3s|run/netns|var/run/netns)' | sort -r \
        | as_root xargs -r -n1 umount -l 2>/dev/null || true
    done
    for backend in iptables iptables-legacy; do
      command -v "$backend-save" >/dev/null 2>&1 || continue
      as_root "$backend-save" 2>/dev/null | grep -v -e KUBE- -e CNI- -e ISTIO -e FLANNEL -e flannel | as_root "$backend-restore"
    done
    as_root rm -rf /var/lib/cni
  fi
else
  . "$MISE_CONFIG_ROOT/.mise/lib/host-runner.sh"
  [ "$(cat "$HOST_RUNNER_DIR/instance" 2>/dev/null)" != "$LIMA_INSTANCE" ] || host_runner_stop
  limactl stop "$LIMA_INSTANCE"
fi
