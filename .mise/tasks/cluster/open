#!/usr/bin/env bash
#MISE description="Forward an Environment's backchannel port to this agent, so its browser opens the install there"
#MISE raw=true
#USAGE flag "--environment <name>" required=#true help="This agent's Environment that cluster:install --backchannel installed into"
#USAGE flag "--port <port>" default="4444" help="The backchannel's port, the same on both ends: it is part of every address the browser sends"
# Runs until stopped, so start it in the background. The forward is an SSH
# link of its own, apart from the cluster tasks' control master, so it stays
# open while the browser uses it. While it is open, neither this agent nor
# the Environment sleeps.
set -euo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"
port="$usage_port"
echo "Forwarding localhost:$port to Environment $CLUSTER_ENVIRONMENT; open http://localhost:$port (Ctrl-C stops it)"
exec ssh -N -o ExitOnForwardFailure=yes -L "127.0.0.1:$port:127.0.0.1:$port" "$ENV_HOST"
