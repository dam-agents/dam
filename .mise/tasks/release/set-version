#!/usr/bin/env bash
#MISE description="Update version fields in all release-participating packages and commit"
#USAGE arg "<version>" help="The new version to set (format: X.Y.Z or X.Y.Z-rcW)"
set -euo pipefail

if [[ -n "$(git status --porcelain)" ]]; then
  echo "ERROR: Working directory not clean"
  exit 1
fi

if ! [[ "$usage_version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)(-rc[0-9]+)?$ ]]; then
  echo "ERROR: Invalid version format: $usage_version"
  echo "Expected format: X.Y.Z or X.Y.Z-rcW (e.g., 1.2.3 or 1.2.3-rc1)"
  exit 1
fi

# Every edit goes to a temp file first, so a failing one leaves the tree clean.
# No `sed -i`: BSD sed takes the next argument as its backup suffix.
new="$(mktemp -d)"
trap 'rm -rf "$new"' EXIT
set -x
yq ".version = \"$usage_version\" | .appVersion = \"$usage_version\"" helm/Chart.yaml > "$new/Chart.yaml"
yq ".version = \"$usage_version\"" packages/cli/package.json > "$new/package.json"
# A hotfix branch cut from a tag older than the skill has no skill to stamp.
if [[ -f skills/dam/SKILL.md ]]; then
  sed -E "s/^(This page describes \`dam\` CLI )[^ ]+\.$/\1$usage_version./" skills/dam/SKILL.md > "$new/SKILL.md"
  cp "$new/SKILL.md" skills/dam/SKILL.md
fi
cp "$new/Chart.yaml" helm/Chart.yaml
cp "$new/package.json" packages/cli/package.json
git add .
git commit --signoff --no-verify -m "bump: v$usage_version"
set +x

echo -e "Pending version in \x1b[36m$(git branch --show-current)\x1b[0m bumped to $usage_version"
