#!/usr/bin/env bash
# Install (or reinstall) the platform into the running dev VM from this
# checkout: build the api-server and UI, lay down the node layout and config,
# and start the units. This is the `cluster:install` of the VM world — it is
# a dev-loop task, not the production install, which is the bootc image.
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
VM="${DAM_VM:-dam}"

pnpm --filter platform-ui exec sh -c 'tsc && vite build'
pnpm --filter api-server exec tsup
PNPM_VERSION=$(sed -n 's/^pnpm = "\([^"]*\)".*/\1/p' .mise/config.toml)

# The repo is a shared mount, so the VM must never run pnpm against it: a
# --prod install there prunes the host's dev dependencies out from under the
# editor and the test run. Source is copied to VM-local disk first.
limactl shell "$VM" sudo rsync -a --delete \
  --exclude node_modules --exclude .git --exclude .worktrees \
  "${MISE_PROJECT_ROOT}/" /opt/dam/src/

# A second node forwards the same guest ports to different host ports, so the
# URLs the browser and Keycloak agree on are not the node's own defaults.
limactl shell "$VM" sudo bash -s -- /opt/dam/src "${PNPM_VERSION}" \
  "${DAM_UI_URL:-http://localhost:4000}" \
  "${DAM_KEYCLOAK_URL:-http://localhost:8081}" <<'REMOTE'
set -euo pipefail
REPO="$1"
PNPM_VERSION="$2"
UI_URL="$3"
KC_URL="$4"
SHARE_URL="${UI_URL%%://*}://share.${UI_URL#*://}"
CONTENT_URL="${UI_URL%%://*}://content.${UI_URL#*://}"

install -d -m 0700 /var/lib/dam/secrets /var/lib/dam/pki /var/lib/dam/registry-auth
install -d -m 0755 /var/lib/dam/images
# The gateway user must be able to traverse to its own agent's directory;
# what it can see inside is settled by the unit's mount namespace.
install -d -m 0751 /var/lib/dam/agents /run/dam /etc/dam
install -d -m 0750 /run/dam/harness /run/dam/extauthz
install -d -m 0755 /run/netns
# /run is a tmpfs, so the directory has to be recreated on every boot.
printf 'd /run/netns 0755 root root -\nd /run/dam 0755 root root -\nd /run/dam/harness 0750 root dam-gateway -\nd /run/dam/extauthz 0750 root dam-gateway -\n' > /etc/tmpfiles.d/dam.conf
id dam-gateway >/dev/null 2>&1 || useradd --system --no-create-home --shell /usr/sbin/nologin dam-gateway
chown dam-gateway /run/dam/harness /run/dam/extauthz

# The dependency tree is built here, not on the host: native modules (sharp,
# argon2) are platform-specific, and a tree deployed from macOS loads none of
# them on Linux.
command -v pnpm >/dev/null || npm install -g "pnpm@${PNPM_VERSION}"
rm -rf /opt/dam/api-server
install -d /opt/dam
(cd "$REPO" && pnpm install --frozen-lockfile --filter api-server... >/dev/null && pnpm --filter api-server --prod --legacy deploy /opt/dam/api-server)
# `deploy` carries the package and its dependencies, not build output or the
# sibling packages read at runtime.
# Trailing /. so a re-install replaces the contents instead of nesting the
# directory inside itself and leaving the old build in place.
rm -rf /opt/dam/api-server/dist /opt/dam/api-server/packages
install -d /opt/dam/api-server/dist /opt/dam/api-server/packages/db/drizzle
cp -a "$REPO/packages/api-server/dist/." /opt/dam/api-server/dist/
cp -a "$REPO/packages/db/drizzle/." /opt/dam/api-server/packages/db/drizzle/

install -m 0644 "$REPO/packages/dam-vm/etc/env" /etc/dam/env
# Secrets are generated once and kept, so a reinstall does not invalidate
# every API key and re-pseudonymize the activity log.
[ -f /var/lib/dam/hmac-keys ] || {
  umask 077
  { echo "ACTIVITY_HMAC_KEY=$(openssl rand -hex 32)"
    echo "API_KEY_HMAC_KEY=$(openssl rand -hex 32)"; } > /var/lib/dam/hmac-keys
}
{
  cat /var/lib/dam/hmac-keys
  echo "DATABASE_URL=postgres://dam:dam@127.0.0.1:5432/dam"
  echo "UI_BASE_URL=${UI_URL}"
  echo "SHARE_BASE_URL=${SHARE_URL}"
  echo "CONTENT_BASE_URL=${CONTENT_URL}"
  echo "KEYCLOAK_EXTERNAL_URL=${KC_URL}"
} >> /etc/dam/env
install -d /etc/dam/templates
cp -a "$REPO/packages/dam-vm/templates"/*.yaml /etc/dam/templates/

sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='dam'" | grep -q 1 || {
  sudo -u postgres psql -c "CREATE ROLE dam LOGIN PASSWORD 'dam'"
  sudo -u postgres createdb --owner dam dam
}

install -m 0644 "$REPO/packages/dam-vm/system/dam-api-server.service" /usr/lib/systemd/system/
install -m 0644 "$REPO/packages/dam-vm/system/dam-gateway@.service" /usr/lib/systemd/system/
install -m 0644 "$REPO/packages/dam-vm/system/dam-keycloak.service" /usr/lib/systemd/system/

# The api-server serves these itself; no reverse proxy, one origin, one port.
install -d /usr/share/dam-ui
rsync -a --delete "$REPO/packages/ui/dist/" /usr/share/dam-ui/

# Keycloak. The client secret and the dev user's password are generated once
# and kept, so a reinstall does not invalidate a logged-in browser session.
id keycloak >/dev/null 2>&1 || useradd --system --home-dir /opt/keycloak --shell /usr/sbin/nologin keycloak
chown -R keycloak:keycloak /opt/keycloak
[ -f /var/lib/dam/keycloak-secrets ] || {
  umask 077
  { echo "PLATFORM_API_CLIENT_SECRET=$(openssl rand -hex 24)"
    echo "PLATFORM_TEST_USER=dev"
    echo "PLATFORM_TEST_PASSWORD=dev"; } > /var/lib/dam/keycloak-secrets
}
. /var/lib/dam/keycloak-secrets
sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname='keycloak'" | grep -q 1 || {
  sudo -u postgres psql -c "CREATE ROLE keycloak LOGIN PASSWORD 'keycloak'"
  sudo -u postgres createdb --owner keycloak keycloak
}
{
  echo "KC_DB=postgres"
  echo "KC_DB_URL=jdbc:postgresql://127.0.0.1:5432/keycloak"
  echo "KC_DB_USERNAME=keycloak"
  echo "KC_DB_PASSWORD=keycloak"
  echo "KC_HTTP_ENABLED=true"
  echo "KC_HTTP_PORT=8081"
  echo "KC_HOSTNAME_STRICT=false"
  echo "KC_BOOTSTRAP_ADMIN_USERNAME=admin"
  echo "KC_BOOTSTRAP_ADMIN_PASSWORD=admin"
  cat /var/lib/dam/keycloak-secrets
} > /etc/dam/keycloak-env
chmod 0640 /etc/dam/keycloak-env && chown root:keycloak /etc/dam/keycloak-env
echo "KEYCLOAK_API_CLIENT_SECRET=${PLATFORM_API_CLIENT_SECRET}" >> /etc/dam/env

# Keycloak substitutes nothing in an imported realm, so the node's URLs and
# secrets are rendered in here.
install -d -m 0750 -o root -g keycloak /etc/dam/keycloak-realm
sed -e "s#@UI_URL@#${UI_URL}#g" \
    -e "s#@SHARE_URL@#${SHARE_URL}#g" \
    -e "s#@API_CLIENT_SECRET@#${PLATFORM_API_CLIENT_SECRET}#g" \
    -e "s#@TEST_USER@#${PLATFORM_TEST_USER}#g" \
    -e "s#@TEST_PASSWORD@#${PLATFORM_TEST_PASSWORD}#g" \
    "$REPO/packages/dam-vm/etc/keycloak-realm.json" > /etc/dam/keycloak-realm/platform-realm.json

systemctl daemon-reload
systemctl enable --now postgresql
systemctl enable --now redis-server 2>/dev/null || systemctl enable --now redis

# `build` bakes the database vendor into the distribution; `start --optimized`
# then refuses to re-derive it at boot, which is what keeps startup quick.
systemctl stop dam-keycloak 2>/dev/null || true
sudo -u keycloak env $(grep -v '^#' /etc/dam/keycloak-env | xargs) /opt/keycloak/bin/kc.sh build >/dev/null
# Import is idempotent: an existing realm is left as it is.
sudo -u keycloak env $(grep -v '^#' /etc/dam/keycloak-env | xargs) \
  /opt/keycloak/bin/kc.sh import --dir /etc/dam/keycloak-realm --override false >/dev/null
systemctl enable --now dam-keycloak

systemctl restart dam-api-server
REMOTE

echo "Installed. Next: mise run vm:status, then ${DAM_UI_URL:-http://localhost:4000} (dev/dev)"
