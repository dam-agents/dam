#!/usr/bin/env bash
#MISE description="Wake N vm agents of one owner at once and report time to ready, runner restarts and OOM kills"
#MISE raw=true
#USAGE flag "--owner <owner>" help="The owner label whose vm agents to wake (agent-platform.ai/owner)"
#USAGE flag "--count <n>" help="How many of the owner's vm agents to wake; all of them when omitted"
#USAGE flag "--namespace <ns>" help="The agent namespace; platform-agents when omitted"
#USAGE flag "--timeout <seconds>" help="How long to wait for every agent to be ready; 600 when omitted"
#USAGE flag "--keep-running" help="Do not stop agents that are running first; wake only the ones already stopped"
# The repro for a user's agents waking together (#4858): stops the chosen
# agents as the api-server's stop does, waits until every one reads
# Hibernated, then removes every stop in one burst so the controller boots
# them all against the owner's one pool. Readiness is read off the Agent
# conditions, so it measures what a user sees, not what the runner says.
# KUBECONFIG set means that cluster (e.g. dev, with KUBECTL_CONTEXT); unset
# means the local lima cluster, like every cluster:* task.
set -eo pipefail
[ -n "${KUBECONFIG:-}" ] || . "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

ns="${usage_namespace:-platform-agents}"
timeout="${usage_timeout:-600}"
[ -n "${usage_owner:-}" ] || { echo "--owner is required; owners with vm agents:" >&2; kubectl get agents -n "$ns" -o json | jq -r '[.items[] | select(.spec.backend.type=="vm") | .metadata.labels["agent-platform.ai/owner"]] | group_by(.) | map("\(length)\t\(.[0])") | .[]' | sort -rn >&2; exit 2; }

agent_json() { kubectl get agents -n "$ns" -l "agent-platform.ai/owner=$usage_owner" -o json; }
ready_reason() { jq -r --arg n "$1" '.items[] | select(.metadata.name==$n) | (.status.conditions // [])[] | select(.type=="Ready") | "\(.status)/\(.reason)"'; }

mapfile -t agents < <(agent_json | jq -r '.items[] | select(.spec.backend.type=="vm") | .metadata.name' | head -n "${usage_count:-100000}")
[ "${#agents[@]}" -gt 0 ] || { echo "owner $usage_owner has no vm agents in $ns" >&2; exit 2; }
echo "owner $usage_owner: ${#agents[@]} vm agents in $ns"

runner_restarts() { kubectl get pods -n "$ns" -o json | jq -r --arg o "$usage_owner" '[.items[] | select(.metadata.labels["agent-platform.ai/owner"]==$o and (.metadata.name|test("vm-runner"))) | .status.containerStatuses[]? | select(.name|test("runner")) | "\(.restartCount) \(.lastState.terminated.reason // "-")"] | join(";")'; }

if [ "${usage_keep_running:-}" != true ]; then
  stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  for a in "${agents[@]}"; do
    kubectl annotate agent "$a" -n "$ns" --overwrite "agent-platform.ai/stop-requested=$stamp" "agent-platform.ai/active-session=" "agent-platform.ai/invocations-active=" >/dev/null &
  done
  wait
  echo "stop requested; waiting for every agent to read Hibernated"
  deadline=$((SECONDS + timeout))
  while :; do
    json="$(agent_json)"
    left=0
    for a in "${agents[@]}"; do [ "$(ready_reason "$a" <<<"$json")" = "False/Hibernated" ] || left=$((left + 1)); done
    [ "$left" -eq 0 ] && break
    [ "$SECONDS" -lt "$deadline" ] || { echo "$left agents did not stop within ${timeout}s" >&2; exit 1; }
    sleep 2
  done
fi

before="$(runner_restarts)"
t0=$SECONDS
stamp="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
for a in "${agents[@]}"; do
  kubectl annotate agent "$a" -n "$ns" --overwrite "agent-platform.ai/last-activity=$stamp" "agent-platform.ai/stop-requested-" >/dev/null &
done
wait
echo "woke ${#agents[@]} agents at once; waiting up to ${timeout}s"

declare -A ready_at
deadline=$((SECONDS + timeout))
while :; do
  json="$(agent_json)"
  for a in "${agents[@]}"; do
    [ -n "${ready_at[$a]:-}" ] && continue
    [ "$(ready_reason "$a" <<<"$json")" = "True/AllPodsReady" ] && ready_at[$a]=$((SECONDS - t0))
  done
  [ "${#ready_at[@]}" -eq "${#agents[@]}" ] && break
  [ "$SECONDS" -lt "$deadline" ] || break
  sleep 2
done

echo
printf '%-28s %s\n' AGENT READY_AFTER
json="$(agent_json)"
for a in "${agents[@]}"; do printf '%-28s %s\n' "$a" "${ready_at[$a]:+${ready_at[$a]}s}${ready_at[$a]:-not ready: $(ready_reason "$a" <<<"$json")}"; done
echo
echo "ready: ${#ready_at[@]}/${#agents[@]}"
[ "${#ready_at[@]}" -eq 0 ] || echo "slowest: $(printf '%s\n' "${ready_at[@]}" | sort -n | tail -1)s"
echo "runner restarts before: ${before:-none}"
echo "runner restarts after:  $(runner_restarts)"
kubectl get events -n "$ns" --field-selector type=Warning -o json | jq -r --arg since "$stamp" '.items[] | select(.lastTimestamp >= $since) | select(.reason|test("VMPool|OOM|Unhealthy|BackOff|Failed")) | "event: \(.reason) \(.involvedObject.name): \(.message)"' | sort -u | head -20
[ "${#ready_at[@]}" -eq "${#agents[@]}" ]
