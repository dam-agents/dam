#!/usr/bin/env bash
# Start (and on first run, create) the dev VM. Everything else in vm:* assumes
# this has succeeded.
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
VM="${DAM_VM:-dam}"
if limactl list --quiet 2>/dev/null | grep -qx "$VM"; then
  limactl start "$VM"
else
  # A second node (the e2e one) needs its own host port, or it silently
  # loses the forward to whichever VM claimed it first.
  limactl start --name="$VM" --tty=false \
    --set=".portForwards[0].hostPort = ${DAM_PORT:-4000}" \
    etc/lima/dam.yaml
fi
echo "VM up. Next: mise run vm:install"
