#!/usr/bin/env bash
#MISE description="Wait until the e2e node stably serves the UI and the Keycloak realm."
#MISE hide=true
#MISE raw=true
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
. "${MISE_PROJECT_ROOT}/etc/e2e-env.sh"

# One lucky 200 is not "serving": the api-server restarts as the install
# finishes, and a spec that dials in mid-restart dies inside the login
# redirect. Require three consecutive ticks on both.
echo "Waiting for the e2e node to serve $PLATFORM_BASE_URL and its realm ..."
STREAK=0
for _ in $(seq 1 100); do
  if curl -fsS -o /dev/null --max-time 3 "$PLATFORM_BASE_URL/" 2>/dev/null &&
     curl -fsS -o /dev/null --max-time 3 "$PLATFORM_KEYCLOAK_URL/realms/platform" 2>/dev/null; then
    STREAK=$((STREAK + 1))
    [ "$STREAK" -ge 3 ] && break
  else
    STREAK=0
  fi
  sleep 3
done
if [ "$STREAK" -lt 3 ]; then
  echo "ERROR: the e2e install is up but not serving. Check 'DAM_VM=$DAM_VM mise run vm:status'." >&2
  exit 1
fi
echo "e2e node ready."
