#!/usr/bin/env bash
#MISE description="Wipe e2e node data without reinstalling: delete every agent, drop and recreate the database, clear stored Playwright auth. Leaves the node running."
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
. "${MISE_PROJECT_ROOT}/etc/e2e-env.sh"

limactl shell "$DAM_VM" sudo bash -s <<'REMOTE'
set -euo pipefail
# Delete the records first and let the supervisor tear their sandboxes down:
# it owns the netns, the link, the gateway unit and the mounts, and a hand
# cleanup would leave half of them behind.
sudo -u postgres psql -q -d dam -c "DELETE FROM agent_records" >/dev/null
for _ in $(seq 1 40); do
  runsc --network=sandbox --overlay2=none list 2>/dev/null | grep -q '^dam-' || break
  sleep 3
done

# Drop and recreate. Nothing may hold a session on it, so the api-server stops
# first; it reruns the migrations from zero when it comes back.
systemctl stop dam-api-server
sudo -u postgres psql -q -c "DROP DATABASE IF EXISTS dam WITH (FORCE)" >/dev/null
sudo -u postgres psql -q -c "CREATE DATABASE dam OWNER dam" >/dev/null
systemctl start dam-api-server
REMOTE

# Terms acceptance lived in the database we just dropped, so a stored session
# would land on the terms gate instead of the app.
rm -f packages/e2e/playwright/.auth/user.json
mise run e2e:gate
echo "e2e data reset complete."
