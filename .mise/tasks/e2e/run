#!/usr/bin/env bash
#MISE alias="e2e"
#MISE description="Run Playwright e2e: spin up fresh test cluster, run the smoke suite, tear down"
#MISE raw=true
#MISE env={ LIMA_INSTANCE = "platform-k3s-test" }
#USAGE flag "--headed" help="Run Playwright headed"
#USAGE flag "--full" help="Smoke plus the slow on-demand specs under src/tests/full/"
set -eo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

PLAYWRIGHT_ARGS=()
[ "${usage_headed:-}" != true ] || PLAYWRIGHT_ARGS+=(--headed)
[ "${usage_full:-}" != true ] || export E2E_FULL=1

cleanup() {
  local exit_code=$?
  if [ $exit_code -ne 0 ] && [ -f "$KUBECONFIG" ]; then
    echo ""
    echo "=== FAILURE: dumping cluster diagnostics ==="
    echo ""
    echo "--- Nodes ---"
    kubectl --kubeconfig="$KUBECONFIG" get nodes -o wide 2>&1 || true
    echo ""
    echo "--- Pods (all namespaces) ---"
    kubectl --kubeconfig="$KUBECONFIG" get pods -A -o wide 2>&1 || true
    echo ""
    echo "--- Events (recent, all namespaces) ---"
    kubectl --kubeconfig="$KUBECONFIG" get events -A --sort-by=.lastTimestamp 2>&1 | tail -50 || true
    echo ""
    echo "--- Describe not-ready pods ---"
    kubectl --kubeconfig="$KUBECONFIG" get pods -A -o json 2>/dev/null \
      | jq -r '.items[] | select(.status.phase != "Running" or ([.status.containerStatuses[]?.ready] | all | not)) | "\(.metadata.namespace) \(.metadata.name)"' \
      | while read -r ns name; do
          echo "### $ns/$name ###"
          kubectl --kubeconfig="$KUBECONFIG" describe pod -n "$ns" "$name" 2>&1 || true
          echo ""
        done
    echo ""
    echo "--- Logs from Platform pods ---"
    for ns in default platform-agents; do
      for pod in $(kubectl --kubeconfig="$KUBECONFIG" get pods -n "$ns" -o name 2>/dev/null); do
        echo "### $ns/$pod (current) ###"
        kubectl --kubeconfig="$KUBECONFIG" logs -n "$ns" "$pod" --all-containers --tail=200 2>&1 || true
        echo "### $ns/$pod (previous) ###"
        kubectl --kubeconfig="$KUBECONFIG" logs -n "$ns" "$pod" --all-containers --tail=200 --previous 2>&1 || true
        echo ""
      done
    done
    echo ""
    echo "--- Mesh cert-expiry check (ztunnel) ---"
    # Same signature the ztunnel-cert-watchdog keys on (cluster:install);
    # keep the regex in sync. Rules mesh certs in or out as the failure cause.
    CERT_HITS=$(kubectl --kubeconfig="$KUBECONFIG" -n istio-system logs \
        -l app=ztunnel --since=6h --tail=5000 --prefix 2>/dev/null \
      | grep -iE 'certificate expired|AlertReceived\(CertificateExpired\)' | tail -5 || true)
    if [ -n "$CERT_HITS" ]; then
      echo "expired-cert signature PRESENT — mesh certs are a likely failure cause:"
      printf '%s\n' "$CERT_HITS"
    else
      echo "no expired-cert signature (mesh certs are not the failure cause)"
    fi
    echo "=== End diagnostics ==="
  fi

  # A GitHub-hosted runner is a fresh VM per job and is discarded after it.
  if [ -z "${GITHUB_ACTIONS:-}" ]; then
    echo ""
    echo "=== Tearing down test cluster ==="
    mise run cluster:delete -- --force || true
  fi

  exit $exit_code
}
trap cleanup EXIT

# Fetch the browser and its OS libraries before there is a cluster to disturb.
# The Playwright run task pulls this in as a dependency, which would otherwise
# put it here — after the cluster is up — and on Linux it is `apt-get install`,
# whose service-restart trigger takes k3s with it. The control plane then goes
# down under the suite: the first spec fails at the transport layer, with no
# tRPC envelope to read a code from, and the rest never run. Ordering it here
# leaves the second, dependency-driven invocation a no-op that installs nothing
# and so restarts nothing.
mise run //packages/e2e/playwright:install-browsers

# Nuke any pre-existing cluster before provisioning: a previous run may have
# died before its own teardown fired. A half-removed k3s fails before any test
# runs: the node comes up without flannel, so `/run/flannel/subnet.env` is
# missing and every pod sandbox — k3s's own bootstrap included — fails to get a
# network. On a GitHub-hosted runner, a fresh VM per job, this finds nothing.
# In a sandbox this uninstalls k3s from the host; locally it deletes the VM.
echo "Nuking any pre-existing test cluster..."
mise run cluster:delete -- --force

# Provision a fresh e2e cluster. Install args + the apiserver race-fix live in
# e2e:install, shared with e2e:loop so the two never drift.
mise run e2e:install

# Wipe data to the specs' expected clean slate. The nuke above means the
# cluster is brand new by the time we get here and this is a fast no-op; it
# stays because nothing should depend on that being true, and a cluster that
# did survive still carries the previous run's data, which the specs'
# clean-slate assertions fail on. Re-gate afterwards — the reset bounces the
# apiserver.
mise run e2e:reset
mise run e2e:gate

PLATFORM_BASE_URL="http://localhost:5555" \
PLATFORM_KEYCLOAK_URL="http://keycloak.localhost:5555" \
  mise run //packages/e2e/playwright:run ${PLAYWRIGHT_ARGS[@]+-- "${PLAYWRIGHT_ARGS[@]}"}
