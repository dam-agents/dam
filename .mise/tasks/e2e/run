#!/usr/bin/env bash
#MISE alias="e2e"
#MISE description="Run the Playwright suite against a fresh e2e node. Options: --headed --full"
#MISE raw=true
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
. "${MISE_PROJECT_ROOT}/etc/e2e-env.sh"
. "${MISE_PROJECT_ROOT}/etc/node-exec.sh"

PLAYWRIGHT_TASK="//packages/e2e/playwright:run"
for arg in "$@"; do
  case "$arg" in
    --headed) PLAYWRIGHT_TASK="//packages/e2e/playwright:run-headed" ;;
    --full) PLAYWRIGHT_TASK="//packages/e2e/playwright:run-full" ;;
  esac
done

cleanup() {
  local code=$?
  if [ $code -ne 0 ]; then
    echo ""
    echo "=== FAILURE: e2e node diagnostics ==="
    DAM_VM="$DAM_VM" mise run vm:status || true
    on_node journalctl -u dam-api-server -n 200 --no-pager || true
  fi
}
trap cleanup EXIT

mise run e2e:install
mise run "$PLAYWRIGHT_TASK"
