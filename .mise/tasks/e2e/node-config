#!/usr/bin/env bash
#MISE description="Make the e2e node an e2e node: the mock as its only template, the e2e control API on."
#MISE hide=true
#MISE raw=true
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
. "${MISE_PROJECT_ROOT}/etc/e2e-env.sh"
. "${MISE_PROJECT_ROOT}/etc/node-exec.sh"

# vm:install lays /etc/dam/env and the templates down from the checkout every
# time, so this runs after it rather than once at bootstrap — otherwise the
# fast loop would reinstall the node and leave it without its e2e surface.

# Every e2e node gets the mock archive, the second one included: the template
# below names a path on the node's own disk, and nothing else puts it there.
[ -f /tmp/platform-mock.tar ] || { echo "no /tmp/platform-mock.tar; run: mise run e2e:install" >&2; exit 1; }
copy_to_node /tmp/platform-mock.tar /tmp/platform-mock.tar

on_node bash -s <<'REMOTE'
set -euo pipefail
install -m 0644 /tmp/platform-mock.tar /var/lib/dam/images/mock.tar

# The mock is the node's whole catalogue: every other template names an image
# the e2e node has no reason to pull.
rm -f /etc/dam/templates/*.yaml
cat > /etc/dam/templates/mock.yaml <<'YAML'
version: "1"
name: Mock
description: Scripted mock agent (e2e test fixture)
category: harness
image: /var/lib/dam/images/mock.tar
hibernationTimeout: 30m
env:
  - name: MOCK_DEFAULT_REPLY
    value: "Hello from the mock agent."
  # A spec proving a queued prompt outlives an abandoned tab waits this out in
  # real time, so the production 90s would cost every such spec a minute and a
  # half of sleeping.
  - name: QUEUE_PARK_MS
    value: "8000"
resources:
  limits:
    cpu: "1"
    memory: 1Gi
YAML

grep -q '^E2E_ENABLED=' /etc/dam/env || echo "E2E_ENABLED=true" >> /etc/dam/env

# The suite runs its specs in parallel, each with its own agent, so it wants
# more agents awake at once than one person's default allowance covers. The
# ceiling is a per-user policy and this node has one user running a test
# harness; leaving the default in place would have the scheduler park specs'
# agents as over-budget, which is the ceiling working rather than a failure to
# reproduce. What still bounds this node is the memory placement subtracts.
grep -q '^DEFAULT_USER_CPU_BUDGET=' /etc/dam/env || echo "DEFAULT_USER_CPU_BUDGET=64" >> /etc/dam/env
grep -q '^DEFAULT_USER_MEMORY_BUDGET=' /etc/dam/env || echo "DEFAULT_USER_MEMORY_BUDGET=128Gi" >> /etc/dam/env
systemctl restart dam-api-server
REMOTE
