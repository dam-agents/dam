#!/usr/bin/env bash
#MISE description="Soak the vm Backend at the smolvm release the runner pins: sustained file and chat load on one vm agent, then repeated stop/start cycles, asserting HOME survives every cycle and the machine comes back each time. Runs against the warm e2e test cluster and installs it with virtualization when there is none, so the host needs /dev/kvm. Options: --cycles=N --load-minutes=N --headed"
#MISE raw=true
#MISE env={ LIMA_INSTANCE = "platform-k3s-test" }
#USAGE flag "--cycles <n>" default="20" help="Stop/start cycles after the load phase"
#USAGE flag "--load-minutes <n>" default="15" help="Minutes of sustained load before the cycles"
#USAGE flag "--headed" help="Run Playwright headed"
# Two upstream failure modes of the microVM runtime drive this task: a guest
# that exits silently under sustained load, and a machine whose virtio-net does
# not come back after a stop and a start. Neither shows in a single boot, so
# the smoke tier cannot catch them; the spec is src/tests/soak/vm-soak.spec.ts.
#
# A warm test cluster is reused as e2e:loop reuses it: its data is reset, and
# it must have been installed with virtualization (the spec fails, naming the
# fix, when it was not). With no cluster, one is installed with
# E2E_VIRTUALIZATION=1 — the path the vm-soak workflow takes on a fresh
# runner. Nothing is torn down afterwards.
set -eo pipefail
. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

for n in "$usage_cycles" "$usage_load_minutes"; do
  case "$n" in '' | *[!0-9]*) echo "e2e:vm-soak: --cycles and --load-minutes take whole numbers, got '$n'" >&2; exit 2 ;; esac
done
export E2E_VIRTUALIZATION=1 E2E_VM_SOAK=1
export E2E_VM_SOAK_CYCLES="$usage_cycles" E2E_VM_SOAK_LOAD_MINUTES="$usage_load_minutes"

PLAYWRIGHT_ARGS=(--project=vm-soak)
[ "${usage_headed:-}" != true ] || PLAYWRIGHT_ARGS+=(--headed)

# The runner's own view of a failure: which machine exited, and what the
# guest's console said last. On failure only, and never fatal itself.
dump_runner() {
  local code=$?
  if [ "$code" -ne 0 ] && [ -f "$KUBECONFIG" ]; then
    echo "=== vm-soak FAILED: VM runner diagnostics ==="
    kubectl -n platform-agents get pods,agents.agent-platform.ai -o wide 2>&1 || true
    kubectl -n platform-agents get events --sort-by=.lastTimestamp 2>&1 | tail -40 || true
    for pod in $(kubectl -n platform-agents get pods -l app.kubernetes.io/component=vm-runner -o name 2>/dev/null); do
      echo "### $pod (current) ###"
      kubectl -n platform-agents logs "$pod" --all-containers --tail=500 2>&1 || true
      echo "### $pod (previous) ###"
      kubectl -n platform-agents logs "$pod" --all-containers --tail=200 --previous 2>&1 || true
    done
  fi
  exit "$code"
}
trap dump_runner EXIT

# Before there is a cluster to disturb; see e2e:run.
mise run //packages/e2e/playwright:install-browsers

if [ -z "${IS_SANDBOX:-}" ] && ! limactl list -q 2>/dev/null | grep -qx "$LIMA_INSTANCE"; then
  BOOTSTRAP=true
elif ! kubectl get deployment platform-apiserver >/dev/null 2>&1; then
  BOOTSTRAP=true
else
  BOOTSTRAP=false
fi
if [ "$BOOTSTRAP" = true ]; then
  echo "No warm e2e cluster — installing one with virtualization (slow, ~minutes)..."
  mise run e2e:install
  rm -f packages/e2e/playwright/.auth/user.json
else
  mise run e2e:reset
  mise run e2e:gate
fi

PLATFORM_BASE_URL="http://localhost:5555" \
PLATFORM_KEYCLOAK_URL="http://keycloak.localhost:5555" \
  mise run //packages/e2e/playwright:run -- "${PLAYWRIGHT_ARGS[@]}"
