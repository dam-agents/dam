#!/usr/bin/env bash
#MISE description="Fast e2e rerun against the warm test cluster (no VM recreate), or an Environment: optionally rebuild components, wipe data, run the smoke suite"
#MISE raw=true
#MISE env={ LIMA_INSTANCE = "platform-k3s-test", DAM_INSTALL = "default", E2E_LANE = "1" }
#USAGE flag "--headed" help="Run Playwright headed"
#USAGE flag "--full" help="Smoke plus the slow on-demand specs under src/tests/full/; the pipeline runs smoke only"
#USAGE flag "--rebuild <components>" help="Comma-separated cluster:build components (controller, api-server, ui, keycloak, agents); asked for when omitted on a terminal"
#USAGE flag "--test <filter>" help="Playwright file/title filter, e.g. prompt-delivery"
#USAGE flag "--environment <name>" help="Run in this agent's Environment of that name: install what the checkout changed there, then run the suite over the link"
#USAGE flag "--no-install" help="With --environment: skip the install, and run on what the Environment already has"
set -eo pipefail

. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

PLAYWRIGHT_ARGS=()
if [ "${usage_headed:-}" = true ]; then
  # An Environment's browser has no display to show a window on.
  [ "$CLUSTER_TARGET" != environment ] || { echo "FATAL: --headed has no window to open in an Environment, whose browser runs there" >&2; exit 1; }
  PLAYWRIGHT_ARGS+=(--headed)
fi
[ "${usage_full:-}" != true ] || export E2E_FULL=1
# --test fully narrows the run only for full-only projects, which have no
# dependencies — e.g. --full --test=prompt-delivery runs just the four
# prompt-delivery specs. A smoke spec still pulls in its whole dependency
# chain: Playwright always runs a selected project's dependencies, and here
# they're needed anyway because e2e:reset (step 3) wipes the state the chain
# builds up. Full-only specs also need --full, or their project doesn't exist
# and the filter matches nothing.
[ -z "${usage_test:-}" ] || PLAYWRIGHT_ARGS+=("$usage_test")
REBUILD="${usage_rebuild:-}"

# 1. Ensure a warm cluster exists. Bootstrap once if it's missing; never try to
# heal a broken one — fail loud and let the operator decide. In an Environment
# the install brings it to the checkout: it builds and streams in only the
# images this checkout changed, and restarts only what runs them. It still
# takes minutes, so it is skipped when the Environment's last install that
# passed its gate was of this same commit from a clean tree, into this same
# cluster rather than an earlier Environment of that name, or with
# --no-install; either way one line says what the Environment runs, so a stale
# one is never silent.
[ "${usage_no_install:-}" != true ] || [ "$CLUSTER_TARGET" = environment ] ||
  { echo "FATAL: --no-install is for an Environment (--environment <name>); a warm test cluster is never reinstalled" >&2; exit 1; }
NEEDS_BOOTSTRAP=false
if [ "$CLUSTER_TARGET" = environment ]; then
  NEEDS_BOOTSTRAP=true
elif [ "$CLUSTER_TARGET" = lima ] && ! limactl list -q 2>/dev/null | grep -qx "$LIMA_INSTANCE"; then
  NEEDS_BOOTSTRAP=true
elif ! kubectl get deployment platform-apiserver >/dev/null 2>&1; then
  NEEDS_BOOTSTRAP=true
fi
if [ "$CLUSTER_TARGET" = environment ]; then
  INSTALLED="$(cut -d' ' -f1 "$ENV_E2E_INSTALLED" 2>/dev/null || true)"
  if [ "${usage_no_install:-}" = true ]; then
    echo "Skipping the install (--no-install): Environment $CLUSTER_ENVIRONMENT runs ${INSTALLED:-an install of no recorded commit}, whatever this checkout changed since."
  elif CURRENT="$(e2e_install_current "$ENV_E2E_INSTALLED" "$(e2e_cluster_id)")"; then
    echo "Skipping the install: Environment $CLUSTER_ENVIRONMENT already runs $CURRENT, this checkout's commit, with a clean tree."
  else
    echo "Installing what this checkout changed into Environment $CLUSTER_ENVIRONMENT..."
    mise run e2e:install
  fi
elif [ "$NEEDS_BOOTSTRAP" = true ]; then
  echo "No warm e2e cluster found — bootstrapping once (slow, ~minutes)..."
  mise run e2e:install
fi

# 2. Optional rebuild. Interactive prompt unless --rebuild was passed. Default
# none: just reset data and rerun. The build tasks inherit LIMA_INSTANCE, so
# they target the test VM rather than the dev cluster. An Environment's
# install above already took every change.
if [ "$CLUSTER_TARGET" = environment ]; then
  REBUILD=""
elif [ -z "${usage_rebuild+set}" ] && [ -t 0 ]; then
  read -r -p "Rebuild which? [controller,api-server,ui,keycloak,agents] (default: none): " REBUILD || true
fi
IFS=', ' read -ra COMPONENTS <<< "$REBUILD"
[ ${#COMPONENTS[@]} -eq 0 ] || mise run cluster:build -- "${COMPONENTS[@]}"

# 3. Wipe data to the specs' expected preconditions.
mise run e2e:reset

# 3b. Readiness gate — shared with the fresh-install path (see e2e:gate), so
# a warm --rebuild of keycloak/traefik gets the same stability check.
mise run e2e:gate

# 3c. A warm cluster shares its machine's CPUs with the browser and whatever
# else runs there, so an action takes seconds where CI's takes tenths. The
# default test and expect timeouts get room for that: on a starved sandbox the
# first UI specs otherwise time out on the login roundtrip's blank page while
# the app still loads (#6034). CI's `e2e` keeps the defaults.
export E2E_TIMEOUT_SCALE="${E2E_TIMEOUT_SCALE:-3}"

# 4. Run the specs against the warm cluster. No teardown — the cluster stays up
# for the next loop. The arguments ride after `--` so mise appends them to the
# playwright command instead of parsing them as its own flags. In an
# Environment the suite reaches the backchannel and the API over a forward
# that stays open until the suite ends, and drives a browser that runs in the
# Environment (env_e2e_browser): the specs stay here, beside the checkout and
# the tools they call.
trap env_e2e_forward_close EXIT
e2e_endpoint
[ "$CLUSTER_TARGET" != environment ] || env_e2e_browser
PLATFORM_BASE_URL="$E2E_BASE_URL" \
PLATFORM_KEYCLOAK_URL="$E2E_KEYCLOAK_URL" \
PLATFORM_E2E_LOGIN_LOCK_PORT="$E2E_LOGIN_LOCK_PORT" \
KUBECONFIG="$E2E_KUBECONFIG" \
  mise run //packages/e2e/playwright:run ${PLAYWRIGHT_ARGS[@]+-- "${PLAYWRIGHT_ARGS[@]}"}
