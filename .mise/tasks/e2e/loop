#!/usr/bin/env bash
#MISE description="Fast rerun against the warm e2e node: reinstall the platform, wipe data, run the suite. Options: --headed --full --test=<filter>"
#MISE raw=true
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
. "${MISE_PROJECT_ROOT}/etc/e2e-env.sh"
. "${MISE_PROJECT_ROOT}/etc/node-exec.sh"

PLAYWRIGHT_TASK="//packages/e2e/playwright:run"
TEST_FILTER=""
for arg in "$@"; do
  case "$arg" in
    --headed) PLAYWRIGHT_TASK="//packages/e2e/playwright:run-headed" ;;
    --full) PLAYWRIGHT_TASK="//packages/e2e/playwright:run-full" ;;
    # A smoke spec still pulls in its whole dependency chain: Playwright always
    # runs a selected project's dependencies, and e2e:reset wipes the state
    # that chain builds up. Full-only specs also need --full.
    --test=*) TEST_FILTER="${arg#--test=}" ;;
  esac
done

# Bootstrap once if the node is missing; never try to heal a broken one.
if ! node_exists; then
  echo "No e2e install found — bootstrapping once (slow, ~minutes)..."
  mise run e2e:install
else
  eval "$(mise run cluster:env)"
  mise run vm:install
  mise run e2e:node-config
  mise run e2e:reset
fi

if [ -n "$TEST_FILTER" ]; then
  mise run "$PLAYWRIGHT_TASK" -- "$TEST_FILTER"
else
  mise run "$PLAYWRIGHT_TASK"
fi
