#!/usr/bin/env bash
#MISE description="CI only: build or fetch this run's amd64 images as the dist/oci tars the e2e cluster loads. Writes ok|fail to the file named by its argument."
#MISE hide=true
# cd.yml's e2e job starts with the run instead of after the builds, because
# bringing the cluster up (k3s, cert-manager, Istio) needs no image. It runs
# this in the background, and cluster:install waits on the status file
# (CI_IMAGES_STATUS) right before it loads the images into k3s.
#
# An image whose effective source is already published (image:resolve says
# REUSE) is pulled right away. The rest are built on this runner on a PR
# (CI_IMAGES_BUILD=1), while the cluster comes up; see image:ci-build. A
# separate build job would first wait for a runner of its own, and then e2e
# would pull what it pushed. On every other run they come from this run's
# build jobs, which build the same set: the `changes` job resolves it the same
# way.
#
# By path, like image:resolve. Needs GH_TOKEN with actions:read,
# GITHUB_REPOSITORY, GITHUB_RUN_ID and IMAGE_PREFIX; RESOLVE_NO_REUSE as the
# `changes` job has it.
set -uo pipefail

status_file="${1:?usage: ci-images <status-file>}"
result=fail
trap 'echo "$result" > "$status_file"' EXIT
set -e

: "${GITHUB_REPOSITORY:?}" "${GITHUB_RUN_ID:?}" "${IMAGE_PREFIX:?}"

resolve=.mise/tasks/image/resolve
LOADED="controller api-server ui keycloak mock"

# Each image's file lands in the ready directory once its tar is complete,
# for cluster:install to import it while the rest still build.
ready="$status_file.ready"
mkdir -p "$ready"
export CI_BUILD_READY_DIR="$ready"
pull() { .mise/tasks/image/pull "$2" "$($resolve tar-path "$1")" "platform-$1:latest" && touch "$ready/$1"; }

stale=() pids=()
for c in $LOADED; do
  decision="$($resolve resolve "$c")" || decision=BUILD
  case "$decision" in
    "REUSE "*)
      echo "$c unchanged: ${decision#REUSE }"
      pull "$c" "${decision#REUSE }" &
      pids+=($!)
      ;;
    *) stale+=("$c") ;;
  esac
done
echo "to build: ${stale[*]:-none}"

if [ "${CI_IMAGES_BUILD:-}" = 1 ]; then
  SECONDS=0
  [ ${#stale[@]} -eq 0 ] || .mise/tasks/image/ci-build amd64 "${stale[@]/%/:load}"
  for pid in ${pids[@]+"${pids[@]}"}; do wait "$pid"; done
  echo "$(date -u +%H:%M:%S) images ready in ${SECONDS}s"
  result=ok
  exit 0
fi

# The jobs that build what is stale, by their cd.yml names: CI_IMAGES_IMAGES_JOB
# builds controller, api-server, ui and keycloak; CI_IMAGES_MOCK_JOB the mock.
# `detect stale images` is always waited on: when it fails, the build jobs that
# need it never start under their names, and nothing else would end the wait.
JOBS=("detect stale images")
for c in ${stale[@]+"${stale[@]}"}; do
  case "$c" in
    mock) JOBS+=("${CI_IMAGES_MOCK_JOB:?}") ;;
    *) JOBS+=("${CI_IMAGES_IMAGES_JOB:?}") ;;
  esac
done
wanted="$(printf '%s\n' "${JOBS[@]}" | sort -u | jq -R . | jq -cs .)"

deadline=$((SECONDS + ${CI_IMAGES_TIMEOUT:-2400}))
while :; do
  # filter=latest: on a re-run, a build that passed in an earlier attempt and
  # was not re-run still counts.
  if jobs="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/jobs?filter=latest&per_page=100" 2>&1)"; then
    state="$(printf '%s' "$jobs" | jq -r --argjson wanted "$wanted" '
      [.jobs[] | select(.name as $n | $wanted | index($n))] as $j
      | ($j | map(select(.status == "completed"))) as $done
      | ($done | map(select(.conclusion != "success"))) as $bad
      | if ($bad | length) > 0 then "failed: " + ($bad | map(.name + "=" + .conclusion) | join(", "))
        elif ($done | length) == ($wanted | length) then "ready"
        else "waiting: \($done | length)/\($wanted | length) done" end')"
  else
    state="waiting: jobs API error: $jobs"
  fi
  echo "$(date -u +%H:%M:%S) $state"
  case "$state" in
    ready) break ;;
    failed:*) exit 1 ;;
  esac
  [ "$SECONDS" -lt "$deadline" ] || { echo "timed out waiting for the image builds" >&2; exit 1; }
  sleep 10
done

# One artifact holds every built image's digest, at <component>/<hex>; see
# image:ci-build. build-mock pushes the mock under its source sha.
for c in ${stale[@]+"${stale[@]}"}; do
  if [ "$c" = mock ]; then
    ref="$IMAGE_PREFIX/mock:$($resolve source-sha mock)"
  else
    [ -d /tmp/digests ] || gh run download "$GITHUB_RUN_ID" -R "$GITHUB_REPOSITORY" -n digests-images-amd64 -D /tmp/digests
    ref="$IMAGE_PREFIX/$c@sha256:$(ls "/tmp/digests/$c")"
  fi
  pull "$c" "$ref" &
  pids+=($!)
done
for pid in ${pids[@]+"${pids[@]}"}; do wait "$pid"; done

result=ok
echo "$(date -u +%H:%M:%S) images pulled"
