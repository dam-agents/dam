#!/usr/bin/env bash
#MISE description="CI only: build or fetch this run's amd64 images and tag what the e2e cluster loads. Writes ok|fail to the file named by its argument."
#MISE hide=true
# cd.yml's e2e job starts with the run instead of after the builds, because
# bringing the cluster up (k3s, cert-manager, Istio) needs no image. It runs
# this in the background, and cluster:install waits on the status file
# (CI_IMAGES_STATUS) right before it loads the images into k3s.
#
# With CI_IMAGES_BUILD=1 (a PR) it builds the images on this runner, from the
# registry buildcache, while the cluster comes up; see image:ci-build. A
# separate build job would first wait for a runner of its own, and then e2e
# would pull what it pushed. Only a mock on a platform-base this run rebuilt
# still comes from build-mock.
#
# By path, like image:resolve. Needs GH_TOKEN with actions:read,
# GITHUB_REPOSITORY, GITHUB_RUN_ID, GITHUB_SHA and IMAGE_PREFIX.
set -uo pipefail

status_file="${1:?usage: ci-images <status-file>}"
result=fail
trap 'echo "$result" > "$status_file"' EXIT
set -e

: "${GITHUB_REPOSITORY:?}" "${GITHUB_RUN_ID:?}" "${GITHUB_SHA:?}" "${IMAGE_PREFIX:?}"

LOADED="controller api-server ui keycloak"
pull_mock=true
if [ "${CI_IMAGES_BUILD:-}" = 1 ]; then
  base="$(.mise/tasks/image/resolve resolve platform-base)"
  echo "platform-base: $base"
  # e2e does not run the vm-runner, so a PR only proves it builds, and the
  # cluster does not wait for it: a cold build of its Rust stage takes
  # minutes. The e2e job's last step reads CI_VM_RUNNER_STATUS.
  (
    code=0
    .mise/tasks/image/ci-build amd64 vm-runner:cacheonly || code=$?
    echo "$code" > "${CI_VM_RUNNER_STATUS:?}"
  ) > /tmp/vm-runner-build.log 2>&1 &
  builds=(controller:load api-server:load ui:load keycloak:load) base_arg=()
  if [ "${base%% *}" = REUSE ]; then
    builds+=(mock:load) base_arg=(--base-image "${base#REUSE }") pull_mock=false
  fi
  SECONDS=0
  .mise/tasks/image/ci-build "${base_arg[@]}" amd64 "${builds[@]}"
  echo "$(date -u +%H:%M:%S) images built in ${SECONDS}s"
  LOADED=""
  if [ "$pull_mock" = false ]; then result=ok; exit 0; fi
fi

# CI_IMAGES_JOBS names the jobs e2e needs finished, separated by `|`. cd.yml
# sets it: the job names differ between a PR and every other run, which
# builds one job per arch. `detect stale images` is always on it: when it
# fails, the jobs that need it never start under their names, and nothing
# else would end the wait. `skipped` counts as done, since a PR skips
# build-mock when its platform-base did not move; an image a skipped job did
# not make fails the pull below instead.
: "${CI_IMAGES_JOBS:?}"
IFS='|' read -r -a JOBS <<< "$CI_IMAGES_JOBS"
wanted="$(printf '%s\n' "${JOBS[@]}" | jq -R . | jq -cs .)"

deadline=$((SECONDS + ${CI_IMAGES_TIMEOUT:-2400}))
while :; do
  # filter=latest: on a re-run, a build that passed in an earlier attempt and
  # was not re-run still counts.
  if jobs="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$GITHUB_RUN_ID/jobs?filter=latest&per_page=100" 2>&1)"; then
    state="$(printf '%s' "$jobs" | jq -r --argjson wanted "$wanted" '
      [.jobs[] | select(.name as $n | $wanted | index($n))] as $j
      | ($j | map(select(.status == "completed"))) as $done
      | ($done | map(select(.conclusion != "success" and .conclusion != "skipped"))) as $bad
      | if ($bad | length) > 0 then "failed: " + ($bad | map(.name + "=" + .conclusion) | join(", "))
        elif ($done | length) == ($wanted | length) then "ready"
        else "waiting: \($done | length)/\($wanted | length) done" end')"
  else
    state="waiting: jobs API error: $jobs"
  fi
  echo "$(date -u +%H:%M:%S) $state"
  case "$state" in
    ready) break ;;
    failed:*) exit 1 ;;
  esac
  [ "$SECONDS" -lt "$deadline" ] || { echo "timed out waiting for the image builds" >&2; exit 1; }
  sleep 10
done

# One artifact holds every image's digest, at <component>/<hex>; see
# image:ci-build.
[ -z "$LOADED" ] || gh run download "$GITHUB_RUN_ID" -R "$GITHUB_REPOSITORY" -n digests-images-amd64 -D /tmp/digests

pids=()
for c in $LOADED; do
  docker pull "$IMAGE_PREFIX/$c@sha256:$(ls "/tmp/digests/$c")" &
  pids+=($!)
done
docker pull "$IMAGE_PREFIX/mock:$GITHUB_SHA" &
pids+=($!)
for pid in "${pids[@]}"; do wait "$pid"; done
for c in $LOADED; do
  docker tag "$IMAGE_PREFIX/$c@sha256:$(ls "/tmp/digests/$c")" "platform-$c:latest"
done
docker tag "$IMAGE_PREFIX/mock:$GITHUB_SHA" "platform-mock:latest"

result=ok
echo "$(date -u +%H:%M:%S) images pulled and tagged"
