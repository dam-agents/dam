#!/usr/bin/env bash
#MISE description="Bring up the e2e install: a cluster VM with the shared services, a node VM with the e2e control API on, and the mock harness as its only image."
#MISE hide=true
#MISE raw=true
set -euo pipefail
cd "${MISE_PROJECT_ROOT:?}"
. "${MISE_PROJECT_ROOT}/etc/e2e-env.sh"

mise run cluster:up
# The realm's issuer is the URL the browser uses, which is this cluster's
# shifted Keycloak port, not the dev cluster's.
mise run cluster:install -- --set "urls.keycloak=$PLATFORM_KEYCLOAK_URL" --set "urls.ui=$DAM_UI_URL"
eval "$(mise run cluster:env)"

mise run vm:up
mise run vm:install

# The mock harness is built here and carried in as a saved archive: the node
# pulls from registries, and this image is never pushed to one.
mise run //packages/platform-base:image
docker build -f packages/e2e/agents/mock/Dockerfile -t platform-mock:latest .
docker save platform-mock:latest -o /tmp/platform-mock.tar
limactl copy /tmp/platform-mock.tar "$DAM_VM":/tmp/platform-mock.tar

limactl shell "$DAM_VM" sudo bash -s <<'REMOTE'
set -euo pipefail
install -m 0644 /tmp/platform-mock.tar /var/lib/dam/images/mock.tar

# The mock is the node's whole catalogue: every other template names an image
# the e2e node has no reason to pull.
rm -f /etc/dam/templates/*.yaml
cat > /etc/dam/templates/mock.yaml <<'YAML'
version: "1"
name: Mock
description: Scripted mock agent (e2e test fixture)
category: harness
image: /var/lib/dam/images/mock.tar
hibernationTimeout: 30m
env:
  - name: MOCK_DEFAULT_REPLY
    value: "Hello from the mock agent."
  # A spec proving a queued prompt outlives an abandoned tab waits this out in
  # real time, so the production 90s would cost every such spec a minute and a
  # half of sleeping.
  - name: QUEUE_PARK_MS
    value: "8000"
resources:
  limits:
    cpu: "1"
    memory: 1Gi
YAML

grep -q '^E2E_ENABLED=' /etc/dam/env || echo "E2E_ENABLED=true" >> /etc/dam/env
systemctl restart dam-api-server
REMOTE

mise run e2e:gate
