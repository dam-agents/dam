#!/usr/bin/env bash
#MISE description="Provision or upgrade the e2e test cluster: mock agents only, e2e control API on"
#MISE hide=true
#MISE raw=true
#MISE env={ LIMA_INSTANCE = "platform-k3s-test", DAM_INSTALL = "default", E2E_LANE = "1" }
#USAGE flag "--environment <name>" help="Install the lane into this agent's Environment of that name instead of the test cluster"
set -eo pipefail

. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

export E2E_MOCK_ONLY=1

INSTALL_ARGS=(
  --lima-template=etc/lima/k3s-test.yaml
  --helm-values=helm/values-e2e.yaml
  --set=domain=localhost
  --set=port=6555
  --set=controller.agent.harnessTemplateDefaults.storageSize=1Gi
  --no-restart
)
# In an Environment the suite runs on the backchannel, which this agent
# reaches over the link, on a port of the Environment's own; the public
# addresses are the Environment's endpoints, which only a signed-in browser
# opens. The install restarts only what changed there, so a rerun that
# changed nothing restarts nothing.
if [ "$CLUSTER_TARGET" = environment ]; then
  E2E_PORT="$(env_e2e_port)" || exit 1
  INSTALL_ARGS=(
    --environment "$CLUSTER_ENVIRONMENT"
    --backchannel
    "--backchannel-port=$E2E_PORT"
    --helm-values=helm/values-e2e.yaml
    --set=controller.agent.harnessTemplateDefaults.storageSize=1Gi
  )
fi
# domain=localhost (NOT localtest.me): Chromium treats *.localhost as a
# secure context per the URL spec, so window.crypto.subtle is available
# and oidc-client-ts can generate PKCE state in signinRedirect(). On
# *.localtest.me the page is NOT secure-context, crypto.subtle is undefined,
# the OIDC redirect throws silently, and the SPA hangs on a blank screen.
# Every agent is a microVM, so the install needs a usable /dev/kvm: nested
# virtualization on the lima VM, or a KVM host in sandbox mode. GitHub's
# standard x64 Linux runners expose it; e2e.yml opens it to the runner's user.
#
# Every machine gets four vCPUs, as in production, and counts a booting one at
# 1Gi. The vCPUs are threads of the runner and its CPU request is zero, so they
# reserve nothing on the node and block no start: they only bound the runner's
# CPU limit, which on the small CI node shares its cores among the machines.
# One vCPU each, the lane's old figure, left a guest's one core to the runtime,
# the display stack and Chromium at once: a cold Chromium start took longer than
# the browser launcher's deadline, and the runtime missed the runner's probes
# while it ran. The controller raises the owner's runner pod's memory request by
# each booting machine's count, and on the single 16 GB CI node the control
# plane already requests about 5Gi, so a 2Gi boot estimate took more from what
# the agents' gateways and the other pods can be scheduled into. The mock
# replays scripts, and its guest needs a fraction of 1Gi.
#
# On a Mac the lane keeps the runner pods on nested virtualization rather than
# the host runner cluster:install would pick: the suite restarts the runner by
# deleting its pod, and the one host runner belongs to the dev cluster.
export PLATFORM_NESTED_VIRT=1
INSTALL_ARGS+=(
  # A cache root of the lane's own, not values-local.yaml's. Every machine
  # here boots a staged tree, and image:stage-vm takes the directory from the
  # install's own values, so a staging that rendered the chart on its own
  # would write the trees where no runner mounts and the first boot would
  # fail.
  --set=virtualization.imageCache.hostPath=/var/lib/vm-images
  --set=virtualization.runner.machineCPUs=4
  --set=virtualization.runner.bootMiB=1024
  # The lane boots one harness Template on the default image and its baked
  # tools (smoke/22-harness-tools).
  --set=harnessTemplates.default.enabled=true
)
# E2E_GATEWAY_PER_OWNER=1 serves the lane's agents from one gateway pod per
# owner (virtualization.gateway.perOwner), the path the suite reaches in CI's
# owner-gateway job.
[ -z "${E2E_GATEWAY_PER_OWNER:-}" ] || INSTALL_ARGS+=(--set=virtualization.gateway.perOwner=true)
mise run cluster:install -- "${INSTALL_ARGS[@]}"

# Readiness gate — shared task, see e2e:gate.
mise run e2e:gate
e2e_mark "gate passed"
