#!/usr/bin/env bash
#MISE description="Provision or upgrade the e2e test cluster: mock agents only, e2e control API on"
#MISE hide=true
#MISE raw=true
#MISE env={ LIMA_INSTANCE = "platform-k3s-test" }
set -eo pipefail

. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

export E2E_MOCK_ONLY=1

INSTALL_ARGS=(
  --lima-template=etc/lima/k3s-test.yaml
  --helm-values=helm/values-e2e.yaml
  --set=domain=localhost
  --set=port=5555
  --set=controller.agent.templateDefaults.storageSize=1Gi
  --no-restart
)
# domain=localhost (NOT localtest.me): Chromium treats *.localhost as a
# secure context per the URL spec, so window.crypto.subtle is available
# and oidc-client-ts can generate PKCE state in signinRedirect(). On
# *.localtest.me the page is NOT secure-context, crypto.subtle is undefined,
# the OIDC redirect throws silently, and the SPA hangs on a blank screen.
# E2E_VIRTUALIZATION=1 installs the vm backend too: cluster:install applies the
# KVM device plugin, and values-local.yaml puts the node image cache where
# this install stages its images. The same variable puts the Playwright suite on the vm Backend — every agent it
# creates is a vm agent, and it adds the runtime migration spec — and that run
# fails, rather than skips, on an install without the backend. It needs a
# usable /dev/kvm (nested virtualization on the lima VM, or a KVM host in
# sandbox mode), so it is opt-in: CI sets it only in its vm lane, e2e.yml's
# e2e-vm job on a KVM runner.
#
# That lane also gives every machine one vCPU and counts a booting one at
# 1Gi. One vCPU is what the lane's 1-CPU mock Size gave each machine before
# machines took their shape from the install, on a small CI node that nests
# KVM beside k3s and the browser. The controller raises the owner's runner pod's memory request by each booting
# machine's count, and on the single 16 GB CI node the control plane already
# requests about 5Gi, so a 2Gi boot estimate took more from what the agents'
# gateways and the other pods can be scheduled into. The mock replays
# scripts, and its guest needs a fraction of 1Gi. The mock and default
# Templates keep a 1Gi Size for the container agents the lane still starts,
# such as a runtime migration's source. The container lane keeps the defaults.
#
# On a Mac the lane keeps the runner pods on nested virtualization rather than
# the host runner cluster:install would pick: the suite restarts the runner by
# deleting its pod, and the one host runner belongs to the dev cluster.
if [ -n "${E2E_VIRTUALIZATION:-}" ]; then
  export PLATFORM_NESTED_VIRT=1
  INSTALL_ARGS+=(
    --set=virtualization.enabled=true
    --set=virtualization.runner.machineCPUs=1
    --set=virtualization.runner.bootMiB=1024
    --set=harnessTemplates.mock.resources.limits.cpu=1000m
    --set=harnessTemplates.mock.resources.limits.memory=1Gi
  )
  # The lane also boots one harness Template on the default image and its
  # baked tools (smoke/22-harness-tools): the default Template, sized like the
  # mock.
  INSTALL_ARGS+=(
    --set=harnessTemplates.default.enabled=true
    --set=harnessTemplates.default.resources.limits.cpu=1000m
    --set=harnessTemplates.default.resources.limits.memory=1Gi
  )
  # E2E_GATEWAY_PER_OWNER=1 serves the lane's vm agents from one gateway pod
  # per owner (virtualization.gateway.perOwner), the path no other suite
  # reaches; CI's vm lane sets it.
  [ -z "${E2E_GATEWAY_PER_OWNER:-}" ] || INSTALL_ARGS+=(--set=virtualization.gateway.perOwner=true)
else
  # The container lane says so: outside CI cluster:install turns the vm
  # backend on by itself on an Apple silicon Mac and in a sandbox that can
  # open /dev/kvm.
  INSTALL_ARGS+=(--set=virtualization.enabled=false)
fi
mise run cluster:install -- "${INSTALL_ARGS[@]}"

# Readiness gate — shared task, see e2e:gate.
mise run e2e:gate
e2e_mark "gate passed"
