#!/usr/bin/env bash
#MISE description="Provision/upgrade the e2e test cluster (mock-only agents, e2e control API on). Shared by `e2e` and `e2e:loop`."
#MISE hide=true
#MISE raw=true
#MISE env={ LIMA_INSTANCE = "platform-k3s-test" }
set -eo pipefail

. "$MISE_CONFIG_ROOT/.mise/lib/cluster.sh"

export E2E_MOCK_ONLY=1

INSTALL_ARGS=(
  --lima-template=etc/lima/k3s-test.yaml
  --helm-values=helm/values-e2e.yaml
  --set=domain=localhost
  --set=port=5555
  --set=controller.agent.templateDefaults.storageSize=1Gi
  --no-restart
)
# domain=localhost (NOT localtest.me): Chromium treats *.localhost as a
# secure context per the URL spec, so window.crypto.subtle is available
# and oidc-client-ts can generate PKCE state in signinRedirect(). On
# *.localtest.me the page is NOT secure-context, crypto.subtle is undefined,
# the OIDC redirect throws silently, and the SPA hangs on a blank screen.
# E2E_VIRTUALIZATION=1 installs the vm backend too: values-local.yaml already
# turns on the chart's own KVM device plugin, states the runner's egressCidrs
# and points the runners at the images this install stages on the node. The
# same variable puts the Playwright suite on the vm Backend — every agent it
# creates is a vm agent, and it adds the runtime migration spec — and that run
# fails, rather than skips, on an install without the backend. It needs a
# usable /dev/kvm (nested virtualization on the lima VM, or a KVM host in
# sandbox mode), so it is opt-in: CI sets it only in its vm lane, cd.yml's
# e2e-vm job on a KVM runner.
#
# That lane also gives the mock agents a 1Gi Size instead of the 2Gi default.
# A vm Agent's machine gets its Size's memory, and the controller raises its
# owner's runner pod's memory request to the sum over the running machines
# plus the runner's 512Mi reserve, so the scheduler sees what the guests hold.
# On the single 16 GB CI node the control plane already requests about 5Gi,
# and every 2Gi machine the suite runs at once took 2Gi more from what the
# agents' gateways and the other pods can be scheduled into. The mock replays
# scripts, and its guest needs a fraction of 1Gi. The container lane keeps the
# default, so its agents are sized as before.
#
# On a Mac the lane keeps the runner pods on nested virtualization rather than
# the host runner cluster:install would pick: the suite restarts the runner by
# deleting its pod, and the one host runner belongs to the dev cluster.
if [ -n "${E2E_VIRTUALIZATION:-}" ]; then
  export PLATFORM_NESTED_VIRT=1
  INSTALL_ARGS+=(
    --set=virtualization.enabled=true
    --set=harnessTemplates.mock.resources.limits.cpu=1000m
    --set=harnessTemplates.mock.resources.limits.memory=1Gi
  )
  # The lane also boots one harness Template on the default image and the
  # node's harness tools (smoke/22-harness-tools): the Claude Code Template,
  # sized like the mock, and the per-node installer that fills its tools.
  INSTALL_ARGS+=(
    --set=harnessTemplates.claude-code.enabled=true
    --set=harnessTemplates.claude-code.resources.limits.cpu=1000m
    --set=harnessTemplates.claude-code.resources.limits.memory=1Gi
    --set=harnessTools.hostPath=/var/lib/platform-harness-tools
  )
else
  # The container lane says so: in sandbox mode cluster:install turns the vm
  # backend on by itself wherever it can open /dev/kvm.
  INSTALL_ARGS+=(--set=virtualization.enabled=false)
fi
mise run cluster:install -- "${INSTALL_ARGS[@]}"

# Readiness gate — shared task, see e2e:gate.
mise run e2e:gate
e2e_mark "gate passed"
