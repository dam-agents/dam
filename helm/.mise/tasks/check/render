#!/usr/bin/env bash
#MISE description="The chart renders, telemetry backend included"
#MISE sources=["**/*.{yaml,yml,tpl}", "charts/*.tgz"]
#MISE outputs=[]
#MISE cache.enabled=true
# Render with the telemetry backend enabled so its manifests are schema-checked too. The
# clickstack subchart emits operator custom resources (ClickHouseCluster/KeeperCluster/
# MongoDBCommunity) that kubeconform has no schema for — skip them alongside the existing
# CRD/Istio kinds. Not network-sandboxed: kubeconform fetches its schemas.
set -euo pipefail
KUBECONFORM=(kubeconform -strict -summary -skip Certificate,Issuer,ClusterIssuer,AuthorizationPolicy,DestinationRule,Gateway,SecurityContextConstraints,CustomResourceDefinition,ClickHouseCluster,KeeperCluster,MongoDBCommunity)
COMMON=(--include-crds --set terms.version=test --set terms.text='Test Terms')
helm template platform . "${COMMON[@]}" --set clickstack.enabled=true | "${KUBECONFORM[@]}" "$@"
# The vm backend renders a whole second set of objects (runner, its policy and
# credentials) that the default values never reach — and,
# with the telemetry backend on, the collector's runner scrape and its RBAC.
helm template platform . "${COMMON[@]}" --set virtualization.enabled=true \
  --set virtualization.runner.resources.limits.memory=8Gi \
  --set 'virtualization.runner.egressCidrs[0]=0.0.0.0/0' \
  --set 'virtualization.runner.dnsCidrs[0]=10.0.2.3/32' \
  --set openshift.scc.anyuidCapNet.enabled=true --set agentNamespace=platform-agents \
  --set virtualization.runner.scc=hostmount-anyuid \
  --set virtualization.runner.releaseHostPath=/var/lib/platform-runner-releases \
  --set clickstack.enabled=true \
  | "${KUBECONFORM[@]}" "$@"
# The node image cache adds one more object nothing else renders: the DaemonSet
# that is the only writer of the node directory, which exists only where the
# cache is a node directory.
helm template platform . "${COMMON[@]}" --set virtualization.enabled=true \
  --set virtualization.runner.resources.limits.memory=8Gi \
  --set 'virtualization.runner.egressCidrs[0]=0.0.0.0/0' \
  --set virtualization.runner.scc=hostmount-anyuid \
  --set virtualization.imageCache.hostPath=/var/lib/platform-images \
  --set agentNamespace=platform-agents \
  | "${KUBECONFORM[@]}" "$@"
# The stager DaemonSet with the node image cache beside it.
helm template platform . "${COMMON[@]}" --set virtualization.enabled=true \
  --set virtualization.runner.resources.limits.memory=8Gi \
  --set 'virtualization.runner.egressCidrs[0]=0.0.0.0/0' \
  --set virtualization.imageCache.hostPath=/var/lib/platform-images \
  --set virtualization.runner.releaseHostPath=/var/lib/platform-runner-releases \
  --set agentNamespace=platform-agents \
  | "${KUBECONFORM[@]}" "$@"
# With install default pull Secrets the cache service also mounts them as a
# projected volume, which no other render reaches.
helm template platform . "${COMMON[@]}" --set virtualization.enabled=true \
  --set virtualization.runner.resources.limits.memory=8Gi \
  --set 'virtualization.runner.egressCidrs[0]=0.0.0.0/0' \
  --set virtualization.imageCache.hostPath=/var/lib/platform-images \
  --set 'controller.agent.base.imagePullSecrets[0]=regcred' \
  --set 'controller.agent.base.imagePullSecrets[1]=fallback' \
  --set agentNamespace=platform-agents \
  | "${KUBECONFORM[@]}" "$@"
# The runners' serving certificates come from their own CA, so the vm backend
# renders its issuers, and the controller's right to request Certificates, with
# the envoyMitm path off.
helm template platform . "${COMMON[@]}" --set virtualization.enabled=true \
  --set virtualization.runner.resources.limits.memory=8Gi \
  --set 'virtualization.runner.egressCidrs[0]=0.0.0.0/0' \
  --set virtualization.runner.dnsPolicy=ClusterFirst \
  --set controller.envoyMitm.enabled=false \
  | "${KUBECONFORM[@]}" "$@"
# A confined runner reaches DNS only at the resolver it uses. One that caches
# on its own claim and names no resolver, a resolver range of /0, and an
# egress entry naming the link-local metadata endpoint all fail the render, as
# does a VMM seccomp mode smolvm would read as no filter.
VM=(--set virtualization.enabled=true --set virtualization.runner.resources.limits.memory=8Gi
  --set 'virtualization.runner.egressCidrs[0]=0.0.0.0/0')
for refused in 'virtualization.runner.dnsPolicy=Default' \
  'virtualization.runner.dnsCidrs[0]=0.0.0.0/0' \
  'virtualization.runner.egressCidrs[1]=169.254.169.254/32' \
  'virtualization.runner.clusterDns=null' \
  'virtualization.runner.seccomp=permissive'; do
  extra=(--set "$refused")
  case "$refused" in
    *seccomp*) extra+=(--set virtualization.imageCache.hostPath=/var/lib/platform-images) ;;
    *egressCidrs*) extra+=(--set 'virtualization.runner.dnsCidrs[0]=10.0.2.3/32') ;;
    *clusterDns*) extra+=(--set virtualization.runner.dnsPolicy=ClusterFirst) ;;
  esac
  if helm template platform . "${COMMON[@]}" "${VM[@]}" "${extra[@]}" >/dev/null 2>&1; then
    echo "a render setting $refused succeeded, but it leaves the runner's DNS or metadata open" >&2
    exit 1
  fi
done
# An unquoted `seccomp: off` in a values file arrives as a boolean, and must
# still mean no filter rather than the default.
helm template platform . "${COMMON[@]}" "${VM[@]}" \
  --set virtualization.imageCache.hostPath=/var/lib/platform-images \
  --set virtualization.runner.seccomp=false | grep '\\"seccomp\\":\\"off\\"' >/dev/null ||
  { echo "a render with seccomp=false did not give the runners seccomp off" >&2; exit 1; }
# A runner on the node cache resolves nothing, so it needs no resolver named.
helm template platform . "${COMMON[@]}" "${VM[@]}" \
  --set virtualization.imageCache.hostPath=/var/lib/platform-images >/dev/null
# Runner pods take a new runner image only from the node's release directory,
# so an install that clears it fails the render.
if helm template platform . "${COMMON[@]}" "${VM[@]}" \
  --set virtualization.imageCache.hostPath=/var/lib/platform-images \
  --set virtualization.runner.releaseHostPath= >/dev/null 2>&1; then
  echo "a render with runner pods and no releaseHostPath succeeded, but no runner could take a new release" >&2
  exit 1
fi
# Virtualization keys the chart no longer reads fail the render rather than
# being dropped without a word.
for removed in 'virtualization.imageCache.preload.enabled=false' \
  'virtualization.runner.releaseSameRuntimeOnly=true' \
  'virtualization.runner.ingressCidrs[0]=10.0.0.0/8' \
  'virtualization.runner.canaryImage=quay.io/x/vm-runner:canary'; do
  if helm template platform . "${COMMON[@]}" --set "$removed" >/dev/null 2>&1; then
    echo "a render setting $removed succeeded, but the chart no longer reads it" >&2
    exit 1
  fi
done
# istio.enforce=false is local-only. An offline render finds no local no-mesh
# marker, so it must fail, and fail for that reason rather than another one; a
# value that is not a boolean must not slip through as truthy either.
for unenforced in '--set istio.enforce=false' '--set-string istio.enforce=false'; do
  # shellcheck disable=SC2086
  if out=$(helm template platform . "${COMMON[@]}" $unenforced 2>&1 >/dev/null); then
    echo "a render with $unenforced succeeded, but only a local no-mesh cluster may leave the mesh unenforced" >&2
    exit 1
  fi
  case "$out" in
    *'istio.enforce=false is local-only'* | *'istio.enforce must be true or false'*) ;;
    *) echo "a render with $unenforced failed for another reason: $out" >&2; exit 1 ;;
  esac
done
# An install that reads kits from an enterprise host renders the api-server's
# catalog credential, which the default values leave out entirely.
helm template platform . "${COMMON[@]}" \
  --set github.enterprise.host=github.example.com \
  --set github.enterprise.token=ghe-test-token \
  | "${KUBECONFORM[@]}" "$@"
# Every install token and client secret reaches the api-server through its
# credentials Secret, which the default values leave out entirely.
helm template platform . "${COMMON[@]}" \
  --set apiServer.slackBotToken=t --set apiServer.slackAppToken=t \
  --set apiServer.slackClientId=c --set apiServer.slackClientSecret=s \
  --set apiServer.telegramBotToken=t --set apiServer.imgbbApiKey=k \
  --set apiServer.oauthAppDefaults.github.clientId=c --set apiServer.oauthAppDefaults.github.clientSecret=s \
  --set apiServer.oauthAppDefaults.githubEnterprise.host=github.example.com \
  --set apiServer.oauthAppDefaults.githubEnterprise.clientId=c --set apiServer.oauthAppDefaults.githubEnterprise.clientSecret=s \
  --set apiServer.oauthAppDefaults.slack.clientId=c --set apiServer.oauthAppDefaults.slack.clientSecret=s \
  | "${KUBECONFORM[@]}" "$@"
# The VM pool alerts render only where the cluster serves prometheus-operator's
# API; the render must hold both, and kubeconform has no schema for its kinds.
MONITORING=(--set monitoring.enabled=true --set clickstack.enabled=true --set virtualization.enabled=true
  --set virtualization.runner.resources.limits.memory=8Gi --set 'virtualization.runner.egressCidrs[0]=0.0.0.0/0'
  --set 'virtualization.runner.dnsCidrs[0]=10.0.2.3/32' --set virtualization.runner.scc=hostmount-anyuid --set agentNamespace=platform-agents)
rendered=$(helm template platform . "${COMMON[@]}" "${MONITORING[@]}" \
  --api-versions monitoring.coreos.com/v1/ServiceMonitor --api-versions monitoring.coreos.com/v1/PrometheusRule)
grep -q '^kind: PrometheusRule$' <<<"$rendered" && grep -q '^kind: ServiceMonitor$' <<<"$rendered" \
  || { echo "monitoring.enabled with prometheus-operator's API rendered no PrometheusRule or ServiceMonitor" >&2; exit 1; }
# A second -skip would replace the first, so the operator kinds join its list.
"${KUBECONFORM[@]:0:3}" -skip "${KUBECONFORM[4]},ServiceMonitor,PrometheusRule" "$@" <<<"$rendered"
! helm template platform . "${COMMON[@]}" "${MONITORING[@]}" | grep -Eq '^kind: (PrometheusRule|ServiceMonitor)$' \
  || { echo "monitoring.enabled without prometheus-operator's API rendered its kinds" >&2; exit 1; }
# The Postgres health checks take their timing from values: by default liveness
# waits 10s per check and kills only after 6 misses, and an override reaches the
# pod. Both keep checking the postgres database.
pg_probes() {
  helm template platform . "${COMMON[@]}" --show-only templates/postgres.yaml "$@" |
    yq -o=json 'select(.kind == "StatefulSet") | .spec.template.spec.containers[0] | {"liveness": .livenessProbe, "readiness": .readinessProbe}'
}
probes=$(pg_probes)
jq -e '.liveness.timeoutSeconds == 10 and .liveness.failureThreshold == 6 and .liveness.periodSeconds == 15
  and .readiness.timeoutSeconds == 5 and .readiness.failureThreshold == 10 and .readiness.periodSeconds == 5
  and ([.liveness, .readiness] | all(.exec.command | index(["-d", "postgres"]) != null))' <<<"$probes" >/dev/null ||
  { echo "the default Postgres health checks are not the tolerant ones: $probes" >&2; exit 1; }
probes=$(pg_probes --set postgres.livenessProbe.timeoutSeconds=30 --set postgres.readinessProbe.failureThreshold=3)
jq -e '.liveness.timeoutSeconds == 30 and .liveness.failureThreshold == 6 and .readiness.failureThreshold == 3' <<<"$probes" >/dev/null ||
  { echo "postgres.livenessProbe / readinessProbe overrides did not reach the Postgres pod: $probes" >&2; exit 1; }
# The built-in provider's CA reaches the api-server as a file from the named
# ConfigMap key, which the default values leave out entirely.
ca=$(helm template platform . "${COMMON[@]}" --show-only templates/apiserver/app.yaml \
  --set apiServer.platformProvider.baseUrl=https://llm.models.svc:8443 --set apiServer.platformProvider.apiKey=k \
  --set apiServer.platformProvider.caConfigMap.name=openshift-service-ca.crt \
  --set apiServer.platformProvider.caConfigMap.key=service-ca.crt |
  yq -o=json 'select(.kind == "Deployment") | .spec.template.spec')
jq -e '(.containers[0].env[] | select(.name == "PLATFORM_PROVIDER_CA_FILE") | .value) as $file
  | (.containers[0].volumeMounts[] | select(.name == "platform-provider-ca") | .mountPath + "/ca.crt") == $file
  and any(.volumes[]; .name == "platform-provider-ca" and .configMap.name == "openshift-service-ca.crt"
    and .configMap.items == [{"key": "service-ca.crt", "path": "ca.crt"}])' <<<"$ca" >/dev/null ||
  { echo "apiServer.platformProvider.caConfigMap did not mount the CA file the api-server reads: $ca" >&2; exit 1; }
