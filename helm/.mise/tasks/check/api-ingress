#!/usr/bin/env bash
#MISE description="The api-server's ingress policy admits an Agent gateway on its public port over HBONE, and only from the agent namespace"
#MISE sources=["templates/apiserver/networkpolicy.yaml", "templates/apiserver/app.yaml", "templates/_helpers.tpl"]
#MISE outputs=[]
#MISE cache.enabled=true
# The chain of the Connection that drives this install ends at the api-server's
# public port, and the ambient mesh carries that hop as HBONE. Without a rule
# for 15008 from the agent namespace, the kernel drops it and the Agent's CLI
# never reaches the API it acts on; with a wider one, any namespace could open
# that hop. The API key the chain injects stays the authentication, so this
# checks the perimeter only.
set -euo pipefail
render() {
  helm template platform . --namespace default \
    --set terms.version=test --set terms.text='Test Terms' \
    --set virtualization.runner.resources.limits.memory=8Gi \
    --set virtualization.imageCache.hostPath=/var/lib/platform-images \
    --set virtualization.runner.releaseHostPath=/var/lib/platform-runner-releases \
    --set agentNamespace=platform-agents "$@" |
    yq -N 'select(.kind == "NetworkPolicy" and (.metadata.name | test("apiserver-ingress$")))'
}

policy=$(render)
[ -n "$policy" ] || { echo "no api-server ingress NetworkPolicy rendered" >&2; exit 1; }

port=$(yq -N '.spec.ingress[] | select(.ports[]?.port == 4000) | .ports[].port' <<<"$policy" | head -1)
[ -n "$port" ] || { echo "the policy admits no public port" >&2; exit 1; }

# The mesh hop: one rule admits 15008 from the agent namespace, and no rule
# admits it from anywhere at all.
yq -N '.spec.ingress[] | select(.ports[]?.port == 15008) | [.from[]?.namespaceSelector.matchLabels."kubernetes.io/metadata.name"] | join(",")' <<<"$policy" |
  grep -qx platform-agents || { echo "no rule admits HBONE from the agent namespace" >&2; exit 1; }
yq -N '[.spec.ingress[] | select(.ports[]?.port == 15008 and (.from == null or (.from | length) == 0))] | length' <<<"$policy" |
  grep -qx 0 || { echo "a rule admits HBONE from every namespace" >&2; exit 1; }

# The api-server learns the address the chain takes the request to; a chart
# that stops naming it leaves the Connection pointing nowhere.
app=$(helm template platform . --namespace default \
  --set terms.version=test --set terms.text='Test Terms' \
  --set virtualization.runner.resources.limits.memory=8Gi \
  --set virtualization.imageCache.hostPath=/var/lib/platform-images \
  --set virtualization.runner.releaseHostPath=/var/lib/platform-runner-releases \
  --set agentNamespace=platform-agents |
  yq -N 'select(.kind == "Deployment" and (.metadata.name | test("apiserver$")))')
echo "$app" | yq -N '.spec.template.spec.containers[].env[] | select(.name == "PLATFORM_APISERVER_URL") | .value' |
  grep -qE '^http://platform-apiserver\.[a-z0-9-]+\.svc\.cluster\.local:4000$' ||
  { echo "the api-server is not told its own Service address" >&2; exit 1; }
echo "api-ingress: ok"
