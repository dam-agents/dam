{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/dam-agents/dam-starter-kits/main/catalog.schema.json",
  "title": "Starter kit catalog",
  "type": "object",
  "properties": {
    "kits": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "path": {
            "default": ".",
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "required": [
    "kits"
  ]
}
