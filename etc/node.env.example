# Node configuration beyond what `vm:install` derives. Copy to etc/node.env
# (or point DAM_NODE_ENV_FILE at your own) and set what your install needs.
# Everything here is optional; each unset value leaves its feature off or at
# its built-in default. Appended to /etc/dam/env last, so it wins.

# Messenger channels. Without these, Slack and Telegram do not run at all.
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...
# SLACK_OAUTH_CALLBACK_URL=https://example.invalid/api/oauth/slack/callback
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_BOT_USERNAME=...

# Install-wide OAuth apps. Unset means every user registers their own.
# PLATFORM_DEFAULT_GITHUB_CLIENT_ID=
# PLATFORM_DEFAULT_GITHUB_CLIENT_SECRET=
# PLATFORM_DEFAULT_GITHUB_APP_SLUG=
# PLATFORM_DEFAULT_SLACK_CLIENT_ID=
# PLATFORM_DEFAULT_SLACK_CLIENT_SECRET=

# Branding. Unset leaves the built-in names and accents.
# BRAND_NAME=
# BRAND_SHORT=
# BRAND_TITLE=
# BRAND_VENDOR=

# Agent telemetry backend. Unset leaves the spend and usage surfaces closed.
# CLICKHOUSE_URL=
# CLICKHOUSE_USER=
# CLICKHOUSE_PASSWORD=
# CLICKHOUSE_DATABASE=

# Skill sources seeded into the catalogue on first boot.
# SKILL_SOURCES_SEED=
