#!/usr/bin/env bash
#MISE description="Run the runner's and platform-init's tests"
# Runs both packages of the workspace: the runner and platform-init. Beside
# their sources, two kinds of file are inputs because the tests read them. The
# contract fixtures are what this crate and the controller are both held to —
# the controller's tests read the same files — so a fixture the controller's
# side changed must rerun these. The image's entrypoint (image.toml) passes
# arguments this binary has to accept, and the chart's image cache template the
# arguments the image cache service has to accept.
#MISE sources=["src/**/*.rs", "tests/**/*.rs", "platform-init/src/**/*.rs", "Cargo.toml", "platform-init/Cargo.toml", "Cargo.lock", "smolvm.pin", "smolvm.patch", "contract/*.json", "image.toml", "reboot-id", "{{vars.repo_root}}/helm/templates/controller/vm-image-cache.yaml", "{{vars.repo_root}}/helm/templates/controller/vm-runner-releases.yaml"]
#MISE outputs=[]
#MISE cache.enabled=true
set -euo pipefail
cargo test --locked "$@"
# The guest agent is rebuilt from smolvm.patch for the image (see oci), so the
# patch's own tests run too: the launch-exit record a failed launch leaves, the
# signal a reaped child keeps for the embedder that did not reap it, and how
# long that note is offered for.
cargo test --locked --manifest-path .smolvm/Cargo.toml -p smolvm --lib -- \
    a_failed_launch_record_names_the_pid_and_the_signal \
    a_reaped_child_keeps_its_signal_for_the_embedder_once \
    a_note_past_its_window_is_not_offered
