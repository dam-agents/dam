#!/usr/bin/env bash
# The suite reads Go source as its source of truth, so every Go file it can
# reach is an input: a cache hit on a stale key would replay a pass the drift
# tests never ran, exactly when a Go change is what they exist to catch. Whole
# directories are declared rather than the files read today, so a test added
# later cannot silently fall outside the key. This list grows with the packages
# gosource::read_in is pointed at — reconciler is here because the share's CA
# file name is pinned against the agent environment the controller builds.
# `smolvm.pin` is an input for the same reason on the other side: the clone it
# names is what this compiles against, and the provider that makes it is not a
# task, so its staleness never reaches this key. A pin that moves `commit=`
# alone leaves `Cargo.lock` untouched — smolvm is a path dependency, recorded
# there as a bare version — so without this the run is replayed against the
# source it was taken on.
#MISE sources=["src/**/*.rs", "Cargo.toml", "Cargo.lock", "smolvm.pin", "{{vars.repo_root}}/packages/controller/pkg/vmrunner/*.go", "{{vars.repo_root}}/packages/controller/pkg/reconciler/*.go"]
#MISE outputs=[]
#MISE cache.enabled=true
set -euo pipefail
cargo test --locked "$@"
