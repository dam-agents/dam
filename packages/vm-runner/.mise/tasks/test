#!/usr/bin/env bash
# Runs both packages of the workspace: the runner and platform-init. Beside
# their sources, two kinds of file are inputs because the tests read them. The
# contract fixtures are what this crate and the controller are both held to —
# the controller's tests read the same files — so a fixture the controller's
# side changed must rerun these. The Dockerfile's ENTRYPOINT passes arguments
# this binary has to accept, and the chart's image cache template the
# arguments the image cache service has to accept. `smolvm.pin` is an input for
# the same reason as in the checks: the clone it names is what this compiles
# against, and the provider that makes it is not a task, so its staleness never
# reaches this key. A pin that moves `commit=` alone leaves `Cargo.lock`
# untouched — smolvm is a path dependency, recorded there as a bare version —
# so without this the run is replayed against the source it was taken on.
#MISE sources=["src/**/*.rs", "platform-init/src/**/*.rs", "Cargo.toml", "platform-init/Cargo.toml", "Cargo.lock", "smolvm.pin", "contract/*.json", "Dockerfile", "{{vars.repo_root}}/helm/templates/controller/vm-image-cache.yaml"]
#MISE outputs=[]
#MISE cache.enabled=true
set -euo pipefail
cargo test --locked "$@"
