#!/usr/bin/env bash
#MISE description="Build the VM runner image to dist/oci/vm-runner.tar"
# With mise oci: the runner, the image cache service, the seed uploader,
# platform-init and platform-runc, compiled from this crate, on Debian with
# the smolvm release smolvm.pin names. Off Linux it builds in the dev
# cluster's Lima VM.
# By path too: the Lima VM runs it with only the tools it names.
set -euo pipefail
pkg="$(cd "$(dirname "$0")/../.." && pwd)"
repo="$(cd "$pkg/../.." && pwd)"
cd "$pkg"
out=dist/oci/vm-runner.tar

if [ "$(uname -s)" != Linux ]; then
  . "$repo/.mise/lib/lima-build.sh"
  # build-essential: the linker cargo needs, and glibc's static archive for
  # platform-init; git clones smolvm, and usage runs image:name-layout. The
  # VM's copy of the tree is made afresh every build, so cargo's target lives
  # beside it.
  lima_build "build-essential git" "rust crane jq usage" \
    sh -c 'CARGO_TARGET_DIR="$HOME/.cache/platform-vm-runner/target" exec packages/vm-runner/.mise/tasks/oci'
  mkdir -p "$(dirname "$out")"
  lima_cat "packages/vm-runner/$out" > "$out"
  exit
fi

# platform-init links statically against glibc's static archive, which zig
# cannot provide, so the image builds with the system's C toolchain rather than
# the zig .mise/config.toml's [env] selects for checks and tests.
t="$(uname -m)_unknown_linux_gnu"
unset "CC_$t" "AR_$t" "CARGO_TARGET_$(printf '%s' "$t" | tr '[:lower:]' '[:upper:]')_LINKER"

sudo=(); [ "$(id -u)" = 0 ] || sudo=(sudo --preserve-env env "PATH=$PATH")
work="$(mktemp -d)"
trap 'rm -rf "$work"' EXIT
b="$work/build"
rel="$b/usr/local/libexec/vm-runner"
install -d "$b/usr/local/bin" "$rel" "$b/opt/smolvm"

# Built for the host's arch rather than cross-compiled: CI builds each
# architecture on a runner of that architecture. The runner links the host's
# glibc dynamically; the check at the end runs it against the image's.
./.mise/fetch-smolvm
target="${CARGO_TARGET_DIR:-target}"
cargo build --release --locked -p vm-runner
# vm-seed is run from this image by the controller's migration Job, which
# uploads an agent's old volume to its runner as the seed of its home.
# The runner and the guest binaries it copies into every share are one runner
# release, kept in one directory: the loader runs this one, or the same files a
# node's stager copied from a newer image (see vm-runner-loader).
install -m 755 "$target/release/vm-runner-loader" "$target/release/vm-image-cache" "$target/release/vm-seed" "$b/usr/local/bin/"
install -m 755 "$target/release/vm-runner" "$rel/"
# platform-init and platform-runc run inside the agent's image, which shares no
# libc with this one, so they are linked statically, against glibc's static archive. The static
# flag is scoped to platform-init's own target triple, so it reaches neither
# the runner nor the build scripts cargo runs on the host.
host="$(rustc -vV | sed -n 's/^host: //p')"
RUSTFLAGS="-C target-feature=+crt-static" cargo build --release --locked -p platform-init --target "$host"
# A binary that names a program interpreter (PT_INTERP) is linked dynamically.
# Read from its program headers, for a 64-bit little-endian ELF: ldd's verdict
# on a static-pie binary differs between architectures.
interp() {
  local off size n i
  off=$(od -An -t u8 -j 32 -N 8 "$1") size=$(od -An -t u2 -j 54 -N 2 "$1") n=$(od -An -t u2 -j 56 -N 2 "$1")
  for ((i = 0; i < n; i++)); do
    [ "$(od -An -t u4 -j $((off + i * size)) -N 4 "$1" | tr -d ' ')" != 3 ] || return 0
  done
  return 1
}
for bin in platform-init platform-runc; do
  built="$target/$host/release/$bin"
  ! interp "$built" || { echo "$bin names a program interpreter, and would fail inside a guest" >&2; exit 1; }
  install -m 755 "$built" "$rel/$bin"
done

case "$(uname -m)" in
  x86_64) arch=x86_64 crane_sha=0ab7a1d6932a213aed964ce97666c3077fe691c8606413674a8b3e0b9ec4cda0 ;;
  aarch64) arch=arm64 crane_sha=898c0cff975f898a33e8c4580bdafb0e7c02c7faa33374e946762f97c4ab7110 ;;
  *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;;
esac
cache="${XDG_CACHE_HOME:-$HOME/.cache}/platform-vm-runner"
mkdir -p "$cache"
# <url> <sha256> -> a cached file with that digest.
fetch() {
  local f="$cache/$2"
  if ! echo "$2  $f" | sha256sum -c --status - 2>/dev/null; then
    curl -fsSL "$1" -o "$f.part"
    echo "$2  $f.part" | sha256sum -c --quiet - || { rm -f "$f.part"; exit 1; }
    mv "$f.part" "$f"
  fi
  echo "$f"
}

# The smolvm release is refused unless it has the digest smolvm.pin records for
# this architecture. It is already the layout the runner reads — the launcher,
# with its libraries, the guest agent's rootfs and the compressed disk
# templates beside it — so only those are unpacked, and the release's
# Kubernetes shim, which the runner does not use, is left out.
version="$(sed -n 's/^tag=v//p' smolvm.pin)"
sha="$(sed -n "s/^sha256-linux-${arch}=//p" smolvm.pin)"
[ -n "$version" ] && [ -n "$sha" ] || { echo "smolvm.pin names no release for linux-${arch}" >&2; exit 1; }
release="smolvm-${version}-linux-${arch}"
tar -xzf "$(fetch "https://github.com/smol-machines/smolvm/releases/download/v${version}/${release}.tar.gz" "$sha")" \
  -C "$b/opt/smolvm" --strip-components=1 --no-same-owner \
  "${release}/smolvm" "${release}/smolvm-bin" "${release}/lib" "${release}/agent-rootfs" \
  "${release}/storage-template.ext4.zst" "${release}/overlay-template.ext4.zst"

# libkrun is the release's own, rebuilt from the commit smolvm.pin names with
# libkrun.patch applied: fixes for guest-reachable bugs in its virtio devices
# that the release does not have yet. Built as smolvm's release workflow builds
# it (make BLK=1 NET=1 INPUT=1 GPU=1, partial RELRO, virglrenderer dropped from
# NEEDED) but with mise.lock's compiler, on this host, like the runner. A build
# that exports a different set of krun_* symbols than the release lib is
# refused, since smolvm resolves them at runtime and a missing one fails a boot.
# Drop this once a smolvm release ships these fixes.
lk_deps="clang libclang-dev patchelf pkg-config libvirglrenderer-dev libepoxy-dev libdrm-dev libgbm-dev"
lk_missing=$(for p in $lk_deps; do dpkg -s "$p" >/dev/null 2>&1 || echo "$p"; done)
# Unattended and bounded: CI runs this in the background beside a starting k3s,
# where a debconf or needrestart prompt waits on stdin for good, a needrestart
# restart takes k3s down, and a stalled mirror or fetch hangs the e2e job until
# its step times out, with nothing in the log.
apt=(${sudo[@]+"${sudo[@]}"} env DEBIAN_FRONTEND=noninteractive NEEDRESTART_MODE=l timeout 600 apt-get -o DPkg::Lock::Timeout=300)
[ -z "$lk_missing" ] || { "${apt[@]}" update -qq && "${apt[@]}" install -y -qq $lk_missing; } </dev/null
timeout 600 rustup target add "$(uname -m)-unknown-linux-musl" >/dev/null
lk_commit="$(sed -n 's/^libkrun-commit=//p' smolvm.pin)"
[ -n "$lk_commit" ] || { echo "smolvm.pin names no libkrun-commit" >&2; exit 1; }
lk="$cache/libkrun"
if [ "$(git -C "$lk" rev-parse HEAD 2>/dev/null)" != "$lk_commit" ]; then
  rm -rf "$lk"
  git init -q "$lk"
  timeout 600 git -C "$lk" fetch -q --depth 1 https://github.com/smol-machines/libkrun "$lk_commit"
  git -C "$lk" checkout -q FETCH_HEAD
fi
# Its target stays between builds; only the sources are reset.
git -C "$lk" checkout -q -- .
git -C "$lk" apply "$pkg/libkrun.patch"
env -u CARGO_TARGET_DIR LIBCLANG_PATH="$(dirname "$(find /usr/lib -name 'libclang.so*' | head -1)")" RUSTFLAGS="-C relro-level=partial" \
  make -C "$lk" --no-print-directory BLK=1 NET=1 INPUT=1 GPU=1 >/dev/null
lk_so="$lk/target/release/libkrun.so.2.0.0"
patchelf --remove-needed libvirglrenderer.so.1 "$lk_so"
krun_symbols() { nm -D --defined-only "$1" | awk '$3 ~ /^krun_/ {print $3}' | sort; }
[ "$(krun_symbols "$lk_so")" = "$(krun_symbols "$b/opt/smolvm/lib/libkrun.so")" ] ||
  { echo "patched libkrun exports other krun_* symbols than the release's" >&2; diff <(krun_symbols "$lk_so") <(krun_symbols "$b/opt/smolvm/lib/libkrun.so") >&2; exit 1; }
install -m 755 "$lk_so" "$b/opt/smolvm/lib/libkrun.so"

# smolvm's guest rootfs ships a crane built with Go 1.21.6 and go-containerregistry
# v0.19-era deps (docker/docker v24, x/sys v0.8.0) — 3 critical + 54 lesser CVEs, all
# from this one file. Upstream has not rebuilt it as of 1.24.1, so replace it here.
# Drop this once a smolvm release ships a current crane.
#
# The same binary serves the runner: a machine may reach only its gateway, so the
# guest cannot fetch its own image: the runner fetches it into its own cache, or
# the image cache service into a node cache.
crane_version=v0.22.1
tar -xzf "$(fetch "https://github.com/google/go-containerregistry/releases/download/${crane_version}/go-containerregistry_Linux_${arch}.tar.gz" "$crane_sha")" \
  -C "$b/opt/smolvm/agent-rootfs/usr/local/bin" --no-same-owner crane
install -m 755 "$b/opt/smolvm/agent-rootfs/usr/local/bin/crane" "$b/usr/local/bin/crane"

# A mise project of its own, outside the repo, whose config is image.toml and
# the copies of the tree above; it names no tools. Its base is read before
# mise is isolated from the repo.
from="$(mise config get -f "$repo/.mise/config.toml" vars.base_image_debian)"
# What a runner release is built against and a running pod cannot change: the
# smolvm release with its guest agent and crane, and the base image's libc the
# runner links. A loader hands its machines only to a release whose id matches.
{ echo "$from"; tar --sort=name --mtime=@0 --owner=0 --group=0 --numeric-owner -cf - -C "$b/opt/smolvm" . | sha256sum; } |
  sha256sum | cut -d' ' -f1 > "$rel/runtime-id"
project="$work/project"
mkdir -p "$project" "$work"/{data,cache,state,config}
cp image.toml "$project/mise.toml"
for d in usr opt; do printf '\n[[oci.copy]]\nhost = "../build/%s"\nimage = "/%s"\n' "$d" "$d" >> "$project/mise.toml"; done
(
  unset MISE_ENV MISE_CONFIG_ROOT MISE_MONOREPO_ROOT MISE_ORIGINAL_CWD MISE_PROJECT_ROOT "${!MISE_TASK_@}"
  export MISE_DATA_DIR="$work/data" MISE_CACHE_DIR="$work/cache" MISE_STATE_DIR="$work/state" \
    MISE_CONFIG_DIR="$work/config" MISE_GLOBAL_CONFIG_FILE="$work/config/none.toml" \
    MISE_SYSTEM_CONFIG_DIR="$work/config/system" MISE_CEILING_PATHS="$work" \
    MISE_TRUSTED_CONFIG_PATHS="$project" MISE_EXPERIMENTAL=1
  : > "$MISE_GLOBAL_CONFIG_FILE"
  cd "$project"
  # The apt bootstrap needs root. Three warnings say nothing here: mise judges
  # every absolute symlink against a tool's install dir, though the apt
  # layer's resolve inside the image and those in smolvm's guest rootfs inside
  # the guest; it flags the copies, though both are this build's own tree; and
  # an image with no tools is the point.
  { ${sudo[@]+"${sudo[@]}"} "$(command -v mise)" oci build --no-mise --from "$from" -o "$work/layout" 2>&1 1>&3 3>&- |
    { grep -vE 'oci layer: symlink [^ ]*(/mise-oci-apt-rootfs-[^ ]*/diff|/agent-rootfs)/[^ ]* .* has an absolute target outside|mise oci build: (copying host path |no tools in the toolset)' || true; } >&2; } 3>&1
)
[ ${#sudo[@]} -eq 0 ] || sudo chown -R "$(id -u):$(id -g)" "$work"
"$repo/.mise/tasks/image/name-layout" "$work/layout" platform-vm-runner:latest
tar -C "$work/layout" -cf "$work/image.tar" $(ls -A "$work/layout")

# The runner, the image cache service and the seed uploader link glibc
# dynamically, and one that needs a newer glibc than the image ships would fail
# its pod at start, so each runs once here, inside the image's own tree.
mkdir "$work/rootfs"
crane export - - < "$work/image.tar" | tar -C "$work/rootfs" -xf -
for bin in /usr/local/libexec/vm-runner/vm-runner /usr/local/bin/vm-runner-loader /usr/local/bin/vm-image-cache /usr/local/bin/vm-seed; do
  ${sudo[@]+"${sudo[@]}"} chroot "$work/rootfs" "$bin" --help >/dev/null
done

mkdir -p "$(dirname "$out")"
mv "$work/image.tar" "$out"
echo "$out"
