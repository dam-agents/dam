# Sourced by mise into every task of this package, through `_.source` in
# config.toml. Cargo links build scripts, proc macros and tests with a C
# linker, and the cc crate (ring, aws-lc, zstd, sqlite) compiles C and archives
# it. On Linux both go through the zig the repository's mise installs, via the
# wrappers beside this file; zig carries its own libc headers, so the machine
# needs no C toolchain of its own.
if [ "$(uname -s)" = Linux ]; then
  zig_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
  export CC="$zig_dir/cc" AR="$zig_dir/ar"
  export "CARGO_TARGET_$(uname -m | tr '[:lower:]' '[:upper:]')_UNKNOWN_LINUX_GNU_LINKER=$zig_dir/cc"
  unset zig_dir
fi
