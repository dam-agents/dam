+#[cfg(unix)]
+fn peek_exit_signal_at(pid: Pid, now: Instant) -> Option<i32> {
+    let mut notes = EXIT_SIGNALS.get_or_init(Default::default).lock().unwrap();
+    let (at, signal) = *notes.get(&pid)?;
+    if now.saturating_duration_since(at) < NOTE_KEPT {
