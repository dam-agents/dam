+/// Checks the storage disk's filesystem once per boot, before its first mount:
+/// a filesystem the kernel marked with errors (a failed write, an aborted
+/// journal) is otherwise mounted as it is, and the damage stays and grows.
+/// `e2fsck -p` returns at once on a clean filesystem and preens one marked
+/// with errors; what preening cannot fix gets a full repair, then one that
+/// also rebuilds directories (the kernel's "Please run e2fsck -D"). False
+/// when the filesystem is still damaged, or e2fsck failed or was killed: the
+/// boot then fails with the reason on the console and the disk stays as it
+/// is not formatted. A disk with no filesystem yet is not checked, so the
+/// format step can make one. A guest without e2fsck mounts as before.
+#[cfg(target_os = "linux")]
+fn storage_filesystem_checked() -> bool {
+    static CHECKED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *CHECKED.get_or_init(|| {
+        const STORAGE_DEVICE: &str = "/dev/vda";
+        // A disk that never held a filesystem has nothing to check; the
+        // format step below makes one.
+        if may_format_storage(STORAGE_DEVICE) {
+            return true;
+        }
+        let passes: [&[&str]; 3] = [&["-p"], &["-f", "-y"], &["-f", "-y", "-D"]];
+        for (i, args) in passes.iter().enumerate() {
+            let output = match std::process::Command::new("e2fsck")
+                .args(*args)
+                .arg(STORAGE_DEVICE)
+                .output()
+            {
+                Ok(output) => output,
+                Err(e) if i == 0 => {
+                    boot_log("WARN", &format!("storage: e2fsck not run ({e}); mounting unchecked"));
+                    return true;
+                }
+                Err(e) => {
+                    boot_log("ERROR", &format!("storage: e2fsck {} could not run ({e}); refusing to mount a damaged filesystem", args.join(" ")));
+                    return false;
+                }
+            };
+            let said = String::from_utf8_lossy(&output.stdout).trim().to_string()
+                + " "
+                + String::from_utf8_lossy(&output.stderr).trim();
+            match fsck_verdict(output.status.code()) {
+                FsckVerdict::Clean => return true,
+                FsckVerdict::Repaired => {
+                    boot_log("WARN", &format!("storage: e2fsck {} repaired the filesystem: {}", args.join(" "), said.trim()));
+                    return true;
+                }
+                FsckVerdict::Damaged if i + 1 < passes.len() => {
+                    boot_log("WARN", &format!("storage: e2fsck {} left errors ({}); trying a fuller repair", args.join(" "), said.trim()));
+                }
+                verdict => {
+                    boot_log("ERROR", &format!("storage: e2fsck {} {verdict:?} (exit {:?}): {}; refusing to mount, and the disk is kept as it is", args.join(" "), output.status.code(), said.trim()));
+                    return false;
+                }
+            }
+        }
+        false
+    })
+}
+
+#[cfg(not(target_os = "linux"))]
+#[allow(dead_code)]
+fn storage_filesystem_checked() -> bool {
+    true
+}
+
+#[derive(Debug, PartialEq)]
+enum FsckVerdict {
+    Clean,
+    Repaired,
+    Damaged,
+    Failed,
+}
+
+/// e2fsck's exit status: 0 clean, 1 and 2 errors corrected (2 asks for a
+/// reboot, which an unmounted disk does not need), 4 errors left, 8 and up an
+/// operational error, a cancel or a library error. A signal-killed e2fsck has
+/// no code and repaired nothing it can vouch for.
+fn fsck_verdict(code: Option<i32>) -> FsckVerdict {
+    match code {
+        Some(0) => FsckVerdict::Clean,
+        Some(1..=3) => FsckVerdict::Repaired,
+        Some(code) if code & !3 == 4 => FsckVerdict::Damaged,
+        _ => FsckVerdict::Failed,
+    }
+}
+
+/// Whether the storage disk may be formatted: only when it can be read and
+/// carries neither an ext2/3/4 nor a btrfs superblock magic, i.e. it never
+/// held a filesystem.
+#[cfg_attr(not(target_os = "linux"), allow(dead_code))]
+fn may_format_storage(device: &str) -> bool {
+    use std::os::unix::fs::FileExt;
+    let mut magic = [0u8; 2];
+    match std::fs::File::open(device).and_then(|f| f.read_exact_at(&mut magic, 1024 + 56)) {
+        Ok(()) => magic != [0x53, 0xEF] && !holds_btrfs(device),
+        Err(_) => false,
+    }
+}
+
+/// Whether `device` holds btrfs: its primary superblock is 64 KiB into the
+/// disk, with the magic `_BHRfS_M` 64 bytes into the superblock.
+#[cfg_attr(not(target_os = "linux"), allow(dead_code))]
+fn holds_btrfs(device: &str) -> bool {
+    use std::os::unix::fs::FileExt;
+    let mut magic = [0u8; 8];
+    std::fs::File::open(device)
+        .and_then(|f| f.read_exact_at(&mut magic, 0x10000 + 0x40))
+        .is_ok_and(|()| &magic == b"_BHRfS_M")
+}
+
+/// Mounts the btrfs storage disk at `mount_point`, compressed with zstd level
+/// 1, and grows it to its device while mounted: the host makes a disk from a
+/// small template and grows the file, as it does for ext4, but btrfs grows
+/// online, so there is no resize before the mount. Growing a filesystem that
+/// already fills its device is a no-op. A grow that fails leaves the disk
+/// mounted at the size it had.
+#[cfg(target_os = "linux")]
+fn mount_storage_btrfs(mount_point: &str) -> bool {
+    use std::os::fd::AsRawFd;
+    let dev = cstr("/dev/vda");
+    let mnt = cstr(mount_point);
+    let btrfs = cstr("btrfs");
+    let options = cstr("compress=zstd:1");
+    // SAFETY: NUL-terminated device, target, type and option strings.
+    if unsafe {
+        libc::mount(
+            dev.as_ptr(),
+            mnt.as_ptr(),
+            btrfs.as_ptr(),
+            libc::MS_NOATIME,
+            options.as_ptr().cast(),
+        )
+    } != 0
+    {
+        boot_log(
+            "ERROR",
+            &format!(
+                "storage: mounting btrfs failed ({}); the disk is kept as it is",
+                std::io::Error::last_os_error()
+            ),
+        );
+        return false;
+    }
+    // struct btrfs_ioctl_vol_args; "max" grows device 1, the only one.
+    #[repr(C)]
+    struct VolArgs {
+        fd: i64,
+        name: [u8; 4088],
+    }
+    let mut args = VolArgs { fd: 0, name: [0; 4088] };
+    args.name[..3].copy_from_slice(b"max");
+    let grown = std::fs::File::open(mount_point).and_then(|dir| {
+        // SAFETY: BTRFS_IOC_RESIZE, _IOW(0x94, 3, struct btrfs_ioctl_vol_args),
+        // on an open directory of the mount; `args` outlives the call.
+        match unsafe { libc::ioctl(dir.as_raw_fd(), libc::_IOW::<VolArgs>(0x94, 3), &args) } {
+            0 => Ok(()),
+            _ => Err(std::io::Error::last_os_error()),
+        }
+    });
+    if let Err(e) = grown {
+        boot_log("WARN", &format!("storage: growing btrfs to its device failed ({e})"));
+    }
+    true
+}
