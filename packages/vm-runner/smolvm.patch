+/// once, and a reader that only needs the signal would otherwise have to wait
+/// for it itself. A boot being monitored and the supervisor's sweep both reap
+/// children the embedder also watches, so the signal has to survive here.
+#[cfg(unix)]
+static EXIT_SIGNALS: OnceLock<Mutex<std::collections::HashMap<Pid, (Instant, i32)>>> =
+    OnceLock::new();
+
+/// How long a noted signal is offered for.
+///
+/// A note bridges one reap to the reader waiting on the same child, which is
+/// milliseconds apart; a note nobody takes inside this window is one no reader
+/// is left for, and it is dropped rather than read later under a pid the kernel
+/// has since given to another process.
+#[cfg(unix)]
+const NOTE_KEPT: Duration = Duration::from_secs(60);
+
+/// Remember the signal in a wait status, for [`peek_exit_signal`].
+///
+/// Public because an embedder that reaps one of these children itself — its own
+/// `waitpid`, for a status word only one reader gets — has to leave the signal
+/// where the code that was waiting for the same child reads it.
+#[cfg(unix)]
+pub fn note_exit_signal(pid: Pid, status: libc::c_int) {
+    if libc::WIFSIGNALED(status) {
+        let now = Instant::now();
+        let mut notes = EXIT_SIGNALS.get_or_init(Default::default).lock().unwrap();
+        notes.retain(|_, (at, _)| now.saturating_duration_since(*at) < NOTE_KEPT);
+        // The first note for a pid is the death itself; a later one in the same
+        // window is a teardown reaping what it just killed, and must not stand in
+        // for a signal the process was already killed by. A pid spawned again
+        // forgets its note, so nothing stale is kept by this.
+        notes.entry(pid).or_insert((now, libc::WTERMSIG(status)));
+    }
