+/// How long a write the host has no room for waits before it is tried again.
+const NO_SPACE_RETRY_MS: i32 = 1000;
+
+/// Run a write until the host has room for it, as QEMU's default
+/// `werror=enospc` does by pausing the guest. A sparse image on a full host
+/// filesystem fails the write with ENOSPC, and virtio-blk can only report
+/// that as an I/O error: the guest drops the data it had in its page cache,
+/// aborts its journal and marks the filesystem with errors. Held here, the
+/// guest only waits, and resumes with nothing lost once the host frees room.
+/// A stop fails the write as before, so the worker still yields the queue.
+/// A flush is never retried: after a failed fsync the host may have dropped
+/// the dirty pages, and a second fsync would report them written.
+fn until_room<T>(
+    stop_fd: &EventFd,
+    stopping: bool,
+    mut write: impl FnMut() -> io::Result<T>,
+) -> io::Result<T> {
+    let mut waited = false;
+    loop {
+        let error = match write() {
+            Err(error) if matches!(error.raw_os_error(), Some(libc::ENOSPC | libc::EDQUOT)) => {
+                error
+            }
+            done => {
+                if waited {
+                    info!("block write resumed: the host has room again");
+                }
+                return done;
+            }
+        };
+        if stopping || !wait_for_room(stop_fd) {
+            return Err(error);
+        }
+        if !waited {
+            warn!("block write held until the host has room: {error}");
+            waited = true;
+        }
+    }
+}
+
+/// Wait out one retry interval; false when a stop came meanwhile.
+#[cfg(unix)]
+fn wait_for_room(stop_fd: &EventFd) -> bool {
+    let mut poll = libc::pollfd {
+        fd: stop_fd.as_raw_fd(),
+        events: libc::POLLIN,
+        revents: 0,
+    };
+    // SAFETY: `poll` is one live pollfd for the call.
+    let ready = unsafe { libc::poll(&mut poll, 1, NO_SPACE_RETRY_MS) };
+    ready == 0 || (ready < 0 && io::Error::last_os_error().kind() == io::ErrorKind::Interrupted)
+}
+
+#[cfg(not(unix))]
+fn wait_for_room(_stop_fd: &EventFd) -> bool {
+    false
+}
