 mod tests {
     use super::*;
 
+    fn no_space() -> io::Result<()> {
+        Err(io::Error::from_raw_os_error(libc::ENOSPC))
+    }
+
+    #[test]
+    fn a_write_the_host_has_no_room_for_waits_until_it_has() {
+        let stop = EventFd::new(EFD_NONBLOCK).unwrap();
+        let mut tries = 0;
+        let started = std::time::Instant::now();
+        until_room(&stop, false, || {
+            tries += 1;
+            if tries < 3 { no_space() } else { Ok(()) }
+        })
+        .unwrap();
+        assert_eq!(tries, 3);
+        assert!(
+            started.elapsed() >= std::time::Duration::from_millis(2 * NO_SPACE_RETRY_MS as u64)
+        );
+    }
+
+    #[test]
+    fn a_stop_fails_a_write_held_for_room() {
+        let stop = EventFd::new(EFD_NONBLOCK).unwrap();
+        stop.write(1).unwrap();
+        let mut tries = 0;
+        let error = until_room(&stop, false, || {
+            tries += 1;
+            no_space()
+        })
+        .unwrap_err();
+        assert_eq!(error.raw_os_error(), Some(libc::ENOSPC));
+        assert_eq!(tries, 1);
+        let stop = EventFd::new(EFD_NONBLOCK).unwrap();
+        assert!(until_room(&stop, true, no_space).is_err());
+    }
+
