#!/usr/bin/env bash
#MISE description="Experimental: build the Debian Claude Code image with `mise oci` instead of a Dockerfile. Linux host of the target arch with apt-get (the lima VM on macOS). Options: --from=REF base image, --load[=TAG] into docker (default platform-claude-code-debian:latest)"
#MISE dir="{{vars.repo_root}}"
set -euo pipefail

pkg=packages/mise-oci
from=""
load=""
for a in "$@"; do
  case "$a" in
    --from=*) from="${a#--from=}" ;;
    --load) load="platform-claude-code-debian:latest" ;;
    --load=*) load="${a#--load=}" ;;
    *) echo "unknown argument: $a" >&2; exit 2 ;;
  esac
done

# `mise oci build` packages the host's own installs and runs the host's apt-get
# for [bootstrap.packages], so the host must be Linux of the image's arch and
# Debian-family.
[ "$(uname -s)" = Linux ] || { echo "mise oci builds on Linux only; on macOS run this in the lima VM" >&2; exit 1; }
command -v apt-get >/dev/null || { echo "needs apt-get on the build host for [bootstrap.packages]" >&2; exit 1; }

state="${XDG_CACHE_HOME:-$HOME/.cache}/platform-mise-oci"
work="$state/build"
stage="$work/stage"
runtime="$work/runtime"
out="$state/out/claude-code"

# agent-runtime and driver-sdk, built with the repo's own toolchain the way
# platform-base's builder stage builds them.
pnpm --filter agent-runtime exec tsup
pnpm --filter driver-sdk exec tsup
rm -rf "$runtime"
npm_config_inject_workspace_packages=true \
  pnpm --filter agent-runtime deploy --frozen-lockfile --prod --node-linker=hoisted "$runtime"
cp packages/agent-runtime/package.json "$runtime/package.json"
(cd "$runtime" && pnpm pkg delete devDependencies)

# From here on mise runs for the image, not for the repo: the project and task
# context mise hands this task is dropped (settings the caller exported stay),
# the staged config sits outside the repo so its root config is not a parent,
# and the ceiling stops the walk up.
unset MISE_ENV MISE_CONFIG_ROOT MISE_MONOREPO_ROOT MISE_ORIGINAL_CWD MISE_PROJECT_ROOT
while IFS= read -r v; do unset "$v"; done < <(compgen -e | grep '^MISE_TASK_')
mkdir -p "$work"/{data,cache,config,state}
export MISE_DATA_DIR="$work/data" MISE_CACHE_DIR="$work/cache" MISE_STATE_DIR="$work/state" \
  MISE_CONFIG_DIR="$work/config" MISE_GLOBAL_CONFIG_FILE="$work/config/none.toml" \
  MISE_SYSTEM_CONFIG_DIR="$work/config/system" MISE_CEILING_PATHS="$work" MISE_EXPERIMENTAL=1
: > "$MISE_GLOBAL_CONFIG_FILE"

rm -rf "$stage"
mkdir -p "$stage"
cp "$pkg/image.toml" "$stage/mise.toml"
mise trust -q "$stage"
mise -C "$stage" install

# rootfs/ is the image's own payload at its image paths; git keeps no empty
# directories, so the two the image needs are made here. /etc/logrotate.d is
# where service installers drop their rotation config, and trixie-slim has none.
r="$stage/rootfs"
mkdir -p "$r"
cp -a "$pkg/rootfs/." "$r/"
install -d "$r"/{home/agent,etc/logrotate.d} "$r/usr/local/share/tool-bin"
cp -a "$runtime/package.json" "$runtime/node_modules" "$r/app/"
cp -a packages/agent-runtime/dist "$r/app/dist"
install -m 644 packages/driver-sdk/dist/driver-sdk.mjs "$r/usr/local/lib/driver-sdk.mjs"

# The two tool-bin links the harness scripts and manifest name, resolved on the
# host and pointed at where the adapter's install sits inside the image.
in_image() { printf '/usr/local/share/mise%s\n' "${1#"$MISE_DATA_DIR"}"; }
acp="$(mise -C "$stage" where npm:@agentclientprotocol/claude-agent-acp)/lib/node_modules/@agentclientprotocol/claude-agent-acp"
cli="$(echo "$acp"/node_modules/@anthropic-ai/claude-agent-sdk-*/claude)"
test -x "$cli"
ln -sfn "$(in_image "$acp")" "$r/usr/local/share/tool-bin/claude-agent-acp-lib"
ln -sfn "$(in_image "$cli")" "$r/usr/local/share/tool-bin/claude"

copies=()
for d in "$r"/*; do copies+=(--copy "$d:/${d##*/}"); done
rm -rf "$out"
mise -C "$stage" oci build -o "$out" ${from:+--from "$from"} "${copies[@]}"
echo "OCI layout: $out"

if [ -n "$load" ]; then
  tar -C "$out" -cf "$work/image.tar" .
  id="$(docker load -i "$work/image.tar" | sed -n 's/^Loaded image ID: //p')"
  docker tag "$id" "$load"
  rm -f "$work/image.tar"
  echo "loaded into docker as $load"
fi
