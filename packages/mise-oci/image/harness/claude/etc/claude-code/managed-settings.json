{
  "permissions": {
    "allow": [
      "mcp__platform-outbound",
      "mcp__knowledge-bases"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /usr/local/lib/report-background-work.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /usr/local/lib/report-background-work.mjs"
          }
        ]
      }
    ]
  }
}
