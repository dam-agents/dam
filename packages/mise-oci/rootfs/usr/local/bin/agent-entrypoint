#!/bin/sh
# The Debian image's own entrypoint. The image runs only as a vm Backend
# machine: booted as root, after platform-init has mounted the agent's home from
# the storage disk and bound the platform MITM CA into /etc/platform/ca.
set -eu

home="${HOME:-/home/agent}"

# The harness runs as root, so an `agent` SSH login is root under that name:
# it lands in the harness's home with its environment, not in an unprivileged
# account that could write none of it. Debian's sshd refuses to run as root
# without its privilege-separation directory.
grep -q '^agent:' /etc/passwd || echo 'agent:x:0:0:Agent User:/home/agent:/bin/bash' >>/etc/passwd
install -d -m 0755 /run/sshd

# The agent reaches the internet only through its Envoy gateway, which for some
# hosts returns a certificate signed by the MITM CA. The CA joins the system
# bundle rather than replacing it; SSL_CERT_FILE and REQUESTS_CA_BUNDLE point
# Python there, and Node gets the CA through NODE_EXTRA_CA_CERTS. No CA file
# means the gateway intercepts nothing.
mitm_ca=/etc/platform/ca/ca.crt
if [ -s "$mitm_ca" ]; then
	t0=$(date +%s%N)
	if cp "$mitm_ca" /usr/local/share/ca-certificates/platform-mitm-ca.crt &&
		update-ca-certificates >/dev/null 2>&1; then
		echo "agent-entrypoint: platform CA trusted in $((($(date +%s%N) - t0) / 1000000))ms"
	else
		echo "agent-entrypoint: WARNING: could not trust the platform CA; intercepted hosts may fail TLS" >&2
	fi
fi

# /app/working-dir stays the pristine copy the runtime reconciles image skills
# against, so the home is seeded from it rather than baked at /home/agent.
if [ ! -f "$home/.initialized" ]; then
	cp -rn /app/working-dir/. "$home/" 2>/dev/null || true
	touch "$home/.initialized"
	echo "agent-entrypoint: seeded home from image workspace"
fi
mkdir -p "$home/work"

# Maven Resolver reads proxies only from settings.xml, so without this every
# `mvn` dependency fetch bypasses the egress gateway. A user-managed file wins.
if [ -n "${HTTPS_PROXY:-}" ] && [ ! -e "$home/.m2/settings.xml" ]; then
	_hp=${HTTPS_PROXY#http://}
	_m2_proxy() {
		printf '<proxy><id>platform-%s</id><active>true</active><protocol>%s</protocol><host>%s</host><port>%s</port><nonProxyHosts>localhost|127.0.0.1</nonProxyHosts></proxy>' \
			"$1" "$1" "${_hp%:*}" "${_hp##*:}"
	}
	if ! { mkdir -p "$home/.m2" &&
		printf '<settings><proxies>%s%s</proxies></settings>\n' "$(_m2_proxy http)" "$(_m2_proxy https)" \
			> "$home/.m2/settings.xml"; } 2>/dev/null; then
		echo "agent-entrypoint: WARNING: could not write ~/.m2/settings.xml; Maven fetches may bypass the gateway" >&2
	fi
fi

exec "$@"
