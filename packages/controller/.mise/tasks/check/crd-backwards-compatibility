#!/usr/bin/env bash
#MISE description="CRD schema changes stay backwards compatible with the latest release"
#MISE sources=["helm/crds/*.yaml"]
#MISE dir="{{vars.repo_root}}"
#USAGE flag "--baseline <ref>" help="Git ref to compare against (default: latest v* tag)"
set -euo pipefail
baseline="${usage_baseline:-$(git tag -l 'v*' --sort=-v:refname | head -1)}"
if [ -z "$baseline" ]; then
  echo "crd-compat: no v* tag found for a baseline; run git fetch --tags or pass --baseline" >&2
  exit 1
fi
if ! git rev-parse -q --verify "$baseline^{commit}" >/dev/null; then
  echo "crd-compat: baseline ref '$baseline' does not resolve to a commit" >&2
  exit 1
fi
crds=helm/crds
legacy="deploy/helm/platform/crds deploy/helm/platform/files/crds" # chart locations at older baselines
config=packages/controller/crdify.yaml # downgrades description-only diffs to advisory
status=0
# CRDs deliberately retired from the platform. A removal here must ship with
# an explicit in-cluster cleanup (the retired definition carries
# helm.sh/resource-policy: keep, so Helm never deletes it itself).
removed_ok="agent-platform.ai_forks.yaml agent-platform.ai_runs.yaml" # #2987: person-scoped forks removed; runs: dam-run executor removed (local exec shim)
# Fields deliberately retired from a CRD, as crdify names them: "<file> <property>".
# A removal here must be dead on every install: nothing writes it, and the
# controller bumps the CRD schema generation, so a stored value is pruned.
removed_fields_ok="
agent-platform.ai_agents.yaml ^.spec.grantedSecretIds
" # #6253: a credential reaches an agent only through a Connection
for f in $(git ls-tree -r --name-only "$baseline" -- "$crds" $legacy); do
  if [ ! -f "$crds/$(basename "$f")" ]; then
    case " $removed_ok " in
      *" $(basename "$f") "*)
        echo "crd-compat: $f removed deliberately — allowed"
        continue ;;
    esac
    echo "crd-compat: $f shipped in $baseline but was removed" >&2
    status=1
  fi
done
# Schema-generation bumps are enforced per-PR by check:crd-schema-generation
# (baseline = origin/main, not a release tag) so a schema change can't slip
# through against a v* tag that predates the CRDs.
# crdify's own git:// loader opens the repo with go-git, which fails outright in
# a git worktree (.git is a file, not a directory), so extract the baseline
# manifest with git ourselves and hand crdify two plain files.
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
for f in "$crds"/*.yaml; do
  name=$(basename "$f")
  base=""
  for dir in "$crds" $legacy; do
    if git show "$baseline:$dir/$name" >"$tmp/$name" 2>/dev/null; then base="$dir/$name"; break; fi
  done
  if [ -z "$base" ]; then
    echo "crd-compat: $f is new since $baseline — skipped"
    continue
  fi
  if crdify --config "$config" "file://$tmp/$name" "file://$f" >/dev/null 2>&1; then
    continue
  fi
  allowed=$(printf '%s\n' "$removed_fields_ok" | awk -v n="$name" '$1 == n { print $2 }' | jq -Rn '[inputs | select(. != "")]')
  remaining=$({ crdify --config "$config" -o json "file://$tmp/$name" "file://$f" || true; } | jq --argjson ok "$allowed" '
    def retired($p): any($ok[]; . as $r | $p == $r or ($p | startswith($r + ".")));
    def field($e): $e | capture("^removed field : [^.]+\\.(?<p>.+)$").p // "";
    [(.crdValidation // [])[] | .name as $n | .errors[]? | select(($n == "existingFieldRemoval" and retired(field(.))) | not)]
    + [(.sameVersionValidation // [])[] | .propertyComparisons[]? | select(retired(.property) | not) | .comparisonResults[]? | .errors[]?]
    + [(.servedVersionValidation // [])[] | .propertyComparisons[]? | select(retired(.property) | not) | .comparisonResults[]? | .errors[]?]
    | length')
  if [ "$remaining" != "0" ]; then
    crdify --config "$config" "file://$tmp/$name" "file://$f" || true
    echo "crd-compat: $f is incompatible with $baseline (see findings above)" >&2
    status=1
  else
    echo "crd-compat: $f removes only fields retired deliberately — allowed"
  fi
done
exit $status
