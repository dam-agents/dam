#!/usr/bin/env bash
#MISE sources=["api/**/*.go", "{{vars.repo_root}}/helm/crds/*.yaml"]
# The chart's CRD manifests must be exactly what controller-gen produces from
# the api/ Go types — catches hand-edits to the "generated" YAML and Go-side
# schema changes committed without `mise run //packages/controller:generate`. The Go doc
# comments are part of the contract: they compile into the CRD descriptions,
# which is why .mise/tasks/strip-comments exempts packages/controller/api/.
set -euo pipefail
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
controller-gen crd paths=./api/... output:crd:dir="$tmp"
crds=$MISE_CONFIG_ROOT/../../helm/crds
status=0
for g in "$tmp"/*.yaml; do
  name=$(basename "$g")
  hdr="$tmp/hdr-$name"
  { echo '# Code generated by controller-gen. DO NOT EDIT.'; cat "$g"; } > "$hdr"
  if [ ! -f "$crds/$name" ]; then
    echo "crd-generated: $name is generated from api/ but missing from the chart — run: mise run //packages/controller:generate" >&2
    status=1
  elif ! diff -u "$crds/$name" "$hdr"; then
    echo "crd-generated: $name drifted from controller-gen output — run: mise run //packages/controller:generate (never edit the manifest by hand)" >&2
    status=1
  fi
done
for f in "$crds"/*.yaml; do
  if [ ! -f "$tmp/$(basename "$f")" ]; then
    echo "crd-generated: $(basename "$f") is in the chart but controller-gen no longer produces it — delete it or restore its api/ type" >&2
    status=1
  fi
done
exit $status
