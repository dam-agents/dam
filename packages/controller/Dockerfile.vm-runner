# The VM runner: smolvm plus the platform's vm-runner agent, run as one
# pod that holds /dev/kvm (a device-plugin resource, or privileged locally) and
# hosts vm-backend agents as microVMs. Same image everywhere; only the pod's
# device grant differs per cluster.
FROM --platform=$BUILDPLATFORM registry.access.redhat.com/hi/go:1.25-builder AS builder

ENV GOTOOLCHAIN=auto
WORKDIR /app
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    go mod download
COPY . .
ARG TARGETOS TARGETARCH
RUN --mount=type=cache,target=/root/.cache/go-build \
    --mount=type=cache,target=/go/pkg/mod \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH} \
    go build -o /vm-runner ./cmd/vm-runner

FROM quay.io/fedora/fedora:42 AS runner

# tar unpacks image archives, e2fsprogs makes and grows machine disks; the
# smolvm release itself comes from GitHub, pinned. Its multi-GiB ext4
# templates are sparse and stay so in the layer.
ARG SMOLVM_VERSION=1.16.0
RUN dnf install -y --setopt=install_weak_deps=False tar e2fsprogs util-linux-core catatonit && dnf clean all && \
    (umask 022; curl -sSL https://smolmachines.com/install.sh | HOME=/opt bash -s -- --version ${SMOLVM_VERSION} --prefix /opt/smolvm) && \
    mv /opt/.local/share/smolvm/agent-rootfs /opt/smolvm/agent-rootfs && rm -rf /opt/.local && \
    chmod -R a+rX /opt/smolvm

COPY --from=builder /vm-runner /usr/local/bin/vm-runner

# smolvm keeps machines and their disks under $HOME/.cache; the chart mounts a
# volume there so they outlive the pod. catatonit reaps the guest processes
# smolvm leaves behind when it gives up on a boot.
ENV HOME=/var/lib/smolvm
ENTRYPOINT ["/usr/libexec/catatonit/catatonit", "--", "vm-runner", "--smolvm", "/opt/smolvm/smolvm"]
