#!/bin/sh
# Each provider's lease keeps the files Pi's provider extension rewrites at
# start in a directory of its own, so two leases on different providers never
# overwrite each other's; everything else stays shared through links.
shared="$HOME/.pi/agent"
# LiteLLM connections set this placeholder for Claude Code. Pi would count it as
# an Anthropic key and fall back to api.anthropic.com when no model resolves.
unset ANTHROPIC_AUTH_TOKEN
# The platform instructions ride Pi's global context file, so the home's
# AGENTS.md stays the owner's; an owner's own file there is kept.
mkdir -p "$shared"
[ -f "$shared/AGENTS.md" ] && [ ! -L "$shared/AGENTS.md" ] ||
  ln -sfn /etc/AGENTS.md "$shared/AGENTS.md"
# With the Model Router one Pi process serves every provider, so the shared
# directory is the only one; the per-provider lease directories are for the
# pre-router runtime.
if [ -n "$PLATFORM_PROVIDER" ] && [ -z "$PLATFORM_MODEL_ROUTER_URL" ]; then
  lease="$HOME/.pi/leases/$PLATFORM_PROVIDER"
  mkdir -p "$lease" "$shared/sessions" "$shared/npm"
  for entry in "$shared"/*; do
    [ -e "$entry" ] || continue
    name=$(basename "$entry")
    case "$name" in settings.json | models.json | auth.json | extensions) continue ;; esac
    [ -e "$lease/$name" ] || [ -L "$lease/$name" ] || ln -s "$entry" "$lease/$name"
  done
  [ -f "$shared/settings.json" ] && cp "$shared/settings.json" "$lease/settings.json"
  [ "$shared/auth.json" -nt "$lease/auth.json" ] && cp -p "$shared/auth.json" "$lease/auth.json"
  mkdir -p "$lease/extensions"
  for entry in "$shared"/extensions/*; do
    [ -e "$entry" ] || continue
    name=$(basename "$entry")
    [ "$name" = pi-dynamic-providers ] && continue
    [ -e "$lease/extensions/$name" ] || [ -L "$lease/extensions/$name" ] || ln -s "$entry" "$lease/extensions/$name"
  done
  export PI_CODING_AGENT_DIR="$lease"
fi
rm -rf "${PI_CODING_AGENT_DIR:-$shared}/extensions/pi-dynamic-providers"
# Homes seeded before the image shipped pi-memory still load their own npm copy.
# Pi exits on a missing -e path, so skip it while the node tools lack pi-memory.
mem="$(mise where npm:@zhafron/pi-memory 2>/dev/null)/node_modules/@zhafron/pi-memory"
[ -d "$shared/npm/node_modules/@zhafron/pi-memory" ] || [ ! -d "$mem" ] ||
  set -- -e "$mem" "$@"
provider= pin=
if [ -n "$PLATFORM_MODEL_ROUTER_URL" ]; then
  # The Model Router: one Pi provider, "platform", carrying every granted
  # provider's models under provider-qualified names; the session's model is
  # a catalog name the runtime sends (PLATFORM_MODEL for the TUI, ACP for chat).
  provider=platform
  unset OPENAI_API_KEY ANTHROPIC_API_KEY
elif [ -n "$AWS_BEARER_TOKEN_BEDROCK" ]; then
  provider=amazon-bedrock pin=$AWS_BEDROCK_MODEL
elif [ -n "$OPENAI_PROXY_URL" ]; then
  provider=openai-proxy pin=$OPENAI_PROXY_MODEL
elif [ -n "$RITS_URL" ]; then
  provider=rits pin=$RITS_MODEL
elif [ -n "$OPENAI_BASE_URL" ]; then
  provider=openai pin=$OPENAI_MODEL
fi
# Pi refuses --provider without --model. The agent's default lease names no
# model, so it runs on the saved default, else the provider's pin.
model=$PLATFORM_MODEL
if [ -n "$provider" ] && [ -z "$model" ]; then
  model=$(jq -r '.defaultModel // empty' "$shared/settings.json" 2>/dev/null)
  model=${model:-$pin}
fi
[ -z "$provider" ] || [ -z "$model" ] || set -- "$@" --provider "$provider"
[ -z "$model" ] || set -- "$@" --model "$model"
extensions=/usr/local/share/pi-platform/extensions
exec pi -e "$extensions/pi-dynamic-providers/index.ts" -e "$extensions/pi-platform-telemetry/index.ts" "$@"
