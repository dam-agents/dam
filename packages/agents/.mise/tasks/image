#!/usr/bin/env bash
#MISE description="Build agent images, or reuse them from the registry while their source is unchanged, as platform-<agent>:latest in docker: all of packages/agents, or the ones named (the e2e mock too). image.toml agents build with `mise oci` on a Linux host of the target arch (the lima VM on macOS), Dockerfile workloads with docker build on claude-code. Options: --build never reuses, --no-load keeps a mise image as its OCI layout only, --dry-run prints the plan."
#MISE dir="{{vars.repo_root}}"
set -euo pipefail

resolve=.mise/tasks/image/resolve
agents=packages/agents
root="$PWD"
dry=false reuse=true load=true named=()
for a in "$@"; do
  case "$a" in
    --dry-run) dry=true ;;
    --build) reuse=false ;;
    --no-load) load=false ;;
    -*) echo "unknown option: $a" >&2; exit 2 ;;
    *) named+=("$a") ;;
  esac
done

dir_of() { local d; for d in "$agents/$1" "packages/e2e/agents/$1"; do [ -d "$d" ] && { echo "$d"; return; }; done; return 1; }
if [ ${#named[@]} -eq 0 ]; then
  for d in "$agents"/*/; do
    [ -f "$d/Dockerfile" ] || [ -f "$d/image.toml" ] && named+=("$(basename "$d")")
  done
fi
mise_images=() docker_images=()
for a in "${named[@]}"; do
  d="$(dir_of "$a")" || { echo "no such agent: $a" >&2; exit 2; }
  if [ -f "$d/image.toml" ]; then mise_images+=("$a")
  elif [ -f "$d/Dockerfile" ]; then docker_images+=("$a")
  else echo "$a has neither an image.toml nor a Dockerfile" >&2; exit 2; fi
done
if [ ${#docker_images[@]} -gt 0 ]; then
  [ "$load" = true ] || { echo "--no-load applies to mise images only: ${docker_images[*]}" >&2; exit 2; }
  case " ${mise_images[*]:-} " in *" claude-code "*) ;; *) mise_images=(claude-code ${mise_images[@]+"${mise_images[@]}"}) ;; esac
fi

if [ "$dry" = true ]; then
  echo "mise oci (one at a time): ${mise_images[*]:-—}"
  echo "docker (in parallel):     ${docker_images[*]:-—}"
  exit 0
fi
[ -z "${SKIP_IMAGE_BUILD:-}" ] || exit 0

reused() {
  [ "$reuse" = true ] || return 1
  local d; d="$($resolve resolve "$1")"
  [ "${d%% *}" = REUSE ] || return 1
  echo "↺ reuse ${d#REUSE } -> platform-$1:latest"
  docker pull "${d#REUSE }" && docker tag "${d#REUSE }" "platform-$1:latest"
}

state="${XDG_CACHE_HOME:-$HOME/.cache}/platform-agent-oci"
work="$state/build"
stage="$work/stage"
runtime="$work/runtime"

runtime_built=false
build_runtime() {
  [ "$runtime_built" = false ] || return 0
  pnpm --filter agent-runtime exec tsup
  pnpm --filter driver-sdk exec tsup
  rm -rf "$runtime"
  npm_config_inject_workspace_packages=true \
    pnpm --filter agent-runtime deploy --frozen-lockfile --prod --node-linker=hoisted "$runtime"
  cp packages/agent-runtime/package.json "$runtime/package.json"
  (cd "$runtime" && pnpm pkg delete devDependencies)
  runtime_built=true
}

# Subshell: it leaves the repo's mise context and directory.
build_mise() (
  harness=$1 out="$state/out/$1"
  [ "$(uname -s)" = Linux ] || { echo "mise oci builds on Linux only; on macOS run this in the lima VM" >&2; exit 1; }

  # mise runs for the staged image project only, outside the repo.
  unset MISE_ENV MISE_CONFIG_ROOT MISE_MONOREPO_ROOT MISE_ORIGINAL_CWD MISE_PROJECT_ROOT MISE_LOCKED "${!MISE_TASK_@}"
  mkdir -p "$work"/{data,cache,config,state}
  export MISE_DATA_DIR="$work/data" MISE_CACHE_DIR="$work/cache" MISE_STATE_DIR="$work/state" \
    MISE_CONFIG_DIR="$work/config" MISE_GLOBAL_CONFIG_FILE="$work/config/none.toml" \
    MISE_SYSTEM_CONFIG_DIR="$work/config/system" MISE_CEILING_PATHS="$work" \
    MISE_TRUSTED_CONFIG_PATHS="$stage" MISE_EXPERIMENTAL=1
  : > "$MISE_GLOBAL_CONFIG_FILE"

  # Repo names mise would not load (every agent dir is a config root) get
  # mise's names here.
  rm -rf "$stage"
  mkdir -p "$stage/mise/conf.d"
  cp "$agents/base/miserc.toml" "$stage/.miserc.toml"
  cp "$agents/base/base.toml" "$stage/mise/conf.d/base.toml"
  for f in "$agents/base/base.toml" "$agents"/*/image.toml packages/e2e/agents/*/image.toml; do
    d="${f%/*}"; a="${d##*/}"
    [ "$a" = base ] || cp "$f" "$stage/mise/conf.d/harness.$a.toml"
    mkdir -p "$stage/$a/rootfs"
    # pi's extension ships as source; node_modules holds its dev dependencies.
    tar -C "$d/rootfs" --exclude=node_modules -cf - . | tar -C "$stage/$a/rootfs" -xf -
  done
  b="$stage/build"
  install -d "$b"/{app,home/agent,etc/logrotate.d,etc/ssl/certs} \
    "$b"/usr/local/lib/platform-python "$b"/usr/local/share/ca-certificates
  cp -a "$runtime/package.json" "$runtime/node_modules" "$b/app/"
  cp -a packages/agent-runtime/dist "$b/app/dist"
  install -m 644 packages/driver-sdk/dist/driver-sdk.mjs "$b/usr/local/lib/driver-sdk.mjs"
  install -m 644 packages/experiment-sdk/src/experiment_sdk.py "$b/usr/local/lib/platform-python/experiment_sdk.py"
  if [ "$harness" = mock ]; then
    pnpm --filter mock-agent exec tsup
    install -D -m 644 packages/e2e/agents/mock/dist/main.js "$stage/mock/rootfs/app/mock-agent.js"
  fi

  # Not -C: mise reads .miserc.toml from the working directory only.
  cd "$stage"
  mise -E "$harness" install

  # The apt bootstrap needs root. out/ is made first, as this user, so the
  # next build can remove it.
  rm -rf "$out"
  mkdir -p "$(dirname "$out")"
  sudo=(); [ "$(id -u)" = 0 ] || sudo=(sudo --preserve-env env "PATH=$PATH")
  ${sudo[@]+"${sudo[@]}"} "$(command -v mise)" -E "$harness" oci build -o "$out"
  [ ${#sudo[@]} -eq 0 ] || sudo chown -R "$(id -u):$(id -g)" "$work" "$out"
  mise -E "$harness" exec -- python3 "$root/$agents/base/own-layout.py" "$out"
  echo "OCI layout: $out"
)

# One at a time: they share the stage and the host's apt caches.
for a in ${mise_images[@]+"${mise_images[@]}"}; do
  reused "$a" && continue
  echo "⚒ build platform-$a:latest"
  build_runtime
  build_mise "$a"
  [ "$load" = false ] || docker tag "$(tar -C "$state/out/$a" -c . | docker load | sed -n 's/^Loaded image ID: //p')" "platform-$a:latest"
done

build_docker() {
  local a=$1 var args=()
  reused "$a" && return
  echo "⚒ build platform-$a:latest"
  case "$a" in
    nous) var=NOUS_REF ;; gepa) var=GEPA_VERSION ;; openevolve) var=OPENEVOLVE_VERSION ;;
    shinkaevolve) var=SHINKA_VERSION ;; skydiscover) var=SKYDISCOVER_REF ;; *) var="" ;;
  esac
  [ -n "$var" ] && [ -n "${!var:-}" ] && args+=(--build-arg "$var=${!var}")
  docker build -t "platform-$a:latest" ${GITHUB_TOKEN:+--secret id=GITHUB_TOKEN,env=GITHUB_TOKEN} \
    ${args[@]+"${args[@]}"} "$(dir_of "$a")"
}

pids=() failed=()
for a in ${docker_images[@]+"${docker_images[@]}"}; do
  build_docker "$a" 2>&1 | sed "s/^/[$a] /" &
  pids+=("$!")
done
for i in ${pids[@]+"${!pids[@]}"}; do wait "${pids[$i]}" || failed+=("${docker_images[$i]}"); done
[ ${#failed[@]} -eq 0 ] || { echo "failed: ${failed[*]}" >&2; exit 1; }
