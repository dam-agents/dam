#!/usr/bin/env bash
#MISE description="Codex's model instructions open with the platform's model, not the release's GPT-5 one"
#MISE sources=["codex/rootfs/etc/codex/model-instructions.md", ".mise/tasks/check/codex-model-identity"]
#MISE outputs=[]
#MISE cache.enabled=true
# The file is the pinned release's gpt-5.5 entry copied verbatim, and a pin bump
# re-copies it. Its own first line said "a coding agent based on GPT-5" whatever
# the router served, and QA caught 3 of 3 DeepSeek sessions on dam-dev repeating
# that, while the chip and Usage said DeepSeek.
set -euo pipefail
cd "$(dirname "$0")/../../.."
f=codex/rootfs/etc/codex/model-instructions.md
first="$(head -n 1 "$f")"
if [ "$first" != "You are Codex, a coding agent." ]; then
  echo "codex-model-identity: $f opens with '$first', which names a model the router need not serve" >&2
  exit 1
fi
echo "codex-model-identity: ok"
