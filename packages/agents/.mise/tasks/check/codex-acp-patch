#!/usr/bin/env -S node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON
//MISE description="The in-memory codex-acp patch targets the codex-acp version the image pins, so a bump revisits it"
//MISE sources=["codex/image.toml", "codex/rootfs/usr/local/share/codex-platform/codex-acp-patch.mjs", ".mise/tasks/check/codex-acp-patch"]
//MISE outputs=[]
//MISE cache.enabled=true
import { readFileSync } from "node:fs";

const read = (path) => readFileSync(new URL(`../../../${path}`, import.meta.url), "utf8");
const pinned = read("codex/image.toml").match(
  /^"npm:@agentclientprotocol\/codex-acp" = (?:"([^"]+)"|\{ version = "([^"]+)")/m,
);
const pinnedVersion = pinned?.[1] ?? pinned?.[2];
const patched = read("codex/rootfs/usr/local/share/codex-platform/codex-acp-patch.mjs").match(
  /^const PATCHED_VERSION = "([^"]+)";$/m,
)?.[1];

if (pinnedVersion === undefined) {
  console.error("codex-acp-patch: codex/image.toml pins codex-acp in a form this check does not read (a version string or an inline table with version first)");
  process.exit(1);
}
if (pinnedVersion !== patched) {
  console.error(
    `codex-acp-patch: the image pins codex-acp ${pinnedVersion} but the patch targets ${patched}. ` +
      "If that release closes agentclientprotocol/codex-acp#663 (skips title generation on a provider other than OpenAI's own, #595, " +
      "names the session from session/new, #338, or carries a switch), " +
      "drop the patch (packages/agents/codex/README.md, \"codex-acp patch\"); " +
      "otherwise confirm its edit still applies and update PATCHED_VERSION.",
  );
  process.exit(1);
}
console.log("codex-acp-patch: ok");
