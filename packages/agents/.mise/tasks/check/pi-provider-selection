#!/usr/bin/env node
//MISE description="Pi starts on the session's provider and model, even with stale saved defaults"
//MISE sources=["pi-agent/rootfs/usr/local/bin/pi-platform", "pi-agent/rootfs/usr/local/share/pi-platform/extensions/pi-dynamic-providers/**", ".mise/tasks/check/pi-provider-selection", "../../pnpm-lock.yaml"]
//MISE outputs=[]
import assert from "node:assert/strict";
import { spawn } from "node:child_process";
import { once } from "node:events";
import { mkdtempSync, mkdirSync, readFileSync, writeFileSync, rmSync } from "node:fs";
import { createServer } from "node:http";
import { tmpdir } from "node:os";
import { dirname, join } from "node:path";
import { fileURLToPath } from "node:url";

const root = fileURLToPath(new URL("../../../pi-agent/", import.meta.url));
const extension = join(root, "rootfs/usr/local/share/pi-platform/extensions/pi-dynamic-providers/index.ts");
const cli = join(dirname(extension), "node_modules/@earendil-works/pi-coding-agent/dist/cli.js");
const home = mkdtempSync(join(tmpdir(), "pi-provider-selection-"));
const requests = [];
let inference;
const inferenceRequest = new Promise((resolve) => { inference = resolve; });
const server = createServer((req, res) => {
  requests.push(req.url);
  if (req.method === "POST") {
    let body = "";
    req.on("data", (chunk) => { body += chunk; });
    req.on("end", () => {
      inference({ path: req.url, ...JSON.parse(body) });
      res.setHeader("content-type", "text/event-stream");
      res.end('data: {"id":"test","object":"chat.completion.chunk","choices":[{"index":0,"delta":{"content":"Hello"},"finish_reason":"stop"}]}\n\ndata: [DONE]\n\n');
    });
    return;
  }
  res.setHeader("content-type", "application/json");
  res.end(JSON.stringify({ data: [{ id: "azure/gpt-6-astra" }, { id: "pin-model" }] }));
});
server.listen(0, "127.0.0.1");
await once(server, "listening");
const address = server.address();
assert.ok(address && typeof address !== "string");
const shared = join(home, ".pi/agent");
mkdirSync(shared, { recursive: true });
writeFileSync(join(shared, "settings.json"), JSON.stringify({ defaultProvider: "anthropic", defaultModel: "claude-sonnet-4-6", packages: [] }));
mkdirSync(join(home, "bin"));
writeFileSync(join(home, "bin/pi"), `#!/bin/sh\nexec '${process.execPath}' '${cli}' "$@"\n`, { mode: 0o755 });
writeFileSync(join(home, "bin/mise"), "#!/bin/sh\nexit 1\n", { mode: 0o755 });
const wrapper = readFileSync(join(root, "rootfs/usr/local/bin/pi-platform"), "utf8").replace("/usr/local/share/pi-platform/extensions/pi-dynamic-providers/index.ts", extension);
writeFileSync(join(home, "pi-platform"), wrapper);
let child;
try {
  child = spawn("/bin/sh", [join(home, "pi-platform"), "--mode", "rpc", "--no-session", "--no-extensions", "--no-skills", "--no-prompt-templates"], {
    cwd: home,
    env: {
      PATH: `${home}/bin:${process.env.PATH}`, HOME: home, PI_OFFLINE: "1",
      PLATFORM_PROVIDER: "litellm-test", PLATFORM_MODEL: "azure/gpt-6-astra",
      OPENAI_PROXY_URL: `http://127.0.0.1:${address.port}`, OPENAI_PROXY_MODEL: "pin-model",
      ANTHROPIC_API_KEY: "dummy-placeholder",
    },
    stdio: ["pipe", "pipe", "pipe"],
  });
  let output = "";
  let errors = "";
  child.stderr.on("data", (data) => { errors += data; });
  const state = await new Promise((resolve, reject) => {
    const timer = setTimeout(() => reject(new Error(`Pi startup timed out: ${errors}`)), 30_000);
    child.once("exit", (code) => { clearTimeout(timer); reject(new Error(`Pi exited ${code}: ${errors}`)); });
    child.stdout.on("data", (data) => {
      output += data;
      for (const line of output.split("\n")) {
        let message;
        try { message = JSON.parse(line); } catch { continue; }
        if (message.type === "response" && message.command === "get_state") {
          clearTimeout(timer);
          resolve(message);
        }
      }
    });
    child.stdin.write(`${JSON.stringify({ id: "state", type: "get_state" })}\n`);
  });
  assert.equal(state.success, true, JSON.stringify(state));
  assert.equal(state.data.model?.provider, "openai-proxy");
  assert.equal(state.data.model?.id, "azure/gpt-6-astra");
  assert.equal(errors.includes("unavailable"), false, errors);
  assert.ok(requests.includes("/v1/models"));
  let timeout;
  try {
    child.stdin.write(`${JSON.stringify({ type: "set_thinking_level", level: "low" })}\n`);
    child.stdin.write(`${JSON.stringify({ type: "prompt", message: "Say hello." })}\n`);
    const request = await Promise.race([
      inferenceRequest,
      new Promise((_, reject) => { timeout = setTimeout(() => reject(new Error("Pi did not call the selected provider")), 30_000); }),
    ]);
    assert.equal(request.path, "/v1/responses");
    assert.equal(request.model, "azure/gpt-6-astra");
    assert.equal(request.max_tokens, undefined);
    assert.equal(request.max_output_tokens, 16384);
    assert.equal(request.reasoning?.effort, "low", JSON.stringify(request));
  } finally { clearTimeout(timeout); }
  console.log("pi-provider-selection: first prompt reaches the selected provider and model with its thinking level; no unsupported imports");
} finally {
  if (child && child.exitCode === null) { child.kill(); await once(child, "exit"); }
  server.close();
  rmSync(home, { recursive: true, force: true });
}
