#!/usr/bin/env bash
#MISE description="Build a Debian agent image with `mise oci`: an agent whose directory has an image.toml (claude-code, codex, pi-agent, bob). Linux host of the target arch with apt-get (the lima VM on macOS). Options: --from=REF base image, --load[=TAG] into docker (default platform-<harness>:latest)"
#MISE dir="{{vars.repo_root}}"
set -euo pipefail

agents=packages/agents
harness=""
from=""
load=""
for a in "$@"; do
  case "$a" in
    --from=*) from="${a#--from=}" ;;
    --load) load=default ;;
    --load=*) load="${a#--load=}" ;;
    -*) echo "unknown option: $a" >&2; exit 2 ;;
    *) harness="$a" ;;
  esac
done
[ -n "$harness" ] && [ -f "$agents/$harness/image.toml" ] || {
  echo "usage: oci <agent> [--from=REF] [--load[=TAG]]; agents built this way:" \
    "$(cd "$agents" && ls -d */image.toml | sed 's|/image.toml$||' | tr '\n' ' ')" >&2
  exit 2
}
[ "$load" = default ] && load="platform-$harness:latest"

# `mise oci build` packages the host's own installs and runs the host's apt-get
# for [bootstrap.packages], so the host must be Linux of the image's arch and
# Debian-family.
[ "$(uname -s)" = Linux ] || { echo "mise oci builds on Linux only; on macOS run this in the lima VM" >&2; exit 1; }
command -v apt-get >/dev/null || { echo "needs apt-get on the build host for [bootstrap.packages]" >&2; exit 1; }

state="${XDG_CACHE_HOME:-$HOME/.cache}/platform-agent-oci"
work="$state/build"
stage="$work/stage"
runtime="$work/runtime"
out="$state/out/$harness"

# agent-runtime and driver-sdk, built with the repo's own toolchain the way
# platform-base's builder stage builds them.
pnpm --filter agent-runtime exec tsup
pnpm --filter driver-sdk exec tsup
rm -rf "$runtime"
npm_config_inject_workspace_packages=true \
  pnpm --filter agent-runtime deploy --frozen-lockfile --prod --node-linker=hoisted "$runtime"
cp packages/agent-runtime/package.json "$runtime/package.json"
(cd "$runtime" && pnpm pkg delete devDependencies)

# From here on mise runs for the image, not for the repo: the project and task
# context mise hands this task is dropped (settings the caller exported stay),
# the staged config sits outside the repo so its root config is not a parent,
# and the ceiling stops the walk up.
unset MISE_ENV MISE_CONFIG_ROOT MISE_MONOREPO_ROOT MISE_ORIGINAL_CWD MISE_PROJECT_ROOT
while IFS= read -r v; do unset "$v"; done < <(compgen -e | grep '^MISE_TASK_')
mkdir -p "$work"/{data,cache,config,state}
export MISE_DATA_DIR="$work/data" MISE_CACHE_DIR="$work/cache" MISE_STATE_DIR="$work/state" \
  MISE_CONFIG_DIR="$work/config" MISE_GLOBAL_CONFIG_FILE="$work/config/none.toml" \
  MISE_SYSTEM_CONFIG_DIR="$work/config/system" MISE_CEILING_PATHS="$work" MISE_EXPERIMENTAL=1
: > "$MISE_GLOBAL_CONFIG_FILE"

# The stage mirrors packages/agents: base/ and every agent with an image.toml
# keep their directories, and what mise loads by name goes where it looks for
# it — base/miserc.toml as .miserc.toml, base/base.toml and each image.toml as
# conf.d fragments. In the repo those files cannot carry mise's own names,
# because every agent directory is a mise config root. build/ beside them is
# what the host builds; git keeps no empty directories, so the ones the image
# needs are made there too. node_modules is left out: pnpm links the pi
# extension's dev dependencies into its tree, and the image ships the
# extension's source only.
rm -rf "$stage"
mkdir -p "$stage/mise/conf.d"
cp "$agents/base/miserc.toml" "$stage/.miserc.toml"
cp "$agents/base/base.toml" "$stage/mise/conf.d/base.toml"
for d in "$agents/base" "$agents"/*/image.toml; do
  [ -d "$d" ] || d="$(dirname "$d")"
  a="$(basename "$d")"
  [ "$a" = base ] || cp "$d/image.toml" "$stage/mise/conf.d/harness.$a.toml"
  mkdir -p "$stage/$a/rootfs"
  tar -C "$d/rootfs" --exclude=node_modules -cf - . | tar -C "$stage/$a/rootfs" -xf -
done
b="$stage/build"
install -d "$b"/{app/working-dir/.agents/skills,app/working-dir/.claude,home/agent,etc/logrotate.d,etc/ssl/certs} \
  "$b"/usr/local/{bin,lib/platform-python} "$b"/usr/local/share/{ca-certificates,tool-bin,dam-skills}
cp -a "$runtime/package.json" "$runtime/node_modules" "$b/app/"
cp -a packages/agent-runtime/dist "$b/app/dist"
install -m 644 packages/driver-sdk/dist/driver-sdk.mjs "$b/usr/local/lib/driver-sdk.mjs"

# What every harness shares with the Fedora images still built on
# platform-base (k-search, the e2e mock) comes from there, not from a copy: the
# skills and the shipped-skill manifest that covers them, the working-dir
# seed, the default runtime manifest, dam-run and the experiment SDK.
p=packages/platform-base
cp -a "$p/skills/." "$b/app/working-dir/.agents/skills/"
cp -a "$p/dam-skills/." "$b/usr/local/share/dam-skills/"
install -m 644 "$p/skills-manifest.json" "$b/usr/local/share/dam-skill-manifest.json"
install -m 644 "$p/working-dir/.claude.json" "$b/app/working-dir/.claude.json"
install -m 644 "$p/working-dir/.claude/settings.json" "$b/app/working-dir/.claude/settings.json"
install -m 644 "$p/runtime-manifest.yaml" "$b/app/runtime-manifest.yaml"
install -m 755 "$p/dam-run.mjs" "$b/usr/local/bin/dam-run"
install -m 644 packages/experiment-sdk/src/experiment_sdk.py "$b/usr/local/lib/platform-python/experiment_sdk.py"

# Every mise call for the image runs from inside the stage, not with -C: mise
# reads .miserc.toml, and with it the env_conf_d opt-in, from the working
# directory, so under -C every harness fragment would load at once.
own_layout="$PWD/$agents/base/own-layout.py"
cd "$stage"
mise trust -q .
# The resolved versions are locked first, the way platform-base locks its tools
# at build time, so an install under MISE_LOCKED (CI) has URLs and checksums.
case "$(uname -m)" in x86_64) platform=linux-x64 ;; aarch64 | arm64) platform=linux-arm64 ;; *) platform="linux-$(uname -m)" ;; esac
mise -E "$harness" lock --platform "$platform"
mise -E "$harness" install

# Claude's CLI sits inside the adapter's install under a per-arch directory, so
# the two tool-bin links its scripts and manifest name are resolved on the host
# and pointed at where that install sits inside the image.
if [ "$harness" = claude-code ]; then
  in_image() { printf '/usr/local/share/mise%s\n' "${1#"$MISE_DATA_DIR"}"; }
  acp="$(mise -E claude-code where npm:@agentclientprotocol/claude-agent-acp)/lib/node_modules/@agentclientprotocol/claude-agent-acp"
  cli="$(echo "$acp"/node_modules/@anthropic-ai/claude-agent-sdk-*/claude)"
  test -x "$cli"
  ln -sfn "$(in_image "$acp")" "$b/usr/local/share/tool-bin/claude-agent-acp-lib"
  ln -sfn "$(in_image "$cli")" "$b/usr/local/share/tool-bin/claude"
fi

# mise's apt bootstrap runs apt-get and dpkg against the host's own apt and
# debconf caches too, so the build needs root; a CI runner has passwordless
# sudo. What it writes as root is handed back, so the next build can reuse it.
# out/ is made here, as this user: the build under sudo would create it as
# root, and nothing could then remove a layout from it.
rm -rf "$out"
mkdir -p "$(dirname "$out")"
if [ "$(id -u)" = 0 ]; then
  mise -E "$harness" oci build -o "$out" ${from:+--from "$from"}
else
  sudo --preserve-env env "PATH=$PATH" "$(command -v mise)" -E "$harness" oci build -o "$out" ${from:+--from "$from"}
  sudo chown -R "$(id -u):$(id -g)" "$work" "$out"
fi
# The layers are built root-owned, and the paths the agent writes are handed to
# it afterwards: mise stamps one owner on every layer it generates.
mise -E "$harness" exec -- python3 "$own_layout" "$out"
echo "OCI layout: $out"

if [ -n "$load" ]; then
  tar -C "$out" -cf "$work/image.tar" .
  id="$(docker load -i "$work/image.tar" | sed -n 's/^Loaded image ID: //p')"
  docker tag "$id" "$load"
  rm -f "$work/image.tar"
  echo "loaded into docker as $load"
fi
