#!/usr/bin/env node
//MISE description="Test that on a machine the entrypoint gives uid 0 the agent's home, and moves what /root/.ssh held into it"
//MISE sources=["base/rootfs/usr/local/bin/agent-entrypoint", ".mise/tasks/test/entrypoint-ssh-home"]
//MISE outputs=[]
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

const entrypoint = fileURLToPath(new URL("../../../base/rootfs/usr/local/bin/agent-entrypoint", import.meta.url));
const dir = mkdtempSync(join(tmpdir(), "entrypoint-ssh-home-"));
const [home, root] = ["home", "root"].map((d) => join(dir, d));
const passwd = join(dir, "passwd");
writeFileSync(
  join(dir, "agent-entrypoint"),
  readFileSync(entrypoint, "utf8")
    .replaceAll("uid=$(id -u)", "uid=0")
    .replaceAll("sed -i 's/^agent:x:65532:0:/agent:x:0:0:/' /etc/passwd", ":")
    // TEST_OVERVIEW: BSD sed takes the argument after -i as a backup suffix, so on a Mac the suffix is given empty.
    .replaceAll("sed -i ", process.platform === "darwin" ? "sed -i '' " : "sed -i ")
    .replaceAll("/etc/passwd", passwd)
    .replaceAll("/run/sshd", join(dir, "sshd"))
    .replaceAll("/root", root)
    .replaceAll("/etc/platform/ca", join(dir, "ca"))
    .replaceAll("/etc/rancher/k3s/config.yaml", join(dir, "k3s-config.yaml"))
    .replaceAll("/platform/runc", join(dir, "platform-runc"))
    .replaceAll("/app/working-dir", join(dir, "working-dir")),
);
const boot = () =>
  execFileSync("/bin/sh", [join(dir, "agent-entrypoint"), "true"], {
    env: { PATH: process.env.PATH, HOME: home },
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
const mode = (p) => statSync(p).mode & 0o777;

try {
  mkdirSync(home);
  mkdirSync(join(root, ".ssh"), { recursive: true, mode: 0o700 });
  writeFileSync(passwd, `root:x:0:0:root:${root}:/bin/bash\nagent:x:0:0::${home}:/bin/sh\n`);

  // TEST_SCENARIO: uid 0's entry, the one OpenSSH reads, names the agent's home rather than /root, so ssh and ssh-keygen use the home on the disk; nothing else in the entry changes.
  boot();
  assert.equal(readFileSync(passwd, "utf8"), `root:x:0:0:root:${home}:/bin/bash\nagent:x:0:0::${home}:/bin/sh\n`);
  assert.equal(existsSync(join(root, ".ssh")), false);

  // TEST_SCENARIO: what an older boot left in /root/.ssh moves into the home with its modes; a key the home already holds is not overwritten and the root's copy stays behind, and the root's known hosts are added to the home's.
  mkdirSync(join(root, ".ssh"), { mode: 0o700 });
  writeFileSync(join(root, ".ssh/id_ed25519"), "vm key\n", { mode: 0o600 });
  writeFileSync(join(root, ".ssh/id_rsa"), "root rsa\n", { mode: 0o600 });
  writeFileSync(join(root, ".ssh/known_hosts"), "github.com ssh-ed25519 B\n");
  mkdirSync(join(home, ".ssh"), { recursive: true, mode: 0o700 });
  writeFileSync(join(home, ".ssh/id_rsa"), "container rsa\n", { mode: 0o600 });
  writeFileSync(join(home, ".ssh/known_hosts"), "gitlab.com ssh-ed25519 A\n");
  boot();
  assert.equal(readFileSync(join(home, ".ssh/id_ed25519"), "utf8"), "vm key\n");
  assert.equal(mode(join(home, ".ssh/id_ed25519")), 0o600);
  assert.equal(mode(join(home, ".ssh")), 0o700);
  assert.equal(readFileSync(join(home, ".ssh/id_rsa"), "utf8"), "container rsa\n");
  assert.equal(readFileSync(join(root, ".ssh/id_rsa"), "utf8"), "root rsa\n");
  assert.equal(readFileSync(join(home, ".ssh/known_hosts"), "utf8"), "gitlab.com ssh-ed25519 A\ngithub.com ssh-ed25519 B\n");
  assert.equal(existsSync(join(root, ".ssh/known_hosts")), false);
} finally {
  rmSync(dir, { recursive: true, force: true });
}
