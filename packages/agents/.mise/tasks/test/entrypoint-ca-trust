#!/usr/bin/env node
//MISE description="Test that the entrypoint builds the CA bundle under /run on every boot and rebuilds Chromium's store only when the platform CA set changes"
//MISE sources=["base/rootfs/usr/local/bin/agent-entrypoint", "base/rootfs/usr/local/bin/platform-ca-bundle", ".mise/tasks/test/entrypoint-ca-trust"]
//MISE outputs=[]
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

const tool = (name) => fileURLToPath(new URL(`../../../base/rootfs/usr/local/bin/${name}`, import.meta.url));
const dir = mkdtempSync(join(tmpdir(), "entrypoint-ca-trust-"));
const [ca, run, home, bin, workingDir] = ["ca", "run", "home", "bin", "working-dir"].map((d) => join(dir, d));
for (const d of [ca, home, bin, workingDir]) mkdirSync(d);
const imageRoots = join(dir, "image-roots.crt");
writeFileSync(imageRoots, "image roots\n");
const calls = join(dir, "calls");
writeFileSync(
  join(bin, "certutil"),
  `#!/bin/sh\nif [ -e ${dir}/certutil-awaits-command ] && [ "$3" = -N ]; then i=0; until grep -qx command ${calls} 2>/dev/null || [ $i -ge 300 ]; do sleep 0.1; i=$((i+1)); done; fi\necho "certutil $3" >> ${calls}\n[ "$3" = -N ] && touch "\${2#sql:}/cert9.db"\nexit 0\n`,
  { mode: 0o755 },
);
const relocated = (name) =>
  readFileSync(tool(name), "utf8")
    .replaceAll("uid=$(id -u)", "uid=never")
    .replaceAll("/etc/platform/ca", ca)
    .replaceAll("/run/platform", run)
    .replaceAll("/usr/share/platform/ca-certificates.crt", imageRoots)
    .replaceAll("/app/working-dir", workingDir);
writeFileSync(join(dir, "agent-entrypoint"), relocated("agent-entrypoint"));
writeFileSync(join(bin, "platform-ca-bundle"), relocated("platform-ca-bundle"), { mode: 0o755 });
const pem = (body) => `-----BEGIN CERTIFICATE-----\n${body}\n-----END CERTIFICATE-----\n`;
const boot = (command = ["true"]) => {
  rmSync(calls, { force: true });
  execFileSync("/bin/sh", [join(dir, "agent-entrypoint"), ...command], {
    env: { PATH: `${bin}:${process.env.PATH}`, HOME: home },
    encoding: "utf8",
    stdio: ["ignore", "pipe", "pipe"],
  });
  return existsSync(calls) ? readFileSync(calls, "utf8").trim().split("\n") : [];
};
const bundle = () => readFileSync(join(run, "ca-certificates.crt"), "utf8");

try {
  // TEST_SCENARIO: the bundle the image's bundle path and CA variables name is built under /run: the image's roots, then every platform CA, each ending in a newline. The platform CAs alone are beside it, for the image's local CA link. Chromium's NSS store gets one certificate per PEM block.
  writeFileSync(join(ca, "ca.crt"), pem("one") + pem("two"));
  writeFileSync(join(ca, "extra.crt"), pem("three").trimEnd());
  assert.deepEqual(boot(), ["certutil -N", "certutil -L", "certutil -A", "certutil -A", "certutil -A"]);
  assert.equal(bundle(), "image roots\n" + pem("one") + pem("two") + pem("three"));
  assert.equal(readFileSync(join(run, "ca.crt"), "utf8"), pem("one") + pem("two") + pem("three"));
  assert.equal(existsSync(join(run, "ca-certificates.crt.new")), false);

  // TEST_SCENARIO: a boot with the same CA set rebuilds Chromium's store in the home, which outlives the boot, not at all.
  assert.deepEqual(boot(), []);

  // TEST_SCENARIO: Chromium's NSS store is built in a process the entrypoint does not wait for, so the image's command starts before it is done. The store's build waits up to 30 s for the command, so an entrypoint that waits for the build records the command last.
  writeFileSync(join(dir, "certutil-awaits-command"), "");
  rmSync(join(home, ".pki"), { recursive: true });
  assert.deepEqual(boot(["sh", "-c", `echo command >> ${calls}`]), ["command", "certutil -N", "certutil -L", "certutil -A", "certutil -A", "certutil -A"]);
  rmSync(join(dir, "certutil-awaits-command"));

  // TEST_SCENARIO: a new image's roots and a rotated CA reach the bundle at the next boot, since it is built from both every time, and a CA that went away leaves it.
  writeFileSync(imageRoots, "new image roots");
  writeFileSync(join(ca, "ca.crt"), pem("four"));
  rmSync(join(ca, "extra.crt"));
  assert.deepEqual(boot(), ["certutil -L", "certutil -A"]);
  assert.equal(bundle(), "new image roots" + pem("four"));

  // TEST_SCENARIO: an install without platform CAs still gets the image's roots at the bundle path.
  rmSync(join(ca, "ca.crt"));
  boot();
  assert.equal(bundle(), "new image roots");
} finally {
  rmSync(dir, { recursive: true, force: true });
}
