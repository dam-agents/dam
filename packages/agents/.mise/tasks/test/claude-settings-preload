#!/usr/bin/env node
//MISE description="Test that Claude Code's settings sync, preloaded into the ACP adapter's node, runs before the adapter and never stops it"
//MISE sources=["claude-code/rootfs/usr/local/lib/sync-claude-settings.mjs", "claude-code/rootfs/usr/local/bin/harness-chat", ".mise/tasks/test/claude-settings-preload"]
//MISE outputs=[]
import assert from "node:assert/strict";
import { spawn, spawnSync } from "node:child_process";
import { existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, renameSync, rmSync, utimesSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

const script = fileURLToPath(new URL("../../../claude-code/rootfs/usr/local/lib/sync-claude-settings.mjs", import.meta.url));
const harnessChat = readFileSync(new URL("../../../claude-code/rootfs/usr/local/bin/harness-chat", import.meta.url), "utf8");

// TEST_SCENARIO: harness-chat preloads this very script into the adapter's node, so the test runs the line it ships.
assert.match(harnessChat, /exec node --import \/usr\/local\/lib\/sync-claude-settings\.mjs/);

const run = (prepare) => {
  const home = mkdtempSync(join(tmpdir(), "claude-settings-preload-"));
  try {
    prepare?.(home);
    const entry = join(home, "adapter.mjs");
    writeFileSync(
      entry,
      `import { readFileSync } from "node:fs";
let settings = null;
try { settings = JSON.parse(readFileSync(process.env.HOME + "/.claude/settings.json", "utf8")); } catch {}
process.stdout.write(JSON.stringify({ argv: process.argv.slice(1), stop: settings?.hooks?.Stop?.length ?? 0 }));
`,
    );
    const r = spawnSync(process.execPath, ["--import", script, entry, "--flag"], {
      env: { PATH: process.env.PATH, HOME: home },
      encoding: "utf8",
    });
    assert.equal(r.status, 0, r.stderr);
    return { entry, ...JSON.parse(r.stdout), stderr: r.stderr };
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
};

// TEST_SCENARIO: The adapter reads the settings the sync wrote, so the sync finishes before the adapter's first line, and the adapter sees its own argv.
const synced = run();
assert.deepEqual(synced.argv, [synced.entry, "--flag"]);
assert.equal(synced.stop, 1);

// TEST_SCENARIO: A home where the settings cannot be written still starts the adapter: the sync says why on stderr and the chat runs on the settings it has.
const unwritable = run((home) => writeFileSync(join(home, ".claude"), ""));
assert.equal(unwritable.stop, 0);
assert.match(unwritable.stderr, /sync-claude-settings: /);

// TEST_SCENARIO: A settings file that parses but has the wrong shape makes the sync throw before its write; the adapter still starts, on the file as it is.
const malformed = run((home) => {
  mkdirSync(join(home, ".claude"));
  writeFileSync(join(home, ".claude/settings.json"), "null");
});
assert.equal(malformed.stop, 0);
assert.match(malformed.stderr, /sync-claude-settings: /);

// TEST_SCENARIO: A settings file the sync cannot parse — caught mid-write, or broken — is kept byte for byte: the sync says why instead of treating it as empty and writing over the only copy.
for (const broken of ['{"theme": "dark", "hooks": {', '{"theme": "dark",}\n']) {
  const home = mkdtempSync(join(tmpdir(), "claude-settings-broken-"));
  try {
    const settings = join(home, ".claude/settings.json");
    mkdirSync(join(home, ".claude"));
    writeFileSync(settings, broken);
    const r = spawnSync(process.execPath, ["--import", script, "-e", ""], {
      env: { PATH: process.env.PATH, HOME: home, OTEL_EXPORTER_OTLP_ENDPOINT: "http://gateway:4318" },
      encoding: "utf8",
    });
    assert.equal(r.status, 0, r.stderr);
    assert.match(r.stderr, /sync-claude-settings: .*settings\.json/);
    assert.equal(readFileSync(settings, "utf8"), broken);
    assert.deepEqual(readdirSync(join(home, ".claude")), ["settings.json"]);
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
}

// TEST_SCENARIO: A starter kit holds the settings lock while the sync starts. The sync waits for it and reads the file only after the kit releases it, so the hook the kit merges while the sync waits survives the sync's own write.
{
  const home = mkdtempSync(join(tmpdir(), "claude-settings-lock-"));
  try {
    const settings = join(home, ".claude/settings.json");
    const lock = `${settings}.lock`;
    const kitStop = "/home/agent/.claude/hooks/kit-stop.sh";
    mkdirSync(join(home, ".claude"));
    writeFileSync(settings, JSON.stringify({ theme: "dark" }));
    writeFileSync(lock, String(process.pid));
    const child = spawn(process.execPath, ["--import", script, "-e", ""], {
      env: { PATH: process.env.PATH, HOME: home, OTEL_EXPORTER_OTLP_ENDPOINT: "http://gateway:4318" },
    });
    let stderr = "";
    child.stderr.on("data", (d) => (stderr += d));
    const exited = new Promise((resolve) => child.on("exit", (code) => resolve(code)));
    await new Promise((resolve) => setTimeout(resolve, 1000));
    assert.equal(child.exitCode, null, "the sync must wait for the lock another writer holds");
    assert.equal(readFileSync(settings, "utf8"), JSON.stringify({ theme: "dark" }));
    writeFileSync(`${settings}.tmp`, JSON.stringify({ theme: "dark", hooks: { Stop: [{ hooks: [{ type: "command", command: kitStop }] }] } }));
    renameSync(`${settings}.tmp`, settings);
    rmSync(lock);
    assert.equal(await exited, 0, stderr);
    assert.equal(stderr, "");
    const after = JSON.parse(readFileSync(settings, "utf8"));
    assert.equal(after.theme, "dark");
    assert.deepEqual(
      after.hooks.Stop.flatMap((matcher) => matcher.hooks.map((hook) => hook.command)).sort(),
      [kitStop, "node /usr/local/lib/report-background-work.mjs"].sort(),
    );
    assert.deepEqual(Object.keys(after.hooks).sort(), ["Stop", "SubagentStop"]);
    assert.equal(after.env.OTEL_EXPORTER_OTLP_ENDPOINT, "http://gateway:4318");
    assert.deepEqual(readdirSync(join(home, ".claude")), ["settings.json"]);
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
}

// TEST_SCENARIO: A lock nobody releases makes the sync say which lock it waited on and leave the file as it is, rather than write without it; the chat still starts.
{
  const home = mkdtempSync(join(tmpdir(), "claude-settings-lock-held-"));
  try {
    const settings = join(home, ".claude/settings.json");
    const lock = `${settings}.lock`;
    mkdirSync(join(home, ".claude"));
    writeFileSync(settings, JSON.stringify({ theme: "dark" }));
    writeFileSync(lock, String(process.pid));
    const r = spawnSync(process.execPath, ["--import", script, "-e", ""], {
      env: { PATH: process.env.PATH, HOME: home, OTEL_EXPORTER_OTLP_ENDPOINT: "http://gateway:4318" },
      encoding: "utf8",
      timeout: 60_000,
    });
    assert.equal(r.status, 0, r.stderr);
    assert.match(r.stderr, /settings\.json\.lock/);
    assert.equal(readFileSync(settings, "utf8"), JSON.stringify({ theme: "dark" }));
    assert.equal(existsSync(lock), true, "a lock the sync did not take is never removed");
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
}

// TEST_SCENARIO: A lock left behind by a writer that died inside its section is broken once it is older than any write takes, so a crash never stops the sync for good.
{
  const home = mkdtempSync(join(tmpdir(), "claude-settings-lock-dead-"));
  try {
    const settings = join(home, ".claude/settings.json");
    const lock = `${settings}.lock`;
    mkdirSync(join(home, ".claude"));
    writeFileSync(settings, JSON.stringify({ theme: "dark" }));
    writeFileSync(lock, `${spawnSync(process.execPath, ["-e", ""]).pid}:gone`);
    const longAgo = new Date(Date.now() - 60_000);
    utimesSync(lock, longAgo, longAgo);
    const r = spawnSync(process.execPath, ["--import", script, "-e", ""], {
      env: { PATH: process.env.PATH, HOME: home, OTEL_EXPORTER_OTLP_ENDPOINT: "http://gateway:4318" },
      encoding: "utf8",
    });
    assert.equal(r.status, 0, r.stderr);
    assert.equal(r.stderr, "");
    assert.equal(JSON.parse(readFileSync(settings, "utf8")).theme, "dark");
    assert.deepEqual(readdirSync(join(home, ".claude")), ["settings.json"]);
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
}

// TEST_SCENARIO: A run whose own keys are already in the file does not rewrite it, so another writer's keys and formatting are left exactly as they are.
{
  const home = mkdtempSync(join(tmpdir(), "claude-settings-unchanged-"));
  try {
    const settings = join(home, ".claude/settings.json");
    const env = { PATH: process.env.PATH, HOME: home, OTEL_EXPORTER_OTLP_ENDPOINT: "http://gateway:4318" };
    mkdirSync(join(home, ".claude"));
    assert.equal(spawnSync(process.execPath, ["--import", script, "-e", ""], { env }).status, 0);
    const settled = `${JSON.stringify({ ...JSON.parse(readFileSync(settings, "utf8")), theme: "dark" }, null, 4)}\n`;
    writeFileSync(settings, settled);
    const r = spawnSync(process.execPath, ["--import", script, "-e", ""], { env, encoding: "utf8" });
    assert.equal(r.status, 0, r.stderr);
    assert.equal(readFileSync(settings, "utf8"), settled);
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
}

// TEST_SCENARIO: A starter kit merges its hooks through ~/.claude/settings.json.tmp and moves that file into place. The sync writes through a name of its own, so the kit's temporary file is still there for its own mv.
const home = mkdtempSync(join(tmpdir(), "claude-settings-tmp-"));
try {
  const settings = join(home, ".claude/settings.json");
  const kitTmp = `${settings}.tmp`;
  mkdirSync(join(home, ".claude"));
  writeFileSync(settings, JSON.stringify({ theme: "dark" }));
  writeFileSync(kitTmp, JSON.stringify({ theme: "dark", hooks: { Stop: [] } }));
  const r = spawnSync(process.execPath, ["--import", script, "-e", ""], {
    env: { PATH: process.env.PATH, HOME: home },
    encoding: "utf8",
  });
  assert.equal(r.status, 0, r.stderr);
  assert.equal(
    readFileSync(kitTmp, "utf8"),
    JSON.stringify({ theme: "dark", hooks: { Stop: [] } }),
  );
  assert.match(readFileSync(script, "utf8"), /\$\{path\}\.\$\{process\.pid\}\.tmp/);
  assert.equal(readdirSync(join(home, ".claude")).sort().join(","), "settings.json,settings.json.tmp");

  // TEST_SCENARIO: Two chats open at once run two syncs on the same settings file. Each writes through its own temporary name, so neither renames the other's file away and both leave a settings file that still parses.
  writeFileSync(kitTmp, "{}");
  const exits = await Promise.all(
    Array.from({ length: 4 }, () =>
      new Promise((resolve, reject) => {
        const child = spawn(process.execPath, ["--import", script, "-e", ""], {
          env: { PATH: process.env.PATH, HOME: home },
        });
        let stderr = "";
        child.stderr.on("data", (d) => (stderr += d));
        child.on("error", reject);
        child.on("exit", (code) => resolve({ code, stderr }));
      }),
    ),
  );
  assert.deepEqual(exits.map((e) => e.stderr), ["", "", "", ""]);
  assert.deepEqual(exits.map((e) => e.code), [0, 0, 0, 0]);
  const synced = JSON.parse(readFileSync(settings, "utf8"));
  assert.equal(synced.theme, "dark");
  assert.deepEqual(Object.keys(synced.hooks).sort(), ["Stop", "SubagentStop"]);
  assert.equal(readdirSync(join(home, ".claude")).sort().join(","), "settings.json,settings.json.tmp");
} finally {
  rmSync(home, { recursive: true, force: true });
}
console.log("Claude Code's settings sync runs before the ACP adapter in its node and never stops it");
