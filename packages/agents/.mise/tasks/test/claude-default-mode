#!/usr/bin/env node
//MISE description="Test that Claude Code's settings sync gives a settings file that names no mode a mode the model's catalog allows, and follows a model change"
//MISE sources=["claude-code/rootfs/usr/local/lib/sync-claude-settings.mjs", ".mise/tasks/test/claude-default-mode"]
//MISE outputs=[]
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

const script = fileURLToPath(new URL("../../../claude-code/rootfs/usr/local/lib/sync-claude-settings.mjs", import.meta.url));

const withHome = (runs) => {
  const home = mkdtempSync(join(tmpdir(), "claude-default-mode-"));
  const settingsPath = join(home, ".claude/settings.json");
  const sync = (patch) => {
    mkdirSync(join(home, ".claude"), { recursive: true });
    let file = {};
    try {
      file = JSON.parse(readFileSync(settingsPath, "utf8"));
    } catch {}
    if (patch !== undefined) writeFileSync(settingsPath, JSON.stringify({ ...file, ...patch }));
    execFileSync(process.execPath, [script], { env: { PATH: process.env.PATH, HOME: home } });
    return JSON.parse(readFileSync(settingsPath, "utf8")).permissions;
  };
  try {
    return runs(sync);
  } finally {
    rmSync(home, { recursive: true, force: true });
  }
};

// TEST_SCENARIO: A settings file that names no mode starts in auto, the catalog's default, which the ACP adapter would not reach on its own: its fallback is the mode that asks before each tool call.
assert.equal(withHome((sync) => sync({ model: "opus", permissions: { allow: ["Read"] } }).defaultMode), "auto");
assert.deepEqual(withHome((sync) => sync({ model: "opus", permissions: { allow: ["Read"] } }).allow), ["Read"]);
assert.equal(withHome((sync) => sync({}).defaultMode), "auto");
assert.equal(withHome((sync) => sync(undefined).defaultMode), "auto");
// TEST_SCENARIO: Haiku's catalog constraints exclude auto, so a settings file on that model starts in the mode that asks instead.
assert.equal(withHome((sync) => sync({ model: "haiku" }).defaultMode), "default");
assert.equal(withHome((sync) => sync({ model: "ibm/aws/claude-haiku-4-5" }).defaultMode), "default");
// TEST_SCENARIO: The default follows the agent's model at every start, both ways, because the platform wrote the mode and nobody chose it.
assert.deepEqual(
  withHome((sync) => ["opus", "haiku", "opus"].map((model) => sync({ model }).defaultMode)),
  ["auto", "default", "auto"],
);
// TEST_SCENARIO: A mode an owner picked stays as it is, also when the agent moves to a model that cannot run it.
for (const mode of ["default", "acceptEdits", "plan", "dontAsk", "bypassPermissions"])
  assert.equal(withHome((sync) => sync({ model: "opus", permissions: { defaultMode: mode } }).defaultMode), mode);
assert.deepEqual(
  withHome((sync) => [
    sync({ model: "opus", permissions: { defaultMode: "bypassPermissions" } }).defaultMode,
    sync({ model: "haiku" }).defaultMode,
  ]),
  ["bypassPermissions", "bypassPermissions"],
);
console.log("Claude Code's settings sync gives a settings file that names no mode a mode the model's catalog allows, and follows a model change");
