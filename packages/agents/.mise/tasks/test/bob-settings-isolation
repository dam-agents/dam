#!/usr/bin/env node
//MISE description="Test that each Bob process reads and writes its own settings file, while its bootstrap reads the shared one"
//MISE sources=["bob/rootfs/usr/local/lib/bob-settings-file.mjs", "bob/rootfs/usr/local/lib/bob-preload-lib.mjs", "bob/rootfs/usr/local/bin/harness-chat", "bob/rootfs/app/bob-settings.mjs", ".mise/tasks/test/bob-settings-isolation"]
//MISE outputs=[]
import assert from "node:assert/strict";
import { execFileSync } from "node:child_process";
import { mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
import { tmpdir } from "node:os";
import { join } from "node:path";
import { fileURLToPath } from "node:url";

const preload = fileURLToPath(new URL("../../../bob/rootfs/usr/local/lib/bob-settings-file.mjs", import.meta.url));
const rootfs = fileURLToPath(new URL("../../../bob/rootfs/", import.meta.url));
const home = mkdtempSync(join(tmpdir(), "bob-settings-isolation-"));
const shared = join(home, ".bob/settings/settings.json");
const own = join(home, ".bob/platform-processes/a/settings.json");
mkdirSync(join(home, ".bob/settings"), { recursive: true });
mkdirSync(join(home, ".bob/platform-processes/a"), { recursive: true });
writeFileSync(shared, '{"session":{"model":"shared"}}');
writeFileSync(own, '{"session":{"model":"own"}}');
// TEST_SCENARIO: Bob reads its settings sync, backs them up, writes async and renames a staged copy over them; every step must stay on the process's own file.
const bob = `
import fs from "node:fs";
import { readFileSync } from "node:fs";
const p = ${JSON.stringify(shared)};
const seen = JSON.parse(readFileSync(p, "utf8")).session.model;
fs.copyFileSync(p, p + ".bak");
await fs.promises.writeFile(p + ".tmp", '{"session":{"model":"written"}}');
fs.renameSync(p + ".tmp", p);
console.log(seen, fs.existsSync(p));
`;
try {
  const out = execFileSync(process.execPath, ["--import", preload, "--input-type=module", "-e", bob], {
    env: { ...process.env, HOME: home, BOB_SETTINGS_FILE: own },
    encoding: "utf8",
  });
  assert.equal(out.trim(), "own true");
  assert.equal(readFileSync(shared, "utf8"), '{"session":{"model":"shared"}}');
  assert.equal(readFileSync(own, "utf8"), '{"session":{"model":"written"}}');
  assert.equal(readFileSync(`${own}.bak`, "utf8"), '{"session":{"model":"own"}}');

  // TEST_SCENARIO: harness-chat starts a per-model Bob process. Its bootstrap must read the agent-wide panel choices from the shared file (an existing process copy must not hide them), and only Bob itself runs with the preload.
  writeFileSync(shared, '{"platform":{"approvals":"ask","mode":"plan"}}');
  mkdirSync(join(home, "bin"));
  writeFileSync(join(home, "bin/bob"), '#!/bin/sh\nprintf "%s\\n" "$NODE_OPTIONS" "$*" > "$HOME/bob-args"\n', { mode: 0o755 });
  const chat = readFileSync(join(rootfs, "usr/local/bin/harness-chat"), "utf8")
    .replaceAll("/app/bob-settings.mjs", join(rootfs, "app/bob-settings.mjs"))
    .replaceAll("/usr/local/lib/bob-settings-file.mjs", preload);
  writeFileSync(join(home, "harness-chat"), chat);
  const run = () => execFileSync("/bin/sh", [join(home, "harness-chat")], {
    env: { PATH: `${join(home, "bin")}:${process.env.PATH}`, HOME: home, PLATFORM_MODEL: "m-1" },
    encoding: "utf8",
  });
  run();
  const [nodeOptions, args] = readFileSync(join(home, "bob-args"), "utf8").split("\n");
  assert.match(nodeOptions, /--import=\S*bob-settings-file\.mjs/);
  assert.equal(args.includes("--auto-approve"), false, args);
  writeFileSync(shared, '{"platform":{"approvals":"auto","mode":"plan"}}');
  run();
  assert.equal(readFileSync(join(home, "bob-args"), "utf8").split("\n")[1].includes("--auto-approve"), true);
  assert.equal(readFileSync(shared, "utf8"), '{"platform":{"approvals":"auto","mode":"plan"}}');
  console.log("a Bob process keeps to its own settings file; its bootstrap reads the shared one");
} finally {
  rmSync(home, { recursive: true, force: true });
}
