#!/bin/sh
# the CLI refuses to start without a key; a provider's own placeholder, which names its connection, wins
: "${OPENAI_API_KEY:=dummy-placeholder}"
export OPENAI_API_KEY
set -- --dangerously-bypass-approvals-and-sandbox -c 'model_provider="openai-platform"'
# The TUI starts on the session's model (a catalog name the Model Router routes);
# /model then offers the router's catalog.
if [ -n "$PLATFORM_MODEL" ]; then
  set -- "$@" -c "model=\"$PLATFORM_MODEL\""
fi
. /usr/local/lib/codex-otel.sh

# pinned by the SessionStart hook in /etc/codex/requirements.toml
THREAD_FILE="$HOME/.codex/platform-sessions/$HARNESS_SESSION_ID"
if [ -s "$THREAD_FILE" ]; then
  exec codex resume "$(cat "$THREAD_FILE")" "$@"
else
  exec codex "$@"
fi
