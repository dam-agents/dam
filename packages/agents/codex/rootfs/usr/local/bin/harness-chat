#!/bin/sh
# the CLI refuses to start without a key; a provider's own placeholder, which names its connection, wins
if [ "${PLATFORM_CODEX_AUTH_MODE:-}" = chatgpt ]; then
  unset OPENAI_API_KEY CODEX_API_KEY OPENAI_BASE_URL OPENAI_MODEL
  if ! platform_native_login_status=$(codex-chatgpt login status 2>&1 >/dev/null) ||
    [ "$platform_native_login_status" != 'Logged in using ChatGPT' ]; then
    printf '%s\n' 'ChatGPT sign-in is required. Run codex-chatgpt login --device-auth over SSH, then retry.' >&2
    exit 77
  fi
  unset platform_native_login_status
else
  : "${OPENAI_API_KEY:=dummy-placeholder}"
  export OPENAI_API_KEY
fi
# The session's model is a per-turn choice the runtime sends over ACP
# (session/set_config_option), picked from the catalog the Model Router serves,
# so no model is pinned at start. codex-acp takes no -c flags: CODEX_CONFIG is
# merged into every session's config.
CODEX_CONFIG="{}"
CODEX_PATH=codex-app-server
# codex-acp sends its mode's approval and sandbox policy with every turn, over config.toml
INITIAL_AGENT_MODE=agent-full-access
# codex-acp drops a session's MCP server whose name config.toml already holds.
# The platform entry is in config.toml for the terminal's codex, but only the
# session's own copy carries the session reference that spawn_subagent and
# schedule_once read the session's choices from, so that copy must win.
DISABLE_MCP_CONFIG_FILTERING=true
export CODEX_CONFIG CODEX_PATH INITIAL_AGENT_MODE DISABLE_MCP_CONFIG_FILTERING
# codex-acp-patch.mjs: temporary fixes for codex-acp, see the codex README.
NODE_OPTIONS="--import=/usr/local/share/codex-platform/codex-acp-patch.mjs${NODE_OPTIONS:+ $NODE_OPTIONS}" \
  exec codex-acp
