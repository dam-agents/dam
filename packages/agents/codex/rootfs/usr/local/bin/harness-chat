#!/bin/sh
model=
# the provider's pin yields to a model chosen in config.toml (Config panel, /model, hand-edit)
if [ -n "$OPENAI_MODEL" ] && ! codex-config-sets-model; then
  model="$OPENAI_MODEL"
fi
# codex-acp takes no -c flags: CODEX_CONFIG is merged into every session's config
CODEX_CONFIG="$(jq -nc --arg url "$OPENAI_BASE_URL" --arg model "$model" '
  (if $url == "" then {} else {model_providers: {"openai-platform": {base_url: $url}}} end)
  + if $model == "" then {} else {model: $model} end')"
# chat and terminal share ~/.codex threads, so both run the image's pinned Codex
CODEX_PATH="$(command -v codex)"
# codex-acp sends its mode's approval and sandbox policy with every turn, over config.toml
INITIAL_AGENT_MODE=agent-full-access
export CODEX_CONFIG CODEX_PATH INITIAL_AGENT_MODE
exec codex-acp
