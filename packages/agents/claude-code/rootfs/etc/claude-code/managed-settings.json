{
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "allow": [
      "mcp__platform-outbound",
      "mcp__knowledge-bases",
      "Read(~/.uploads/**)"
    ],
    "deny": [
      "EnterPlanMode"
    ]
  },
  "crossSessionInbound": "refuse",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebSearch",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$PLATFORM_WEB_SEARCH_CONTROL\" ] || echo '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"allow\"}}'",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$PLATFORM_TERMINAL_ID\" ] || sed -n 's/.*\"session_id\":\"\\([^\"]*\\)\".*/{\"sessionId\":\"\\1\"}/p' | curl -sf -m 2 -H 'Content-Type: application/json' --data-binary @- \"$PLATFORM_RUNTIME_URL/api/terminals/$PLATFORM_TERMINAL_ID/session\" || true"
          }
        ]
      }
    ]
  }
}
