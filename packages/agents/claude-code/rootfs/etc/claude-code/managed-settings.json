{
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "allow": [
      "mcp__platform-outbound",
      "mcp__knowledge-bases"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "[ -z \"$PLATFORM_TERMINAL_ID\" ] || sed -n 's/.*\"session_id\":\"\\([^\"]*\\)\".*/{\"sessionId\":\"\\1\"}/p' | curl -sf -m 2 -H 'Content-Type: application/json' --data-binary @- \"$PLATFORM_RUNTIME_URL/api/terminals/$PLATFORM_TERMINAL_ID/session\" || true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /usr/local/lib/report-background-work.mjs"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node /usr/local/lib/report-background-work.mjs"
          }
        ]
      }
    ]
  }
}
