# claude-code-vm — Fedora bootc guest for the KubeVirt vm backend.
#
# Build-time reuse, never runtime composition: the harness content is COPY'd
# from the already-built claude-code OCI image, so that image stays the single
# source of harness truth and this stays a thin derived artifact. The build
# pipeline (build.sh) turns this OCI image into a qcow2 via
# bootc-image-builder and wraps it as a KubeVirt containerDisk.
#
# Guest contract (mirrors the pod image + the controller's cloud-init):
#   - cloud-init (NoCloud) writes /etc/platform/env + /etc/platform/ca/ca.crt
#     and mounts the workspace PVCs (virtiofs tags = sanitized mount names).
#   - platform-scratch mounts the "scratch" disk under docker/k3s image stores.
#   - platform-ca installs the MITM CA into the OS trust store.
#   - platform-boot-gate blocks agent-runtime until the paired gateway answers.
#   - agent-runtime runs as root (unprivileged virtiofsd EPERMs creates from
#     any other guest uid — see agent-runtime.service), spawning
#     harness-chat/-terminal like in a pod. The agent user still exists for
#     SSH sessions and image-baked $HOME content.
ARG AGENT_IMAGE=platform-claude-code:latest
FROM ${AGENT_IMAGE} AS agent

FROM quay.io/fedora/fedora-bootc:44

# runc explicitly: install_weak_deps=False drops it, and dockerd then dies on
# startup — "failed to find runc binary" while initialising buildkit — so the
# `docker` this image advertises never comes up. k3s hides the gap by shipping
# its own containerd and runc, so the cluster works while docker does not.
RUN dnf install -y --setopt=install_weak_deps=False \
      moby-engine docker-compose docker-buildx runc \
      cloud-init qemu-guest-agent openssh-server sudo \
      git tar gzip xz jq rsync && \
    dnf clean all

# k3s: binary in /usr (immutable bootc area), unit written by the installer;
# stable channel resolved at build time. Airgap images seed
# /var/lib/rancher/k3s/agent/images so the cluster comes up without any egress
# approvals (pause/coredns/traefik would otherwise hang on gated pulls).
RUN curl -sfL https://get.k3s.io | \
      INSTALL_K3S_SKIP_START=true INSTALL_K3S_SKIP_ENABLE=true \
      INSTALL_K3S_SKIP_SELINUX_RPM=true INSTALL_K3S_BIN_DIR=/usr/bin sh - && \
    ver=$(/usr/bin/k3s --version | awk 'NR==1{print $3}') && \
    arch=$(uname -m | sed 's/x86_64/amd64/; s/aarch64/arm64/') && \
    mkdir -p /var/lib/rancher/k3s/agent/images && \
    curl -fL "https://github.com/k3s-io/k3s/releases/download/${ver}/k3s-airgap-images-${arch}.tar.zst" \
      -o /var/lib/rancher/k3s/agent/images/k3s-airgap-images.tar.zst

# Harness content from the pod image. /usr/local resolves to /var/usrlocal on
# bootc — fine here: the qcow2 seeds /var at deploy and these VMs never
# bootc-upgrade. /app is agent-runtime (node dist/server.js + node_modules).
COPY --from=agent /usr/local/bin/ /usr/local/bin/
# sbin too, not just bin: the mise shims are symlinks to /usr/local/sbin/mise,
# so without it every shim dangles — `node` doesn't resolve and agent-runtime
# exits immediately, restart-looping forever.
COPY --from=agent /usr/local/sbin/ /usr/local/sbin/
COPY --from=agent /usr/local/lib/ /usr/local/lib/
COPY --from=agent /usr/local/share/mise/ /usr/local/share/mise/
COPY --from=agent /usr/local/share/lazy-tools/ /usr/local/share/lazy-tools/
COPY --from=agent /etc/mise/ /etc/mise/
COPY --from=agent /etc/AGENTS.md /etc/AGENTS.md
# Managed settings carry the Stop/SubagentStop background-work hooks — without
# them a VM session's running jobs are reaped out from under it.
COPY --from=agent /etc/claude-code/ /etc/claude-code/
COPY --from=agent /etc/profile.d/model-gateway.sh /etc/profile.d/model-gateway.sh
COPY --from=agent /app/ /app/
COPY --from=agent /opt/ /opt/

# The agent user matches the pod image uid so PVC content ownership carries
# over across backends. A full VM is deliberately root-capable: docker group +
# passwordless sudo (the machine is the sandbox; NetworkPolicy on the
# virt-launcher pod is the boundary, not in-guest privilege).
# /home is a bootc symlink to /var/home, absent at build time
RUN mkdir -p /var/home && \
    useradd -u 65532 -d /home/agent -s /bin/bash agent && \
    usermod -aG docker agent && \
    echo 'agent ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/agent && \
    chown -R agent /etc/mise /app /usr/local/share/mise && chown agent /etc/AGENTS.md && \
    printf '\n## VM sandbox\n\nThis sandbox is a full virtual machine: systemd, `docker` (moby), a preinstalled `k3s` Kubernetes cluster (`kubectl` works out of the box), and passwordless `sudo`. OS state outside your home and workspace is discarded on hibernation.\n' >> /etc/AGENTS.md

# The guest has no SSH and an ephemeral rootfs, so a boot that fails before
# agent-runtime leaves the journal unreachable — the serial console (captured
# by virt-launcher, readable with `kubectl logs -c guest-console-log`) is the
# only channel out. Forward via kmsg, not ForwardToConsole: userspace writes to
# /dev/console follow the last console= kernel arg, which bootc-image-builder
# sets to ttyS0 — nonexistent on aarch64, where the PL011 port is ttyAMA0.
# The kernel ring buffer reaches every registered console, so kmsg lands on the
# captured one regardless of arch.
# warning, not info: the console is an emulated serial port and journald writes
# to it synchronously, so forwarding every info line slows boot noticeably.
# warning still carries the failures worth a post-mortem — "Failed to start",
# "Dependency failed", "Found ordering cycle" — without the flood.
RUN mkdir -p /usr/lib/systemd/journald.conf.d && \
    printf '[Journal]\nForwardToKMsg=yes\nMaxLevelKMsg=warning\n' \
      > /usr/lib/systemd/journald.conf.d/platform-console.conf

# Boot can run far slower than systemd's 45s defaults assume — a virtiofs
# device forces a shared-memory backing for guest RAM, and on a nested host
# that measured ~17x slower to reach the initrd than the same VM without one.
# The resulting failures are fatal rather than merely slow:
#   - a device that appears late fails its .mount, which fails local-fs.target,
#     which ships OnFailure=emergency.target + OnFailureJobMode=replace-irreversibly
#     and so discards the rest of the boot;
#   - a generator sandbox that overruns leaves PID1 "Freezing execution".
# Set on the kernel command line, not just system.conf.d: the initrd runs its
# own systemd with the initramfs's configuration, and both failures above were
# seen there. Harmless where boot is fast — these are ceilings, not delays.
RUN printf 'kargs = ["systemd.default_timeout_start_sec=300", "systemd.default_device_timeout_sec=300"]\n' \
      > /usr/lib/bootc/kargs.d/10-platform-slow-host.toml

RUN mkdir -p /usr/lib/systemd/system.conf.d && \
    printf '[Manager]\nDefaultDeviceTimeoutSec=300\nDefaultTimeoutStartSec=300\n' \
      > /usr/lib/systemd/system.conf.d/platform-timeouts.conf

COPY system/platform-scratch.sh /usr/libexec/platform-scratch.sh
COPY system/platform-boot-gate.sh /usr/libexec/platform-boot-gate.sh
COPY system/platform-scratch.service system/platform-ca.service \
     system/platform-boot-gate.service system/agent-runtime.service \
     /usr/lib/systemd/system/
COPY system/proxy-dropin.conf /usr/lib/systemd/system/docker.service.d/platform.conf
COPY system/proxy-dropin.conf /usr/lib/systemd/system/k3s.service.d/platform.conf
COPY system/k3s-config.yaml /etc/rancher/k3s/config.yaml
COPY system/profile-platform.sh /etc/profile.d/platform-vm.sh

RUN chmod 755 /usr/libexec/platform-scratch.sh /usr/libexec/platform-boot-gate.sh && \
    systemctl enable docker.service k3s.service qemu-guest-agent.service \
      platform-scratch.service platform-ca.service platform-boot-gate.service \
      agent-runtime.service
