[Unit]
Description=Platform agent-runtime (ACP server + harness supervisor)
# cloud-final: virtiofs workspace mounts and /etc/platform/* are in place.
# Requires on the gate keeps this fail-closed — gate failure ⇒ no runtime.
After=cloud-final.service platform-ca.service platform-boot-gate.service
Requires=platform-boot-gate.service

[Service]
User=agent
WorkingDirectory=/app
EnvironmentFile=/etc/platform/env
Environment=PORT=8080
Environment=MISE_DATA_DIR=/usr/local/share/mise
Environment=PATH=/app/node_modules/.bin:/usr/local/share/mise/shims:/usr/local/bin:/usr/bin:/bin:/usr/local/share/lazy-tools
Environment=SSL_CERT_FILE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
Environment=REQUESTS_CA_BUNDLE=/etc/pki/ca-trust/extracted/pem/tls-ca-bundle.pem
Environment=KUBECONFIG=/etc/rancher/k3s/k3s.yaml
# agent-entrypoint: CA trust is root-owned here (platform-ca.service) so its
# own attempt just warns; the ~/.cache→/tmp symlink and mise-pin heal still
# apply, then it execs the runtime.
ExecStart=/usr/local/bin/agent-entrypoint node dist/server.js
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
