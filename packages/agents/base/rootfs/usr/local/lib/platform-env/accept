#!/bin/sh
# One Environment Link connection on an Environment, which socat hands here
# with the connection on stdin and stdout: the owning agent's public key on
# the first line, then SSH, which sshd -i serves. Only the owning agent
# reaches the link, so its key is trusted for this boot (a tmpfs file).
# PLATFORM_LINK marks this process while sshd runs, so the agent-runtime
# counts the link as busy: sshd-session writes its title over its own env.
set -eu
dir=/run/platform-env
IFS= read -r key
case "$key" in
	ssh-ed25519\ * | ecdsa-sha2-nistp*\ * | ssh-rsa\ *) ;;
	*) echo "platform-env: a link connection sent no key" >&2; exit 1 ;;
esac
grep -qxF "$key" "$dir/authorized_keys" 2>/dev/null || printf '%s\n' "$key" >> "$dir/authorized_keys"
PLATFORM_LINK=1 /usr/sbin/sshd -i -e -f "$dir/sshd_config"
