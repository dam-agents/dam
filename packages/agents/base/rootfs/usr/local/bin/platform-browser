#!/usr/bin/env node

import { spawn, spawnSync } from "node:child_process";
import { existsSync, renameSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

const SESSION = "preview";
const PROFILE = join(homedir(), ".local/share/platform/browser-preview");
const LINK_PREFIX = "platform://browser?url=";

const DISPLAY = ":99";
const X_SOCKET = "/tmp/.X11-unix/X99";
const SCREEN = "3840x2400x24";
const CHROMIUM = "/opt/ms-playwright/chromium";

const running = (command) =>
  spawnSync("pgrep", ["-f", `^${command}( |$)`], { stdio: "ignore" })
    .status === 0;

const detached = (command, args, env = process.env) =>
  spawn(command, args, { env, detached: true, stdio: "ignore" }).unref();

const waitFor = (check, ms) => {
  const until = Date.now() + ms;
  while (!check() && Date.now() < until)
    Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, 50);
  return check();
};

const startDisplay = () => {
  if (!existsSync("/usr/bin/Xvfb") || !existsSync(CHROMIUM)) return false;
  if (!existsSync(X_SOCKET))
    detached("Xvfb", [DISPLAY, "-screen", "0", SCREEN, "-nolisten", "tcp"]);
  if (!waitFor(() => existsSync(X_SOCKET), 5_000)) return false;
  if (!running("matchbox-window-manager"))
    detached(
      "matchbox-window-manager",
      ["-use_titlebar", "no", "-use_cursor", "no"],
      { ...process.env, DISPLAY },
    );
  return true;
};

const headed = startDisplay();
const ENV = headed
  ? {
      ...process.env,
      DISPLAY,
      AGENT_BROWSER_EXECUTABLE_PATH: CHROMIUM,
      AGENT_BROWSER_ARGS: [
        process.env.AGENT_BROWSER_ARGS,
        "--kiosk",
        "--hide-scrollbars",
        "--no-first-run",
        "--test-type",
      ]
        .filter(Boolean)
        .join(","),
    }
  : process.env;
const BROWSER = [
  "--session",
  SESSION,
  "--profile",
  PROFILE,
  ...(headed ? ["--headed"] : []),
];

const usage = () => {
  process.stderr.write(
    [
      "usage: platform-browser open <address>     show the user a page; prints a button for your reply",
      "       platform-browser <agent-browser command> [args...]   act in the user's browser",
      "       e.g. platform-browser snapshot -i   platform-browser click @e3",
      "",
    ].join("\n"),
  );
  process.exit(2);
};

const args = process.argv.slice(2);
const [command, address, ...rest] = args;
if (!command || command === "--help" || command === "-h") usage();

if (command === "close") {
  process.stderr.write(
    "platform-browser: not closing — the user's browser panel is attached to this browser\n",
  );
  process.exit(2);
}

if (command === "screenshot") {
  const devicePixels = args.includes("--device-pixels");
  const shotArgs = args.filter((a) => a !== "--device-pixels");
  const shot = spawnSync("agent-browser", [...BROWSER, ...shotArgs], {
    encoding: "utf8",
    env: ENV,
  });
  process.stdout.write(shot.stdout ?? "");
  process.stderr.write(shot.stderr ?? "");
  if (shot.error || shot.status !== 0 || devicePixels)
    process.exit(shot.error ? 127 : (shot.status ?? 1));
  const path =
    shotArgs.slice(1).find((a) => /\.(png|jpe?g)$/i.test(a)) ??
    /([^\s'"]+\.(?:png|jpe?g))/i.exec(shot.stdout ?? "")?.[1];
  const ratio = Number(
    (
      spawnSync("agent-browser", [...BROWSER, "eval", "devicePixelRatio"], {
        encoding: "utf8",
        env: ENV,
      }).stdout ?? ""
    )
      .trim()
      .replace(/"/g, ""),
  );
  if (path && existsSync(path) && ratio > 1 && existsSync("/usr/bin/ffmpeg")) {
    const scaled = `${path}.css${/\.png$/i.test(path) ? ".png" : ".jpg"}`;
    const ok = spawnSync(
      "ffmpeg",
      ["-y", "-loglevel", "error", "-i", path, "-vf", `scale=trunc(iw/${ratio}):trunc(ih/${ratio})`, scaled],
      { stdio: "ignore" },
    );
    if (ok.status === 0) renameSync(scaled, path);
  }
  process.exit(0);
}

if (command !== "open") {
  const passed = spawnSync("agent-browser", [...BROWSER, ...args], {
    stdio: "inherit",
    env: ENV,
  });
  if (passed.error) {
    process.stderr.write(`platform-browser: ${passed.error.message}\n`);
    process.exit(127);
  }
  process.exit(passed.status ?? 1);
}

if (!address || rest.length > 0) usage();

const withScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(address)
  ? address
  : `http://${address}`;
let url;
try {
  url = new URL(withScheme);
} catch {
  process.stderr.write(`platform-browser: not a web address: ${address}\n`);
  process.exit(2);
}
if (url.protocol !== "http:" && url.protocol !== "https:") {
  process.stderr.write("platform-browser: only http and https addresses open\n");
  process.exit(2);
}

const opened = spawnSync("agent-browser", [...BROWSER, "open", url.href], {
  stdio: ["ignore", "ignore", "pipe"],
  encoding: "utf8",
  env: ENV,
});
const currentHost = () => {
  const got = spawnSync("agent-browser", [...BROWSER, "get", "url"], {
    encoding: "utf8",
    env: ENV,
  });
  try {
    return new URL(got.stdout.trim()).host;
  } catch {
    return null;
  }
};
if (opened.error || opened.status !== 0) {
  const stillLoading =
    !opened.error &&
    /timed out/i.test(opened.stderr ?? "") &&
    currentHost() === url.host;
  if (!stillLoading) {
    process.stderr.write(opened.stderr ?? "");
    process.stderr.write(
      `platform-browser: the browser did not open ${url.href}${opened.error ? `: ${opened.error.message}` : ""}\n`,
    );
    process.exit(1);
  }
  process.stderr.write(
    "platform-browser: the page is open but still loading; wait before you snapshot it (platform-browser wait --load domcontentloaded)\n",
  );
}

const label = `${url.host}${url.pathname === "/" ? "" : url.pathname}`;
process.stdout.write(
  `[Open ${label}](${LINK_PREFIX}${encodeURIComponent(url.href)}&at=${Date.now()})\n`,
);
