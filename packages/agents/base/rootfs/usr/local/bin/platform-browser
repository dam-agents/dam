#!/usr/bin/env node

import { spawnSync } from "node:child_process";
import { homedir } from "node:os";
import { join } from "node:path";

const SESSION = "preview";
const PROFILE = join(homedir(), ".local/share/platform/browser-preview");
const LINK_PREFIX = "platform://browser?url=";

const BROWSER = ["--session", SESSION, "--profile", PROFILE];

const usage = () => {
  process.stderr.write(
    [
      "usage: platform-browser open <address>     show the user a page; prints a button for your reply",
      "       platform-browser <agent-browser command> [args...]   act in the user's browser",
      "       e.g. platform-browser snapshot -i   platform-browser click @e3",
      "",
    ].join("\n"),
  );
  process.exit(2);
};

const args = process.argv.slice(2);
const [command, address, ...rest] = args;
if (!command || command === "--help" || command === "-h") usage();

if (command === "close") {
  process.stderr.write(
    "platform-browser: not closing — the user's browser panel is attached to this browser\n",
  );
  process.exit(2);
}

if (command !== "open") {
  const passed = spawnSync("agent-browser", [...BROWSER, ...args], {
    stdio: "inherit",
  });
  if (passed.error) {
    process.stderr.write(`platform-browser: ${passed.error.message}\n`);
    process.exit(127);
  }
  process.exit(passed.status ?? 1);
}

if (!address || rest.length > 0) usage();

const withScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(address)
  ? address
  : `http://${address}`;
let url;
try {
  url = new URL(withScheme);
} catch {
  process.stderr.write(`platform-browser: not a web address: ${address}\n`);
  process.exit(2);
}
if (url.protocol !== "http:" && url.protocol !== "https:") {
  process.stderr.write("platform-browser: only http and https addresses open\n");
  process.exit(2);
}

const opened = spawnSync("agent-browser", [...BROWSER, "open", url.href], {
  stdio: ["ignore", "ignore", "pipe"],
  encoding: "utf8",
});
const currentHost = () => {
  const got = spawnSync("agent-browser", [...BROWSER, "get", "url"], {
    encoding: "utf8",
  });
  try {
    return new URL(got.stdout.trim()).host;
  } catch {
    return null;
  }
};
if (opened.error || opened.status !== 0) {
  const stillLoading =
    !opened.error &&
    /timed out/i.test(opened.stderr ?? "") &&
    currentHost() === url.host;
  if (!stillLoading) {
    process.stderr.write(opened.stderr ?? "");
    process.stderr.write(
      `platform-browser: the browser did not open ${url.href}${opened.error ? `: ${opened.error.message}` : ""}\n`,
    );
    process.exit(1);
  }
  process.stderr.write(
    "platform-browser: the page is open but still loading; wait before you snapshot it (platform-browser wait --load domcontentloaded)\n",
  );
}

const label = `${url.host}${url.pathname === "/" ? "" : url.pathname}`;
process.stdout.write(
  `[Open ${label}](${LINK_PREFIX}${encodeURIComponent(url.href)})\n`,
);
