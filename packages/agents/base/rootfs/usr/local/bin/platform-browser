#!/usr/bin/env node

import { spawn, spawnSync } from "node:child_process";
import {
  chmodSync,
  existsSync,
  mkdirSync,
  readdirSync,
  readFileSync,
  renameSync,
  rmSync,
  writeFileSync,
} from "node:fs";
import { homedir, userInfo } from "node:os";
import { join } from "node:path";

const SESSION = "preview";
const PROFILE = join(homedir(), ".local/share/platform/browser-preview");
const SOCKET_DIR = join(homedir(), ".agent-browser");
const LOCK = join(SOCKET_DIR, `${SESSION}.launch.lock`);
const LINK_PREFIX = "platform://browser?url=";

const DISPLAY = ":99";
const X_SOCKET = "/tmp/.X11-unix/X99";
const SCREEN = "3840x2400x24";
const XVFB = "/usr/bin/Xvfb";
const I3 = "/usr/bin/i3";
const SELKIES = "/opt/selkies/bin/selkies";
const STREAM_PORT = "5999";
const RUNTIME_DIR = `/tmp/platform-display-${userInfo().uid}`;
const I3_CONFIG = join(RUNTIME_DIR, "i3.conf");
const CHROMIUM = "/opt/ms-playwright/chromium";
const HEADLESS_SHELL = "/opt/ms-playwright/headless-shell";
const HEADED =
  existsSync(XVFB) && existsSync(I3) && existsSync(SELKIES) && existsSync(CHROMIUM);

const BASE_ARGS = ["--no-sandbox", "--disable-dev-shm-usage"];
const HEADED_ARGS = [
  "--kiosk",
  "--hide-scrollbars",
  "--no-first-run",
  "--test-type",
  "--disable-infobars",
  "--ozone-platform=x11",
];

const fail = (message, code = 1) => {
  process.stderr.write(`platform-browser: ${message}\n`);
  process.exit(code);
};

const browserEnv = () => {
  const env = Object.fromEntries(
    Object.entries(process.env).filter(
      ([key]) => !key.startsWith("AGENT_BROWSER_"),
    ),
  );
  delete env.DISPLAY;
  delete env.WAYLAND_DISPLAY;
  return {
    ...env,
    AGENT_BROWSER_SOCKET_DIR: SOCKET_DIR,
    AGENT_BROWSER_EXECUTABLE_PATH: HEADED ? CHROMIUM : HEADLESS_SHELL,
    AGENT_BROWSER_ARGS: [...BASE_ARGS, ...(HEADED ? HEADED_ARGS : [])].join(
      ",",
    ),
    ...(HEADED ? { DISPLAY, AGENT_BROWSER_NO_XVFB: "1" } : {}),
  };
};
const BROWSER = [
  "--session",
  SESSION,
  "--profile",
  PROFILE,
  ...(HEADED ? ["--headed"] : []),
];

const agentBrowser = (args, options = {}) =>
  spawnSync("agent-browser", [...BROWSER, ...args], {
    env: browserEnv(),
    encoding: "utf8",
    ...options,
  });

const sleep = (ms) =>
  Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, ms);

const waitFor = (check, ms) => {
  const until = Date.now() + ms;
  while (!check() && Date.now() < until) sleep(50);
  return check();
};

const cmdline = (pid) => {
  try {
    return readFileSync(`/proc/${pid}/cmdline`, "utf8");
  } catch {
    return "";
  }
};

const processes = () =>
  readdirSync("/proc")
    .map(Number)
    .filter((pid) => pid > 1 && pid !== process.pid && pid !== process.ppid)
    .map((pid) => ({ pid, cmdline: cmdline(pid) }))
    .filter((p) => p.cmdline);

const daemonPid = () => {
  try {
    const pid = Number(readFileSync(join(SOCKET_DIR, `${SESSION}.pid`), "utf8"));
    return pid > 1 && cmdline(pid).includes("agent-browser") ? pid : null;
  } catch {
    return null;
  }
};

const profileChromes = () =>
  processes().filter((p) =>
    p.cmdline.split("\0").includes(`--user-data-dir=${PROFILE}`),
  );

const kill = (pids, signal) => {
  for (const pid of pids) {
    try {
      process.kill(pid, signal);
    } catch {}
  }
};

const stopProfileChromes = () => {
  const pids = profileChromes().map((p) => p.pid);
  if (pids.length === 0) return;
  kill(pids, "SIGTERM");
  if (!waitFor(() => profileChromes().length === 0, 3_000))
    kill(
      profileChromes().map((p) => p.pid),
      "SIGKILL",
    );
};

const clearStaleProfileLocks = () => {
  for (const name of ["SingletonLock", "SingletonSocket", "SingletonCookie"])
    rmSync(join(PROFILE, name), { force: true });
};

const running = (binary) =>
  processes().some((p) => p.cmdline.split("\0")[0] === binary);

const cmdlineHas = (...parts) =>
  processes().some((p) => parts.every((part) => p.cmdline.includes(part)));

const displayRunning = () => existsSync(X_SOCKET) && running(XVFB);

const detached = (command, args, env = process.env) =>
  spawn(command, args, { env, detached: true, stdio: "ignore" }).unref();

const displayEnv = () => ({
  ...process.env,
  DISPLAY,
  XDG_RUNTIME_DIR: RUNTIME_DIR,
});

const I3_KIOSK = [
  "font pango:monospace 8",
  "default_border none",
  "default_floating_border none",
  "focus_follows_mouse no",
  'for_window [class=".*"] fullscreen enable',
  "",
].join("\n");

const startDisplay = () => {
  mkdirSync(RUNTIME_DIR, { recursive: true });
  chmodSync(RUNTIME_DIR, 0o700);
  if (!displayRunning()) {
    rmSync(X_SOCKET, { force: true });
    rmSync("/tmp/.X99-lock", { force: true });
    detached(XVFB, [DISPLAY, "-screen", "0", SCREEN, "-nolisten", "tcp"]);
    if (!waitFor(displayRunning, 10_000))
      fail("the virtual display did not start");
  }
  if (!running(I3)) {
    writeFileSync(I3_CONFIG, I3_KIOSK);
    detached(I3, ["-c", I3_CONFIG], displayEnv());
  }
  if (!cmdlineHas("selkies.__main__", `--port=${STREAM_PORT}`))
    detached(
      SELKIES,
      [
        `--port=${STREAM_PORT}`,
        "--enable-basic-auth=false",
        "--audio-enabled=false",
        "--gamepad-enabled=false",
        "--use-css-scaling=true",
        "--backpressure-queue-size=4",
        "--video-streaming-mode=false",
        "--framerate=30,8-60",
      ],
      displayEnv(),
    );
};

const browserAnswers = () =>
  daemonPid() !== null &&
  agentBrowser(["get", "url"], { timeout: 10_000 }).status === 0;

const launch = (relaunch) => {
  if (HEADED) startDisplay();
  if (!relaunch && browserAnswers()) return;
  agentBrowser(["close"], { timeout: 10_000 });
  kill([daemonPid()].filter(Boolean), "SIGKILL");
  stopProfileChromes();
  clearStaleProfileLocks();
  const started = agentBrowser(["get", "url"], { timeout: 45_000 });
  if (started.status !== 0)
    fail(
      `the browser did not start: ${(started.stderr || started.error?.message || "").trim()}`,
    );
};

const shutdown = () => {
  agentBrowser(["close"], { timeout: 15_000 });
  kill([daemonPid()].filter(Boolean), "SIGKILL");
  stopProfileChromes();
  clearStaleProfileLocks();
};

const usage = () => {
  process.stderr.write(
    [
      "usage: platform-browser open <address>     show the user a page; prints a button for your reply",
      "       platform-browser <agent-browser command> [args...]   act in the user's browser",
      "       e.g. platform-browser snapshot -i   platform-browser click @e3",
      "",
    ].join("\n"),
  );
  process.exit(2);
};

const LOCKED = "--platform-browser-locked";

const RELAUNCH = "PLATFORM_BROWSER_RELAUNCH";

const underLock = (args, relaunch = false) => {
  mkdirSync(SOCKET_DIR, { recursive: true });
  const locked = spawnSync(
    "flock",
    ["-w", "90", LOCK, process.execPath, process.argv[1], LOCKED, ...args],
    {
      stdio: "inherit",
      env: { ...process.env, ...(relaunch ? { [RELAUNCH]: "1" } : {}) },
    },
  );
  if (locked.error) fail(locked.error.message, 127);
  process.exit(locked.status ?? 1);
};

let args = process.argv.slice(2);
const locked = args[0] === LOCKED;
if (locked) args = args.slice(1);
const [command, address, ...rest] = args;
if (!command || command === "--help" || command === "-h") usage();

if (command === "close")
  fail(
    "not closing — the user's browser panel is attached to this browser",
    2,
  );

if (command === "set" && (address === "viewport" || address === "device"))
  fail(
    "not resizing — the browser fills the screen, and the screen follows the user's panel",
    2,
  );

if (command === "screen") {
  const [width, height] = [address, rest[0]].map(Number);
  if (!HEADED || !(width >= 200 && height >= 200 && width <= 8192 && height <= 8192))
    usage();
  if (!displayRunning()) fail("the virtual display is not running");
  const resized = spawnSync(
    "xrandr",
    ["--fb", `${width - (width % 2)}x${height - (height % 2)}`],
    { env: displayEnv(), encoding: "utf8" },
  );
  if (resized.status !== 0) fail(`xrandr: ${(resized.stderr ?? "").trim()}`);
  process.exit(0);
}

if (command === "launch" || command === "shutdown") {
  if (!locked) underLock([command]);
  if (command === "launch") launch(process.env[RELAUNCH] === "1");
  else shutdown();
  process.exit(0);
}

if (!locked && daemonPid() === null) underLock(args);
if (locked) launch(process.env[RELAUNCH] === "1");

const otherConfiguration = (result) =>
  /different daemon configuration/i.test(result.stderr ?? "");

const run = (runArgs, options) => {
  const result = agentBrowser(runArgs, options);
  if (!locked && otherConfiguration(result)) underLock(args, true);
  return result;
};

if (command === "screenshot") {
  const devicePixels = args.includes("--device-pixels");
  const shotArgs = args.filter((a) => a !== "--device-pixels");
  const shot = run(shotArgs);
  process.stdout.write(shot.stdout ?? "");
  process.stderr.write(shot.stderr ?? "");
  if (shot.error || shot.status !== 0 || devicePixels)
    process.exit(shot.error ? 127 : (shot.status ?? 1));
  const path =
    shotArgs.slice(1).find((a) => /\.(png|jpe?g)$/i.test(a)) ??
    /([^\s'"]+\.(?:png|jpe?g))/i.exec(shot.stdout ?? "")?.[1];
  const ratio = Number(
    (agentBrowser(["eval", "devicePixelRatio"]).stdout ?? "")
      .trim()
      .replace(/"/g, ""),
  );
  if (path && existsSync(path) && ratio > 1 && existsSync("/usr/bin/ffmpeg")) {
    const scaled = `${path}.css${/\.png$/i.test(path) ? ".png" : ".jpg"}`;
    const ok = spawnSync(
      "ffmpeg",
      [
        "-y",
        "-loglevel",
        "error",
        "-i",
        path,
        "-vf",
        `scale=trunc(iw/${ratio}):trunc(ih/${ratio})`,
        scaled,
      ],
      { stdio: "ignore" },
    );
    if (ok.status === 0) renameSync(scaled, path);
  }
  process.exit(0);
}

if (command !== "open") {
  const passed = run(args);
  process.stdout.write(passed.stdout ?? "");
  process.stderr.write(passed.stderr ?? "");
  if (passed.error) fail(passed.error.message, 127);
  process.exit(passed.status ?? 1);
}

if (!address || rest.length > 0) usage();

const withScheme = /^[a-z][a-z0-9+.-]*:\/\//i.test(address)
  ? address
  : `http://${address}`;
let url;
try {
  url = new URL(withScheme);
} catch {
  fail(`not a web address: ${address}`, 2);
}
if (url.protocol !== "http:" && url.protocol !== "https:")
  fail("only http and https addresses open", 2);

const opened = run(["open", url.href]);
const currentHost = () => {
  try {
    return new URL(agentBrowser(["get", "url"]).stdout.trim()).host;
  } catch {
    return null;
  }
};
if (opened.error || opened.status !== 0) {
  const stillLoading =
    !opened.error &&
    /timed out/i.test(opened.stderr ?? "") &&
    currentHost() === url.host;
  if (!stillLoading) {
    process.stderr.write(opened.stderr ?? "");
    fail(
      `the browser did not open ${url.href}${opened.error ? `: ${opened.error.message}` : ""}`,
    );
  }
  process.stderr.write(
    "platform-browser: the page is open but still loading; wait before you snapshot it (platform-browser wait --load domcontentloaded)\n",
  );
}

const label = `${url.host}${url.pathname === "/" ? "" : url.pathname}`;
process.stdout.write(
  `[Open ${label}](${LINK_PREFIX}${encodeURIComponent(url.href)}&at=${Date.now()})\n`,
);
