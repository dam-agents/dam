#!/bin/sh
# Runs as the agent in a container, as root on a vm Backend machine.
set -eu

home="${HOME:-/home/agent}"
# A machine's guest takes several milliseconds to start any process, so the
# boot runs as few as it can.
uid=$(id -u)

# A container runtime started under a tighter umask creates image layers a
# non-root container cannot traverse (CoreDNS and traefik under k3s die on it).
umask 022

# On a machine, SSH logins as `agent` must land as root, the harness's user;
# extrausers serves no uid 0 entry.
if [ "$uid" = 0 ]; then
	if ! grep -q '^agent:x:0:0:' /etc/passwd; then
		grep -q '^agent:' /etc/passwd || grep '^agent:' /var/lib/extrausers/passwd >>/etc/passwd
		sed -i 's/^agent:x:65532:0:/agent:x:0:0:/' /etc/passwd
	fi
	install -d -m 0755 /run/sshd
fi

# Every certificate under /etc/platform/ca is trusted: the gateway's MITM CA,
# and the CAs the install names for TLS-inspecting proxies beyond the gateway,
# which a host the gateway passes through can still be intercepted by.
ca_dir=/etc/platform/ca
ca_files=$(find "$ca_dir" -maxdepth 1 -name '*.crt' -size +0 2>/dev/null | sort)
# Each store records what it was last built from, and is rebuilt only when that
# differs: a machine's root and every home outlive a boot, and
# update-ca-certificates forks per bundled root, seconds on a machine. A
# machine's root also outlives a new image, so the system record holds the
# image's distribution roots as well: the digest of them the image's build
# recorded, as reading every root costs a machine boot about 150 ms. An image
# built without the digest reads the roots. An agent that changes the roots on
# its own root does it with the package manager, whose trigger rebuilds the
# store with the platform CAs in it.
ca_set() { for f in $ca_files; do echo "$f"; cat "$f"; done; }
system_inputs() {
	ca_set
	cat /etc/ca-certificates.conf
	cat /usr/share/ca-certificates.sha256 ||
		find /usr/share/ca-certificates -type f -print0 | sort -z | xargs -0r cat
} 2>/dev/null
local_cas=/usr/local/share/ca-certificates
system_set="$local_cas/.platform-ca-set"
certs=/etc/ssl/certs
# A store no boot has touched is the one the image's own update-ca-certificates
# built, so the platform CAs are added the way it would add them alone: a link
# per CA, the CAs after the bundle's, each ending in a newline, and a hash link
# per CA file holding one certificate, as openssl rehash skips any other. That
# takes a few forks, not several for each distribution root, and only the
# platform CAs are hashed: a rehash of the whole directory reads every root,
# about half a second on a machine. A Secret's or ConfigMap's key holds no
# character it would rewrite in a name.
add_platform_cas() {
	for crt in "$local_cas"/platform-*.crt; do
		name=${crt##*/}
		ln -sf "$crt" "$certs/${name%.crt}.pem" || return
		[ "$(grep -c -- '-----BEGIN CERTIFICATE-----' "$crt")" = 1 ] || continue
		hash=$(openssl x509 -hash -noout -in "$crt") || return
		n=0
		while [ -e "$certs/$hash.$n" ] || [ -L "$certs/$hash.$n" ]; do n=$((n + 1)); done
		ln -s "${name%.crt}.pem" "$certs/$hash.$n" || return
	done
	# update-ca-certificates appends to a leftover .new bundle, so none is left.
	new="$certs/ca-certificates.crt.new"
	{ { cat "$certs/ca-certificates.crt" && awk 1 "$local_cas"/platform-*.crt; } >"$new" &&
		chmod 0644 "$new" && mv -f "$new" "$certs/ca-certificates.crt"; } ||
		{ rm -f "$new"; return 1; }
}
nssdb="$home/.pki/nssdb"
if [ -n "$ca_files" ] && ! system_inputs | cmp -s - "$system_set"; then
	# A record, a local CA or a hook (which only update-ca-certificates runs)
	# means the store is no longer the image's own.
	touched=$(find "$local_cas" /etc/ca-certificates/update.d -mindepth 1 -print -quit 2>/dev/null || true)
	rm -f "$local_cas"/platform-*.crt "$system_set"
	trusted=true
	for f in $ca_files; do
		cp "$f" "$local_cas/platform-${f##*/}" || trusted=false
	done
	# A failed add leaves the store to update-ca-certificates in the same boot.
	{ $trusted && { { [ -z "$touched" ] && add_platform_cas; } || update-ca-certificates; } >/dev/null 2>&1 &&
		system_inputs >"$system_set"; } ||
		echo "agent-entrypoint: WARNING: could not trust the platform CAs; intercepted hosts may fail TLS" >&2
fi
# Chromium trusts its own NSS store in the home, not the system bundle, and
# certutil imports one certificate per file, so each bundle is split. Nothing
# starts Chromium before the runtime listens, so the store is built while the
# runtime starts, which a machine's first boot no longer waits about 300 ms for.
# The build is left to the init to reap: the runtime reaps only its own.
( (
	if [ -n "$ca_files" ] && ! { [ -f "$nssdb/cert9.db" ] && ca_set | cmp -s - "$nssdb/platform-ca-set"; }; then
		rm -f "$nssdb/platform-ca-set"
		split="$(mktemp -d)"
		if ! (mkdir -p "$nssdb" && { [ -f "$nssdb/cert9.db" ] || certutil -d "sql:$nssdb" -N --empty-password; } &&
			for nick in $(certutil -d "sql:$nssdb" -L | sed -n 's/^\(platform-[^ ]*\) .*/\1/p'); do
				certutil -d "sql:$nssdb" -D -n "$nick" || exit 1
			done &&
			cat $ca_files | awk -v dir="$split" '/-----BEGIN CERTIFICATE-----/ { n++ } n { print > (dir "/" n ".pem") }' &&
			for pem in "$split"/*.pem; do
				certutil -d "sql:$nssdb" -A -t "C,," -n "platform-ca-$(basename "$pem" .pem)" -i "$pem" || exit 1
			done && ca_set >"$nssdb/platform-ca-set") 2>/dev/null; then
			echo "agent-entrypoint: WARNING: could not trust the platform CAs in Chromium; its intercepted hosts may fail TLS" >&2
		fi
		rm -rf "$split"
	fi
) & )

# /app/working-dir stays pristine: the runtime reconciles image skills against it.
if [ ! -f "$home/.initialized" ]; then
	cp -rn /app/working-dir/. "$home/" 2>/dev/null || true
	touch "$home/.initialized"
	echo "agent-entrypoint: seeded home from image workspace"
fi
mkdir -p "$home/work"

# docker runs only on a machine. Its client passes the agent's gateway, which
# differs per agent, to every container and build; the rest of the file, logins
# included, is kept.
if [ "$uid" = 0 ] && [ -n "${HTTPS_PROXY:-}" ]; then
	cfg="$home/.docker/config.json"
	mkdir -p "$home/.docker"
	[ -s "$cfg" ] || echo '{}' >"$cfg"
	if jq --arg http "${HTTP_PROXY:-$HTTPS_PROXY}" --arg https "$HTTPS_PROXY" --arg no "${NO_PROXY:-}" \
		'.proxies.default = {httpProxy: $http, httpsProxy: $https, noProxy: $no}' "$cfg" >"$cfg.tmp"; then
		mv "$cfg.tmp" "$cfg"
	else
		rm -f "$cfg.tmp"
		echo "agent-entrypoint: WARNING: $cfg is not valid JSON; docker containers and builds get no proxy" >&2
	fi
fi

# A container trusts only the roots its own image ships, not this machine's. The
# share carries platform-runc, which adds the platform CA to every container's
# bundle before starting it. docker's builder runs the runc on PATH and ignores
# daemon.json, so the wrapper is linked as runc in a directory of /run put
# ahead of docker's, whose own is on the read-only harness tools; k3s runs its
# own containerd, which reads a drop-in under the data dir. A share without the
# wrapper removes the drop-in, or every pod would name a runtime that is gone.
runc_wrapper=/platform/runc
if [ "$uid" = 0 ]; then
	k3s_data=$(sed -n 's/^data-dir: *//p' /etc/rancher/k3s/config.yaml 2>/dev/null || true)
	dropin="${k3s_data:-/var/lib/rancher/k3s}/agent/etc/containerd/config-v3.toml.d/platform-runc.toml"
	if [ -x "$runc_wrapper" ]; then
		if mkdir -p /run/platform/bin && ln -sf "$runc_wrapper" /run/platform/bin/runc; then
			export PATH="/run/platform/bin:$PATH"
		else
			echo "agent-entrypoint: WARNING: docker containers and builds do not get the platform CA" >&2
		fi
		if ! { mkdir -p "${dropin%/*}" &&
			printf '[plugins."io.containerd.cri.v1.runtime".containerd.runtimes.runc.options]\n  BinaryName = "%s"\n' \
				"$runc_wrapper" >"$dropin"; } 2>/dev/null; then
			echo "agent-entrypoint: WARNING: k3s pods do not get the platform CA" >&2
		fi
	else
		rm -f "$dropin"
	fi
fi

# In a container $HOME is a network volume: ~/.cache goes to pod-local /tmp.
mkdir -p /tmp/agent-cache
if [ "${PLATFORM_BACKEND:-container}" != vm ] && [ ! -L "$home/.cache" ]; then
	if ln -sfn /tmp/agent-cache "$home/.cache.tmp" 2>/dev/null; then
		rm -rf "$home/.cache" && mv "$home/.cache.tmp" "$home/.cache"
	else
		rm -f "$home/.cache.tmp"
		echo "agent-entrypoint: WARNING: could not swap ~/.cache to local disk; caches stay on the workspace volume" >&2
	fi
fi

# npm keeps its tarball cache, npx installs and debug logs under ~/.npm, not
# ~/.cache, so they miss the swap above; in a container they go to the same
# local disk. An image that sets its own location wins.
if [ "${PLATFORM_BACKEND:-container}" != vm ]; then
	export npm_config_cache="${npm_config_cache:-/tmp/agent-cache/npm}"
fi

# The home outlives the image, so a cache a tool wrote there survives the image
# that dropped or replaced the tool, and nothing in the agent's own work shrinks
# it: on a default-sized home that is how an agent stops starting. Caches no
# shipped tool reads are discarded here. A discard is a rename on the same
# volume — instant and atomic however many files a content-addressed store
# holds — and the delete runs in the background; one cut short by a restart
# resumes on the next boot, since discarded copies are found by name.
# Toolchains the agent installed into its home for itself are its own and stay.
discard() { # $1 path, $2 why
	if [ -e "$1" ] && mv "$1" "$1.discarded.$(date +%s)" 2>/dev/null; then
		echo "agent-entrypoint: discarding $1: $2"
	fi
}
purge_discarded() { # $1 dir: delete its discarded entries, this boot's and earlier boots'
	set -- "$1"/*.discarded.*
	[ -e "$1" ] || return 0
	# Go's module cache is read-only on disk; the chmod pass runs only when a
	# plain rm left something behind.
	( (for p; do rm -rf "$p" 2>/dev/null || { chmod -R u+w "$p" && rm -rf "$p"; }; done) >/dev/null 2>&1 &)
}

gomodcache=${GOMODCACHE:-${GOPATH:-$home/go}/pkg/mod}
if ! command -v go >/dev/null 2>&1; then
	discard "$gomodcache" "no go in this image"
fi
purge_discarded "$(dirname "$gomodcache")"

# pnpm reads one store layout, the one `store path` names, and changes it
# across majors; aube, which answers as pnpm here, names a store of its own
# elsewhere. Asked only when a store exists, since asking creates one.
pnpm_stores="$home/.local/share/pnpm/store"
if [ -d "$pnpm_stores" ]; then
	live_store=$(cd "$home" && npm_config_update_notifier=false pnpm store path 2>/dev/null) || live_store=
	for store in "$pnpm_stores"/*; do
		case $store in *.discarded.*) continue ;; esac
		if [ -d "$store" ] && [ "$store" != "$live_store" ]; then
			discard "$store" "no pnpm in this image reads this store layout"
		fi
	done
	purge_discarded "$pnpm_stores"
fi

if [ "${npm_config_cache:-$home/.npm}" != "$home/.npm" ]; then
	for d in _cacache _npx _logs; do
		discard "$home/.npm/$d" "npm caches on local disk now"
	done
fi
purge_discarded "$home/.npm"

# Maven reads proxies only from settings.xml.
if [ -n "${HTTPS_PROXY:-}" ] && [ ! -e "$home/.m2/settings.xml" ]; then
	_hp=${HTTPS_PROXY#http://}
	_m2_proxy() {
		printf '<proxy><id>platform-%s</id><active>true</active><protocol>%s</protocol><host>%s</host><port>%s</port><nonProxyHosts>localhost|127.0.0.1</nonProxyHosts></proxy>' \
			"$1" "$1" "${_hp%:*}" "${_hp##*:}"
	}
	if ! { mkdir -p "$home/.m2" &&
		printf '<settings><proxies>%s%s</proxies></settings>\n' "$(_m2_proxy http)" "$(_m2_proxy https)" \
			> "$home/.m2/settings.xml"; } 2>/dev/null; then
		echo "agent-entrypoint: WARNING: could not write ~/.m2/settings.xml; Maven fetches may bypass the gateway" >&2
	fi
fi

# A workload's venv comes first, ahead of the tool directories mise puts at the
# front of the image's PATH.
if [ -d /opt/venv/bin ]; then export PATH="/opt/venv/bin:$PATH"; fi

exec "$@"
