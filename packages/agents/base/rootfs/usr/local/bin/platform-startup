#!/usr/bin/env node

import { spawnSync } from "node:child_process";
import { mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { dirname, join } from "node:path";

const USAGE = `usage: platform-startup add <id> -- <command>
       platform-startup remove <id>
       platform-startup list

Startup Items are commands this machine starts at every boot: after a
hibernation, a restart or a new image. Each runs in ~/work with PATH and the
gateway's proxy and CA variables, without your connections' credentials, and
its output goes to ~/.platform/startup-logs/<id>.log. A failed exit starts it
again after a growing delay; a clean exit is done until the next boot. An item
never keeps the agent awake: it stops when the agent sleeps and starts again
when it wakes. <id> is lowercase letters, digits and hyphens.

add starts the item at once, and replaces one with the same id. The user sees
Startup Items in the agent's Processes panel as Login items, and can stop,
restart, disable or remove them there; an item the user disabled stays
disabled, and only the user can remove it.
`;

const LIST = join(homedir(), ".platform", "startup.json");
const CTL = "/usr/local/lib/platform-startup/ctl";
const ID = /^[a-z0-9][a-z0-9-]{0,39}$/;

function fail(message, code = 1) {
  process.stderr.write(`platform-startup: ${message}\n`);
  process.exit(code);
}

function readList() {
  try {
    const parsed = JSON.parse(readFileSync(LIST, "utf8"));
    return Array.isArray(parsed.items) ? parsed : { items: [] };
  } catch {
    return { items: [] };
  }
}

function writeList(list) {
  mkdirSync(dirname(LIST), { recursive: true });
  const tmp = `${LIST}.tmp`;
  writeFileSync(tmp, JSON.stringify(list, null, 2));
  renameSync(tmp, LIST);
}

function ctl(...args) {
  const result = spawnSync(CTL, args, { stdio: "inherit" });
  if (result.error) fail(`could not run the Startup Items service: ${result.error.message}`);
  return result.status ?? 1;
}

const [action, ...rest] = process.argv.slice(2);

switch (action) {
  case "add": {
    const [id, separator, ...command] = rest;
    if (!id || separator !== "--" || command.length === 0) fail(`give an id and a command\n\n${USAGE}`, 2);
    if (!ID.test(id)) fail(`${id} is not an id: lowercase letters, digits and hyphens, at most 40`, 2);
    const list = readList();
    const before = list.items.find((item) => item.id === id);
    if (before?.disabled) fail(`the user disabled ${id}; it stays disabled until they enable it`);
    if (before) ctl("stop", id);
    const item = { id, command: command.join(" ") };
    list.items = [...list.items.filter((i) => i.id !== id), item];
    writeList(list);
    process.exit(ctl("start", id) === 0 ? 0 : 1);
    break;
  }
  case "remove": {
    const [id] = rest;
    if (!id) fail(`give an id\n\n${USAGE}`, 2);
    const list = readList();
    const item = list.items.find((i) => i.id === id);
    if (!item) fail(`no Startup Item ${id}`);
    if (item.disabled) fail(`the user disabled ${id}; only they can remove it, in the Processes panel`);
    ctl("stop", id);
    list.items = list.items.filter((item) => item.id !== id);
    writeList(list);
    break;
  }
  case "list": {
    const { items } = readList();
    if (items.length === 0) process.stdout.write("no Startup Items\n");
    for (const item of items)
      process.stdout.write(`${item.id}${item.disabled ? " (disabled by the user)" : ""}: ${item.command}\n`);
    break;
  }
  case "--help":
  case "-h":
    process.stdout.write(USAGE);
    break;
  default:
    fail(`unknown command ${action ?? ""}\n\n${USAGE}`, 2);
}
