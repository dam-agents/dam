#!/sbin/openrc-run
# The image's k3s on a vm machine. In no runlevel: the agent starts it, or adds
# it to the default runlevel to start it at every boot.
description="k3s server"
command=$(command -v k3s)
command_args=server
command_background=yes
pidfile=/run/k3s.pid
output_log=/var/log/k3s.log
error_log=/var/log/k3s.log
# A tighter umask makes image layers CoreDNS and traefik cannot traverse.
umask=022
# openrc may start it before the entrypoint, so it builds the CA bundle its
# pulls trust itself. It listens on config.yaml's port, unless its data dir
# holds a cluster made on another one: k3s never rewrites the kubeconfigs it
# keeps there, which name its API server on the port after its own, and exits
# when they disagree. So an Environment made on 6443 keeps 6443.
start_pre() {
	platform-ca-bundle
	data=$(sed -n 's/^data-dir: *//p' /etc/rancher/k3s/config.yaml 2>/dev/null)
	api=$(sed -n 's#^ *server: https://127.0.0.1:\([0-9]*\)$#\1#p' "${data:-/var/lib/rancher/k3s}/server/cred/admin.kubeconfig" 2>/dev/null | head -n 1)
	[ -z "$api" ] || command_args="server --https-listen-port $((api - 1))"
}
