#!/sbin/openrc-run
# The agent's Startup Items, the commands its machine starts at every boot. In
# the default runlevel, so platform-init's boot starts them and openrc's
# shutdown stops them when the machine stops. The list lives in the agent's
# home, which every boot and every new image keep.
description="Startup Items"

depend() {
	after docker k3s
}

start() {
	ebegin "Starting Startup Items"
	/usr/local/lib/platform-startup/ctl boot
	eend $?
}

stop() {
	ebegin "Stopping Startup Items"
	/usr/local/lib/platform-startup/ctl shutdown
	eend $?
}
