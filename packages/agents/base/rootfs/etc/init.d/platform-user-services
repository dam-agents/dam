#!/sbin/openrc-run
# The agent's own services, at boot: openrc's user services for root, from
# ~/.config/rc. Nobody logs in to a machine, so this starts them itself, as
# openrc-user would after a login, and stops them at shutdown.
description="The agent's own services (~/.config/rc)"

export HOME=/home/agent XDG_RUNTIME_DIR=/run/user/0

# openrc --user takes the RC_* variables openrc-run gives this service, RC_PATH
# among them, for its own, and would look for the agent's services in the
# system's paths: it starts from an environment without them.
user_openrc() {
	env $(env | sed -n 's/^\(RC_[A-Z_]*\|EINFO_[A-Z_]*\|SVCNAME\|IN_[A-Z_]*\)=.*/-u \1/p') \
		openrc --user "$@"
}

depend() {
	after docker k3s
}

start() {
	ebegin "Starting the agent's services"
	mkdir -p -m 0700 "$XDG_RUNTIME_DIR" && mkdir -p "$HOME/.local/state/rc" "$HOME/work" &&
		user_openrc default
	eend $?
}

stop() {
	ebegin "Stopping the agent's services"
	user_openrc shutdown
	eend $?
}
