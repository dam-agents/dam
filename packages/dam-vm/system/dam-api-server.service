[Unit]
Description=Platform api-server (UI, tRPC, ACP relay, sandbox supervisor)
# Postgres and Redis are hard requirements, and neither is on this node: they
# are the install's, reached over the network. There is nothing local to order
# against, so the unit starts when the network is up and the restart below is
# what waits for the cluster — a node booting before it can crash-loop for a
# few seconds rather than being held back by a dependency that will never
# appear.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Root, and this is the cost of folding the controller in: the supervisor
# creates network namespaces, writes nftables rules and starts sandboxes,
# none of which an unprivileged process can do. The hardening below is what
# keeps that from meaning "unrestricted".
User=root
WorkingDirectory=/opt/dam/api-server
EnvironmentFile=/etc/dam/env
# Written by first-boot provisioning, not shipped in the image: the same bytes
# on every node would mean one node could mint another's API keys.
EnvironmentFile=/var/lib/dam/hmac-keys
# The --import preload wires OpenTelemetry before the app evaluates; a no-op
# unless an OTLP endpoint is configured in the environment.
ExecStart=/usr/local/bin/node --import /opt/dam/api-server/dist/telemetry.js /opt/dam/api-server/dist/index.js
Restart=always
RestartSec=2

NoNewPrivileges=yes
# Deliberately NOT ProtectSystem / PrivateTmp / ProtectHome: each of those
# gives the unit its own mount namespace, and the supervisor's whole job is to
# create mounts the rest of the node must see. A network namespace is a bind
# mount under /run/netns; made inside a private namespace it is invisible to
# runsc, which is asked to join it from outside. Shared propagation does
# not rescue it either — iproute2 marks /run/netns shared on first use, and
# that marking lands in the private namespace too. The mount namespace is
# therefore the host's, and the hardening below is what is left: no new
# privileges, a capability set cut to what the job needs, and the kernel
# surfaces closed off.
# ProtectKernelTunables and ProtectKernelLogs are absent for the same reason:
# each implies MountAPIVFS, which is a private mount namespace by another
# name. ProtectKernelModules is capability-based and costs nothing here.
# No seccomp-installing directive may appear here — RestrictSUIDSGID,
# LockPersonality, RestrictRealtime, ProtectKernelModules and their kind all
# install a filter, and gVisor installs its own when it re-execs itself for
# the sentry and the gofer. An inherited filter makes that exec fail outright,
# so a single one of them means no sandbox on the node starts at all. What
# RestrictSUIDSGID would have bought is kept by choice instead: image
# extraction drops setuid bits rather than being prevented from restoring
# them.
# CAP_FSETID is for unpacking images faithfully: a layer carries setuid bits,
# and without it every image with one fails to extract. They are inert in the
# sandbox regardless — its spec sets noNewPrivileges and an empty capability
# set, so a setuid binary there elevates nothing.
# Two jobs need capabilities here. The supervisor's own: namespaces and the
# ruleset (NET_ADMIN), entering them (SYS_ADMIN), handing each gateway its
# credentials (CHOWN, DAC_OVERRIDE, FOWNER), unpacking images faithfully
# (FSETID), the runtime's AppArmor profile (MAC_ADMIN), stopping things
# (KILL). The rest is what gVisor needs to build a sandbox: it re-execs
# itself for the gofer and the sentry, and a capability it asks for that
# is outside this set fails that exec outright rather than degrading.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_KILL CAP_MAC_ADMIN CAP_SETGID CAP_SETUID CAP_SETPCAP CAP_SETFCAP CAP_NET_BIND_SERVICE CAP_NET_RAW CAP_SYS_CHROOT CAP_SYS_PTRACE CAP_SYS_RESOURCE CAP_IPC_LOCK CAP_MKNOD CAP_AUDIT_WRITE
# No StateDirectory / RuntimeDirectory: both make systemd bind-mount the
# directory into the unit, which is a private mount namespace again — and
# RuntimeDirectory would take /run/dam, sockets and all, down with a restart.
# tmpfiles.d owns those directories instead.

[Install]
WantedBy=multi-user.target
