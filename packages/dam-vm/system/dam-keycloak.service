[Unit]
Description=Keycloak (the install's identity authority)
After=network-online.target postgresql.service
Requires=postgresql.service
Before=dam-api-server.service

[Service]
Type=simple
User=keycloak
Group=keycloak
EnvironmentFile=/etc/dam/keycloak-env
ExecStart=/opt/keycloak/bin/kc.sh start --optimized
Restart=always
RestartSec=5

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/opt/keycloak/data

[Install]
WantedBy=multi-user.target
