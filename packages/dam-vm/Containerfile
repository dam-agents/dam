# dam-vm — the whole platform as one bootc image.
#
# Everything the install used to get from a Kubernetes cluster is a systemd
# unit here: the api-server that supervises the agent sandboxes, calling runsc
# for each one directly. The shared services — Postgres, Redis, Keycloak, the
# object store — are not on the node: they run on the cluster, and a node is
# told where to find them. There is no
# orchestrator, so there is nothing to install into — the image *is* the
# install, and `bootc upgrade` is the upgrade path.
#
# The agent images themselves are unchanged OCI images pulled at runtime;
# this image carries no harness content.
FROM quay.io/fedora/fedora-bootc:44
ARG TARGETARCH

# gVisor is the sandbox boundary, so runsc is not optional here the way a
# RuntimeClass was in the cluster.
RUN dnf install -y --setopt=install_weak_deps=False \
      nftables iproute openssl \
      jq tar gzip zstd && \
    dnf clean all

# Node from upstream rather than the distribution's, for the same reason the
# dev node's provisioning does it: the api-server is built against this version
# and the packaged one trails it. Keep in step with etc/lima/dam.yaml.
ARG NODE_VERSION=24.9.0
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) nodearch=x64 ;; \
      arm64) nodearch=arm64 ;; \
      *) echo "no Node build for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${nodearch}.tar.xz" \
      | tar -xJ -C /usr/local --strip-components=1

# The paired gateway. No distribution we build on packages Envoy, so it comes
# from its own release the way the dev node's provisioning takes it — keep this
# version in step with etc/lima/dam.yaml, which installs it for a lima node.
ARG ENVOY_VERSION=1.36.1
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) envoyarch=x86_64 ;; \
      arm64) envoyarch=aarch_64 ;; \
      *) echo "no Envoy build for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/envoy \
      "https://github.com/envoyproxy/envoy/releases/download/v${ENVOY_VERSION}/envoy-${ENVOY_VERSION}-linux-${envoyarch}"; \
    chmod 0755 /usr/local/bin/envoy

# gVisor names architectures the way the kernel does, and the build names them
# the way Go does. A node built for the wrong one installs a runsc that cannot
# exec, which looks like nothing at all until the first sandbox starts, so an
# architecture this does not know about stops the build instead.
ARG GVISOR_BASE=https://storage.googleapis.com/gvisor/releases/release/latest
RUN set -eux; \
    case "${TARGETARCH:-amd64}" in \
      amd64) gvarch=x86_64 ;; \
      arm64) gvarch=aarch64 ;; \
      *) echo "no gVisor build for ${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL -o /usr/local/bin/runsc "${GVISOR_BASE}/${gvarch}/runsc"; \
    chmod 0755 /usr/local/bin/runsc

# The gateway uid: Envoy runs as this, and it is the only reader of an
# agent's credential files and control-plane sockets.
RUN useradd --system --no-create-home --shell /sbin/nologin dam-gateway

COPY --from=platform-api-server:latest /app /opt/dam/api-server
COPY system/*.service /usr/lib/systemd/system/
COPY bin/ /opt/dam/bin/
COPY etc/ /etc/dam/
# The agent templates a node offers. Without them it serves a catalogue of
# nothing and no agent can be created.
COPY templates/ /etc/dam/templates/

COPY --from=platform-ui:latest /usr/share/nginx/html /usr/share/dam-ui

RUN systemctl enable dam-first-boot dam-api-server
