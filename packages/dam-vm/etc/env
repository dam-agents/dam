# Node configuration. Everything the Helm values used to carry that still
# means something on one node; anything that was about scheduling, storage
# classes or the mesh is gone rather than defaulted.

DAM_AGENTS_ROOT=/var/lib/dam/agents
DAM_SECRET_STORE_ROOT=/var/lib/dam/secrets
DAM_REGISTRY_AUTH_ROOT=/var/lib/dam/registry-auth
DAM_PKI_ROOT=/var/lib/dam/pki
DAM_RUN_ROOT=/run/dam
DAM_GATEWAY_PORT=3128
DAM_SANDBOX_PORT=8080

PORT=4000
PLATFORM_RELEASE_NAME=dam
PLATFORM_HARNESS_SERVER_URL=http://harness.dam.internal:4001

DATABASE_URL=postgres://dam@/dam?host=/run/postgresql
REDIS_URL=redis://127.0.0.1:6379

UI_BASE_URL=http://localhost:8080
SHARE_BASE_URL=http://share.localhost:8080
CONTENT_BASE_URL=http://content.localhost:8080
KEYCLOAK_URL=http://localhost:8081

# Node-local secrets. The install generates them on first run; they are here so
# a hand-rolled node has one place to put its own.
ACTIVITY_HMAC_KEY=
API_KEY_HMAC_KEY=

TERMS_VERSION=1
TERMS_TEXT=Use of this install is governed by its operator's terms.

AGENT_TEMPLATES_PATH=/etc/dam/templates
GIT_REPOS_PATH=/etc/dam/repos
TRUSTED_HOSTS_PATH=/etc/dam/trusted-hosts.yaml
