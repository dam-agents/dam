#!/usr/bin/env bash
#MISE sources=["src/**/*.ts", "tsconfig.json", "scripts/event-coverage.mjs"]
#MISE outputs=[]
#MISE cache.enabled=true
# Guards the write-side event registry: every type in src/events.ts must have
# an emit site and a subscriber. Both halves drift silently past tsc and lint,
# because a declared-but-unsubscribed event is perfectly well-typed.
set -euo pipefail
node scripts/event-coverage.mjs "$@"
