#!/usr/bin/env bash
#MISE description="Build the UI image to dist/oci/ui.tar"
#MISE sources=["src/**", "public/**", "index.html", "vite.config.ts", "tsconfig.json", "package.json", "default.conf", ".mise/tasks/build", ".mise/tasks/oci", "{{config_root}}/../agent-runtime-api/src/**", "{{config_root}}/../agent-runtime-api/package.json", "{{config_root}}/../api-server-api/src/**", "{{config_root}}/../api-server-api/package.json", "{{config_root}}/../../pnpm-lock.yaml", "{{config_root}}/../../.mise/tasks/image/pack", "{{config_root}}/../../.mise/config.toml", "{{config_root}}/../../mise.lock"]
#MISE outputs=["dist/oci/ui.tar"]
set -euo pipefail
base="$(mise config get -f "$MISE_CONFIG_ROOT/../../.mise/config.toml" vars.base_image_ui)"
mise run //packages/ui:build
root="$(mktemp -d)"
trap 'rm -rf "$root"' EXIT
mkdir -p "$root/usr/share/nginx" "$root/etc/nginx/conf.d"
cp -R dist/js "$root/usr/share/nginx/html"
cp default.conf "$root/etc/nginx/conf.d/"
"$MISE_CONFIG_ROOT/../../.mise/tasks/image/pack" "$base" "$root" dist/oci/ui.tar platform-ui:latest
