#!/usr/bin/env bash
#MISE description="Build the theme JAR (update-kc-gen + tsc + vite build + keycloakify build)"
#MISE sources=["src/**/*", "public/**/*", "vite.config.ts", "package.json"]
#MISE outputs=["dist_keycloak/**/*"]
#MISE cache.enabled=true
set -eo pipefail
export XDG_CACHE_HOME="$PWD/node_modules/.cache"
export KEYCLOAKIFY_USE_DEFAULT_MAVEN_REPO=true
pnpm exec keycloakify update-kc-gen
pnpm exec tsc --noEmit
pnpm exec vite build
pnpm exec keycloakify build
