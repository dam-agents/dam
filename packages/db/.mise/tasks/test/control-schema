#!/usr/bin/env bash
#MISE description="Check the control schema's guards, versions and change feed on the local cluster's Postgres"
# The `control` tables' behaviour lives in triggers and functions a schema diff
# cannot see, and Drizzle emits only the tables. This drives them inside a
# transaction that is always rolled back: generation bumps on exactly what the
# controller renders, signals versions rotating where a compare-and-set relies
# on them, immutable identity, and the constraints that mirror CRD admission.
set -euo pipefail
# Defaults to the installed database; point CONTROL_SCHEMA_DB at a scratch one
# that has this checkout's migrations when the cluster runs an older release.
db="${CONTROL_SCHEMA_DB:-platform}"
{
  cat <<'SQL'
BEGIN;
INSERT INTO control.agents (id, owner_sub, image, cpu_limit, memory_limit, hibernation_timeout_ns)
VALUES ('agent-abc', 'sub-1', 'img', '1', '1Gi', 1000000000);
INSERT INTO control.agent_signals (agent_id) VALUES ('agent-abc');

-- a display-only edit is not a spec change
UPDATE control.agents SET name = 'renamed' WHERE id = 'agent-abc';
DO $$ BEGIN ASSERT (SELECT generation = 1 FROM control.agents WHERE id = 'agent-abc'), 'display change bumped generation'; END $$;

-- a rendered column is, and does not disturb the signals row
UPDATE control.agents SET image = 'img2' WHERE id = 'agent-abc';
DO $$ BEGIN ASSERT (SELECT generation = 2 FROM control.agents WHERE id = 'agent-abc'), 'rendered change did not bump generation'; END $$;
DO $$ BEGIN ASSERT (SELECT version = 0 FROM control.agent_signals WHERE agent_id = 'agent-abc'), 'rendered-only change bumped signals'; END $$;

-- eligibility is both rendered and versioned: a status write's reclaim
-- compare-and-set has to see a timeout raised at the same instant
UPDATE control.agents SET hibernation_timeout_ns = 0 WHERE id = 'agent-abc';
DO $$ BEGIN ASSERT (SELECT generation = 3 FROM control.agents WHERE id = 'agent-abc'), 'timeout change did not bump generation'; END $$;
DO $$ BEGIN ASSERT (SELECT version = 1 FROM control.agent_signals WHERE agent_id = 'agent-abc'), 'timeout change did not bump signals'; END $$;

-- hosts and grants were spec fields, so they still advance the generation
INSERT INTO control.agent_l7_hosts (agent_id, host) VALUES ('agent-abc', '*.example.test');
DO $$ BEGIN ASSERT (SELECT generation = 4 FROM control.agents WHERE id = 'agent-abc'), 'l7 host change did not bump generation'; END $$;

INSERT INTO public.connections (id, owner, template_id, name, inputs, contributions, auth)
VALUES ('conn-1', 'sub-1', 'tpl', 'conn', '{}', '[]', '{}');
INSERT INTO public.connection_grants (connection_id, agent_id) VALUES ('conn-1', 'agent-abc');
DO $$ BEGIN ASSERT (SELECT generation = 5 FROM control.agents WHERE id = 'agent-abc'), 'grant change did not bump generation'; END $$;
DO $$ BEGIN ASSERT (SELECT count(*) = 1 FROM control.agent_connection_grants WHERE agent_id = 'agent-abc'), 'grants projection empty'; END $$;

-- every write to a versioned row rotates its token
UPDATE control.agent_signals SET last_activity_at = now() WHERE agent_id = 'agent-abc';
DO $$ BEGIN ASSERT (SELECT version = 2 FROM control.agent_signals WHERE agent_id = 'agent-abc'), 'signals version did not rotate'; END $$;
INSERT INTO control.agent_status (agent_id) VALUES ('agent-abc');
UPDATE control.agent_status SET machine_restarts = 3 WHERE agent_id = 'agent-abc';
DO $$ BEGIN ASSERT (SELECT version = 1 FROM control.agent_status WHERE agent_id = 'agent-abc'), 'status version did not rotate'; END $$;

-- every trigger the change feed hangs on fires: a payload it cannot build fails
-- here. The notification itself is delivered at commit, which this transaction
-- never reaches, so delivery is the switch's own check.
UPDATE control.agent_signals SET last_activity_at = now() WHERE agent_id = 'agent-abc';
UPDATE control.agents SET name = 'renamed again' WHERE id = 'agent-abc';
DELETE FROM control.agent_l7_hosts WHERE agent_id = 'agent-abc';
INSERT INTO control.agent_conditions (agent_id, type, status, reason, observed_generation, last_transition_at)
VALUES ('agent-abc', 'Ready', 'True', 'Reconciled', 5, now());
DELETE FROM control.agent_conditions WHERE agent_id = 'agent-abc';

-- identity is immutable
DO $$ BEGIN
  BEGIN UPDATE control.agents SET owner_sub = 'sub-2' WHERE id = 'agent-abc';
    RAISE EXCEPTION 'owner change was allowed';
  EXCEPTION WHEN raise_exception THEN
    IF SQLERRM NOT LIKE '%owner_sub is immutable%' THEN RAISE; END IF;
  END;
END $$;
DO $$ BEGIN
  BEGIN UPDATE control.agents SET incarnation = gen_random_uuid() WHERE id = 'agent-abc';
    RAISE EXCEPTION 'incarnation change was allowed';
  EXCEPTION WHEN raise_exception THEN
    IF SQLERRM NOT LIKE '%incarnation is immutable%' THEN RAISE; END IF;
  END;
END $$;

-- the constraints mirror CRD admission rather than tightening it
DO $$ BEGIN
  BEGIN INSERT INTO control.agents (id, owner_sub, image, cpu_limit, memory_limit) VALUES ('Bad_Name', 's', 'i', '1', '1Gi');
    RAISE EXCEPTION 'bad id was admitted';
  EXCEPTION WHEN check_violation THEN NULL; END;
  BEGIN INSERT INTO control.agents (id, owner_sub, image, cpu_limit, memory_limit) VALUES ('agent-x', 's', 'i', 'not-a-quantity', '1Gi');
    RAISE EXCEPTION 'unparseable quantity was admitted';
  EXCEPTION WHEN check_violation THEN NULL; END;
  BEGIN INSERT INTO control.user_budgets (owner_sub) VALUES ('sub-1');
    RAISE EXCEPTION 'a budget with no override was admitted';
  EXCEPTION WHEN check_violation THEN NULL; END;
END $$;

-- deleting an Agent takes its rows with it
DELETE FROM control.agents WHERE id = 'agent-abc';
DO $$ BEGIN ASSERT (SELECT count(*) = 0 FROM control.agent_signals), 'signals survived the delete'; END $$;
DO $$ BEGIN ASSERT (SELECT count(*) = 0 FROM control.agent_status), 'status survived the delete'; END $$;
ROLLBACK;
SQL
} | mise run //:cluster:kubectl -- exec -i platform-postgres-0 -- psql -U platform -d "$db" -v ON_ERROR_STOP=1 -q
