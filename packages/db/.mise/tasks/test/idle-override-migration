#!/usr/bin/env bash
#MISE description="Check that 0151 clears regular Agents' idle overrides and keeps Environments' and sub-agents', on a throwaway Postgres"
# Needs a PostgreSQL from mise (`mise install postgres@18`), like
# test:upgrade-from-release. Applies this checkout's migrations to an empty
# database, writes one row per shape 0151 decides on, runs 0151 again over them
# and asserts what it cleared and what it kept.
set -euo pipefail
repo="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
pgbin=""
for major in 18 17 16; do
  if dir="$(mise where "postgres@$major" 2>/dev/null)" && [ -x "$dir/bin/postgres" ]; then
    pgbin="$dir/bin"
    break
  fi
done
[ -n "$pgbin" ] || { echo "no PostgreSQL from mise: install one with 'mise install postgres@18'" >&2; exit 1; }
export PATH="$pgbin:$PATH"
work="$(mktemp -d)"
trap 'pg_ctl -D "$work/pgdata" -m immediate stop >/dev/null 2>&1; rm -rf "$work"' EXIT
port="$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
initdb -D "$work/pgdata" -U postgres --auth=trust >"$work/initdb.log" 2>&1 || { cat "$work/initdb.log" >&2; exit 1; }
pg_ctl -D "$work/pgdata" -o "-p $port -c listen_addresses=127.0.0.1 -c fsync=off" -l "$work/postgres.log" -w start >/dev/null
psql -h 127.0.0.1 -p "$port" -U postgres -v ON_ERROR_STOP=1 -q -d postgres <<'SQL'
CREATE ROLE platform LOGIN;
CREATE ROLE platform_controller LOGIN;
CREATE ROLE usage_readers NOLOGIN;
CREATE DATABASE t OWNER platform;
SQL
"$repo/packages/api-server/node_modules/.bin/tsx" "$repo/packages/db/scripts/upgrade-rehearsal-migrate.ts" \
  "postgres://platform@127.0.0.1:$port/t" "$repo/packages/db/drizzle" >"$work/migrate.log" 2>&1 ||
  { cat "$work/migrate.log" >&2; exit 1; }
{
  cat <<'SQL'
INSERT INTO control.agents (id, owner_sub, image, cpu_limit, memory_limit, environment_of, hibernation_timeout_ns) VALUES
  ('agent-t-never', 'sub-t', 'img', '1', '1Gi', NULL, 0),
  ('agent-t-window', 'sub-t', 'img', '1', '1Gi', NULL, 3600000000000),
  ('agent-t-env', 'sub-t', 'img', '1', '1Gi', 'agent-t-never', 0),
  ('agent-t-sub', 'sub-t', 'img', '1', '1Gi', NULL, 300000000000),
  ('agent-t-plain', 'sub-t', 'img', '1', '1Gi', NULL, NULL);
INSERT INTO invocations (id, driver_agent_id, root_driver_id, owner, expires_at)
VALUES ('agent-t-sub', 'agent-t-never', 'agent-t-never', 'sub-t', now() + interval '1 hour');
SQL
  cat "$repo/packages/db/drizzle/0151_clear_regular_agent_idle_overrides.sql"
  cat <<'SQL'
DO $$
BEGIN
  ASSERT (SELECT count(*) = 0 FROM control.agents WHERE id IN ('agent-t-never', 'agent-t-window') AND hibernation_timeout_ns IS NOT NULL), 'a regular agent kept its override';
  ASSERT (SELECT generation = 2 FROM control.agents WHERE id = 'agent-t-never'), 'clearing did not bump the generation';
  ASSERT (SELECT hibernation_timeout_ns = 0 AND generation = 1 FROM control.agents WHERE id = 'agent-t-env'), 'an Environment lost its idle timeout';
  ASSERT (SELECT hibernation_timeout_ns = 300000000000 AND generation = 1 FROM control.agents WHERE id = 'agent-t-sub'), 'a sub-agent lost its idle timeout';
  ASSERT (SELECT generation = 1 FROM control.agents WHERE id = 'agent-t-plain'), 'an agent without an override was rewritten';
END $$;
SQL
} | psql -h 127.0.0.1 -p "$port" -U platform -v ON_ERROR_STOP=1 -q -d t
echo "0151 clears regular agents' overrides and keeps Environments' and sub-agents'"
