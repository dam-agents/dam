#!/usr/bin/env bash
#MISE description="Check the ETE LiteLLM beta-flag removal using temporary tables in the local cluster"
set -euo pipefail
repo="$(git rev-parse --show-toplevel)"
{
  cat <<'SQL'
BEGIN;
CREATE TEMP TABLE connections (id text, template_id text, contributions jsonb, auth jsonb);
CREATE TEMP TABLE connection_grants (agent_id text, connection_id text);
CREATE TEMP TABLE runtime_state_outbox (agent_id text, version int, last_enqueued_at timestamptz);
INSERT INTO connections VALUES
  ('flagged', 'ibm-litellm', '[{"kind":"env","name":"ANTHROPIC_BASE_URL","placeholder":"https://ete.test"},{"kind":"env","name":"CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS","placeholder":"1"},{"kind":"egress-inject","host":"ete.test"}]', '{"credential":"untouched"}'),
  ('clean', 'ibm-litellm', '[{"kind":"env","name":"ANTHROPIC_BASE_URL","placeholder":"https://ete.test"}]', '{}'),
  ('other', 'curve-bender', '[{"kind":"env","name":"CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS","placeholder":"1"}]', '{}');
INSERT INTO connection_grants VALUES ('a', 'flagged'), ('b', 'clean'), ('c', 'other');
INSERT INTO runtime_state_outbox VALUES ('a', 5, NULL), ('b', 3, NULL), ('c', 7, NULL);
SQL
  cat "$repo/packages/db/drizzle/0060_drop_litellm_disable_experimental_betas.sql"
  cat <<'SQL'
DO $$
BEGIN
  ASSERT (SELECT contributions = '[{"kind":"env","name":"ANTHROPIC_BASE_URL","placeholder":"https://ete.test"},{"kind":"egress-inject","host":"ete.test"}]'::jsonb AND auth = '{"credential":"untouched"}'::jsonb FROM connections WHERE id = 'flagged'), 'Flag kept, another contribution lost, or credential changed';
  ASSERT (SELECT contributions = '[{"kind":"env","name":"CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS","placeholder":"1"}]'::jsonb FROM connections WHERE id = 'other'), 'Another provider changed';
  ASSERT (SELECT count(*) = 3 FROM connection_grants), 'Grants changed';
  ASSERT (SELECT version = 6 AND last_enqueued_at IS NOT NULL FROM runtime_state_outbox WHERE agent_id = 'a'), 'Affected agent not queued';
  ASSERT (SELECT version = 3 AND last_enqueued_at IS NULL FROM runtime_state_outbox WHERE agent_id = 'b'), 'Unaffected agent queued';
  ASSERT (SELECT version = 7 AND last_enqueued_at IS NULL FROM runtime_state_outbox WHERE agent_id = 'c'), 'Unrelated agent queued';
END $$;
ROLLBACK;
SQL
} | mise run //:cluster:kubectl -- exec -i platform-postgres-0 -- psql -U platform -d platform -v ON_ERROR_STOP=1
