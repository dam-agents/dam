#!/bin/sh
# Reached only when the image ships no k3s, which is the normal case.
#
# k3s is installed through mise like every other tool here, so it arrives with
# the same lockfile, release-age floor and provenance checking as the rest. The
# upstream get.k3s.io installer is deliberately not used: it refuses to run
# unless it finds systemd or openrc to hand a service to, and a sandbox has
# neither — its init is catatonit and these shims start their daemons
# themselves.
#
# Unlike the mise-backed shims in lazy-tools, this one stays ahead of the binary
# it installs, because it has work to do on every call and not just the first:
# the flags below are what make a cluster work in a sandbox at all.
#
# `--data-dir` is defaulted onto the machine's storage disk: a guest's rootfs is
# an overlay, overlayfs refuses an overlay as an upperdir, and k3s's containerd
# snapshotter fails on exactly that — the default would not work at all on the
# vm Backend. An explicit --data-dir always wins.
set -eu

# The sandbox shell runs with umask 027, and a container runtime started under it
# creates every image layer 750 — which a container running as a non-root uid
# cannot traverse, so it dies on `stat` of its own entrypoint. The same umask
# reaches the projected service-account volumes, where it costs a non-root pod
# its token and its CA. Diagnosed in a guest as all three symptoms of one cause:
# CoreDNS crash-looping, traefik's installer unable to exec, and its helm fetch
# failing x509 verification. 022 is what containerd assumes everywhere else.
umask 022

if ! dam-tool-real k3s >/dev/null 2>&1; then
    # A cluster needs a machine of its own, which only the vm Backend gives: k3s
    # needs root to run at all. Refusing here keeps the failure early and
    # legible, rather than one buried inside a cluster that can never start.
    [ "$(id -u)" = 0 ] || {
        echo "k3s needs root, which a container sandbox does not have; use a VM sandbox to run a cluster" >&2
        exit 1
    }
    dam-auto-install k3s env MISE_AUTO_INSTALL=false mise install k3s
fi
# The postinstall hook normally puts it in tool-bin, which dam-tool-real finds;
# mise itself is the fallback for a hook that could not write there.
real=$(dam-tool-real k3s 2>/dev/null || mise which k3s)

case "${1:-}" in
server | agent)
    # k3s bundles a containerd and starts it by default, which would be a second
    # daemon and a second copy of every shared layer next to docker's. Pointing
    # it at the one dam-containerd runs leaves a single content store.
    #
    # Both opt out, for the same reason: dam-containerd has to name k3s's CNI
    # plugin and config directories, and it derives them from the data dir this
    # shim picks. A caller who chooses either flag is somewhere that helper was
    # not told about, so k3s keeps the containerd it brings.
    for arg in "$@"; do
        case "$arg" in
        --data-dir | --data-dir=* | \
            --container-runtime-endpoint | --container-runtime-endpoint=*)
            exec "$real" "$@"
            ;;
        esac
    done

    sub=$1
    shift
    set -- --container-runtime-endpoint "$(dam-containerd)" "$@"
    for d in /storage /workspace; do
        if [ -d "$d" ] && [ -w "$d" ]; then
            set -- --data-dir "$d/k3s" "$@"
            break
        fi
    done
    exec "$real" "$sub" "$@"
    ;;
esac

exec "$real" "$@"
