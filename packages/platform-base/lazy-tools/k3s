#!/bin/sh
# Reached only when the image ships no k3s, which is the normal case.
#
# The release binary is fetched directly rather than through get.k3s.io. That
# installer refuses to run at all unless it finds systemd or openrc to hand the
# service to, and a sandbox has neither — its init is catatonit and the shims
# start their daemons themselves. The version still comes from the same stable
# channel the installer resolves, and the published checksum is still verified:
# what is skipped is the service wiring, not the integrity check.
#
# `--data-dir` is defaulted onto the machine's storage disk: a guest's rootfs is
# an overlay, overlayfs refuses an overlay as an upperdir, and k3s's containerd
# snapshotter fails on exactly that — the default would not work at all on the
# vm Backend. An explicit --data-dir always wins.
set -eu

# The sandbox shell runs with umask 027, and a container runtime started under it
# creates every image layer 750 — which a container running as a non-root uid
# cannot traverse, so it dies on `stat` of its own entrypoint. The same umask
# reaches the projected service-account volumes, where it costs a non-root pod
# its token and its CA. Diagnosed in a guest as all three symptoms of one cause:
# CoreDNS crash-looping, traefik's installer unable to exec, and its helm fetch
# failing x509 verification. 022 is what containerd assumes everywhere else.
umask 022

if ! dam-tool-real k3s >/dev/null 2>&1; then
    # A cluster needs a machine of its own, which only the vm Backend gives: the
    # install writes to /usr/local/bin and k3s then needs root to run at all.
    # Refusing here keeps the failure early and legible, rather than a permission
    # error after a 70 MB download.
    [ "$(id -u)" = 0 ] || {
        echo "k3s needs root, which a container sandbox does not have; use a VM sandbox to run a cluster" >&2
        exit 1
    }
    dam-auto-install k3s sh -c '
        set -eu
        case $(uname -m) in
        x86_64) arch=amd64; suffix= ;;
        aarch64) arch=arm64; suffix=-arm64 ;;
        *) echo "no k3s release is published for $(uname -m)" >&2; exit 1 ;;
        esac

        # The channel URL redirects to the release page of the current stable;
        # the last segment of where it lands is the version tag.
        tag=$(curl -sS -L -o /dev/null -w "%{url_effective}" \
            https://update.k3s.io/v1-release/channels/stable | sed "s|.*/||")
        [ -n "$tag" ] || { echo "could not resolve the k3s stable channel" >&2; exit 1; }

        # A + is not valid unencoded in a GitHub release path, and every k3s tag
        # carries one.
        rel=https://github.com/k3s-io/k3s/releases/download/$(printf %s "$tag" | sed "s/+/%2B/")
        tmp=$(mktemp -d)
        trap "rm -rf $tmp" EXIT
        curl -sSfL -o "$tmp/k3s" "$rel/k3s$suffix"
        curl -sSfL -o "$tmp/sums" "$rel/sha256sum-$arch.txt"

        want=$(grep " k3s$suffix$" "$tmp/sums" | cut -d" " -f1)
        got=$(sha256sum "$tmp/k3s" | cut -d" " -f1)
        [ -n "$want" ] && [ "$want" = "$got" ] || {
            echo "k3s checksum mismatch for $tag" >&2; exit 1; }

        install -m 755 "$tmp/k3s" /usr/local/bin/k3s
        echo "installed k3s $tag"'
fi
real=$(dam-tool-real k3s)

case "${1:-}" in
server | agent)
    # k3s bundles a containerd and starts it by default, which would be a second
    # daemon and a second copy of every shared layer next to docker's. Pointing
    # it at the one dam-containerd runs leaves a single content store.
    #
    # Both opt out, for the same reason: dam-containerd has to name k3s's CNI
    # plugin and config directories, and it derives them from the data dir this
    # shim picks. A caller who chooses either flag is somewhere that helper was
    # not told about, so k3s keeps the containerd it brings.
    for arg in "$@"; do
        case "$arg" in
        --data-dir | --data-dir=* | \
            --container-runtime-endpoint | --container-runtime-endpoint=*)
            exec "$real" "$@"
            ;;
        esac
    done

    sub=$1
    shift
    set -- --container-runtime-endpoint "$(dam-containerd)" "$@"
    for d in /storage /workspace; do
        if [ -d "$d" ] && [ -w "$d" ]; then
            set -- --data-dir "$d/k3s" "$@"
            break
        fi
    done
    exec "$real" "$sub" "$@"
    ;;
esac

exec "$real" "$@"
