#!/bin/sh
# Prints where a container runtime keeps its data in this guest, or nothing
# when the default has to do. The docker, containerd and k3s shims all ask here,
# so the three always agree.
#
# A guest's rootfs is an overlay, and overlayfs refuses an overlay as an
# upperdir, so a runtime whose data sits on the rootfs never becomes ready. On
# the vm Backend the rootfs is also emptied on every boot. HOME is the one path
# a machine keeps, and it is a bind of the storage disk rather than an overlay,
# so the data goes under it — where a rootless runtime would put it too.
set -eu
home=${HOME:-/home/agent}
[ -d "$home" ] && [ -w "$home" ] || exit 0
[ "$(stat -f -c %T "$home")" != overlayfs ] || exit 0
printf '%s\n' "$home/.local/share"
