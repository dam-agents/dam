#!/bin/sh
# dam-lazy-tool <mise tool> <binary> [args...]
#
# The body every mise-backed shim runs: install the tool on first use, then hand
# over to it. It exists so those shims take the same install-once, logged and
# locked path as the docker and k3s ones, rather than being a second mechanism
# with its own behaviour — an install that reported nothing and re-ran on every
# single invocation.
#
# It runs once per tool and then never again: the mise postinstall hook symlinks
# the new binary into tool-bin, which sits ahead of this directory on PATH, so
# the next call reaches the real thing and never arrives here.
set -eu
export MISE_AUTO_INSTALL=false
tool=$1
bin=$2
shift 2

mise where "$tool" >/dev/null 2>&1 || dam-auto-install "$bin" mise install "$tool"

exec mise exec "$tool" -- "$bin" "$@"
