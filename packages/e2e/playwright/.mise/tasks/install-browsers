#!/usr/bin/env bash
#MISE description="Download the Chromium binary Playwright drives (+ OS libs on Linux)"
# Deliberately a task, not a [deps] provider: `mise deps --monorepo` installs every
# provider, and this one is a large download plus `sudo apt` on Linux that only
# the e2e run tasks need.
set -euo pipefail
# GitHub's runner image already has Chromium's libraries; --with-deps would
# only add fonts and xvfb, 25s of apt a run that headless tests never use.
if [ "$(uname)" = "Linux" ] && [ -z "${GITHUB_ACTIONS:-}" ]; then
  pnpm exec playwright install --with-deps chromium
else
  pnpm exec playwright install chromium
fi
