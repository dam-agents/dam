#!/usr/bin/env bash
#MISE description="Run the e2e smoke suite; E2E_FULL=1 adds the slow specs, args after -- go to playwright test"
#MISE depends=[":install-browsers"]
#MISE env={ NODE_OPTIONS = "--dns-result-order=ipv4first", LIMA_INSTANCE = "platform-k3s-test" }
# Smoke specs live under src/tests/smoke/ (the always-on pipeline tier), slow
# on-demand ones under src/tests/full/. Useful args: --headed, --ui, a filter.
# Defensive: the sandbox k3s ingress binds IPv4 only, so the specs' own
# fetches (Keycloak token mint, tRPC clients) resolve `*.localhost` v4-first
# instead of depending on happy-eyeballs fallback. The browser side gets the
# same via --host-resolver-rules in the config.
set -euo pipefail
pnpm exec playwright test "$@"
