#!/usr/bin/env bash
#MISE description="Run the FULL suite: smoke plus the slow on-demand specs under src/tests/full/"
#MISE depends=[":install-browsers"]
#MISE env={ NODE_OPTIONS = "--dns-result-order=ipv4first" }
set -euo pipefail
# One worker: the full specs have no dependencies, so more would race auth's
# terms check and the slack specs' shared mock outbound.
E2E_FULL=1 pnpm exec playwright test --workers=1 "$@"
