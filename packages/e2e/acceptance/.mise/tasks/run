#!/usr/bin/env bash
#MISE description="Run the behaviour examples and journeys against a running install; args after -- go to playwright test"
#MISE depends=["//packages/e2e/integration:install-browsers"]
#MISE env={ NODE_OPTIONS = "--dns-result-order=ipv4first" }
set -euo pipefail
pnpm exec bddgen
# E2E_ACCEPTANCE_SHARD, as "2/3", runs one shard of the suite, as a CI job does.
pnpm exec playwright test ${E2E_ACCEPTANCE_SHARD:+--shard="$E2E_ACCEPTANCE_SHARD"} "$@"
