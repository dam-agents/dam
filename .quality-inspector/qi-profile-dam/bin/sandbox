#!/usr/bin/env bash
# bin/sandbox check — the sandbox accounts answer (quality-inspector docs/profile-contract.md → sandbox).
# One request per account and value; `ok` / `FAIL` lines; never a value. Exit 1 on any FAIL.
set -u
[ "${1:-}" = check ] || { echo "usage: bin/sandbox check" >&2; exit 2; }
set -a; . "$QI_ENV_DIR/credentials.env"; set +a
cfg="${QI_PROFILE_CONFIG:-}"; [ -n "$cfg" ] || cfg='{}'
repo="$(jq -r '.sandbox_github_repo // ""' <<<"$cfg")"
fails=0
ok() { echo "ok $*"; }
bad() { echo "FAIL $*"; fails=1; }
lower() { tr 'A-Z' 'a-z' <<<"$1"; }

# GitHub, per test user (account github, github2): who the token is, and that it sees the sandbox
# repository, which is no fork.
gh_get() { curl -s --max-time 20 -H "Authorization: Bearer $1" -H 'Accept: application/vnd.github+json' "https://api.github.com/$2"; }
gh_code() { curl -s -o /dev/null -w '%{http_code}' --max-time 20 -X "$2" -H "Authorization: Bearer $1" \
  -H 'Accept: application/vnd.github+json' ${4:+-d "$4"} "https://api.github.com/repos/$repo/$3"; }
gh_user() {  # <account id> <its line prefix, E2E_SANDBOX_<ID>_>
  local id="$1" p="$2" v tok want login r g name what m path body
  v="${p}TOKEN"; tok="${!v:-}"; v="${p}LOGIN"; want="${!v:-}"
  if [ -z "$tok" ] || [ -z "$repo" ]; then bad "$id ${p}TOKEN or profile.sandbox_github_repo is not set"; return; fi
  login="$(gh_get "$tok" user | jq -r '.login // empty' 2>/dev/null)"
  r="$(gh_get "$tok" "repos/$repo")"
  if [ -z "$login" ]; then bad "$id the token is refused (expired, or no egress for GET api.github.com/user)"
  elif [ "$(jq -r '.full_name // empty' <<<"$r" | tr 'A-Z' 'a-z')" != "$(lower "$repo")" ]; then bad "$id the token cannot see $repo"
  elif [ "$(jq -r .fork <<<"$r")" = true ]; then bad "$id $repo is a fork — use a repository of its own"
  elif [ "$(jq -r '.has_issues' <<<"$r")" != true ]; then bad "$id $repo has issues turned off"
  else ok "$id token of $login sees $repo"; fi
  # The write grants the cleanup needs, by writes that change nothing: a pull request and a branch
  # that do not exist. A public repository is readable with no grant, so only a write tells: 403
  # without the grant, 404 or 422 (not found) with it.
  for g in "Pull requests:pull requests:PATCH:pulls/999999999:{}" "Contents:branches:DELETE:git/refs/heads/qi-sandbox-check-no-such-branch:"; do
    IFS=: read -r name what m path body <<<"$g"
    case "$(gh_code "$tok" "$m" "$path" "$body")" in
      (404|422) ok "$id the token may write $repo's $what";;
      (403) bad "$id the token may not write $repo's $what — give it $name: Read and write";;
      (*) bad "$id no answer from $m api.github.com/repos/$repo/$path (its egress rule is added by hand)";;
    esac
  done
  # The test user who signs in through DAM's OAuth: the token is theirs, the TOTP secret is base32.
  if [ -n "$login" ] && [ "$(lower "$login")" != "$(lower "$want")" ]; then
    bad "$id the token is $login's, not ${p}LOGIN's — create it as the test user"
  fi
  v="${p}PASSWORD"; [ -n "${!v:-}" ] || bad "$id ${p}PASSWORD is not set"
  v="${p}TOTP_SECRET"
  tr -d ' =' <<<"${!v:-}" | grep -qiE '^[A-Z2-7]{16,}$' \
    && ok "$id the test user's TOTP secret is base32" || bad "$id ${p}TOTP_SECRET is not a base32 TOTP secret"
}
gh_user github E2E_SANDBOX_GITHUB_
# The second user and person are optional: with all their lines empty, a check that needs two
# people is testable: no, and the rest runs as before. A line half filled is a mistake.
if [ -z "${E2E_SANDBOX_GITHUB2_TOKEN:-}${E2E_SANDBOX_GITHUB2_LOGIN:-}${E2E_SANDBOX_GITHUB2_PASSWORD:-}${E2E_SANDBOX_GITHUB2_TOTP_SECRET:-}" ]; then
  ok "github2 not set — a check with two GitHub users is testable: no"
else gh_user github2 E2E_SANDBOX_GITHUB2_; fi
if [ -n "${E2E_SANDBOX_GITHUB2_LOGIN:-}" ] && [ "$(lower "$E2E_SANDBOX_GITHUB2_LOGIN")" = "$(lower "${E2E_SANDBOX_GITHUB_LOGIN:-}")" ]; then
  bad "github2 is the same user as github — sign up a second one"
fi
# GitHub knows the OAuth App both users sign in through (a made-up code is refused as a bad code,
# not as a bad client).
e="$(curl -s --max-time 20 -X POST -H 'Accept: application/json' \
      --data-urlencode "client_id=${E2E_SANDBOX_GITHUB_OAUTH_CLIENT_ID:-none}" --data-urlencode "client_secret=${E2E_SANDBOX_GITHUB_OAUTH_CLIENT_SECRET:-none}" \
      --data-urlencode code=qi-sandbox-check https://github.com/login/oauth/access_token | jq -r '.error // empty' 2>/dev/null)"
case "$e" in
  (bad_verification_code) ok "github the OAuth App answers its client id and secret";;
  (incorrect_client_credentials) bad "github the OAuth App refuses E2E_SANDBOX_GITHUB_OAUTH_CLIENT_ID / _SECRET";;
  (*) bad "github no answer from POST github.com/login/oauth/access_token (its egress rule is added by hand)";;
esac

# Slack: the bot, the app-level token and the two people, each in the channel, all in one workspace,
# and the two people two accounts apart from the bot.
sl() { curl -s --max-time 20 -X POST -H "Authorization: Bearer $1" "https://slack.com/api/$2" ${3:+--data-urlencode "$3"}; }
users=""
for t in slack:BOT_TOKEN:bot slack:HUMAN_TOKEN:human slack2:HUMAN_TOKEN:human; do
  IFS=: read -r id name w <<<"$t"
  v="E2E_SANDBOX_$(tr 'a-z' 'A-Z' <<<"$id")_$name"
  if [ "$id" = slack2 ] && [ -z "${!v:-}" ]; then ok "slack2 not set — a check with two Slack people is testable: no"; continue; fi
  r="$(sl "${!v:-none}" auth.test)"
  if [ "$(jq -r .ok <<<"$r" 2>/dev/null)" = true ]; then
    ok "$id $w token is $(jq -r .user <<<"$r") in $(jq -r .team <<<"$r")"
    u="$(jq -r '.team_id + ":" + .user_id' <<<"$r")"
    case " $users " in
      (*" $u "*) bad "$id $w token is the same Slack account as another sandbox token — use a person of its own";;
      (*) [ -z "$users" ] || [ "${users%%:*}" = "${u%%:*}" ] || bad "$id $w token is in another workspace than the bot";;
    esac
    users="${users:+$users }$u"
  else bad "$id $w token refused: $(jq -r '.error // "no answer (egress for slack.com?)"' <<<"$r" 2>/dev/null)"; fi
  r="$(sl "${!v:-none}" conversations.info "channel=${E2E_SANDBOX_SLACK_CHANNEL_ID:-none}")"
  [ "$(jq -r .channel.is_member <<<"$r" 2>/dev/null)" = true ] && ok "$id $w is in the channel" \
    || bad "$id $w is not in E2E_SANDBOX_SLACK_CHANNEL_ID's channel: $(jq -r '.error // "not a member — invite it"' <<<"$r" 2>/dev/null)"
done
r="$(sl "${E2E_SANDBOX_SLACK_APP_TOKEN:-none}" apps.connections.open)"
[ "$(jq -r .ok <<<"$r" 2>/dev/null)" = true ] && ok "slack Socket Mode answers the app-level token" \
  || bad "slack app-level token refused: $(jq -r '.error // "no answer"' <<<"$r" 2>/dev/null)"
exit "$fails"
