# Copy to values-dev.yaml (gitignored) for personal cluster overrides.
# These are auto-loaded by `mise run cluster:install`.
#
# Example:
# apiServer:
#   slackBotToken: "xoxb-..."
#   slackAppToken: "xapp-..."
#
# Raise the per-user compute ceiling (summed limits across your running agents).
# The chart default is 8 CPU / 16Gi. A driver agent plus a couple of concurrent
# Invocation targets can exceed that, so bump it if you run wide fan-outs:
# controller:
#   userBudgets:
#     defaultCpu: "12"
#     defaultMemory: "24Gi"
