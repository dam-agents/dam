#!/usr/bin/env bash
# preflight.sh — deterministic pre-flight for {{AGENT_NAME}}.
#
# TODO(creator): keep this header contract verbatim, fill the per-mode detection, delete
# TODO comments. The script DETECTS, it NEVER ACTS:
#
#   - NO external writes at all (list/GET calls only),
#   - NO git commit/push (the agent persists at end of run),
#   - local writes only: documented bookkeeping status flips, per-mode log lines, caches.
#
#   preflight.sh <mode>   -> one JSON object on stdout; everything else to stderr.
#   .nothing_to_do == true  -> the agent ends the run immediately.
#   otherwise               -> the agent processes the arrays per CLAUDE.md + docs/.
#
# Requires: bash, jq, git, sed/grep/cut/tr, GNU date (Linux pod). Deliberately awk-free —
# awk is not available in the pod.

set -u
export LC_ALL=C

MODE="${1:-}"                       # TODO(creator): default to the most frequent mode
HOME_DIR="${HOME:-/home/agent}"
WORK="${WORK_DIR:-$HOME_DIR/work}"
CONFIG="$WORK/CONFIG.md"
NOW_EPOCH=$(date -u +%s)
NOW_ISO=$(date -u +%Y-%m-%dT%H:%M:%SZ)

LOGS=()
log() { LOGS+=("$1"); }

# The config readers (`cfg`, `cfg_table`) live in one file that every reader of
# CONFIG.md sources — never copied here, so the runtime and the verifier cannot
# drift apart. A missing lib is fatal: parsing config by hand is how they drift.
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
. "$SCRIPT_DIR/lib/config.sh" || { echo "cannot source lib/config.sh" >&2; exit 1; }

# GNU date first, BSD fallback (macOS dev machines — `-u` matters: without it the
# trailing Z is parsed in local time and lock ages skew); epoch 0 on unparsable input.
iso2epoch() { date -d "$1" +%s 2>/dev/null \
              || date -j -u -f '%Y-%m-%dT%H:%M:%SZ' "$1" +%s 2>/dev/null || echo 0; }

# ---------------------------------------------------------------- config ----
# TODO(creator): resolve every config key the detection needs, env vars first:
#   TARGET="${TARGET_ENV_VAR:-$(cfg target_key)}"
# and fail_out early when a required one is missing.

fail_out() {  # nothing-to-do JSON with an error; the agent just logs it
  jq -n --arg mode "$MODE" --arg err "$1" \
    --argjson logs "$(printf '%s\n' "${LOGS[@]:-}" | jq -R . | jq -s '[.[] | select(length>0)]')" \
    '{mode:$mode, nothing_to_do:true, error:$err, logs:$logs}'
  exit 0
}

emit() {  # $1 = jq object body of mode-specific arrays, e.g. '{items_due:$items}'
  # TODO(creator): build one emit per mode from jq -n with --argjson arrays; set
  # nothing_to_do by testing every array's length. Never hand-concatenate JSON.
  :
}

# =========================================================== <MODE 1> ====
# TODO(creator): one section per scheduled run type. Shape:
#   1. One batched read-only listing call for the mode's item universe.
#   2. Per item: compute the decision (due / skip / cleanup / self-heal / retry),
#      pushing self-contained JSON entries into arrays and a log line per decision.
#   3. Documented local bookkeeping only (status flips whose transition must log once).
#   4. Append the mode's log line to work/<RUNTYPE>.log; emit the JSON.

# ============================================================ AUDIT MODE ====
# TODO(creator): keep; extend with domain checks from the design (state vs external
# markers, orphaned artifacts, claimed-but-unsent messages…). Universal checks to
# implement here, each appending {id, status: ok|warn|fail, detail} to a checks array
# and never fixing anything:
#   - connectivity: one unauthenticated-failure-proof GET per integration (+ rate limit
#     headroom where reported); token scopes + required CLI commands (both specified
#     once, in README)
#   - backup invariants (git-backed state): no work/.git on the volume; count of .nfs*
#     files under work/ (early concurrency signal)
#   - run cadence: gaps in each run type's log vs. its registered cadence
#   - error scan: grep "^.*ERROR:" across the week's work/*.log lines; with the events
#     log, group the week's {level: error} events into failures[] signatures
#     (event/tool/error, volatile bits normalized, dated first/last) for the agent's
#     diagnosis pass, and delete events files older than the retention window
#   - open issues on the definition repo (PRs filtered out)
#   - stale locks / duplicate tracking rows / leftover /tmp/{{AGENT_NAME}}-* dirs
#   - disk usage of the volume (warn threshold)
#   - definition cleanliness (git -C "$HOME" status --porcelain empty) and version
#     currency: origin/main VERSION vs checked-out VERSION vs work/VERSION
# plus 7-day stats counters from the logs (runs, idle ratio, per-mode throughput).

case "$MODE" in
  # TODO(creator): mode dispatch — one case per run type + audit; unknown mode →
  # fail_out "unknown mode: $MODE".
  *) fail_out "unknown mode: $MODE" ;;
esac
