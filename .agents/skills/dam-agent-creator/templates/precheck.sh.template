#!/usr/bin/env bash
# precheck.sh — the schedule gate for {{AGENT_NAME}}: decides whether a run starts at all.
#
# TODO(creator): keep this file verbatim except the mode table below; it has no domain
# logic of its own. Delete it only when the design has no scheduled runs.
#
# The platform runs `precheck.sh <mode>` before a scheduled fire and reads the EXIT
# CODE as the verdict — the way grep splits it:
#
#   0  -> run the turn. stdout (first 8 KiB) is appended to the task prompt.
#   1  -> decline this occurrence. No model is woken; stdout is discarded.
#   *  -> the gate itself broke: the platform runs the turn ANYWAY and records the
#         reason. Fail-open by design, so a typo exiting 127 cannot silence a
#         schedule for weeks while looking exactly like "nothing changed".
#
# It runs the mode's pass ONCE — `preflight.sh <mode>`, or `monitor.sh` for the
# monitor — under its own budget, keeps the worklist in a file, and prints the path
# plus the summary the run starts from:
#
#   nothing_to_do -> exit 1, no output. The pass's own log lines carry the tick.
#   work          -> exit 0, `worklist: <path>` + the non-empty keys and the logs.
#   no JSON       -> exit 2 with the reason, the pass's exit code and its stderr tail.
#   over budget   -> exit 2 with the pass's last logged step.
#   error         -> exit 2 with the pass's `error`: it could not decide, which is a
#                    broken gate, never an idle tick — a failed read is never an answer.
#
# The pass is never run twice for one fire: its bookkeeping is one-shot, so the run
# reads the file named here instead of recomputing the decisions. The JSON itself
# never travels in the prompt — a worklist with per-item context reaches megabytes.
#
# Runs under `bash -lc` with the work directory as cwd, a 2-minute deadline, and
# PLATFORM_SCHEDULE_ID / PLATFORM_FIRE_AT / PLATFORM_LAST_RUN_AT in the environment.
# PLATFORM_LAST_RUN_AT is the last fire that ACTUALLY RAN — declined occurrences do
# not move it, so it is the right "changed since?" watermark for a detection pass.

set -u
export LC_ALL=C

MODE="${1:-}"
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TMP="${TMPDIR:-/tmp}"
PREFIX="{{AGENT_NAME}}"

LOG_JOB="$MODE"
# stdout is the task prompt (an idle fire must print nothing at all), so everything
# below writes to a file, a variable or /dev/null
if ! . "$SCRIPT_DIR/log.sh" >/dev/null 2>&1; then
  logev() { :; }; _log_mask() { printf '%s' "$1"; }
fi

# TODO(creator): drop the monitor row when the design has no scripts/monitor.sh.
case "$MODE" in
  monitor) PASS=monitor.sh; PASS_ARGS=(); RERUN='bash "$HOME/scripts/monitor.sh"';;
  audit)
    printf 'precheck: audit is not gated — its worklist carries work whenever the report is enabled. Run `bash "$HOME/scripts/preflight.sh" audit` in the session.\n'
    exit 2;;
  '')
    printf 'precheck: no mode given — run the pre-flight yourself (CLAUDE.md → Run types).\n'
    exit 2;;
  *) PASS=preflight.sh; PASS_ARGS=("$MODE"); RERUN="bash \"\$HOME/scripts/preflight.sh\" $MODE";;
esac

# A missing pass degrades to a slower run, never a skipped one: the same fallback the
# agent-side contract states for non-JSON output.
[ -f "$SCRIPT_DIR/$PASS" ] || {
  printf 'precheck (%s): scripts/%s is missing — fall back to the manual procedure in docs/.\n' "$MODE" "$PASS"
  exit 2
}

# The scratch of a gated fire, bounded here rather than by the session: a declined
# fire has no session to clean up after it. Three hours takes only dead files.
find "$TMP" -maxdepth 1 -name "$PREFIX-worklist-*.json" -mmin +180 -delete >/dev/null 2>&1 || true

# The pass gets its own budget, under the platform's two-minute limit: a pass the
# platform stops leaves no trace of why, one stopped here names its last logged step.
# A host without `timeout` runs the pass without a budget (`${LIMIT[@]+…}`: bash
# before 4.4 treats an empty array as unset under `set -u`).
BUDGET="${PRECHECK_BUDGET_S:-100}"
START="$(date -u +%Y-%m-%dT%H:%M:%S)"
LIMIT=(); command -v timeout >/dev/null 2>&1 && LIMIT=(timeout -k 5 "$BUDGET")
ERR="$(mktemp "$TMP/$PREFIX-precheck-err.XXXXXX" 2>/dev/null || echo /dev/null)"
JSON="$(${LIMIT[@]+"${LIMIT[@]}"} bash "$SCRIPT_DIR/$PASS" ${PASS_ARGS[@]+"${PASS_ARGS[@]}"} 2>"$ERR")"; RC=$?
# a broken gate's reason reaches the owner's panel, so it passes the log's masking
WHY="$(_log_mask "$(tail -c 400 "$ERR" 2>/dev/null | tr '\n' ' ')")"
[ "$ERR" = /dev/null ] || rm -f "$ERR"

if [ "${#LIMIT[@]}" -gt 0 ] && { [ "$RC" -eq 124 ] || [ "$RC" -eq 137 ]; }; then
  LAST="$(cat "${LOG_DIR:-/nonexistent}/events-$(date -u +%Y-%m-%d).jsonl" 2>/dev/null \
    | jq -r --arg job "$MODE" --arg since "$START" \
        'select(.job == $job and .ts >= $since) | "\(.event): \(.msg)"' 2>/dev/null \
    | tail -1 | cut -c1-200)"
  LAST="$(_log_mask "${LAST:-none}")"
  logev error precheck "$MODE gate: $PASS stopped at its ${BUDGET}s budget — the run starts and does the work manually — last step: $LAST"
  printf 'precheck (%s): scripts/%s did not finish in its %ss budget (last logged step: %s). Do the equivalent work manually per docs/ — never silently skip a run. One-shot bookkeeping of the stopped pass may be spent, so a second pass may report less than the first.\n' \
    "$MODE" "$PASS" "$BUDGET" "$LAST"
  exit 2
fi

if ! printf '%s' "$JSON" | jq -e 'type == "object" and has("nothing_to_do")' >/dev/null 2>&1; then
  logev error precheck "$MODE gate: $PASS printed no worklist (exit $RC) — the run starts and does the work manually${WHY:+ — stderr: $WHY}"
  printf 'precheck (%s): scripts/%s printed no JSON worklist (exit %s)%s. Do the equivalent work manually per docs/ — never silently skip a run.\n' \
    "$MODE" "$PASS" "$RC" "${WHY:+ — stderr: $WHY}"
  exit 2
fi

ERRTXT="$(printf '%s' "$JSON" | jq -r '.error // empty | tostring' | cut -c1-400)"
if [ -n "$ERRTXT" ]; then
  # a pass that could not even list has NOT answered "nothing changed": declining
  # would hide an outage inside the decline counter, where it reads like a quiet week
  ERRTXT="$(_log_mask "$ERRTXT")"
  logev error precheck "$MODE gate: $PASS could not decide (exit $RC) — the run starts and does the work manually — $ERRTXT"
  printf 'precheck (%s): scripts/%s could not decide (exit %s): %s. Do the equivalent work manually per docs/ — never silently skip a run.\n' \
    "$MODE" "$PASS" "$RC" "$ERRTXT"
  exit 2
fi

if [ "$(printf '%s' "$JSON" | jq -r '.nothing_to_do')" = "true" ]; then
  logev info precheck "$MODE gate: nothing to do, no session started — $(printf '%s' "$JSON" | jq -r '[.logs[]?] | join("; ")' | cut -c1-300)"
  exit 1
fi

# The worklist carries resolved config and per-item context, and /tmp is shared:
# the file is this instance's to read.
OUT="$TMP/$PREFIX-worklist-$MODE-$(date -u +%Y%m%dT%H%M%SZ)-$$.json"
if ! ( umask 077; printf '%s\n' "$JSON" > "$OUT" ) 2>/dev/null; then
  logev error precheck "$MODE gate: the worklist file could not be written — the run recomputes it"
  printf 'precheck (%s): work is due, but the worklist file could not be written. Run `%s` yourself; one-shot bookkeeping of the first pass is already spent, so it may report less.\n' \
    "$MODE" "$RERUN"
  exit 0
fi

# the non-empty work keys, so the prompt says why the run fired without the whole
# worklist travelling in it
WHAT="$(printf '%s' "$JSON" | jq -r '
  [ to_entries[]
    | select(.key | endswith("_due"))
    | select((.value | type) == "array" and (.value | length) > 0)
    | "\(.key)=\((.value | length))"
      + ( [ .value[] | .id? // empty | tostring ] | if length > 0 then " (" + join(", ") + ")" else "" end ) ]
  + ( if .housekeeping_only == true then [ "housekeeping_only" ] else [] end )
  | join(", ")')"

logev info precheck "$MODE gate: work due — ${WHAT:-see the worklist}"
printf 'worklist: %s\n' "$OUT"
printf 'mode=%s, due: %s\n' "$MODE" "${WHAT:-see the worklist}"
printf '%s' "$JSON" | jq -r '.logs[]? | "- " + .'
printf 'The worklist above is already computed. Read the file, do not run %s again this run.\n' "$PASS"
exit 0
