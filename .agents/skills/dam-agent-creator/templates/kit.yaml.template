# kit.yaml — the platform's Starter Kit for {{AGENT_NAME}}.
#
# TODO(creator): delete the fields the design does not need (all of them are
# optional except schemaVersion/id/name/description/category). Keep this file in step with
# README and ONBOARDING — the schedules here and the ones ONBOARDING checks for are
# the same schedules, by the same names.
#
# An optional key is either filled in or DELETED, never left bare: `tagline:` with
# nothing after it parses as null, which the platform's schema refuses, and the kit
# is then dropped from the catalog listing with only a server-side log to say so.
# That is why the optional keys below start commented out.
#
# This repository IS the kit: the platform reads this file out of git, creates the
# agent from it, seeds this definition into $HOME, and opens the first session on
# ONBOARDING.md. See references/kit.md for what that leaves the runbook to do.

schemaVersion: v1
id: {{AGENT_NAME}}
name: {{AGENT_DISPLAY_NAME}}
description: >-
  TODO(creator): one paragraph — what the agent does, on which unit of work, where
  its output lands, and every run and outward surface this kit creates (the monitor,
  a dashboard, a channel). This is the catalog's promise; a new run or surface
  updates it in the same commit.
# TODO(creator): pick the category that fits: knowledge | software | productivity | research
category: software

# TODO(creator): uncomment and fill what the catalog card should show.
# tagline: One line — the hook, not a summary.
# icon: robot
# avatar: {path: avatar.png}  # or a character (shield) or "emoji:🛡️"; a JPG or PNG of at most 2 MB
# docsUrl: https://github.com/<org>/{{AGENT_NAME}}/blob/main/README.md

# The definition is seeded from this very repository, at the commit the kit was read
# at, into $HOME — never a clone, so nothing the platform put there is removed.
# Do not add `url` or `ref`: `self` names this repository and pins it by itself.
seed:
  self: true
  into: home

# NOTE: no `onboarding` field, deliberately. Absent means the platform composes the
# briefing from the live agent state and ends it with "follow ONBOARDING.md" — which
# is what keeps the onboarding gate, the progress tools, and the hold on schedules.
# Declaring a command here would stamp the agent onboarded at create and drop all
# three (references/kit.md → Never declare `onboarding`).

# TODO(creator): one entry per connection the design needs. `accepts` takes a family
# (github, github-enterprise, slack, telegram, …) so any auth method satisfies it.
# `required: true` is checked BEFORE the agent is created and refuses the apply;
# anything gated behind an opt-in config key is `required: false`.
connections:
  - accepts: [github]
    required: true
    note: TODO(creator) — what the agent does with it, in one line.

# TODO(creator): keep only when the agent listens on a channel; suggested only, a
# channel never blocks apply. Delete the key otherwise.
channels:
  - type: slack
    note: TODO(creator) — what arrives here and what the agent does with it.

# TODO(creator): one entry per scheduled run type from the design, INCLUDING the
# weekly audit and the monitor. `name` carries the agent prefix — ONBOARDING reconciles
# exactly these names. `task` is the run's entry text, verbatim the blockquote of its
# ONBOARDING step (the validator compares the two). `description` is one plain
# sentence the operator reads on the schedule's card. `enabled: false` makes it
# suggested: created switched off for the operator to turn on. `precheck` declines an
# idle occurrence before any model is woken; every run gets one except the audit
# (references/preflight.md → The Precheck). The cron is the default cadence — around
# the clock at the active interval, because an idle tick behind a precheck is free;
# an instance's window is its own (work/CONFIG.md), registered by ONBOARDING.
# The kit schema has no `model` or `sessionTitle` field yet, so these schedules start
# on the platform's default model and untitled; ONBOARDING re-registers each with
# `run_model` and its title. Declare them here once the schema carries them.
# Delete the whole key for a design with no scheduled runs (rare — the audit is
# recommended for every agent).
schedules:
  - name: {{AGENT_NAME}}-<runtype>-<cadence>
    cron: "TODO(creator) — five-field cron"
    description: TODO(creator) — one sentence on what this run does, for the operator.
    sessionMode: fresh
    precheck: 'bash "$HOME/scripts/precheck.sh" <mode>'
    task: >-
      TODO(creator) — <Run name>. The precheck already ran the pre-flight and found
      work: read the worklist JSON at the path its output names, and never run
      preflight.sh again this run. If the prompt carries no worklist path, run
      `bash "$HOME/scripts/preflight.sh" <mode>` yourself. Then follow CLAUDE.md →
      "<Run section>": …, and back up work/ at the end
      (`scripts/work-backup.sh persist`).
  - name: {{AGENT_NAME}}-audit-weekly
    cron: "0 6 * * 5"
    sessionMode: fresh
    task: >-
      TODO(creator) — Weekly audit. Run `bash "$HOME/scripts/preflight.sh" audit`
      first — this run is ungated. Follow CLAUDE.md → "Audit run": …
  # The monitor: every instance, no question at onboarding; an idle tick costs no
  # model call (docs/monitor.md).
  - name: {{AGENT_NAME}}-monitor-15m
    cron: "*/15 * * * *"
    sessionMode: fresh
    precheck: 'bash "$HOME/scripts/precheck.sh" monitor'
    task: >-
      TODO(creator) — Agent monitor. The precheck already ran scripts/monitor.sh and
      found alerts due: read the worklist JSON at the path its output names, and never
      run monitor.sh again this run. If the prompt carries no worklist path, run
      `bash "$HOME/scripts/monitor.sh"` yourself. Then follow CLAUDE.md → "Monitor
      run": read docs/monitor.md, report every alert of the worklist in one message,
      acknowledge them with `scripts/monitor.sh ack <ids>` only after the send, never
      repair or re-run anything in response, and back up work/
      (`scripts/work-backup.sh persist`).

# TODO(creator): keep only when the workload needs more disk than the install
# default. `storage` is fixed at create; CPU and memory come from the owner's pool.
resources:
  storage: 5Gi
  note: TODO(creator) — why this disk.

# TODO(creator): keep only when the job needs other web access than the platform
# default (trusted sites): none | trusted | all.
egressPreset: trusted
# TODO(creator): keep only for hosts the job always needs beyond the preset.
egressRules:
  - host: TODO(creator).example.com

# TODO(creator): keep only when the agent runs a program at every boot — a
# dashboard, a local API, a watcher: each is a Login item (an openrc user
# service) written at create, never an onboarding step.
# `command` is a program on PATH, an absolute path, or ~/… — never a shell line.
startupItems:
  - name: TODO-creator-item
    description: TODO(creator) — what it serves, one line
    command: ~/bin/TODO-creator
    args: [serve]

# TODO(creator): keep only when a heartbeat fires finer than the install's idle
# timeout — otherwise the agent is paid for a wake-up round trip every tick.
hibernationTimeoutMin: 30

# TODO(creator): keep only for values EVERY deployment shares. Anything that differs
# between two deployments is a config key in the onboarding dialog, never here.
env:
  - name: TODO_CREATOR_NAME
    value: "TODO(creator) — the fixed value"

# TODO(creator): keep only when the definition bundles a skill of its own. A scan
# root; the platform installs nothing, the harness finds it in the checkout.
bundledSkills:
  path: .agents/skills

# TODO(creator): keep only when the design depends on a harness family's conventions
# (hook layout, command spelling). Omit to let the operator pick any harness.
harnesses: [claude-code]
