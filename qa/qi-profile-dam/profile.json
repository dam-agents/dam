{
  "schema": "qi-profile/v1",
  "product": "DAM",
  "app": { "url": "http://localhost:4444" },
  "issues": { "provider": "github" },
  "engine": "helm-k3s",
  "engine_config": {
    "chart": "{{config:chart_ref}}",
    "registry_api": "quay",
    "release": "platform",
    "namespace": "default",
    "app_port": 4444,
    "traefik_port": true,
    "apply_chart_crds": true,
    "channels": {
      "main": { "tag": "^0\\.0\\.0-main\\.[0-9]+$", "order": "numeric-suffix" },
      "release": { "tag": "^[0-9]+\\.[0-9]+\\.[0-9]+$", "order": "semver" }
    },
    "default_candidate": "main",
    "default_baseline": "release",
    "helm_version": "{{config:helm_version}}",
    "credentials": { "users": { "owner": { "username": "qa-owner" } }, "secrets": ["keycloak_admin"] },
    "prerequisites": [
      { "kind": "manifest", "name": "cert-manager",
        "url": "https://github.com/cert-manager/cert-manager/releases/download/{{config:cert_manager_version}}/cert-manager.yaml",
        "unless": "ns/cert-manager", "wait": { "namespace": "cert-manager", "deployments": true } },
      { "kind": "manifest", "name": "gateway-api",
        "url": "https://github.com/kubernetes-sigs/gateway-api/releases/download/{{config:gateway_api_version}}/standard-install.yaml",
        "unless": "crd/gateways.gateway.networking.k8s.io" },
      { "kind": "adopt-crds", "name": "gateway-api-for-traefik", "release": "traefik-crd", "namespace": "kube-system",
        "crds": ["gatewayclasses.gateway.networking.k8s.io", "gateways.gateway.networking.k8s.io", "grpcroutes.gateway.networking.k8s.io",
                 "httproutes.gateway.networking.k8s.io", "referencegrants.gateway.networking.k8s.io"] },
      { "kind": "helm", "name": "istio-base", "repo": "https://istio-release.storage.googleapis.com/charts", "chart": "base",
        "version": "{{config:istio_version}}", "namespace": "istio-system", "set": { "defaultRevision": "" } },
      { "kind": "manifest", "name": "no-mesh-marker", "file": "no-mesh-marker.yaml" }
    ],
    "values": {
      "domain": "localhost",
      "port": "{{app_port}}",
      "scheme": "http",
      "ingress": { "catchAllAppHost": true },
      "istio": { "enforce": false },
      "terms": { "version": "qa", "text": "Nested QA environment." },
      "keycloak": {
        "admin": { "password": "{{secret:keycloak_admin}}" },
        "testUser": { "enabled": true, "username": "{{user:owner.username}}", "password": "{{user:owner.password}}" }
      }
    },
    "overlays": [
      { "when": "mock_image", "values": { "harnessTemplates": { "mock": {
        "enabled": true, "description": "Scripted mock agent (QA)",
        "image": { "repository": "{{config_repo:mock_image}}", "tag": "{{config_tag:mock_image}}" } } } } }
    ]
  },
  "boundary": { "github_paths": ["actions/runs?per_page=1", "releases?per_page=1"], "urls": [] },
  "egress": [
    { "host": "quay.io", "method": "GET", "why": "chart and image pulls, tag listings" },
    { "host": "*.quay.io", "method": "GET", "why": "image layers" },
    { "host": "get.helm.sh", "method": "GET", "why": "the helm binary" },
    { "host": "istio-release.storage.googleapis.com", "method": "GET", "why": "Istio charts" },
    { "host": "github.com", "method": "GET", "path": "/cert-manager/cert-manager/releases/*", "why": "cert-manager manifest" },
    { "host": "github.com", "method": "GET", "path": "/kubernetes-sigs/gateway-api/releases/*", "why": "Gateway API CRDs" },
    { "host": "objects.githubusercontent.com", "method": "GET", "why": "release downloads" },
    { "host": "release-assets.githubusercontent.com", "method": "GET", "why": "release downloads" }
  ],
  "requires": { "root": true, "commands": ["k3s", "curl", "jq", "node"], "memory_gi": 12 },
  "config": {
    "chart_ref": { "default": "oci://quay.io/dam-agents/charts/platform", "about": "OCI chart the builds come from" },
    "mock_image": { "default": "", "about": "image of a mock harness template so nested agents answer without a model; empty = none", "ask": true },
    "istio_version": { "default": "1.29.1", "about": "Istio CRDs only (istio-base), installed once in the nested cluster" },
    "cert_manager_version": { "default": "v1.21.2", "about": "cert-manager, installed once" },
    "gateway_api_version": { "default": "v1.2.0", "about": "Gateway API CRDs, installed once" },
    "helm_version": { "default": "v3.19.0", "about": "helm downloaded into the home" }
  }
}
